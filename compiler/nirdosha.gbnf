# Nirdosha — GBNF grammar for constrained decoding.
#
# Hand-translated from GRAMMAR.md's EBNF, production-for-production, the
# same discipline `grammar_check/src/nirdosha.lalrpop` already follows for
# its own (different-purpose) cross-check. This is **not** a mechanical
# export — there is no tool that turns `parser.rs`'s hand-written
# recursive descent, or GRAMMAR.md's EBNF, into GBNF automatically. See
# the unified development plan's §4.2.3, and `../grammar_export/README.md`
# for the full story of what's actually been checked and how (a real
# llama.cpp grammar-parser dependency, plus a fidelity corpus comparing
# accept/reject behavior against the real lexer+parser).
#
# 2026-08-25: brought current with GRAMMAR.md after `tests/fidelity.rs`
# caught real drift — this file previously only covered `fn_decl` plus
# the base expression/statement language (a v1-era snapshot). It now
# also covers `struct`/`enum`/`match` (row 11), `effect(...)`/
# `requires(...)` annotations (row 12), `.ident` field access, generic
# type application (`Pair(i64, str)`), `transact`, the `screen`/
# `dashboard`/`module`/`workflow` UI/workflow DSLs, `audited`, and
# `listen`/`accept` — every production GRAMMAR.md documents.
#
# Found by that real check, not by re-reading this file more carefully:
# llama.cpp's GBNF parser requires a rule's *entire* multi-line body to
# sit inside one already-open, unclosed group — not just multi-line
# *alternation* (`type`, `scalar-type-name`, `unary`, `primary` all wrap
# in `(...)` for exactly that reason). A multi-line rule with no `|` at
# all still needs the same wrapping (found via `transact-expr`: without
# it, the real parser reports "expecting name" at the second line,
# because once a line ends with no group left open, it starts looking
# for the next rule's `name ::=`, not a continuation of this one).
# Nothing in GBNF's documentation makes either of these obvious in
# advance — both found by running the real llama.cpp grammar parser
# against this file, not by re-reading the file more carefully.
#
# Known, deliberate imprecision: `ident` accepts any identifier-shaped
# text, including this language's keywords (`let`, `fn`, `if`, ...) —
# GBNF has no clean negative-lookahead/"not a keyword" primitive without
# enumerating every keyword as an explicit exclusion, which would roughly
# double this file's size for a property that costs nothing to get wrong
# in the direction this does: a constrained decoder that occasionally
# permits `let` as a bare identifier where the real grammar wouldn't is
# *safe* (the real parser/typeck still rejects it — same "over-permissive
# in a safe direction" tradeoff `GRAMMAR.md`'s own LALR(1) cross-check
# documents for the statement-separator ambiguity), whereas a decoder
# that's ever *too strict* would block a legal completion outright. The
# fidelity corpus (`tests/gbnf.rs`) tests real programs, not adversarial
# keyword-as-identifier cases, so this gap doesn't show up there. Every
# keyword-literal alternative below is listed before the generic
# `ident`/`call` fallback in the same production (`type`'s scalar names
# before its trailing `ident(...)` case, `unary`'s `spawn`/`sandbox`/...
# before its trailing `call` case) — the same order-of-alternatives
# discipline the pre-existing `unary` rule already relied on, now applied
# consistently to every rule added in the 2026-08-25 update too.

root        ::= ws program ws

program     ::= (item ws)*

item        ::= fn-decl | struct-decl | enum-decl | screen-decl | dashboard-decl | module-decl | workflow-decl | workspace-decl

fn-decl     ::= "fn" ws ident ws "(" ws params? ws ")" ws ret-type? (ws effect-annotation)? (ws requires-annotation)? ws block

effect-annotation ::= "effect" ws "(" ws effect-name (ws "," ws effect-name)* ws ")"
effect-name ::= "pure" | "rng" | "io" | "concurrent" | "network"

requires-annotation ::= "requires" ws "(" ws (
                           ("role" ws ":" ws str-lit)
                         | ("claim" ws ":" ws str-lit ws "," ws str-lit)
                         | "public"
                       ) ws ")"

struct-decl ::= "struct" ws ident (ws type-param-list)? ws "{" ws field (ws "," ws field)* (ws ",")? ws "}"
field       ::= ident ws ":" ws type
type-param-list ::= "(" ws ident (ws "," ws ident)* ws ")"

enum-decl   ::= "enum" ws ident (ws type-param-list)? ws "{" ws variant (ws "," ws variant)* (ws ",")? ws "}"
variant     ::= ident (ws "(" ws type (ws "," ws type)* ws ")")?

screen-decl    ::= "screen" ws ident ws "{" ws (screen-item ws)* "}"
screen-item    ::= paginate-block | field-override | action-decl | kv-entry
paginate-block ::= "paginate" ws "{" ws (kv-entry ws)* "}"
field-override ::= "field" ws ident ws "{" ws (kv-entry ws)* "}"
action-decl    ::= "action" ws str-lit ws "->" ws ident (ws "{" ws (kv-entry ws)* "}")?
kv-entry       ::= ident ws ":" ws expr

dashboard-decl ::= "dashboard" ws "{" ws (dashboard-item ws)* "}"
dashboard-item ::= ("tile" | "chart") ws str-lit ws "->" ws ident

# `workspace Name { subject: Struct panel "..." { ... } }` -- Track E1's
# composite multi-panel screen. `action-decl` inside `panel-item` is
# `screen-item`'s own production, reused unchanged.
workspace-decl ::= "workspace" ws ident ws "{" ws (workspace-item ws)* "}"
workspace-item ::= panel-decl | kv-entry
panel-decl     ::= "panel" ws str-lit ws "{" ws (panel-item ws)* "}"
panel-item     ::= action-decl | kv-entry

module-decl ::= "module" ws str-lit ws "{" ws ((fn-decl | struct-decl | enum-decl) ws)* "}"

workflow-decl  ::= "workflow" ws ident ws "{" ws (data-block ws)? (state-decl ws)+ "}"
data-block     ::= "data" ws "{" ws field (ws "," ws field)* (ws ",")? ws "}"
state-decl     ::= "state" ws ident (ws "terminal")? ws "{" ws (on-entry-block ws)? (on-exit-block ws)? (transition ws)* "}"
on-entry-block ::= "on_entry" ws "{" ws (action-call ws)* "}"
on-exit-block  ::= "on_exit" ws "{" ws (action-call ws)* "}"
action-call    ::= ident ws "(" ws (expr (ws "," ws expr)*)? ws ")"
transition     ::= "on" (ws "link")? ws ident ws "->" ws ident

params      ::= param (ws "," ws param)*
param       ::= ident ws ":" ws type

ret-type    ::= "->" ws type

type        ::= (
                  "&" ws type
                | "box" ws type
                | "thread" ws type
                | "chan" ws type
                | "sandbox"
                | "Vector" ws "(" ws type ws "," ws int-lit ws ")"
                | "Matrix" ws "(" ws type ws "," ws int-lit ws "," ws int-lit ws ")"
                | scalar-type-name
                | ident (ws "(" ws type (ws "," ws type)* ws ")")?
                | "fn" ws "(" ws (type (ws "," ws type)*)? ws ")" (ws "->" ws type)?
              )

scalar-type-name ::= (
                    "i8" | "i16" | "i32" | "i64"
                  | "u8" | "u16" | "u32" | "u64" | "usize" | "f64"
                  | "bool" | "unit" | "str" | "tcp_listener" | "tcp"
                  )

block       ::= "{" ws stmt* ws "}"

stmt        ::= (let-stmt | return-stmt | while-stmt | audited-stmt | expr-stmt) ws

let-stmt    ::= "let" ws ident ws ":" ws type ws "=" ws expr
return-stmt ::= "return" (ws expr)?
while-stmt  ::= "while" ws expr ws block
audited-stmt ::= "audited" ws str-lit ws "{" ws stmt* ws "}"
expr-stmt   ::= expr

expr        ::= if-expr | transact-expr | match-expr | assignment

if-expr     ::= "if" ws expr ws block (ws "else" ws (block | if-expr))?

match-expr  ::= "match" ws expr ws "{" ws match-arm (ws "," ws match-arm)* (ws ",")? ws "}"
match-arm   ::= variant-arm | literal-arm
variant-arm ::= ident (ws "(" ws (ident (ws "," ws ident)*)? ws ")")? ws "=>" ws expr
literal-arm ::= (str-lit | int-lit | "true" | "false" | "_") ws "=>" ws expr

transact-expr ::= (
                     "transact" ws "{" ws
                     ("precheck" ws ":" ws call ws)?
                     "network" ws ":" ws call (ws "retry" ws int-lit)? (ws "timeout" ws int-lit)? ws
                     "verify" ws ":" ws call ws
                     "commit" ws ":" ws call
                     (ws "compensate" ws ":" ws call)?
                     (ws "log" ws ":" ws call)?
                     ws "}"
                   )

assignment  ::= (ident ws "=" ws assignment) | logic-or

logic-or    ::= logic-and (ws "||" ws logic-and)*
logic-and   ::= equality (ws "&&" ws equality)*
equality    ::= comparison (ws ("==" | "!=") ws comparison)*
comparison  ::= additive (ws ("<=" | ">=" | "<" | ">") ws additive)*
additive    ::= multiplicative (ws ("+" | "-") ws multiplicative)*
multiplicative ::= unary (ws (".*" | "./" | "*" | "/") ws unary)*

unary       ::= (
                  ("!" | "-" | "*" | "box" | "&") ws unary
                | "spawn" ws call
                | "join" ws unary
                | "chan"
                | "send" ws "(" ws expr ws "," ws expr ws ")"
                | "recv" ws "(" ws expr ws ")"
                | "sandbox" ws call
                | "stop" ws unary
                | "connect" ws "(" ws expr ws "," ws expr ws ")"
                | "listen" ws "(" ws expr ws ")"
                | "accept" ws "(" ws expr ws ")"
                | "acquire" ws call
                | call
              )

call        ::= postfix (ws "(" ws args? ws ")")?
args        ::= expr (ws "," ws expr)*

postfix     ::= primary (ws (("[" ws expr (ws "," ws expr)* ws "]") | ("." ws ident)))*

primary     ::= (
                  float-lit | int-lit | str-lit | "true" | "false" | ident
                | "(" ws expr ws ")"
                | array-lit
              )

array-lit   ::= "[" ws expr (ws "," ws expr)* ws "]"

str-lit     ::= "\"" str-char* "\""
str-char    ::= [^"\\] | "\\" ["\\ntr]

int-lit     ::= [0-9]+
float-lit   ::= [0-9]+ "." [0-9]+

ident       ::= [a-zA-Z_] [a-zA-Z0-9_]*

ws          ::= ( [ \t\r\n] | "//" [^\n]* "\n" )*
