// JSON -- concrete, per-target-type accessors (json_get_str/_i64/_f64/
// _bool) over an already-parsed document, every fallible one returning
// a real Result(_, str) (Row 11 layer 7's prelude) rather than trapping.
// No growable-collection type needed: array/object navigation reads the
// already-parsed serde_json tree directly, never materializing a
// Nirdosha-level Vector/Matrix for it.

struct Text {
    value: str,
}

fn main() {
    let text: str = "{\"name\": \"nirdosha\", \"version\": 1, \"stable\": false, \"tags\": [\"lang\", \"compiler\"]}"
    let described: Text = match json_parse(text) {
        Ok(doc) => match json_get_str(doc, "name") {
            Ok(name) => Text(name),
            Err(msg) => Text(msg),
        },
        Err(msg) => Text(msg),
    }
    print(described.value)
}
