// Exercises: `str` -- literals, escapes, function parameters/returns,
// equality. Deliberately minimal: no concatenation, no indexing, no
// slicing -- just enough to name things (a hostname, an image, a
// message) that couldn't be spelled any other way. See tcp_client.nir
// for what strings are actually *for* right now.
//
// `str` can no longer be, or be part of, a function's parameter or
// return type (the "enum favoring" rule -- `TypeErrorKind::
// StrInFnSignature`, typeck.rs::check_fn) -- so `greet` takes/returns
// `Text`, a one-field carrier struct, instead of bare `str`. `str`
// itself is untouched everywhere else: it's still a completely ordinary
// struct field type, local variable type, and literal.
struct Text {
    value: str,
}

fn greet(name: Text) -> Text {
    return name
}

fn main() {
    let s: str = "hello, nirdosha"
    print(s)

    let escaped: str = "line one\nline two\ttabbed"
    print(escaped)

    let g: Text = greet(Text("world"))
    print(g.value)

    let a: str = "same"
    let b: str = "same"
    let c: str = "different"
    print(a == b) // true
    print(a == c) // false
}
