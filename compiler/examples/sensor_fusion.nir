// Exercises: Phase 3's deterministic simulation primitives -- geometry
// (WGS84 lat/lon/alt <-> ECEF <-> local-ENU) and the linear Kalman
// filter -- together, the way a real sensor-fusion track would use them:
// convert a noisy sensor fix to a local tangent frame, then filter it.
fn main() {
    // A reference point (the tracking station) and a target fix, both
    // real-world lat/lon/alt.
    let station: Vector(f64, 3) = [37.7749, -122.4194, 0.0]
    let target: Vector(f64, 3) = [37.8044, -122.2712, 100.0]

    print(distance(lla_to_ecef(station), lla_to_ecef(target))) // meters
    print(bearing(station, target)) // degrees

    // The target's position in the station's local East-North-Up frame.
    let target_ecef: Vector(f64, 3) = lla_to_ecef(target)
    let enu: Vector(f64, 3) = ecef_to_enu(target_ecef, station)
    print(enu)

    // Round trip back to ECEF should recover the same point.
    let back: Vector(f64, 3) = enu_to_ecef(enu, station)
    print(back)

    // A 2-D constant-velocity Kalman filter tracking the target's ENU
    // (East, North) position from noisy fixes -- state x = [E, N],
    // process noise Q, one measurement update per step with
    // measurement noise R.
    rand_seed(7)
    let x: Vector(f64, 2) = [0.0, 0.0]
    let p: Matrix(f64, 2, 2) = [[100.0, 0.0], [0.0, 100.0]]
    let f: Matrix(f64, 2, 2) = [[1.0, 0.0], [0.0, 1.0]]
    let q: Matrix(f64, 2, 2) = [[0.1, 0.0], [0.0, 0.1]]
    let h: Matrix(f64, 2, 2) = [[1.0, 0.0], [0.0, 1.0]]
    let r: Matrix(f64, 2, 2) = [[4.0, 0.0], [0.0, 4.0]]

    let x1: Vector(f64, 2) = kf_predict_state(x, p, f, q)
    let p1: Matrix(f64, 2, 2) = kf_predict_cov(x, p, f, q)

    // A noisy measurement near [10.0, 5.0].
    let noise: f64 = rand_gaussian(0.0, 2.0)
    let z: Vector(f64, 2) = [10.0 + noise, 5.0]

    let x2: Vector(f64, 2) = kf_update_state(x1, p1, z, h, r)
    let p2: Matrix(f64, 2, 2) = kf_update_cov(x1, p1, z, h, r)
    print(x2)
    print(p2)
}
