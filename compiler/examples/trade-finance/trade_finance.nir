// ---- regulatory extracts: real computed aggregates, illustrative only -

// `[MOCK]` -- stands in for a live Basel III/IV RWA/CRM extraction
// pipeline; the RWA figure itself is a real SQL aggregate (total credit
// exposure plus undrawn LC commitments) times a fixed illustrative
// risk-weight density, not a literal stub number. **Not for actual
// regulatory filing.**
fn mock_basel_extract_inner(conn: db) -> i64 {
    let exposure_cents: i64 = match db_query(conn, "SELECT COALESCE(SUM(utilized_cents), 0) as value FROM credit_limit") {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_i64(row, "value") { Ok(v) => v, Err(e) => 0 },
            Err(e) => 0,
        },
        Err(e) => 0,
    }
    let undrawn_lc_cents: i64 = match db_query(conn, "SELECT COALESCE(SUM(amount_cents), 0) as value FROM letter_of_credit WHERE status IN ('advised', 'amended', 'presented')") {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_i64(row, "value") { Ok(v) => v, Err(e) => 0 },
            Err(e) => 0,
        },
        Err(e) => 0,
    }
    stop conn
    let risk_weight_density_bps: i64 = 7500
    return ((exposure_cents + undrawn_lc_cents) * risk_weight_density_bps) / 10000
}

fn mock_basel_extract() -> i64 {
    return match db_connect("trade_finance.db") {
        Ok(conn) => mock_basel_extract_inner(conn),
        Err(e) => 0,
    }
}

// `[MOCK]` -- stands in for a FinCEN/FIU-formatted AML export; a real
// count of sanctions overrides plus counterparties still carrying a
// "high" risk rating, not a literal stub number. **Not for actual
// regulatory filing.**
fn mock_aml_export_inner(conn: db) -> i64 {
    let overrides: i64 = match db_query(conn, "SELECT COUNT(*) as value FROM approval_request WHERE action_type = 'override_sanctions_match'") {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_i64(row, "value") { Ok(v) => v, Err(e) => 0 },
            Err(e) => 0,
        },
        Err(e) => 0,
    }
    // 'High', not 'high' -- risk_rating is now a real enum
    // (`RiskRating`), stored as its variant *name* (sql_bind_params'
    // enum-binding arm), not a lowercase convention string.
    let high_risk_counterparties: i64 = match db_query(conn, "SELECT COUNT(*) as value FROM counterparty WHERE risk_rating = 'High'") {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_i64(row, "value") { Ok(v) => v, Err(e) => 0 },
            Err(e) => 0,
        },
        Err(e) => 0,
    }
    stop conn
    return overrides + high_risk_counterparties
}

fn mock_aml_export() -> i64 {
    return match db_connect("trade_finance.db") {
        Ok(conn) => mock_aml_export_inner(conn),
        Err(e) => 0,
    }
}

struct RegulatoryExport {
    id: i64,
    export_type: str,
    period_note: str,
    generated_by: str,
    computed_value: i64,
    status: str,
}

fn list_regulatory_export_inner(conn: db) -> Result(json, ErrorCode) {
    let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS regulatory_export (id INTEGER PRIMARY KEY AUTOINCREMENT, export_type TEXT, period_note TEXT, generated_by TEXT, computed_value INTEGER, status TEXT)") { Ok(n) => n, Err(e) => -1 }
    let rows: Result(json, str) = db_query(conn, "SELECT id, export_type, period_note, generated_by, computed_value, status FROM regulatory_export ORDER BY id DESC")
    stop conn
    return match rows { Ok(v) => Ok(v), Err(e) => Err(DbError()) }
}

fn list_regulatory_export() -> Result(json, ErrorCode) requires(role: "compliance_officer") {
    return match db_connect("trade_finance.db") {
        Ok(conn) => list_regulatory_export_inner(conn),
        Err(e) => Err(DbError()),
    }
}

// Triggering a Basel III/IV or AML/FIU export is 6-Eyes per the doc's
// table -- this module's marquee governance wiring, same submit/apply
// shape as every earlier module's own high-risk action.
fn submit_regulatory_export(identity: VerifiedIdentity, export_type: ExportType, period_note: Text, justification: Text) -> Result(i64, ErrorCode) {
    return submit_approval(identity, ActionTypeRegulatoryExport(), ApprovalRiskTierSixEyes(), 2, 8, justification)
}

fn generate_regulatory_export_inner(conn: db, identity: VerifiedIdentity, request_id: i64, export_type: ExportType, period_note: Text) -> Result(i64, ErrorCode) {
    let status: str = match db_query(conn, "SELECT status as value FROM approval_request WHERE id = ?", request_id) {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_str(row, "value") { Ok(v) => v, Err(e) => "MISSING" },
            Err(e) => "MISSING",
        },
        Err(e) => "MISSING",
    }
    stop conn
    return if status != "APPROVED" {
        Err(RegulatoryExportIsNotYetFully6EyesApproved())
    } else {
        let computed_value: i64 = match export_type {
            ExportTypeBasel => mock_basel_extract(),
            ExportTypeAml => mock_aml_export(),
        }
        match db_connect("trade_finance.db") {
            Ok(conn2) => finish_regulatory_export(conn2, identity, export_type, period_note, computed_value),
            Err(e) => Err(DbError()),
        }
    }
}

fn finish_regulatory_export(conn: db, identity: VerifiedIdentity, export_type: ExportType, period_note: Text, computed_value: i64) -> Result(i64, ErrorCode) {
    let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS regulatory_export (id INTEGER PRIMARY KEY AUTOINCREMENT, export_type TEXT, period_note TEXT, generated_by TEXT, computed_value INTEGER, status TEXT)") { Ok(n) => n, Err(e) => -1 }
    let inserted: i64 = match db_execute(conn, "INSERT INTO regulatory_export (export_type, period_note, generated_by, computed_value, status) VALUES (?, ?, ?, ?, 'generated')", export_type, period_note.value, identity.subject, computed_value) {
        Ok(n) => n,
        Err(e) => -1,
    }
    stop conn
    return if inserted >= 0 { Ok(inserted) } else { Err(FailedToRecordRegulatoryExport()) }
}

fn generate_regulatory_export(identity: VerifiedIdentity, request_id: i64, export_type: ExportType, period_note: Text) -> Result(i64, ErrorCode) {
    return match db_connect("trade_finance.db") {
        Ok(conn) => generate_regulatory_export_inner(conn, identity, request_id, export_type, period_note),
        Err(e) => Err(DbError()),
    }
}

