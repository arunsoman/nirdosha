// Clearing a fraud flag as false-positive is Maker-Checker per the doc's
// table -- plain callable update, same disclosed per-module scoping every
// earlier module uses for its non-marquee actions (this module's marquee
// governance wiring is the discounting-bundle funding flow below).
fn update_fraud_case_inner(conn: db, f: FraudCase) -> Result(i64, ErrorCode) {
    let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS fraud_case (id INTEGER PRIMARY KEY AUTOINCREMENT, invoice_id INTEGER, flag_reason TEXT, score_bps INTEGER, disposition TEXT)") { Ok(n) => n, Err(e) => -1 }
    let result: Result(i64, str) = db_execute(conn, "UPDATE fraud_case SET flag_reason = ?, score_bps = ?, disposition = ? WHERE id = ?", f.flag_reason, f.score_bps, f.disposition, f.id)
    stop conn
    return match result { Ok(v) => Ok(v), Err(e) => Err(DbError()) }
}

fn update_fraud_case(f: FraudCase) -> Result(i64, ErrorCode) {
    return match db_connect("trade_finance.db") {
        Ok(conn) => update_fraud_case_inner(conn, f),
        Err(e) => Err(DbError()),
    }
}

// Double-discounting check (real, exact-match, zero false negatives) +
// a disclosed heuristic fraud flag + Module 6 delivery-dispute gating --
// all real logic, not stubs.
fn create_invoice_inner(conn: db, inv: Invoice) -> Result(i64, ErrorCode) {
    let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS invoice (id INTEGER PRIMARY KEY AUTOINCREMENT, purchase_order_id INTEGER, invoice_number TEXT, tax_id TEXT, supplier_code TEXT, face_value_cents INTEGER, fraud_score_bps INTEGER, eligibility_status TEXT)") { Ok(n) => n, Err(e) => -1 }
    let t2: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS fraud_case (id INTEGER PRIMARY KEY AUTOINCREMENT, invoice_id INTEGER, flag_reason TEXT, score_bps INTEGER, disposition TEXT)") { Ok(n) => n, Err(e) => -1 }

    let duplicate_count: i64 = match db_query(conn, "SELECT COUNT(*) as value FROM invoice WHERE invoice_number = ? AND tax_id = ? AND supplier_code = ? AND face_value_cents = ?", inv.invoice_number, inv.tax_id, inv.supplier_code, inv.face_value_cents) {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_i64(row, "value") { Ok(v) => v, Err(e) => 0 },
            Err(e) => 0,
        },
        Err(e) => 0,
    }

    return if duplicate_count > 0 {
        stop conn
        Err(DoubleDiscountingCheckFailed())
    } else {
        // `[SUBSTITUTED]` heuristic in place of the doc's trained anomaly
        // model: a face value at/above $500,000 is flagged for manual
        // review, a fixed illustrative band, not a statistical score.
        let fraud_score_bps: i64 = if inv.face_value_cents >= 50000000 { 8000 } else { 0 }
        let eligibility_status: str = if fraud_score_bps >= 5000 {
            "held_fraud"
        } else {
            if has_open_dispute(inv.purchase_order_id) { "held_dispute" } else { "eligible" }
        }
        let inserted: i64 = match db_execute(conn, "INSERT INTO invoice (purchase_order_id, invoice_number, tax_id, supplier_code, face_value_cents, fraud_score_bps, eligibility_status) VALUES (?, ?, ?, ?, ?, ?, ?)", inv.purchase_order_id, inv.invoice_number, inv.tax_id, inv.supplier_code, inv.face_value_cents, fraud_score_bps, eligibility_status) {
            Ok(n) => n,
            Err(e) => -1,
        }
        let invoice_id: i64 = match db_query(conn, "SELECT last_insert_rowid() as value") {
            Ok(rows) => match json_array_get(rows, 0) {
                Ok(row) => match json_get_i64(row, "value") { Ok(v) => v, Err(e) => -1 },
                Err(e) => -1,
            },
            Err(e) => -1,
        }
        let case_inserted: i64 = if fraud_score_bps >= 5000 {
            match db_execute(conn, "INSERT INTO fraud_case (invoice_id, flag_reason, score_bps, disposition) VALUES (?, 'face value far outside illustrative band', ?, 'open')", invoice_id, fraud_score_bps) {
                Ok(n) => n,
                Err(e) => -1,
            }
        } else {
            0
        }
        stop conn
        if inserted >= 0 { Ok(invoice_id) } else { Err(FailedToSubmitInvoice()) }
    }
}

fn create_invoice(inv: Invoice) -> Result(i64, ErrorCode) {
    return match db_connect("trade_finance.db") {
        Ok(conn) => create_invoice_inner(conn, inv),
        Err(e) => Err(DbError()),
    }
}

// `[MOCK]` -- stands in for a live SOFR/EURIBOR benchmark feed; kept as
// basis points (i64), not `f64`, so it composes with every other rate in
// this file without an int<->float cast Nirdosha doesn't have
// (LANGUAGE.md §3) -- same convention as `required_eyes_for_amount` and
// every other `_bps` field in this build.
fn mock_benchmark_rate_bps() -> i64 {
    return 525
}

// Bundling three fixed invoice slots (`invoice_id_a/b/c`, 0 = unused) is
// the same disclosed fixed-arity substitution as Module 4's batch
// payment, for the identical reason: Nirdosha has no array parameter
// type, so "N selected invoices" becomes a fixed small N.
struct DiscountingBundle {
    id: i64,
    invoice_id_a: i64,
    invoice_id_b: i64,
    invoice_id_c: i64,
    advance_rate_bps: i64,
    total_advance_cents: i64,
    interest_cents: i64,
    status: str,
}

fn list_discounting_bundle_inner(conn: db) -> Result(json, ErrorCode) {
    let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS discounting_bundle (id INTEGER PRIMARY KEY AUTOINCREMENT, invoice_id_a INTEGER, invoice_id_b INTEGER, invoice_id_c INTEGER, advance_rate_bps INTEGER, total_advance_cents INTEGER, interest_cents INTEGER, status TEXT, accrued INTEGER)") { Ok(n) => n, Err(e) => -1 }
    let rows: Result(json, str) = db_query(conn, "SELECT id, invoice_id_a, invoice_id_b, invoice_id_c, advance_rate_bps, total_advance_cents, interest_cents, status FROM discounting_bundle ORDER BY id DESC")
    stop conn
    return match rows { Ok(v) => Ok(v), Err(e) => Err(DbError()) }
}

fn list_discounting_bundle() -> Result(json, ErrorCode) requires(role: "corporate_seller") {
    return match db_connect("trade_finance.db") {
        Ok(conn) => list_discounting_bundle_inner(conn),
        Err(e) => Err(DbError()),
    }
}

// Real risk-based pricing (doc §5.2): advance rate (80-90%), platform
// fee, and a benchmark+spread interest rate, all driven by the primary
// invoice's buyer counterparty's latest recorded Module 2 credit score --
// one SQL join, not a stub. Reserve-hold percentage is implicitly
// `10000 - advance_rate_bps` (the face value not advanced).
fn create_discounting_bundle_inner(conn: db, invoice_id_a: i64, invoice_id_b: i64, invoice_id_c: i64) -> Result(i64, ErrorCode) {
    let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS discounting_bundle (id INTEGER PRIMARY KEY AUTOINCREMENT, invoice_id_a INTEGER, invoice_id_b INTEGER, invoice_id_c INTEGER, advance_rate_bps INTEGER, total_advance_cents INTEGER, interest_cents INTEGER, status TEXT, accrued INTEGER)") { Ok(n) => n, Err(e) => -1 }

    let face_a: i64 = match db_query(conn, "SELECT COALESCE((SELECT face_value_cents FROM invoice WHERE id = ? AND eligibility_status = 'eligible'), 0) as value", invoice_id_a) {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_i64(row, "value") { Ok(v) => v, Err(e) => 0 },
            Err(e) => 0,
        },
        Err(e) => 0,
    }
    let face_b: i64 = match db_query(conn, "SELECT COALESCE((SELECT face_value_cents FROM invoice WHERE id = ? AND eligibility_status = 'eligible'), 0) as value", invoice_id_b) {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_i64(row, "value") { Ok(v) => v, Err(e) => 0 },
            Err(e) => 0,
        },
        Err(e) => 0,
    }
    let face_c: i64 = match db_query(conn, "SELECT COALESCE((SELECT face_value_cents FROM invoice WHERE id = ? AND eligibility_status = 'eligible'), 0) as value", invoice_id_c) {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_i64(row, "value") { Ok(v) => v, Err(e) => 0 },
            Err(e) => 0,
        },
        Err(e) => 0,
    }
    let total_face_value_cents: i64 = face_a + face_b + face_c

    return if total_face_value_cents == 0 {
        stop conn
        Err(NoEligibleInvoicesInThisBundle())
    } else {
        let credit_score: i64 = match db_query(conn, "SELECT COALESCE((SELECT fs.credit_score FROM financial_statement fs JOIN purchase_order po ON po.buyer_counterparty_id = fs.counterparty_id WHERE po.id = (SELECT purchase_order_id FROM invoice WHERE id = ?) ORDER BY fs.id DESC LIMIT 1), 5000) as value", invoice_id_a) {
            Ok(rows) => match json_array_get(rows, 0) {
                Ok(row) => match json_get_i64(row, "value") { Ok(v) => v, Err(e) => 5000 },
                Err(e) => 5000,
            },
            Err(e) => 5000,
        }
        let advance_rate_bps: i64 = if credit_score >= 8000 { 9000 } else { if credit_score >= 5000 { 8500 } else { 8000 } }
        let risk_spread_bps: i64 = if credit_score >= 8000 { 100 } else { if credit_score >= 5000 { 300 } else { 600 } }
        let total_rate_bps: i64 = mock_benchmark_rate_bps() + risk_spread_bps
        let platform_fee_bps: i64 = 100
        let gross_advance_cents: i64 = (total_face_value_cents * advance_rate_bps) / 10000
        let fee_cents: i64 = (total_face_value_cents * platform_fee_bps) / 10000
        let net_advance_cents: i64 = gross_advance_cents - fee_cents
        // Single-period accrual, not a multi-row amortization table
        // (Nirdosha has no loop-friendly "generate N periods" ergonomic
        // beyond fixed arity) -- one real, correctly-computed interest
        // figure feeding Module 7's `accrue_daily_interest` below.
        let interest_cents: i64 = ((net_advance_cents * total_rate_bps) / 10000) / 12

        let inserted: i64 = match db_execute(conn, "INSERT INTO discounting_bundle (invoice_id_a, invoice_id_b, invoice_id_c, advance_rate_bps, total_advance_cents, interest_cents, status, accrued) VALUES (?, ?, ?, ?, ?, ?, 'draft', 0)", invoice_id_a, invoice_id_b, invoice_id_c, advance_rate_bps, net_advance_cents, interest_cents) {
            Ok(n) => n,
            Err(e) => -1,
        }
        stop conn
        if inserted >= 0 { Ok(inserted) } else { Err(FailedToCreateDiscountingBundle()) }
    }
}

fn create_discounting_bundle(invoice_id_a: i64, invoice_id_b: i64, invoice_id_c: i64) -> Result(i64, ErrorCode) {
    return match db_connect("trade_finance.db") {
        Ok(conn) => create_discounting_bundle_inner(conn, invoice_id_a, invoice_id_b, invoice_id_c),
        Err(e) => Err(DbError()),
    }
}

// Submitting a bundle for funding is Maker-Checker per the doc's table;
// approving a disbursement above threshold is 6-Eyes -- one
// `required_eyes_for_amount` reuse (Module 4's rule, not re-derived) sizes
// the request by the bundle's own `total_advance_cents`.
fn submit_discounting_bundle(identity: VerifiedIdentity, bundle_id: i64, total_advance_cents: i64, justification: Text) -> Result(i64, ErrorCode) {
    return submit_approval(identity, ActionTypeFundDiscountingBundle(), ApprovalRiskTierTradePayment(), required_eyes_for_amount(total_advance_cents), 24, justification)
}

fn fund_discounting_bundle_inner(conn: db, request_id: i64, bundle_id: i64) -> Result(i64, ErrorCode) {
    let status: str = match db_query(conn, "SELECT status as value FROM approval_request WHERE id = ?", request_id) {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_str(row, "value") { Ok(v) => v, Err(e) => "MISSING" },
            Err(e) => "MISSING",
        },
        Err(e) => "MISSING",
    }
    return if status != "APPROVED" {
        stop conn
        Err(DiscountingBundleFundingIsNotYetFullyApproved())
    } else {
        let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS discounting_bundle (id INTEGER PRIMARY KEY AUTOINCREMENT, invoice_id_a INTEGER, invoice_id_b INTEGER, invoice_id_c INTEGER, advance_rate_bps INTEGER, total_advance_cents INTEGER, interest_cents INTEGER, status TEXT, accrued INTEGER)") { Ok(n) => n, Err(e) => -1 }
        let result: Result(i64, str) = db_execute(conn, "UPDATE discounting_bundle SET status = 'funded' WHERE id = ?", bundle_id)
        stop conn
        match result { Ok(v) => Ok(v), Err(e) => Err(DbError()) }
    }
}

fn fund_discounting_bundle(request_id: i64, bundle_id: i64) -> Result(i64, ErrorCode) {
    return match db_connect("trade_finance.db") {
        Ok(conn) => fund_discounting_bundle_inner(conn, request_id, bundle_id),
        Err(e) => Err(DbError()),
    }
}

