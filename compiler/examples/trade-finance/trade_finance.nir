fn stat_total_portfolio_exposure_cents_inner(conn: db) -> i64 {
    let result: i64 = match db_query(conn, "SELECT COALESCE(SUM(utilized_cents), 0) as value FROM credit_limit") {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_i64(row, "value") { Ok(v) => v, Err(e) => 0 },
            Err(e) => 0,
        },
        Err(e) => 0,
    }
    stop conn
    return result
}

fn stat_total_portfolio_exposure_cents() -> i64 {
    return match db_connect("trade_finance.db") {
        Ok(conn) => stat_total_portfolio_exposure_cents_inner(conn),
        Err(e) => 0,
    }
}

fn stat_facility_utilization_bps_inner(conn: db) -> i64 {
    let utilized: i64 = match db_query(conn, "SELECT COALESCE(SUM(utilized_cents), 0) as value FROM credit_limit") {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_i64(row, "value") { Ok(v) => v, Err(e) => 0 },
            Err(e) => 0,
        },
        Err(e) => 0,
    }
    let cap: i64 = match db_query(conn, "SELECT COALESCE(SUM(facility_cap_cents), 0) as value FROM credit_limit") {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_i64(row, "value") { Ok(v) => v, Err(e) => 0 },
            Err(e) => 0,
        },
        Err(e) => 0,
    }
    stop conn
    return if cap == 0 { 0 } else { (utilized * 10000) / cap }
}

fn stat_facility_utilization_bps() -> i64 {
    return match db_connect("trade_finance.db") {
        Ok(conn) => stat_facility_utilization_bps_inner(conn),
        Err(e) => 0,
    }
}

fn chart_portfolio_by_module_inner(conn: db) -> Result(json, ErrorCode) {
    let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS commission_waterfall_entry (id INTEGER PRIMARY KEY AUTOINCREMENT, trade_payment_id INTEGER, tier_name TEXT, rate_bps INTEGER, amount_cents INTEGER, partner_wallet_id INTEGER)") { Ok(n) => n, Err(e) => -1 }
    let rows: Result(json, str) = db_query(conn, "SELECT 'commissions' as label, COALESCE(SUM(amount_cents), 0) as value FROM commission_waterfall_entry UNION ALL SELECT 'discounting_funded', COALESCE(SUM(total_advance_cents), 0) FROM discounting_bundle WHERE status = 'funded' UNION ALL SELECT 'trade_payments', COALESCE(SUM(amount_cents), 0) FROM trade_payment")
    stop conn
    return match rows { Ok(v) => Ok(v), Err(e) => Err(DbError()) }
}

fn chart_portfolio_by_module() -> Result(json, ErrorCode) {
    return match db_connect("trade_finance.db") {
        Ok(conn) => chart_portfolio_by_module_inner(conn),
        Err(e) => Err(DbError()),
    }
}

