// Enterprise Trade Finance B2B Platform, implemented in Nirdosha.
// Source spec: Enterprise_Trade_Finance_B2B_Platform_Expanded.docx.
// Build tracker + disposition of every requirement (BUILD/MOCK/
// SUBSTITUTED): examples/trade-finance/todo.md -- read that first.
//
//     nirdosha serve examples/trade-finance/trade_finance.nir --port 8090 \
//       --jwks-file <jwks.json> --issuer https://mock-idp.local \
//       --audience store-app --identity-base http://localhost:9090
//
// (reuses examples/identity_mock.nir, extended with this platform's own
// role vocabulary -- run it on port 9090 first, same JWKS.)
//
// One unified Nirdosha service, one shared SQLite DB
// (trade_finance.db), standing in for "nine distributed microservices"
// -- see todo.md's architecture note for why, given no import system
// and heavy real interdependency between modules. `db` is affine with
// no borrowing (examples/db.nir's doc comment), so every function below
// opens, uses, and `stop`s its own connection; schema creation is
// inlined per function for the same reason (examples/store.nir's own
// header comment already documents this).

// =========================================================================
// Module 1: System Foundation, Identity, Security & Approval Governance
// =========================================================================
module "Module 1: System Foundation, Identity, Security & Approval Governance" {
//
// The one governance primitive every other module's sensitive actions
// route through. Maker-Checker (2-Eyes) needs exactly one independent
// decision; 6-Eyes needs two (Reviewer, then Approver) -- modeled as an
// append-only ApprovalDecision log rather than mutable stage fields, so
// segregation-of-duties (a decider's identity must differ from the
// initiator AND every prior decider on this request) is one SQL query,
// not hand-rolled state-machine logic per risk tier.

// "Enum favoring" -- replaces the previous `str`-typed error channel
// (`Result(_, str)`) used throughout this file: one variant per distinct
// static error message actually used below. This language has zero
// string concatenation, so every error message below was already a
// static literal -- converting to an enum is a lossless, mechanical
// rename, not a loss of detail.
enum ErrorCode {
    // A raw `db_query`/`db_execute` failure (a real SQL driver error) --
    // every read/write helper below that just passes a builtin `Result`
    // straight through maps its `str`-typed `Err` to this one variant
    // rather than inventing a bespoke variant per SQL statement (there's
    // no static catalog of driver error text the way there is for this
    // file's own ~46 hand-written messages -- see the block below).
    DbError,
    FailedToSubmitApprovalRequest,
    SegregationOfDutiesViolationOrWrongStage,
    FailedToMintDecisionLink,
    DecisionLinkIsInvalidExpiredOrAlreadyUsed,
    LcIssuanceIsNotYetFully6EyesApproved,
    ApprovalRequestIsNotPending,
    BatchPaymentIsNotYetFullyApproved,
    ChartOfAccountsChangeIsNotYetFully6EyesApproved,
    CommissionDisputeAdjustmentIsNotYetFully6EyesApproved,
    DiscountingBundleFundingIsNotYetFullyApproved,
    DiscrepancyWaiverIsNotYetFully6EyesApproved,
    DoubleDiscountingCheckFailed,
    ExceptionResolutionIsNotYetFullyApproved,
    FailedToCreateAccount,
    FailedToCreateCommissionRule,
    FailedToCreateCounterparty,
    FailedToCreateCreditLimit,
    FailedToCreateDeliveryDispute,
    FailedToCreateDiscountingBundle,
    FailedToCreatePurchaseOrder,
    FailedToGenerateApiKey,
    FailedToGenerateNoticeOfAssignment,
    FailedToIssueLetterOfCredit,
    FailedToPostJournalEntry,
    FailedToPostMilestoneRelease,
    FailedToPostOneOrMoreBatchPaymentLines,
    FailedToPostTradePayment,
    FailedToProvisionVirtualIban,
    FailedToRecordCommissionDispute,
    FailedToRecordDocumentPresentation,
    FailedToRecordFinancialStatement,
    FailedToRecordGoodsReceiptNote,
    FailedToRecordPaymentExecution,
    FailedToRecordRegulatoryExport,
    FailedToRegisterWebhookSubscription,
    FailedToRouteUnmatchedPaymentToExceptionQueue,
    FailedToSubmitInvoice,
    InsufficientWalletBalanceForWithdrawal,
    LeiNotFoundInMockGleifRegistry,
    ManualJournalEntryIsNotYetFullyApproved,
    MilestoneReleaseBlocked,
    MilestoneReleaseIsNotYetFully6EyesApproved,
    NoEligibleInvoicesInThisBundle,
    NoPostedTradePaymentFoundToSettleForThisReference,
    PaymentExecutionIsNotYetFullyApproved,
    RegulatoryExportIsNotYetFully6EyesApproved,
    SanctionsOverrideRequestIsNotYetFullyApproved,
    TradePaymentIsNotYetFullyApproved,
    UnbalancedPostingRejected,
    VirtualIbanClosureIsNotYetFully6EyesApproved,
}

// "Enum favoring" -- `finish_with_audit`'s `entity_type`/`action` were
// each a small closed set of tag strings (2 and 4 distinct values
// respectively, across all four call sites), so both become real enums
// instead of free text.
enum EntityType {
    EntityTypeApprovalRequest,
    EntityTypeDecisionLink,
}

enum AuditAction {
    AuditActionSubmit,
    AuditActionDecide,
    AuditActionLinkMinted,
    AuditActionLinkDecideRejected,
}

// `submit_approval`'s `risk_tier` -- exactly two values across every
// call site in this file.
enum ApprovalRiskTier {
    ApprovalRiskTierSixEyes,
    ApprovalRiskTierTradePayment,
}

// `submit_approval`'s `action_type` -- one variant per distinct
// approval-governed action in this file (15 call sites, 15 distinct
// values).
enum ActionType {
    ActionTypeOverrideSanctionsMatch,
    ActionTypeIssueLetterOfCredit,
    ActionTypeAcceptDiscrepancyWaiver,
    ActionTypeTradePayment,
    ActionTypeBatchTradePayment,
    ActionTypeMilestoneRelease,
    ActionTypeWalletWithdrawal,
    ActionTypeCommissionDisputeAdjustment,
    ActionTypeFundDiscountingBundle,
    ActionTypeManualJournalEntry,
    ActionTypeCreateAccount,
    ActionTypeResolveException,
    ActionTypePaymentExecution,
    ActionTypeCloseVirtualIban,
    ActionTypeRegulatoryExport,
}

// `decide_approval`'s `decision` -- APPROVE/REJECT, the only two values
// a reviewer/approver can submit.
enum Decision {
    DecisionApprove,
    DecisionReject,
}

// Every currency this file actually deals in (`mock_fx_rate_bps`/
// `select_rail`'s own literal comparisons).
enum Currency {
    CurrencyEur,
    CurrencyUsd,
    CurrencyGbp,
}

// `recommend_workflow_variant`'s `trust_tier` -- "new"/"high" are its
// only two explicit checks; the implicit else case is the third,
// ordinary tier.
enum TrustTier {
    TrustTierNew,
    TrustTierHigh,
    TrustTierStandard,
}

// `recommend_workflow_variant`'s return value -- one of five advisory
// payment-terms recommendations.
enum WorkflowVariant {
    WorkflowVariantLcBacked,
    WorkflowVariantAdvancePayment,
    WorkflowVariantOpenAccount,
    WorkflowVariantDocumentaryCollection,
    WorkflowVariantMilestoneEscrow,
}

// `mock_generate_swift_message`'s `msg_type` -- the four MT message
// types this mock actually branches on, plus an `Other` fallback for
// anything else (the original code's `_ =>` wildcard).
enum MsgType {
    MsgTypeMt700,
    MsgTypeMt707,
    MsgTypeMt710,
    MsgTypeMt760,
    MsgTypeOther,
}

// `post_journal_entry`'s `event_type` -- one variant per distinct
// journal-posting call site in this file.
enum JournalEventType {
    JournalEventTypeTradePayment,
    JournalEventTypeMilestoneRelease,
    JournalEventTypeManualAdjustment,
    JournalEventTypePaymentClearing,
    JournalEventTypeInterestAccrual,
}

// `settle_trade_payment_reconciliation`'s `match_type`.
enum MatchType {
    MatchTypeDeterministic,
    MatchTypeManual,
    MatchTypeVirtualAccountDirect,
}

// `generate_regulatory_export`'s `export_type` -- BASEL is the only
// explicit case (`generate_regulatory_export_inner`'s own `match`),
// everything else is the AML fallback.
enum ExportType {
    ExportTypeBasel,
    ExportTypeAml,
}

// "Enum favoring"'s free-text carrier -- wherever genuine free text
// (a justification, a note, an identity subject, a reference number)
// needs to cross a function boundary that can no longer take/return
// bare `str`. Reused everywhere in this file rather than one wrapper
// per field, since every use is the same shape: opaque text, no
// comparison, no parsing, just storage/round-trip.
struct Text {
    value: str,
}

// Named `Approval`, not `ApprovalRequest` -- `emit-ui` derives a
// screen's nav entry by snake_case-matching a struct's name against
// `list_<name>`/etc, so the struct name has to agree with the
// `list_approval`/`submit_approval`/... functions below (the audit
// log's own `entity_type` string tag still says "ApprovalRequest",
// independently -- that's just descriptive text, not tied to this
// struct's Nirdosha name).
struct Approval {
    id: i64,
    action_type: str,
    risk_tier: str,
    initiator_subject: str,
    sla_hours: i64,
    payload_note: str,
    status: str,
    required_eyes: i64,
}

// Named `AuditLog`, not `AuditLogEntry`, for the same
// snake_case-matching reason as `Approval` above (`list_audit_log`).
struct AuditLog {
    id: i64,
    entity_type: str,
    entity_id: i64,
    actor_subject: str,
    action: str,
    note: str,
    prev_hash: str,
    hash: str,
}

// Schema creation is inlined into every function that touches these
// tables, not factored into a shared helper: `db` is affine with no
// borrowing, so passing an already-open `conn` into another function
// moves it away from the caller (confirmed the hard way while building
// this file -- see `examples/store.nir`'s header comment for the same
// discipline in the earlier apps). `finish_with_audit` below is the one
// exception, and only because it's always the *last* thing a caller
// does with `conn`.

fn list_audit_log_inner(conn: db) -> Result(json, ErrorCode) {
    let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS approval_request (id INTEGER PRIMARY KEY AUTOINCREMENT, action_type TEXT, risk_tier TEXT, initiator_subject TEXT, sla_hours INTEGER, payload_note TEXT, status TEXT, required_eyes INTEGER)") { Ok(n) => n, Err(e) => -1 }
    let t2: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS approval_decision (id INTEGER PRIMARY KEY AUTOINCREMENT, request_id INTEGER, actor_subject TEXT, stage_index INTEGER, decision TEXT)") { Ok(n) => n, Err(e) => -1 }
    let t3: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS audit_log_entry (id INTEGER PRIMARY KEY AUTOINCREMENT, entity_type TEXT, entity_id INTEGER, actor_subject TEXT, action TEXT, note TEXT, prev_hash TEXT, hash TEXT)") { Ok(n) => n, Err(e) => -1 }
    let rows: Result(json, str) = db_query(conn, "SELECT id, entity_type, entity_id, actor_subject, action, note, hash FROM audit_log_entry ORDER BY id DESC")
    stop conn
    return match rows { Ok(v) => Ok(v), Err(e) => Err(DbError()) }
}

fn list_audit_log() -> Result(json, ErrorCode) requires(role: "compliance_officer") {
    return match db_connect("trade_finance.db") {
        Ok(conn) => list_audit_log_inner(conn),
        Err(e) => Err(DbError()),
    }
}

// Walks the whole chain and returns -1 ("OK") or the id of the first
// row whose stored `hash` no longer matches a fresh
// `sha256_hex(prev_hash, note)` recompute -- real tamper detection, not
// a stub. `count` bounds how many rows to check (no dynamic-length
// array iteration ergonomic enough to walk an unbounded result set
// without a loop-friendly JSON-array primitive -- see todo.md; capped
// at a caller-supplied count instead of "all rows" for now).
fn verify_audit_chain_rows(rows: json) -> i64 {
    let n: i64 = match json_array_len(rows) {
        Ok(k) => k,
        Err(e) => 0,
    }
    let i: i64 = 0
    let broken_at: i64 = -1
    while i < n {
        let row: json = match json_array_get(rows, i) {
            Ok(r) => r,
            Err(e) => rows,
        }
        let note: str = match json_get_str(row, "note") { Ok(s) => s, Err(e) => "" }
        let prev_hash: str = match json_get_str(row, "prev_hash") { Ok(s) => s, Err(e) => "" }
        let stored_hash: str = match json_get_str(row, "hash") { Ok(s) => s, Err(e) => "" }
        let recomputed: str = sha256_hex(prev_hash, note)
        let this_id: i64 = match json_get_i64(row, "id") { Ok(v) => v, Err(e) => -1 }
        if recomputed != stored_hash && broken_at < 0 {
            broken_at = this_id
        }
        i = i + 1
    }
    return broken_at
}

fn verify_audit_chain_inner(conn: db, count: i64) -> i64 {
    let result: i64 = match db_query(conn, "SELECT id, note, prev_hash, hash FROM audit_log_entry ORDER BY id ASC LIMIT ?", count) {
        Ok(rows) => verify_audit_chain_rows(rows),
        Err(e) => -2,
    }
    stop conn
    return result
}

fn verify_audit_chain(count: i64) -> i64 {
    return match db_connect("trade_finance.db") {
        Ok(conn) => verify_audit_chain_inner(conn, count),
        Err(e) => -2,
    }
}

// ---- Maker-Checker (2-Eyes) / 6-Eyes (3-tier), one primitive --------

// Terminal: appends one hash-chained audit entry using the caller's
// still-open `conn`, `stop`s it, and produces the function's final
// `Result` -- the one place `conn` changes hands to another function,
// and only because it's always the caller's *last* use of it (an
// affine handle can be handed off exactly once, on a path where the
// caller never touches it again). `hash = sha256_hex(prev_hash, note)`
// chains onto whatever the previous entry's hash was, so
// `verify_audit_chain` can independently detect tampering.
fn finish_with_audit(conn: db, entity_type: EntityType, entity_id: i64, actor_subject: Text, action: AuditAction, note: Text, is_ok: bool, ok_value: i64, err_message: ErrorCode) -> Result(i64, ErrorCode) {
    let prev_hash: str = match db_query(conn, "SELECT hash as value FROM audit_log_entry ORDER BY id DESC LIMIT 1") {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_str(row, "value") {
                Ok(h) => h,
                Err(e) => "genesis",
            },
            Err(e) => "genesis",
        },
        Err(e) => "genesis",
    }
    let hash: str = sha256_hex(prev_hash, note.value)
    let inserted: i64 = match db_execute(conn, "INSERT INTO audit_log_entry (entity_type, entity_id, actor_subject, action, note, prev_hash, hash) VALUES (?, ?, ?, ?, ?, ?, ?)", entity_type, entity_id, actor_subject.value, action, note.value, prev_hash, hash) {
        Ok(n) => n,
        Err(e) => -1,
    }
    stop conn
    return if is_ok { Ok(ok_value) } else { Err(err_message) }
}

fn submit_approval_inner(conn: db, identity: VerifiedIdentity, action_type: ActionType, risk_tier: ApprovalRiskTier, required_eyes: i64, sla_hours: i64, payload_note: Text) -> Result(i64, ErrorCode) {
    let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS approval_request (id INTEGER PRIMARY KEY AUTOINCREMENT, action_type TEXT, risk_tier TEXT, initiator_subject TEXT, sla_hours INTEGER, payload_note TEXT, status TEXT, required_eyes INTEGER)") { Ok(n) => n, Err(e) => -1 }
    let t2: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS approval_decision (id INTEGER PRIMARY KEY AUTOINCREMENT, request_id INTEGER, actor_subject TEXT, stage_index INTEGER, decision TEXT)") { Ok(n) => n, Err(e) => -1 }
    let t3: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS audit_log_entry (id INTEGER PRIMARY KEY AUTOINCREMENT, entity_type TEXT, entity_id INTEGER, actor_subject TEXT, action TEXT, note TEXT, prev_hash TEXT, hash TEXT)") { Ok(n) => n, Err(e) => -1 }
    let inserted: i64 = match db_execute(conn, "INSERT INTO approval_request (action_type, risk_tier, initiator_subject, sla_hours, payload_note, status, required_eyes) VALUES (?, ?, ?, ?, ?, 'PENDING', ?)", action_type, risk_tier, identity.subject, sla_hours, payload_note.value, required_eyes) {
        Ok(n) => n,
        Err(e) => -1,
    }
    let request_id: i64 = match db_query(conn, "SELECT last_insert_rowid() as value") {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_i64(row, "value") { Ok(v) => v, Err(e) => -1 },
            Err(e) => -1,
        },
        Err(e) => -1,
    }
    return finish_with_audit(conn, EntityTypeApprovalRequest(), request_id, Text(identity.subject), AuditActionSubmit(), payload_note, request_id >= 0, request_id, FailedToSubmitApprovalRequest())
}

// Any signed-in identity may submit or decide -- the real control here
// is segregation-of-duties (below), not a role check: the doc's own
// Module 1 description is explicit that SoD is enforced "regardless of
// role assignment." `required_eyes` generalizes Maker-Checker (1) /
// 6-Eyes (2) / any n-eyes policy to a plain integer instead of a
// hardcoded tier name -- decide_approval_core below no longer branches
// on risk_tier at all, it just needs required_eyes distinct decisions.
fn submit_approval(identity: VerifiedIdentity, action_type: ActionType, risk_tier: ApprovalRiskTier, required_eyes: i64, sla_hours: i64, payload_note: Text) -> Result(i64, ErrorCode) {
    return match db_connect("trade_finance.db") {
        Ok(conn) => submit_approval_inner(conn, identity, action_type, risk_tier, required_eyes, sla_hours, payload_note),
        Err(e) => Err(DbError()),
    }
}

fn list_approval_inner(conn: db) -> Result(json, ErrorCode) {
    let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS approval_request (id INTEGER PRIMARY KEY AUTOINCREMENT, action_type TEXT, risk_tier TEXT, initiator_subject TEXT, sla_hours INTEGER, payload_note TEXT, status TEXT, required_eyes INTEGER)") { Ok(n) => n, Err(e) => -1 }
    let rows: Result(json, str) = db_query(conn, "SELECT id, action_type, risk_tier, initiator_subject, sla_hours, payload_note, status, required_eyes FROM approval_request ORDER BY id DESC")
    stop conn
    return match rows { Ok(v) => Ok(v), Err(e) => Err(DbError()) }
}

fn list_approval() -> Result(json, ErrorCode) requires(role: "compliance_officer") {
    return match db_connect("trade_finance.db") {
        Ok(conn) => list_approval_inner(conn),
        Err(e) => Err(DbError()),
    }
}

// The state machine itself, generalized to n-eyes: `status` is the
// object's state (PENDING/APPROVED/REJECTED); `required_eyes` (stored
// on the request, set at submit time) is the exit condition's
// threshold; `prior_decisions` (a plain COUNT over the append-only
// decision log) is how many of those exits have already been taken.
// Whether the caller is proven via a live bearer token (decide_approval
// below) or via a single-use decision-link token
// (decide_approval_via_link further down) is irrelevant here -- both
// paths resolve to a plain `actor_subject: str` before reaching this
// function, because this function always reloads `status`/
// `required_eyes`/prior decisions fresh from `conn` rather than trusting
// any in-memory state. There is no separate "object is already in
// memory" fast path: every Nirdosha request opens its own `db` handle
// and nothing survives between requests, so this cold-reload *is* the
// only path, for a same-session click or a reply to a three-day-old
// email alike.
fn decide_approval_core(conn: db, actor_subject: Text, request_id: i64, decision: Decision) -> Result(i64, ErrorCode) {
    let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS approval_request (id INTEGER PRIMARY KEY AUTOINCREMENT, action_type TEXT, risk_tier TEXT, initiator_subject TEXT, sla_hours INTEGER, payload_note TEXT, status TEXT, required_eyes INTEGER)") { Ok(n) => n, Err(e) => -1 }
    let t2: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS approval_decision (id INTEGER PRIMARY KEY AUTOINCREMENT, request_id INTEGER, actor_subject TEXT, stage_index INTEGER, decision TEXT)") { Ok(n) => n, Err(e) => -1 }
    let t3: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS audit_log_entry (id INTEGER PRIMARY KEY AUTOINCREMENT, entity_type TEXT, entity_id INTEGER, actor_subject TEXT, action TEXT, note TEXT, prev_hash TEXT, hash TEXT)") { Ok(n) => n, Err(e) => -1 }

    let status: str = match db_query(conn, "SELECT status as value FROM approval_request WHERE id = ?", request_id) {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_str(row, "value") { Ok(v) => v, Err(e) => "MISSING" },
            Err(e) => "MISSING",
        },
        Err(e) => "MISSING",
    }
    let required_eyes: i64 = match db_query(conn, "SELECT required_eyes as value FROM approval_request WHERE id = ?", request_id) {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_i64(row, "value") { Ok(v) => v, Err(e) => 1 },
            Err(e) => 1,
        },
        Err(e) => 1,
    }

    // Segregation of duties, one query: has `actor_subject` already
    // acted on this request, either as the original initiator or as a
    // prior decider? If so, reject -- the identity check the doc
    // describes ("regardless of role assignment"), done in SQL rather
    // than hand-rolled comparisons against however many prior stages a
    // given policy happens to require.
    let already_acted: i64 = match db_query(conn, "SELECT COUNT(*) as value FROM (SELECT initiator_subject as subj FROM approval_request WHERE id = ? UNION ALL SELECT actor_subject FROM approval_decision WHERE request_id = ?) WHERE subj = ?", request_id, request_id, actor_subject.value) {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_i64(row, "value") { Ok(v) => v, Err(e) => 1 },
            Err(e) => 1,
        },
        Err(e) => 1,
    }

    let prior_decisions: i64 = match db_query(conn, "SELECT COUNT(*) as value FROM approval_decision WHERE request_id = ?", request_id) {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_i64(row, "value") { Ok(v) => v, Err(e) => 0 },
            Err(e) => 0,
        },
        Err(e) => 0,
    }
    let stage_index: i64 = prior_decisions + 1

    let eligible: bool = status == "PENDING" && already_acted == 0 && prior_decisions < required_eyes

    let outcome: str = if !eligible {
        "not eligible"
    } else {
        match decision {
            DecisionReject => "rejected",
            DecisionApprove => "recorded",
        }
    }

    let recorded: i64 = if eligible {
        match db_execute(conn, "INSERT INTO approval_decision (request_id, actor_subject, stage_index, decision) VALUES (?, ?, ?, ?)", request_id, actor_subject.value, stage_index, decision) {
            Ok(n) => n,
            Err(e) => -1,
        }
    } else {
        -1
    }

    let final_status: str = if !eligible {
        status
    } else {
        match decision {
            DecisionReject => "REJECTED",
            DecisionApprove => if prior_decisions + 1 >= required_eyes { "APPROVED" } else { "PENDING" },
        }
    }
    let updated: i64 = if eligible && final_status != status {
        match db_execute(conn, "UPDATE approval_request SET status = ? WHERE id = ?", final_status, request_id) {
            Ok(n) => n,
            Err(e) => -1,
        }
    } else {
        0
    }

    return finish_with_audit(conn, EntityTypeApprovalRequest(), request_id, actor_subject, AuditActionDecide(), Text(outcome), eligible, request_id, SegregationOfDutiesViolationOrWrongStage())
}

fn decide_approval_inner(conn: db, identity: VerifiedIdentity, request_id: i64, decision: Decision) -> Result(i64, ErrorCode) {
    return decide_approval_core(conn, Text(identity.subject), request_id, decision)
}

fn decide_approval(identity: VerifiedIdentity, request_id: i64, decision: Decision) -> Result(i64, ErrorCode) {
    return match db_connect("trade_finance.db") {
        Ok(conn) => decide_approval_inner(conn, identity, request_id, decision),
        Err(e) => Err(DbError()),
    }
}

// ---- decision links: deciding without a live login session --------
//
// A real reviewer at their Nth-eyes stage is often not logged into this
// app when their turn comes -- they get an email, click a link, or
// enter an OTP. `serve.rs` only ever produces a VerifiedIdentity by
// validating a request's own `Authorization: Bearer <token>` header,
// and Nirdosha has no struct-literal syntax at all -- a .nir function
// can never fabricate a VerifiedIdentity itself. So "decide via link"
// has to be a genuinely different, unauthenticated endpoint: it proves
// *which* identity is deciding via a single-use signed token instead of
// a bearer token, then hands off to the exact same decide_approval_core
// used by the logged-in path above -- one state-machine transition, two
// ways to prove who's making it.
//
// `actor_subject` is *always* `identity.subject` -- a caller can only
// ever mint a link for themselves, never name someone else (a live,
// exploited bug in an earlier version of this function: any signed-in
// identity could name an arbitrary, even nonexistent, actor_subject and
// then single-handedly decide as them, fully defeating segregation of
// duties). The realistic flow is still served: Carol logs in once,
// mints her own link ahead of time, and later decides via that link
// without a live session -- she just can't mint one for Bob.
//
// token = sha256_hex(sha256_hex(sha256_hex(identity.subject,
// payload_note), prev_hash), <secret>) -- `prev_hash` is the audit
// chain's current tip at mint time: public (list_audit_log has no
// gate), but it advances on every governance action in the system
// (including this function's own terminal finish_with_audit call), so
// it serves as a nonce that makes even a repeat mint for the same
// actor+request produce a different token -- the earlier version had no
// nonce at all, so identical (actor_subject, payload_note) mints
// collided and one leaked token could decide multiple links. `prev_hash`
// being public is fine specifically because it's the nonce, not the
// secret: the trailing `<secret>` (a fixed dev-only string, same
// precedent as identity_mock.nir's hardcoded HMAC JWKS key -- a real
// deployment would pull it from a real secret store, which Nirdosha has
// no builtin for) is what still has to stay unknown to forge a token.
// The secret goes last (an envelope/suffix MAC), not first, so a
// length-extension attack against the underlying Merkle-Damgard SHA-256
// can't forge a valid token without already knowing it.
// No expiry: Nirdosha has no wall-clock builtin (see todo.md's SLA
// deadline note) -- a link is single-use via `consumed` instead of
// time-boxed. `get_decision_link` only exists because there's no real
// email sender to deliver the link/token out of band for this demo; a
// real deployment would never expose it -- and even here, it now only
// returns a link's token to the identity that minted it.

fn mint_decision_link_inner(conn: db, identity: VerifiedIdentity, request_id: i64) -> Result(i64, ErrorCode) {
    let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS approval_request (id INTEGER PRIMARY KEY AUTOINCREMENT, action_type TEXT, risk_tier TEXT, initiator_subject TEXT, sla_hours INTEGER, payload_note TEXT, status TEXT, required_eyes INTEGER)") { Ok(n) => n, Err(e) => -1 }
    let t2: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS decision_link (id INTEGER PRIMARY KEY AUTOINCREMENT, request_id INTEGER, actor_subject TEXT, token TEXT, consumed INTEGER)") { Ok(n) => n, Err(e) => -1 }
    let t3: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS audit_log_entry (id INTEGER PRIMARY KEY AUTOINCREMENT, entity_type TEXT, entity_id INTEGER, actor_subject TEXT, action TEXT, note TEXT, prev_hash TEXT, hash TEXT)") { Ok(n) => n, Err(e) => -1 }

    let status: str = match db_query(conn, "SELECT status as value FROM approval_request WHERE id = ?", request_id) {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_str(row, "value") { Ok(v) => v, Err(e) => "MISSING" },
            Err(e) => "MISSING",
        },
        Err(e) => "MISSING",
    }
    let payload_note: str = match db_query(conn, "SELECT payload_note as value FROM approval_request WHERE id = ?", request_id) {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_str(row, "value") { Ok(v) => v, Err(e) => "" },
            Err(e) => "",
        },
        Err(e) => "",
    }
    let prev_hash: str = match db_query(conn, "SELECT hash as value FROM audit_log_entry ORDER BY id DESC LIMIT 1") {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_str(row, "value") { Ok(h) => h, Err(e) => "genesis" },
            Err(e) => "genesis",
        },
        Err(e) => "genesis",
    }

    return if status != "PENDING" {
        stop conn
        Err(ApprovalRequestIsNotPending())
    } else {
        let combo: str = sha256_hex(identity.subject, payload_note)
        let salted: str = sha256_hex(combo, prev_hash)
        let token: str = sha256_hex(salted, "trade-finance-decision-link-secret-dev-only")
        let inserted: i64 = match db_execute(conn, "INSERT INTO decision_link (request_id, actor_subject, token, consumed) VALUES (?, ?, ?, 0)", request_id, identity.subject, token) {
            Ok(n) => n,
            Err(e) => -1,
        }
        let link_id: i64 = match db_query(conn, "SELECT last_insert_rowid() as value") {
            Ok(rows) => match json_array_get(rows, 0) {
                Ok(row) => match json_get_i64(row, "value") { Ok(v) => v, Err(e) => -1 },
                Err(e) => -1,
            },
            Err(e) => -1,
        }
        finish_with_audit(conn, EntityTypeDecisionLink(), link_id, Text(identity.subject), AuditActionLinkMinted(), Text(payload_note), link_id >= 0, link_id, FailedToMintDecisionLink())
    }
}

fn mint_decision_link(identity: VerifiedIdentity, request_id: i64) -> Result(i64, ErrorCode) {
    return match db_connect("trade_finance.db") {
        Ok(conn) => mint_decision_link_inner(conn, identity, request_id),
        Err(e) => Err(DbError()),
    }
}

// Dev-only stand-in for "the email that would have delivered this link"
// -- see the block comment above. Only returns a link's token to the
// identity that minted it (`actor_subject` is always that same identity
// now), matching how a real email would only ever reach that person's
// own inbox.
fn get_decision_link_inner(conn: db, link_id: i64, caller_subject: Text) -> Result(json, ErrorCode) {
    let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS decision_link (id INTEGER PRIMARY KEY AUTOINCREMENT, request_id INTEGER, actor_subject TEXT, token TEXT, consumed INTEGER)") { Ok(n) => n, Err(e) => -1 }
    let rows: Result(json, str) = db_query(conn, "SELECT id, request_id, actor_subject, token, consumed FROM decision_link WHERE id = ? AND actor_subject = ?", link_id, caller_subject.value)
    stop conn
    return match rows { Ok(v) => Ok(v), Err(e) => Err(DbError()) }
}

fn get_decision_link(identity: VerifiedIdentity, link_id: i64) -> Result(json, ErrorCode) {
    return match db_connect("trade_finance.db") {
        Ok(conn) => get_decision_link_inner(conn, link_id, Text(identity.subject)),
        Err(e) => Err(DbError()),
    }
}

fn decide_approval_via_link_inner(conn: db, link_id: i64, token: Text, decision: Decision) -> Result(i64, ErrorCode) {
    let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS decision_link (id INTEGER PRIMARY KEY AUTOINCREMENT, request_id INTEGER, actor_subject TEXT, token TEXT, consumed INTEGER)") { Ok(n) => n, Err(e) => -1 }
    let t2: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS approval_request (id INTEGER PRIMARY KEY AUTOINCREMENT, action_type TEXT, risk_tier TEXT, initiator_subject TEXT, sla_hours INTEGER, payload_note TEXT, status TEXT, required_eyes INTEGER)") { Ok(n) => n, Err(e) => -1 }
    let t3: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS approval_decision (id INTEGER PRIMARY KEY AUTOINCREMENT, request_id INTEGER, actor_subject TEXT, stage_index INTEGER, decision TEXT)") { Ok(n) => n, Err(e) => -1 }
    let t4: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS audit_log_entry (id INTEGER PRIMARY KEY AUTOINCREMENT, entity_type TEXT, entity_id INTEGER, actor_subject TEXT, action TEXT, note TEXT, prev_hash TEXT, hash TEXT)") { Ok(n) => n, Err(e) => -1 }

    let request_id: i64 = match db_query(conn, "SELECT request_id as value FROM decision_link WHERE id = ?", link_id) {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_i64(row, "value") { Ok(v) => v, Err(e) => -1 },
            Err(e) => -1,
        },
        Err(e) => -1,
    }
    let actor_subject: str = match db_query(conn, "SELECT actor_subject as value FROM decision_link WHERE id = ?", link_id) {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_str(row, "value") { Ok(v) => v, Err(e) => "" },
            Err(e) => "",
        },
        Err(e) => "",
    }
    let stored_token: str = match db_query(conn, "SELECT token as value FROM decision_link WHERE id = ?", link_id) {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_str(row, "value") { Ok(v) => v, Err(e) => "" },
            Err(e) => "",
        },
        Err(e) => "",
    }
    let consumed: i64 = match db_query(conn, "SELECT consumed as value FROM decision_link WHERE id = ?", link_id) {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_i64(row, "value") { Ok(v) => v, Err(e) => 1 },
            Err(e) => 1,
        },
        Err(e) => 1,
    }

    // `constant_time_str_eq`, not `==` -- a red-team finding: comparing
    // a secret-derived token with a short-circuiting `==` is a timing
    // side channel on the one thing standing between "click the link"
    // and forging a decision.
    let valid: bool = consumed == 0 && request_id >= 0 && constant_time_str_eq(stored_token, token.value)

    return if !valid {
        finish_with_audit(conn, EntityTypeDecisionLink(), link_id, Text(actor_subject), AuditActionLinkDecideRejected(), Text("invalid, already-consumed, or unknown decision link"), false, -1, DecisionLinkIsInvalidExpiredOrAlreadyUsed())
    } else {
        let marked: i64 = match db_execute(conn, "UPDATE decision_link SET consumed = 1 WHERE id = ?", link_id) {
            Ok(n) => n,
            Err(e) => -1,
        }
        decide_approval_core(conn, Text(actor_subject), request_id, decision)
    }
}

fn decide_approval_via_link(link_id: i64, token: Text, decision: Decision) -> Result(i64, ErrorCode) {
    return match db_connect("trade_finance.db") {
        Ok(conn) => decide_approval_via_link_inner(conn, link_id, token, decision),
        Err(e) => Err(DbError()),
    }
}

}

// =========================================================================
// Module 2: Corporate & Counterparty Onboarding (KYC/KYB)
// =========================================================================
module "Module 2: Corporate & Counterparty Onboarding (KYC/KYB)" {

// Categorical, human-chosen at onboarding (never system-computed) --
// a real zero-payload enum, per the language's new categorical-field
// support (LANGUAGE.md SS12's sibling `module` note; see
// `interpreter.rs::sql_bind_params`/`serve.rs::decode_enum_value` for
// the round-trip fix that makes this possible at all). `emit-ui` renders
// it as a searchable dropdown, options in this declaration order.
enum CounterpartyType {
    Buyer,
    Seller,
    Bank,
    Agent,
}

// Ordinal -- variant declaration order (Low < Medium < High) is this
// field's own real order, with no separate ordinal concept needed
// (`ui_gen.rs::build_field`'s "select" case doc comment).
enum RiskRating {
    Low,
    Medium,
    High,
}

struct Counterparty {
    id: i64,
    legal_name: str,
    lei: str,
    tax_id: str,
    counterparty_type: CounterpartyType,
    status: str,
    risk_rating: RiskRating,
}

fn list_counterparty_inner(conn: db) -> Result(json, ErrorCode) {
    let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS counterparty (id INTEGER PRIMARY KEY AUTOINCREMENT, legal_name TEXT, lei TEXT, tax_id TEXT, counterparty_type TEXT, status TEXT, risk_rating TEXT)") { Ok(n) => n, Err(e) => -1 }
    let rows: Result(json, str) = db_query(conn, "SELECT id, legal_name, lei, tax_id, counterparty_type, status, risk_rating FROM counterparty ORDER BY id DESC")
    stop conn
    return match rows { Ok(v) => Ok(v), Err(e) => Err(DbError()) }
}

fn list_counterparty() -> Result(json, ErrorCode) requires(role: "trade_party") {
    return match db_connect("trade_finance.db") {
        Ok(conn) => list_counterparty_inner(conn),
        Err(e) => Err(DbError()),
    }
}

fn create_counterparty_inner(conn: db, c: Counterparty) -> Result(i64, ErrorCode) {
    let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS counterparty (id INTEGER PRIMARY KEY AUTOINCREMENT, legal_name TEXT, lei TEXT, tax_id TEXT, counterparty_type TEXT, status TEXT, risk_rating TEXT)") { Ok(n) => n, Err(e) => -1 }
    let inserted: i64 = match db_execute(conn, "INSERT INTO counterparty (legal_name, lei, tax_id, counterparty_type, status, risk_rating) VALUES (?, ?, ?, ?, 'draft', ?)", c.legal_name, c.lei, c.tax_id, c.counterparty_type, c.risk_rating) {
        Ok(n) => n,
        Err(e) => -1,
    }
    stop conn
    return if inserted >= 0 { Ok(inserted) } else { Err(FailedToCreateCounterparty()) }
}

// Onboarding is Nirdosha's own affine/db pattern applied to KYC: create
// as `status = 'draft'`; `update_counterparty` lets an operator move it
// to `active` once screening (below) has cleared. Not
// `requires`-gated at the language level -- the doc's own governance
// table treats "approve onboarding activation" as Maker-Checker, which
// is a *workflow* decision (submit_approval/decide_approval), not a
// blanket role restriction on who may call `update_counterparty` at
// all; wiring that specific action through the shared governance
// primitive end-to-end is illustrated below for the sanctions-override
// case, the doc's own highest-risk action in this module.
fn update_counterparty_inner(conn: db, c: Counterparty) -> Result(i64, ErrorCode) {
    let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS counterparty (id INTEGER PRIMARY KEY AUTOINCREMENT, legal_name TEXT, lei TEXT, tax_id TEXT, counterparty_type TEXT, status TEXT, risk_rating TEXT)") { Ok(n) => n, Err(e) => -1 }
    let result: Result(i64, str) = db_execute(conn, "UPDATE counterparty SET legal_name = ?, lei = ?, tax_id = ?, counterparty_type = ?, status = ?, risk_rating = ? WHERE id = ?", c.legal_name, c.lei, c.tax_id, c.counterparty_type, c.status, c.risk_rating, c.id)
    stop conn
    return match result { Ok(v) => Ok(v), Err(e) => Err(DbError()) }
}

fn update_counterparty(c: Counterparty) -> Result(i64, ErrorCode) {
    return match db_connect("trade_finance.db") {
        Ok(conn) => update_counterparty_inner(conn, c),
        Err(e) => Err(DbError()),
    }
}

fn create_counterparty(c: Counterparty) -> Result(i64, ErrorCode) {
    return match db_connect("trade_finance.db") {
        Ok(conn) => create_counterparty_inner(conn, c),
        Err(e) => Err(DbError()),
    }
}

// `[MOCK]` -- stands in for a real GLEIF LEI registry lookup. Exact
// match against a tiny fixed local table (no HTTP call, no live
// registry) -- see todo.md's Module 2 section.
fn mock_lei_lookup(lei: Text) -> Result(json, ErrorCode) {
    let parsed: Result(json, str) = match lei.value {
        "5493001KJTIIGC8Y1R129" => json_parse("{\"lei\":\"5493001KJTIIGC8Y1R129\",\"legal_name\":\"Novak Grain Trading GmbH\",\"registry_status\":\"ISSUED\"}"),
        "213800WSGIIZCXF1P572" => json_parse("{\"lei\":\"213800WSGIIZCXF1P572\",\"legal_name\":\"Kabul Grain Import Co\",\"registry_status\":\"ISSUED\"}"),
        _ => Err("lei not found"),
    }
    return match parsed { Ok(v) => Ok(v), Err(e) => Err(LeiNotFoundInMockGleifRegistry()) }
}

// `[MOCK]` -- stands in for OFAC/EU/UN/UK consolidated sanctions/PEP
// lists (no licensed OpenSanctions feed). Exact-name match against a
// tiny fixed local watchlist. A real match still routes to a 6-Eyes
// override exactly like the doc specifies -- see
// `override_sanctions_match` below.
fn mock_sanctions_screen(legal_name: Text) -> Result(json, ErrorCode) {
    let parsed: Result(json, str) = if legal_name.value == "Sanctioned Trading Ltd" {
        json_parse("{\"matched\":true,\"list_source\":\"mock-consolidated\",\"match_score\":98}")
    } else {
        json_parse("{\"matched\":false,\"list_source\":\"mock-consolidated\",\"match_score\":0}")
    }
    return match parsed { Ok(v) => Ok(v), Err(e) => Err(DbError()) }
}

// A real sanctions match is high-risk per the doc's own table (6-Eyes)
// -- this wires the shared Module 1 primitive end-to-end for one
// representative marquee action per module, rather than every listed
// action (see todo.md's scoping note). `submit_sanctions_override`
// creates the 6-Eyes request; once `decide_approval` has recorded two
// distinct APPROVE decisions on it (verified via `list_approval`), an
// operator calls `clear_sanctions_override` to actually flip the
// counterparty's status -- two steps, matching how a real
// workflow-gated action (propose, then execute-once-approved) works,
// as opposed to a blanket role check.
fn submit_sanctions_override(identity: VerifiedIdentity, counterparty_id: i64, justification: Text) -> Result(i64, ErrorCode) {
    return submit_approval(identity, ActionTypeOverrideSanctionsMatch(), ApprovalRiskTierSixEyes(), 2, 4, justification)
}

fn clear_sanctions_override_inner(conn: db, request_id: i64, counterparty_id: i64) -> Result(i64, ErrorCode) {
    let status: str = match db_query(conn, "SELECT status as value FROM approval_request WHERE id = ?", request_id) {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_str(row, "value") { Ok(v) => v, Err(e) => "MISSING" },
            Err(e) => "MISSING",
        },
        Err(e) => "MISSING",
    }
    return if status == "APPROVED" {
        let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS counterparty (id INTEGER PRIMARY KEY AUTOINCREMENT, legal_name TEXT, lei TEXT, tax_id TEXT, counterparty_type TEXT, status TEXT, risk_rating TEXT)") { Ok(n) => n, Err(e) => -1 }
        let updated: Result(i64, str) = db_execute(conn, "UPDATE counterparty SET status = 'active' WHERE id = ?", counterparty_id)
        stop conn
        match updated { Ok(v) => Ok(v), Err(e) => Err(DbError()) }
    } else {
        stop conn
        Err(SanctionsOverrideRequestIsNotYetFullyApproved())
    }
}

fn clear_sanctions_override(request_id: i64, counterparty_id: i64) -> Result(i64, ErrorCode) {
    return match db_connect("trade_finance.db") {
        Ok(conn) => clear_sanctions_override_inner(conn, request_id, counterparty_id),
        Err(e) => Err(DbError()),
    }
}

// ---- credit limits ------------------------------------------------

struct CreditLimit {
    id: i64,
    counterparty_id: i64,
    facility_cap_cents: i64,
    utilized_cents: i64,
    status: str,
}

fn list_credit_limit_inner(conn: db) -> Result(json, ErrorCode) {
    let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS credit_limit (id INTEGER PRIMARY KEY AUTOINCREMENT, counterparty_id INTEGER, facility_cap_cents INTEGER, utilized_cents INTEGER, status TEXT)") { Ok(n) => n, Err(e) => -1 }
    let rows: Result(json, str) = db_query(conn, "SELECT id, counterparty_id, facility_cap_cents, utilized_cents, status FROM credit_limit ORDER BY id DESC")
    stop conn
    return match rows { Ok(v) => Ok(v), Err(e) => Err(DbError()) }
}

fn list_credit_limit() -> Result(json, ErrorCode) requires(role: "compliance_officer") {
    return match db_connect("trade_finance.db") {
        Ok(conn) => list_credit_limit_inner(conn),
        Err(e) => Err(DbError()),
    }
}

fn create_credit_limit_inner(conn: db, cl: CreditLimit) -> Result(i64, ErrorCode) {
    let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS credit_limit (id INTEGER PRIMARY KEY AUTOINCREMENT, counterparty_id INTEGER, facility_cap_cents INTEGER, utilized_cents INTEGER, status TEXT)") { Ok(n) => n, Err(e) => -1 }
    let inserted: i64 = match db_execute(conn, "INSERT INTO credit_limit (counterparty_id, facility_cap_cents, utilized_cents, status) VALUES (?, ?, 0, 'active')", cl.counterparty_id, cl.facility_cap_cents) {
        Ok(n) => n,
        Err(e) => -1,
    }
    stop conn
    return if inserted >= 0 { Ok(inserted) } else { Err(FailedToCreateCreditLimit()) }
}

fn create_credit_limit(cl: CreditLimit) -> Result(i64, ErrorCode) requires(role: "compliance_officer") {
    return match db_connect("trade_finance.db") {
        Ok(conn) => create_credit_limit_inner(conn, cl),
        Err(e) => Err(DbError()),
    }
}

// Real, reusable hold check -- called synchronously (a real function
// call, not just documented intent) by any later module before it lets
// a disbursement/payment/discounting request through: does the
// counterparty have enough headroom? Returns `true` if the request
// would fit within the facility cap.
fn check_credit_hold_inner(conn: db, counterparty_id: i64, amount_cents: i64) -> bool {
    let headroom: i64 = match db_query(conn, "SELECT facility_cap_cents - utilized_cents as value FROM credit_limit WHERE counterparty_id = ? AND status = 'active'", counterparty_id) {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_i64(row, "value") { Ok(v) => v, Err(e) => 0 },
            Err(e) => 0,
        },
        Err(e) => 0,
    }
    stop conn
    return amount_cents <= headroom
}

fn check_credit_hold(counterparty_id: i64, amount_cents: i64) -> bool {
    return match db_connect("trade_finance.db") {
        Ok(conn) => check_credit_hold_inner(conn, counterparty_id, amount_cents),
        Err(e) => false,
    }
}

// ---- financial statements: real ratio computation ------------------
//
// `Ty::I64`/`Ty::F64` have no conversion operator between them
// (LANGUAGE.md §3), so ratios are computed and stored as basis points
// (i64 * 10000 / i64) throughout, the same convention
// `examples/rev-assurence/rev_assurance.nir`'s `stat_leakage_rate_bps`
// already established -- real division, guarded against a zero
// divisor (`LANGUAGE.md` §4: int division traps on zero).

struct FinancialStatement {
    id: i64,
    counterparty_id: i64,
    period: str,
    current_assets_cents: i64,
    current_liabilities_cents: i64,
    total_liabilities_cents: i64,
    total_equity_cents: i64,
}

fn list_financial_statement_inner(conn: db) -> Result(json, ErrorCode) {
    let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS financial_statement (id INTEGER PRIMARY KEY AUTOINCREMENT, counterparty_id INTEGER, period TEXT, current_ratio_bps INTEGER, debt_to_equity_bps INTEGER, credit_score INTEGER)") { Ok(n) => n, Err(e) => -1 }
    let rows: Result(json, str) = db_query(conn, "SELECT id, counterparty_id, period, current_ratio_bps, debt_to_equity_bps, credit_score FROM financial_statement ORDER BY id DESC")
    stop conn
    return match rows { Ok(v) => Ok(v), Err(e) => Err(DbError()) }
}

fn list_financial_statement() -> Result(json, ErrorCode) requires(role: "compliance_officer") {
    return match db_connect("trade_finance.db") {
        Ok(conn) => list_financial_statement_inner(conn),
        Err(e) => Err(DbError()),
    }
}

fn create_financial_statement_inner(conn: db, fs: FinancialStatement) -> Result(i64, ErrorCode) {
    let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS financial_statement (id INTEGER PRIMARY KEY AUTOINCREMENT, counterparty_id INTEGER, period TEXT, current_ratio_bps INTEGER, debt_to_equity_bps INTEGER, credit_score INTEGER)") { Ok(n) => n, Err(e) => -1 }

    let current_ratio_bps: i64 = if fs.current_liabilities_cents == 0 {
        0
    } else {
        (fs.current_assets_cents * 10000) / fs.current_liabilities_cents
    }
    let debt_to_equity_bps: i64 = if fs.total_equity_cents == 0 {
        0
    } else {
        (fs.total_liabilities_cents * 10000) / fs.total_equity_cents
    }
    // A deliberately simple, deterministic heuristic -- real arithmetic
    // over the two computed ratios, not a trained model (the doc's own
    // scikit-learn/XGBoost scoring pipeline is `[SUBSTITUTED]`; see
    // todo.md). Higher current ratio and lower leverage both raise the
    // score; clamped to [0, 10000].
    let raw_score: i64 = 5000 + (current_ratio_bps / 4) - (debt_to_equity_bps / 4)
    let credit_score: i64 = if raw_score < 0 {
        0
    } else {
        if raw_score > 10000 { 10000 } else { raw_score }
    }

    let inserted: i64 = match db_execute(conn, "INSERT INTO financial_statement (counterparty_id, period, current_ratio_bps, debt_to_equity_bps, credit_score) VALUES (?, ?, ?, ?, ?)", fs.counterparty_id, fs.period, current_ratio_bps, debt_to_equity_bps, credit_score) {
        Ok(n) => n,
        Err(e) => -1,
    }
    stop conn
    return if inserted >= 0 { Ok(credit_score) } else { Err(FailedToRecordFinancialStatement()) }
}

fn create_financial_statement(fs: FinancialStatement) -> Result(i64, ErrorCode) {
    return match db_connect("trade_finance.db") {
        Ok(conn) => create_financial_statement_inner(conn, fs),
        Err(e) => Err(DbError()),
    }
}


}

// `screen`/`dashboard` blocks stay top-level-only (LANGUAGE.md's `module`
// section) -- deliberately outside every `module { ... }` block, not a
// business-organizational choice. This is the one worked example of
// field-level RBAC in this app (LANGUAGE.md's `screen`/`dashboard`
// section): `risk_rating` is compliance-sensitive, so only
// `compliance_officer`/`bank_ops` can see it at all (every other role
// `list_counterparty`'s own `trade_party` gate admits -- `corporate_
// seller`/`corporate_buyer` -- sees the rest of a counterparty's profile
// with this one field redacted to `null`), and only `compliance_officer`
// can change it via `update_counterparty` (anyone else's submitted value
// for just this field is rejected if it differs from what's stored; the
// rest of the update still goes through).
screen Counterparty {
    field risk_rating {
        view: role("compliance_officer", "bank_ops")
        edit: role("compliance_officer")
    }
}

// =========================================================================
// Module 3: Trade Contracts, Documents & Instrument Lifecycle
// =========================================================================
module "Module 3: Trade Contracts, Documents & Instrument Lifecycle" {
//
// Five workflow variants as real stored/selectable state (not prose):
// ADVANCE_PAYMENT / OPEN_ACCOUNT / DOCUMENTARY_COLLECTION / LC_BACKED /
// MILESTONE_ESCROW. `recommend_workflow_variant` is a real deterministic
// rule function; the doc is explicit this is a *recommendation*, so the
// actually-used `workflow_variant` on a `PurchaseOrder` is always a
// separate human-recorded field, never auto-applied.

struct PurchaseOrder {
    id: i64,
    buyer_counterparty_id: i64,
    seller_counterparty_id: i64,
    workflow_variant: str,
    goods_description: str,
    quantity: i64,
    beneficiary_name: str,
    total_amount_cents: i64,
    currency: str,
    status: str,
}

fn list_purchase_order_inner(conn: db) -> Result(json, ErrorCode) {
    let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS purchase_order (id INTEGER PRIMARY KEY AUTOINCREMENT, buyer_counterparty_id INTEGER, seller_counterparty_id INTEGER, workflow_variant TEXT, goods_description TEXT, quantity INTEGER, beneficiary_name TEXT, total_amount_cents INTEGER, currency TEXT, status TEXT)") { Ok(n) => n, Err(e) => -1 }
    let rows: Result(json, str) = db_query(conn, "SELECT id, buyer_counterparty_id, seller_counterparty_id, workflow_variant, goods_description, quantity, beneficiary_name, total_amount_cents, currency, status FROM purchase_order ORDER BY id DESC")
    stop conn
    return match rows { Ok(v) => Ok(v), Err(e) => Err(DbError()) }
}

fn list_purchase_order() -> Result(json, ErrorCode) requires(role: "trade_party") {
    return match db_connect("trade_finance.db") {
        Ok(conn) => list_purchase_order_inner(conn),
        Err(e) => Err(DbError()),
    }
}

fn create_purchase_order_inner(conn: db, po: PurchaseOrder) -> Result(i64, ErrorCode) {
    let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS purchase_order (id INTEGER PRIMARY KEY AUTOINCREMENT, buyer_counterparty_id INTEGER, seller_counterparty_id INTEGER, workflow_variant TEXT, goods_description TEXT, quantity INTEGER, beneficiary_name TEXT, total_amount_cents INTEGER, currency TEXT, status TEXT)") { Ok(n) => n, Err(e) => -1 }
    let inserted: i64 = match db_execute(conn, "INSERT INTO purchase_order (buyer_counterparty_id, seller_counterparty_id, workflow_variant, goods_description, quantity, beneficiary_name, total_amount_cents, currency, status) VALUES (?, ?, ?, ?, ?, ?, ?, ?, 'draft')", po.buyer_counterparty_id, po.seller_counterparty_id, po.workflow_variant, po.goods_description, po.quantity, po.beneficiary_name, po.total_amount_cents, po.currency) {
        Ok(n) => n,
        Err(e) => -1,
    }
    stop conn
    return if inserted >= 0 { Ok(inserted) } else { Err(FailedToCreatePurchaseOrder()) }
}

fn create_purchase_order(po: PurchaseOrder) -> Result(i64, ErrorCode) {
    return match db_connect("trade_finance.db") {
        Ok(conn) => create_purchase_order_inner(conn, po),
        Err(e) => Err(DbError()),
    }
}

fn update_purchase_order_inner(conn: db, po: PurchaseOrder) -> Result(i64, ErrorCode) {
    let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS purchase_order (id INTEGER PRIMARY KEY AUTOINCREMENT, buyer_counterparty_id INTEGER, seller_counterparty_id INTEGER, workflow_variant TEXT, goods_description TEXT, quantity INTEGER, beneficiary_name TEXT, total_amount_cents INTEGER, currency TEXT, status TEXT)") { Ok(n) => n, Err(e) => -1 }
    // Split across two statements -- db_execute's bind-value arity caps
    // at 8 (10 args total incl. conn+sql; typeck.rs's (2..=10) range),
    // and this struct has 9 settable columns + the WHERE id.
    let part1: i64 = match db_execute(conn, "UPDATE purchase_order SET buyer_counterparty_id = ?, seller_counterparty_id = ?, workflow_variant = ?, goods_description = ? WHERE id = ?", po.buyer_counterparty_id, po.seller_counterparty_id, po.workflow_variant, po.goods_description, po.id) {
        Ok(n) => n,
        Err(e) => -1,
    }
    let result: Result(i64, str) = db_execute(conn, "UPDATE purchase_order SET quantity = ?, beneficiary_name = ?, total_amount_cents = ?, currency = ?, status = ? WHERE id = ?", po.quantity, po.beneficiary_name, po.total_amount_cents, po.currency, po.status, po.id)
    stop conn
    return match result { Ok(v) => Ok(v), Err(e) => Err(DbError()) }
}

// Amending a PO line item is Maker-Checker per the doc's table --
// implemented as a plain, callable update here (same disclosed scoping
// as `update_counterparty` in Module 2: only one marquee action per
// module gets wired through the full submit/decide governance
// primitive end-to-end; every other action is real, callable business
// logic whose governance tier is documented, not re-derived per call).
fn update_purchase_order(po: PurchaseOrder) -> Result(i64, ErrorCode) {
    return match db_connect("trade_finance.db") {
        Ok(conn) => update_purchase_order_inner(conn, po),
        Err(e) => Err(DbError()),
    }
}

// Real deterministic rule, not a stub: counterparty trust tier, credit
// rating, order size, and an explicit bank-guarantee requirement select
// a recommended workflow variant. The doc is explicit this is advisory
// only -- `create_purchase_order`/`update_purchase_order` above always
// take `workflow_variant` as a plain human-supplied field; nothing here
// writes to storage.
fn recommend_workflow_variant(trust_tier: TrustTier, credit_rating_bps: i64, order_amount_cents: i64, bank_guarantee_required: bool) -> WorkflowVariant {
    return if bank_guarantee_required {
        WorkflowVariantLcBacked()
    } else {
        match trust_tier {
            TrustTierNew => WorkflowVariantAdvancePayment(),
            TrustTierHigh => if credit_rating_bps >= 7000 {
                WorkflowVariantOpenAccount()
            } else {
                if order_amount_cents > 10000000 && credit_rating_bps < 5000 {
                    WorkflowVariantAdvancePayment()
                } else {
                    if order_amount_cents > 5000000 {
                        WorkflowVariantDocumentaryCollection()
                    } else {
                        WorkflowVariantMilestoneEscrow()
                    }
                }
            },
            TrustTierStandard => if order_amount_cents > 10000000 && credit_rating_bps < 5000 {
                WorkflowVariantAdvancePayment()
            } else {
                if order_amount_cents > 5000000 {
                    WorkflowVariantDocumentaryCollection()
                } else {
                    WorkflowVariantMilestoneEscrow()
                }
            },
        }
    }
}

// ---- Letters of Credit: applied -> advised -> amended -> presented ->
// discrepancy-checked -> settled -----------------------------------

struct LetterOfCredit {
    id: i64,
    purchase_order_id: i64,
    lc_number: str,
    status: str,
    amount_cents: i64,
    currency: str,
}

fn list_letter_of_credit_inner(conn: db) -> Result(json, ErrorCode) {
    let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS letter_of_credit (id INTEGER PRIMARY KEY AUTOINCREMENT, purchase_order_id INTEGER, lc_number TEXT, status TEXT, amount_cents INTEGER, currency TEXT)") { Ok(n) => n, Err(e) => -1 }
    let rows: Result(json, str) = db_query(conn, "SELECT id, purchase_order_id, lc_number, status, amount_cents, currency FROM letter_of_credit ORDER BY id DESC")
    stop conn
    return match rows { Ok(v) => Ok(v), Err(e) => Err(DbError()) }
}

fn list_letter_of_credit() -> Result(json, ErrorCode) requires(role: "trade_party") {
    return match db_connect("trade_finance.db") {
        Ok(conn) => list_letter_of_credit_inner(conn),
        Err(e) => Err(DbError()),
    }
}

// Issuance (MT700) is 6-Eyes per the doc's table -- this module's
// marquee governance wiring, same two-step "submit, then apply once
// approved" shape as Module 2's sanctions override:
// `submit_lc_issuance` opens a `required_eyes: 2` request;
// `issue_letter_of_credit` only actually creates the LC row once
// `list_approval` shows that request as APPROVED.
fn submit_lc_issuance(identity: VerifiedIdentity, purchase_order_id: i64, lc_number: Text, justification: Text) -> Result(i64, ErrorCode) {
    return submit_approval(identity, ActionTypeIssueLetterOfCredit(), ApprovalRiskTierSixEyes(), 2, 8, justification)
}

fn issue_letter_of_credit_inner(conn: db, request_id: i64, purchase_order_id: i64, lc_number: Text, amount_cents: i64, currency: Currency) -> Result(i64, ErrorCode) {
    let status: str = match db_query(conn, "SELECT status as value FROM approval_request WHERE id = ?", request_id) {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_str(row, "value") { Ok(v) => v, Err(e) => "MISSING" },
            Err(e) => "MISSING",
        },
        Err(e) => "MISSING",
    }
    return if status != "APPROVED" {
        stop conn
        Err(LcIssuanceIsNotYetFully6EyesApproved())
    } else {
        let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS letter_of_credit (id INTEGER PRIMARY KEY AUTOINCREMENT, purchase_order_id INTEGER, lc_number TEXT, status TEXT, amount_cents INTEGER, currency TEXT)") { Ok(n) => n, Err(e) => -1 }
        let inserted: i64 = match db_execute(conn, "INSERT INTO letter_of_credit (purchase_order_id, lc_number, status, amount_cents, currency) VALUES (?, ?, 'advised', ?, ?)", purchase_order_id, lc_number.value, amount_cents, currency) {
            Ok(n) => n,
            Err(e) => -1,
        }
        stop conn
        if inserted >= 0 { Ok(inserted) } else { Err(FailedToIssueLetterOfCredit()) }
    }
}

fn issue_letter_of_credit(request_id: i64, purchase_order_id: i64, lc_number: Text, amount_cents: i64, currency: Currency) -> Result(i64, ErrorCode) {
    return match db_connect("trade_finance.db") {
        Ok(conn) => issue_letter_of_credit_inner(conn, request_id, purchase_order_id, lc_number, amount_cents, currency),
        Err(e) => Err(DbError()),
    }
}

// Amendment is Maker-Checker per the doc's table -- plain callable
// update, same disclosed scoping as `update_purchase_order` above.
fn amend_letter_of_credit_inner(conn: db, lc: LetterOfCredit) -> Result(i64, ErrorCode) {
    let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS letter_of_credit (id INTEGER PRIMARY KEY AUTOINCREMENT, purchase_order_id INTEGER, lc_number TEXT, status TEXT, amount_cents INTEGER, currency TEXT)") { Ok(n) => n, Err(e) => -1 }
    let result: Result(i64, str) = db_execute(conn, "UPDATE letter_of_credit SET lc_number = ?, amount_cents = ?, currency = ?, status = 'amended' WHERE id = ?", lc.lc_number, lc.amount_cents, lc.currency, lc.id)
    stop conn
    return match result { Ok(v) => Ok(v), Err(e) => Err(DbError()) }
}

fn amend_letter_of_credit(lc: LetterOfCredit) -> Result(i64, ErrorCode) {
    return match db_connect("trade_finance.db") {
        Ok(conn) => amend_letter_of_credit_inner(conn, lc),
        Err(e) => Err(DbError()),
    }
}

// ---- UCP 600 discrepancy checker: real field-by-field comparison ----
//
// One row per presentation, comparing the two fields the doc names
// (quantity, party name) against the underlying PO -- real comparison
// logic, not a stub. Dates aren't compared numerically since Nirdosha
// has no date/time builtin (same substitution as the SLA-deadline gap
// noted elsewhere); `date_note` is captured on the `TradeDocument` row
// for the record but not diffed.

struct TradeDocument {
    id: i64,
    letter_of_credit_id: i64,
    doc_type: str,
    presented_quantity: i64,
    presented_party_name: str,
    date_note: str,
}

struct DiscrepancyCheckResult {
    id: i64,
    letter_of_credit_id: i64,
    po_quantity: i64,
    presented_quantity: i64,
    quantity_status: str,
    po_party_name: str,
    presented_party_name: str,
    party_status: str,
    overall_status: str,
}

fn list_discrepancy_check_result_inner(conn: db) -> Result(json, ErrorCode) {
    let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS discrepancy_check_result (id INTEGER PRIMARY KEY AUTOINCREMENT, letter_of_credit_id INTEGER, po_quantity INTEGER, presented_quantity INTEGER, quantity_status TEXT, po_party_name TEXT, presented_party_name TEXT, party_status TEXT, overall_status TEXT)") { Ok(n) => n, Err(e) => -1 }
    let rows: Result(json, str) = db_query(conn, "SELECT id, letter_of_credit_id, po_quantity, presented_quantity, quantity_status, po_party_name, presented_party_name, party_status, overall_status FROM discrepancy_check_result ORDER BY id DESC")
    stop conn
    return match rows { Ok(v) => Ok(v), Err(e) => Err(DbError()) }
}

fn list_discrepancy_check_result() -> Result(json, ErrorCode) requires(role: "bank_ops") {
    return match db_connect("trade_finance.db") {
        Ok(conn) => list_discrepancy_check_result_inner(conn),
        Err(e) => Err(DbError()),
    }
}

fn present_documents_inner(conn: db, letter_of_credit_id: i64, doc_type: Text, presented_quantity: i64, presented_party_name: Text, date_note: Text) -> Result(i64, ErrorCode) {
    let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS trade_document (id INTEGER PRIMARY KEY AUTOINCREMENT, letter_of_credit_id INTEGER, doc_type TEXT, presented_quantity INTEGER, presented_party_name TEXT, date_note TEXT)") { Ok(n) => n, Err(e) => -1 }
    let t2: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS discrepancy_check_result (id INTEGER PRIMARY KEY AUTOINCREMENT, letter_of_credit_id INTEGER, po_quantity INTEGER, presented_quantity INTEGER, quantity_status TEXT, po_party_name TEXT, presented_party_name TEXT, party_status TEXT, overall_status TEXT)") { Ok(n) => n, Err(e) => -1 }
    let t3: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS letter_of_credit (id INTEGER PRIMARY KEY AUTOINCREMENT, purchase_order_id INTEGER, lc_number TEXT, status TEXT, amount_cents INTEGER, currency TEXT)") { Ok(n) => n, Err(e) => -1 }
    let t4: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS purchase_order (id INTEGER PRIMARY KEY AUTOINCREMENT, buyer_counterparty_id INTEGER, seller_counterparty_id INTEGER, workflow_variant TEXT, goods_description TEXT, quantity INTEGER, beneficiary_name TEXT, total_amount_cents INTEGER, currency TEXT, status TEXT)") { Ok(n) => n, Err(e) => -1 }

    let purchase_order_id: i64 = match db_query(conn, "SELECT purchase_order_id as value FROM letter_of_credit WHERE id = ?", letter_of_credit_id) {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_i64(row, "value") { Ok(v) => v, Err(e) => -1 },
            Err(e) => -1,
        },
        Err(e) => -1,
    }
    let po_quantity: i64 = match db_query(conn, "SELECT quantity as value FROM purchase_order WHERE id = ?", purchase_order_id) {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_i64(row, "value") { Ok(v) => v, Err(e) => 0 },
            Err(e) => 0,
        },
        Err(e) => 0,
    }
    let po_party_name: str = match db_query(conn, "SELECT beneficiary_name as value FROM purchase_order WHERE id = ?", purchase_order_id) {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_str(row, "value") { Ok(v) => v, Err(e) => "" },
            Err(e) => "",
        },
        Err(e) => "",
    }

    let quantity_status: str = if presented_quantity == po_quantity { "MATCH" } else { "DISCREPANT" }
    let party_status: str = if presented_party_name.value == po_party_name { "MATCH" } else { "DISCREPANT" }
    let overall_status: str = if quantity_status == "MATCH" && party_status == "MATCH" { "CLEAN" } else { "DISCREPANT" }

    let doc_inserted: i64 = match db_execute(conn, "INSERT INTO trade_document (letter_of_credit_id, doc_type, presented_quantity, presented_party_name, date_note) VALUES (?, ?, ?, ?, ?)", letter_of_credit_id, doc_type.value, presented_quantity, presented_party_name.value, date_note.value) {
        Ok(n) => n,
        Err(e) => -1,
    }
    let result_inserted: i64 = match db_execute(conn, "INSERT INTO discrepancy_check_result (letter_of_credit_id, po_quantity, presented_quantity, quantity_status, po_party_name, presented_party_name, party_status, overall_status) VALUES (?, ?, ?, ?, ?, ?, ?, ?)", letter_of_credit_id, po_quantity, presented_quantity, quantity_status, po_party_name, presented_party_name.value, party_status, overall_status) {
        Ok(n) => n,
        Err(e) => -1,
    }
    let new_lc_status: str = if overall_status == "CLEAN" { "presented" } else { "discrepancy_checked" }
    let updated: i64 = match db_execute(conn, "UPDATE letter_of_credit SET status = ? WHERE id = ?", new_lc_status, letter_of_credit_id) {
        Ok(n) => n,
        Err(e) => -1,
    }
    stop conn
    return if result_inserted >= 0 { Ok(result_inserted) } else { Err(FailedToRecordDocumentPresentation()) }
}

fn present_documents(letter_of_credit_id: i64, doc_type: Text, presented_quantity: i64, presented_party_name: Text, date_note: Text) -> Result(i64, ErrorCode) {
    return match db_connect("trade_finance.db") {
        Ok(conn) => present_documents_inner(conn, letter_of_credit_id, doc_type, presented_quantity, presented_party_name, date_note),
        Err(e) => Err(DbError()),
    }
}

// Accepting a UCP 600 discrepancy waiver is 6-Eyes per the doc's table
// -- second half of this module's governance wiring, same submit/apply
// shape as LC issuance above: only once two distinct approvers have
// accepted does the LC actually move to `settled`.
fn submit_discrepancy_waiver(identity: VerifiedIdentity, letter_of_credit_id: i64, justification: Text) -> Result(i64, ErrorCode) {
    return submit_approval(identity, ActionTypeAcceptDiscrepancyWaiver(), ApprovalRiskTierSixEyes(), 2, 8, justification)
}

fn apply_discrepancy_waiver_inner(conn: db, request_id: i64, letter_of_credit_id: i64) -> Result(i64, ErrorCode) {
    let status: str = match db_query(conn, "SELECT status as value FROM approval_request WHERE id = ?", request_id) {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_str(row, "value") { Ok(v) => v, Err(e) => "MISSING" },
            Err(e) => "MISSING",
        },
        Err(e) => "MISSING",
    }
    return if status != "APPROVED" {
        stop conn
        Err(DiscrepancyWaiverIsNotYetFully6EyesApproved())
    } else {
        let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS letter_of_credit (id INTEGER PRIMARY KEY AUTOINCREMENT, purchase_order_id INTEGER, lc_number TEXT, status TEXT, amount_cents INTEGER, currency TEXT)") { Ok(n) => n, Err(e) => -1 }
        let updated: Result(i64, str) = db_execute(conn, "UPDATE letter_of_credit SET status = 'settled' WHERE id = ?", letter_of_credit_id)
        stop conn
        match updated { Ok(v) => Ok(v), Err(e) => Err(DbError()) }
    }
}

fn apply_discrepancy_waiver(request_id: i64, letter_of_credit_id: i64) -> Result(i64, ErrorCode) {
    return match db_connect("trade_finance.db") {
        Ok(conn) => apply_discrepancy_waiver_inner(conn, request_id, letter_of_credit_id),
        Err(e) => Err(DbError()),
    }
}

// ---- SWIFT messaging: `[MOCK]`, real semantic fields, not wire bytes -

struct SwiftMessageLog {
    id: i64,
    msg_type: str,
    reference: str,
    fields_note: str,
    status: str,
}

fn list_swift_message_log_inner(conn: db) -> Result(json, ErrorCode) {
    let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS swift_message_log (id INTEGER PRIMARY KEY AUTOINCREMENT, msg_type TEXT, reference TEXT, fields_note TEXT, status TEXT)") { Ok(n) => n, Err(e) => -1 }
    let rows: Result(json, str) = db_query(conn, "SELECT id, msg_type, reference, fields_note, status FROM swift_message_log ORDER BY id DESC")
    stop conn
    return match rows { Ok(v) => Ok(v), Err(e) => Err(DbError()) }
}

fn list_swift_message_log() -> Result(json, ErrorCode) requires(role: "bank_ops") {
    return match db_connect("trade_finance.db") {
        Ok(conn) => list_swift_message_log_inner(conn),
        Err(e) => Err(DbError()),
    }
}

fn mock_generate_swift_message_inner(conn: db, msg_type: MsgType, reference: Text, fields_note: Text) -> Text {
    let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS swift_message_log (id INTEGER PRIMARY KEY AUTOINCREMENT, msg_type TEXT, reference TEXT, fields_note TEXT, status TEXT)") { Ok(n) => n, Err(e) => -1 }
    let inserted: i64 = match db_execute(conn, "INSERT INTO swift_message_log (msg_type, reference, fields_note, status) VALUES (?, ?, ?, 'generated')", msg_type, reference.value, fields_note.value) {
        Ok(n) => n,
        Err(e) => -1,
    }
    stop conn
    // A real enum `match` now, not a literal-pattern one -- `msg_type`
    // used to be a bare `str` matched by literal (see
    // `examples/identity_mock.nir`'s `login` for that older pattern);
    // "enum favoring" replaces it with a real closed type instead.
    return match msg_type {
        MsgTypeMt700 => Text("MT700 generated (mock): irrevocable documentary credit issuance"),
        MsgTypeMt707 => Text("MT707 generated (mock): amendment to documentary credit"),
        MsgTypeMt710 => Text("MT710 generated (mock): advice of a third bank's documentary credit"),
        MsgTypeMt760 => Text("MT760 generated (mock): guarantee/standby letter of credit"),
        MsgTypeOther => Text("SWIFT message generated (mock)"),
    }
}

// `[MOCK]` -- stands in for real Prowide/SWIFT Alliance Access
// transmission; logs the real semantic fields, not wire-format bytes,
// not actually transmitted anywhere. See todo.md's Module 3 section.
fn mock_generate_swift_message(msg_type: MsgType, reference: Text, fields_note: Text) -> Text {
    return match db_connect("trade_finance.db") {
        Ok(conn) => mock_generate_swift_message_inner(conn, msg_type, reference, fields_note),
        Err(e) => Text("swift message log unavailable (mock)"),
    }
}


}

// =========================================================================
// Module 6: Inventory & Goods Movement Reconciliation
// =========================================================================
module "Module 6: Inventory & Goods Movement Reconciliation" {
//
// Closes the physical-to-financial gap: a warehouse operator enters a
// Goods Receipt Note (no IoT/RFID/barcode feed exists -- `[MOCK]`, see
// todo.md), a real three-way match engine compares it against the
// underlying purchase order, and the result either auto-confirms within
// tolerance or opens a real `DeliveryDispute` that Modules 4 and 5 gate
// on synchronously below.

struct GoodsReceiptNote {
    id: i64,
    purchase_order_id: i64,
    received_quantity: i64,
    condition_note: str,
    status: str,
}

struct MatchResult {
    id: i64,
    purchase_order_id: i64,
    po_quantity: i64,
    grn_quantity: i64,
    variance_bps: i64,
    status: str,
}

enum DisputeType {
    Short,
    Damage,
    Over,
}

struct DeliveryDispute {
    id: i64,
    purchase_order_id: i64,
    dispute_type: DisputeType,
    description: str,
    status: str,
}

fn list_goods_receipt_note_inner(conn: db) -> Result(json, ErrorCode) {
    let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS goods_receipt_note (id INTEGER PRIMARY KEY AUTOINCREMENT, purchase_order_id INTEGER, received_quantity INTEGER, condition_note TEXT, status TEXT)") { Ok(n) => n, Err(e) => -1 }
    let rows: Result(json, str) = db_query(conn, "SELECT id, purchase_order_id, received_quantity, condition_note, status FROM goods_receipt_note ORDER BY id DESC")
    stop conn
    return match rows { Ok(v) => Ok(v), Err(e) => Err(DbError()) }
}

fn list_goods_receipt_note() -> Result(json, ErrorCode) requires(role: "trade_party") {
    return match db_connect("trade_finance.db") {
        Ok(conn) => list_goods_receipt_note_inner(conn),
        Err(e) => Err(DbError()),
