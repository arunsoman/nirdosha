        Ok(conn) => has_open_dispute_inner(conn, purchase_order_id),
        Err(e) => false,
    }
}

// ---- three-way match: real reconciliation math, not a stub ---------
//
// `variance_bps = |po_quantity - grn_quantity| * 10000 / po_quantity`.
// Within `TOLERANCE_BPS` (2%, a fixed illustrative tolerance -- the doc
// leaves the exact figure to configuration, which Nirdosha has no
// externalized-config mechanism for): `auto_confirmed`, no human
// action, and a best-effort `inventory.grn.confirmed` publish onto
// `mq` (Redis) -- the one required real `mq` integration point named in
// todo.md. Beyond tolerance: `dispute`, and a `DeliveryDispute` opens
// automatically so Modules 4/5's gate gets exercised without a human
// step first.
fn create_goods_receipt_note_inner(conn: db, g: GoodsReceiptNote) -> Result(i64, str) {
    let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS goods_receipt_note (id INTEGER PRIMARY KEY AUTOINCREMENT, purchase_order_id INTEGER, received_quantity INTEGER, condition_note TEXT, status TEXT)") { Ok(n) => n, Err(e) => -1 }
    let t2: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS match_result (id INTEGER PRIMARY KEY AUTOINCREMENT, purchase_order_id INTEGER, po_quantity INTEGER, grn_quantity INTEGER, variance_bps INTEGER, status TEXT)") { Ok(n) => n, Err(e) => -1 }
    let t3: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS delivery_dispute (id INTEGER PRIMARY KEY AUTOINCREMENT, purchase_order_id INTEGER, dispute_type TEXT, description TEXT, status TEXT)") { Ok(n) => n, Err(e) => -1 }
    let t4: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS purchase_order (id INTEGER PRIMARY KEY AUTOINCREMENT, buyer_counterparty_id INTEGER, seller_counterparty_id INTEGER, workflow_variant TEXT, goods_description TEXT, quantity INTEGER, beneficiary_name TEXT, total_amount_cents INTEGER, currency TEXT, status TEXT)") { Ok(n) => n, Err(e) => -1 }

    let grn_inserted: i64 = match db_execute(conn, "INSERT INTO goods_receipt_note (purchase_order_id, received_quantity, condition_note, status) VALUES (?, ?, ?, 'received')", g.purchase_order_id, g.received_quantity, g.condition_note) {
        Ok(n) => n,
        Err(e) => -1,
    }

    let po_quantity: i64 = match db_query(conn, "SELECT quantity as value FROM purchase_order WHERE id = ?", g.purchase_order_id) {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_i64(row, "value") { Ok(v) => v, Err(e) => 0 },
            Err(e) => 0,
        },
        Err(e) => 0,
    }
    let diff: i64 = po_quantity - g.received_quantity
    let abs_diff: i64 = if diff < 0 { -diff } else { diff }
    let variance_bps: i64 = if po_quantity == 0 { 10000 } else { (abs_diff * 10000) / po_quantity }
    let tolerance_bps: i64 = 200
    let match_status: str = if variance_bps <= tolerance_bps { "auto_confirmed" } else { "dispute" }

    let match_inserted: i64 = match db_execute(conn, "INSERT INTO match_result (purchase_order_id, po_quantity, grn_quantity, variance_bps, status) VALUES (?, ?, ?, ?, ?)", g.purchase_order_id, po_quantity, g.received_quantity, variance_bps, match_status) {
        Ok(n) => n,
        Err(e) => -1,
    }

    let followup: i64 = if match_status == "auto_confirmed" {
        // Best-effort: a queue outage doesn't fail the GRN itself, same
        // discipline as `examples/store.nir`'s `order.created` publish.
        match mq_connect("127.0.0.1", 6379) {
            Ok(mqconn) => match mq_publish(mqconn, "inventory.grn.confirmed", "inventory.grn.confirmed") {
                Ok(u) => 0,
                Err(e) => -1,
            },
            Err(e) => -1,
        }
    } else {
        let dispute_type: str = if g.received_quantity < po_quantity { "short" } else { "over" }
        match db_execute(conn, "INSERT INTO delivery_dispute (purchase_order_id, dispute_type, description, status) VALUES (?, ?, 'auto-opened: three-way match variance beyond tolerance', 'open')", g.purchase_order_id, dispute_type) {
            Ok(n) => n,
            Err(e) => -1,
        }
    }

    stop conn
    return if grn_inserted >= 0 { Ok(grn_inserted) } else { Err("failed to record goods receipt note") }
}

fn create_goods_receipt_note(g: GoodsReceiptNote) -> Result(i64, str) {
    return match db_connect("trade_finance.db") {
        Ok(conn) => create_goods_receipt_note_inner(conn, g),
        Err(e) => Err(e),
    }
}

// ---- dashboard: real tiles/charts over match/dispute data -----------

fn stat_match_rate_bps_inner(conn: db) -> i64 {
    let confirmed: i64 = match db_query(conn, "SELECT COUNT(*) as value FROM match_result WHERE status = 'auto_confirmed'") {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_i64(row, "value") { Ok(v) => v, Err(e) => 0 },
            Err(e) => 0,
        },
        Err(e) => 0,
    }
    let total: i64 = match db_query(conn, "SELECT COUNT(*) as value FROM match_result") {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_i64(row, "value") { Ok(v) => v, Err(e) => 0 },
            Err(e) => 0,
        },
        Err(e) => 0,
    }
    stop conn
    return if total == 0 { 0 } else { (confirmed * 10000) / total }
}

fn stat_match_rate_bps() -> i64 {
    return match db_connect("trade_finance.db") {
        Ok(conn) => stat_match_rate_bps_inner(conn),
        Err(e) => 0,
    }
}

fn chart_dispute_by_type_inner(conn: db) -> Result(json, str) {
    let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS delivery_dispute (id INTEGER PRIMARY KEY AUTOINCREMENT, purchase_order_id INTEGER, dispute_type TEXT, description TEXT, status TEXT)") { Ok(n) => n, Err(e) => -1 }
    let rows: Result(json, str) = db_query(conn, "SELECT dispute_type as label, COUNT(*) as value FROM delivery_dispute WHERE status = 'open' GROUP BY dispute_type ORDER BY value DESC")
    stop conn
    return rows
}

fn chart_dispute_by_type() -> Result(json, str) {
    return match db_connect("trade_finance.db") {
        Ok(conn) => chart_dispute_by_type_inner(conn),
        Err(e) => Err(e),
    }
}


// =========================================================================
// Module 4: B2B Trade Payments & Tiered Commission Engine
// =========================================================================
//
// Unified `TradePayment` initiation across all five Module 3 workflow
// variants, governance-routed by value (standard = Maker-Checker, above
// threshold = 6-Eyes -- one `required_eyes` computed from
// `amount_cents`, reusing Module 1's n-eyes primitive rather than two
// separate code paths). `reference` carries the settlement reference
// Module 7's bank-feed matcher looks up by exact string match.

struct TradePayment {
    id: i64,
    purchase_order_id: i64,
    payment_type: str,
    amount_cents: i64,
    currency: str,
    reference: str,
    status: str,
}

fn list_trade_payment_inner(conn: db) -> Result(json, str) {
    let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS trade_payment (id INTEGER PRIMARY KEY AUTOINCREMENT, purchase_order_id INTEGER, payment_type TEXT, amount_cents INTEGER, currency TEXT, reference TEXT, status TEXT)") { Ok(n) => n, Err(e) => -1 }
    let rows: Result(json, str) = db_query(conn, "SELECT id, purchase_order_id, payment_type, amount_cents, currency, reference, status FROM trade_payment ORDER BY id DESC")
    stop conn
    return rows
}

fn list_trade_payment() -> Result(json, str) {
    return match db_connect("trade_finance.db") {
        Ok(conn) => list_trade_payment_inner(conn),
        Err(e) => Err(e),
    }
}

// A high-value threshold: at/above $50,000 (5,000,000 cents) a trade
// payment is 6-Eyes; below it, Maker-Checker -- a plain deterministic
// rule function, matching the doc's own "configurable per-tenant"
// intent with a fixed illustrative cutoff (no per-tenant config store
// exists yet -- see todo.md's multi-tenant gap).
fn required_eyes_for_amount(amount_cents: i64) -> i64 {
    return if amount_cents >= 5000000 { 2 } else { 1 }
}

// This module's marquee governance wiring: `submit_trade_payment` opens
// an n-eyes request sized by value; `post_trade_payment` only actually
// creates the `TradePayment` row -- and runs the real commission
// waterfall below -- once `list_approval` shows that request APPROVED.
fn submit_trade_payment(identity: VerifiedIdentity, purchase_order_id: i64, amount_cents: i64, justification: str) -> Result(i64, str) {
    return submit_approval(identity, "trade_payment", "TRADE_PAYMENT", required_eyes_for_amount(amount_cents), 24, justification)
}

fn post_trade_payment_inner(conn: db, request_id: i64, purchase_order_id: i64, payment_type: str, amount_cents: i64, currency: str, reference: str) -> Result(i64, str) {
    let status: str = match db_query(conn, "SELECT status as value FROM approval_request WHERE id = ?", request_id) {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_str(row, "value") { Ok(v) => v, Err(e) => "MISSING" },
            Err(e) => "MISSING",
        },
        Err(e) => "MISSING",
    }
    return if status != "APPROVED" {
        stop conn
        Err("trade payment is not yet fully approved")
    } else {
        let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS trade_payment (id INTEGER PRIMARY KEY AUTOINCREMENT, purchase_order_id INTEGER, payment_type TEXT, amount_cents INTEGER, currency TEXT, reference TEXT, status TEXT)") { Ok(n) => n, Err(e) => -1 }
        let inserted: i64 = match db_execute(conn, "INSERT INTO trade_payment (purchase_order_id, payment_type, amount_cents, currency, reference, status) VALUES (?, ?, ?, ?, ?, 'posted')", purchase_order_id, payment_type, amount_cents, currency, reference) {
            Ok(n) => n,
            Err(e) => -1,
        }
        let payment_id: i64 = match db_query(conn, "SELECT last_insert_rowid() as value") {
            Ok(rows) => match json_array_get(rows, 0) {
                Ok(row) => match json_get_i64(row, "value") { Ok(v) => v, Err(e) => -1 },
                Err(e) => -1,
            },
            Err(e) => -1,
        }
        stop conn
        let waterfall: i64 = if payment_id >= 0 { run_commission_waterfall(payment_id, amount_cents) } else { -1 }
        if payment_id >= 0 { Ok(payment_id) } else { Err("failed to post trade payment") }
    }
}

fn post_trade_payment(request_id: i64, purchase_order_id: i64, payment_type: str, amount_cents: i64, currency: str, reference: str) -> Result(i64, str) {
    return match db_connect("trade_finance.db") {
        Ok(conn) => post_trade_payment_inner(conn, request_id, purchase_order_id, payment_type, amount_cents, currency, reference),
        Err(e) => Err(e),
    }
}

// Bulk/batch payment run: a fixed 3-line batch (Nirdosha has no array
// parameter type -- a real, disclosed simplification of "N line items",
// same class of gap as every other fixed-arity stand-in for a dynamic
// list in this build). The real requirement this proves is the
// *aggregate*-value governance routing: even if every individual line
// is below the 6-Eyes threshold, the summed batch total drives
// `required_eyes_for_amount`, not any one line on its own.
fn submit_batch_payment(identity: VerifiedIdentity, amount_a_cents: i64, amount_b_cents: i64, amount_c_cents: i64, justification: str) -> Result(i64, str) {
    let aggregate: i64 = amount_a_cents + amount_b_cents + amount_c_cents
    return submit_approval(identity, "batch_trade_payment", "TRADE_PAYMENT", required_eyes_for_amount(aggregate), 24, justification)
}

fn post_batch_payment_inner(conn: db, request_id: i64, purchase_order_id_a: i64, amount_a_cents: i64, purchase_order_id_b: i64, amount_b_cents: i64, purchase_order_id_c: i64, amount_c_cents: i64, currency: str) -> Result(i64, str) {
    let status: str = match db_query(conn, "SELECT status as value FROM approval_request WHERE id = ?", request_id) {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_str(row, "value") { Ok(v) => v, Err(e) => "MISSING" },
            Err(e) => "MISSING",
        },
        Err(e) => "MISSING",
    }
    return if status != "APPROVED" {
        stop conn
        Err("batch payment is not yet fully approved")
    } else {
        let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS trade_payment (id INTEGER PRIMARY KEY AUTOINCREMENT, purchase_order_id INTEGER, payment_type TEXT, amount_cents INTEGER, currency TEXT, reference TEXT, status TEXT)") { Ok(n) => n, Err(e) => -1 }
        let ins_a: i64 = match db_execute(conn, "INSERT INTO trade_payment (purchase_order_id, payment_type, amount_cents, currency, reference, status) VALUES (?, 'batch_line', ?, ?, 'batch', 'posted')", purchase_order_id_a, amount_a_cents, currency) { Ok(n) => n, Err(e) => -1 }
        let ins_b: i64 = match db_execute(conn, "INSERT INTO trade_payment (purchase_order_id, payment_type, amount_cents, currency, reference, status) VALUES (?, 'batch_line', ?, ?, 'batch', 'posted')", purchase_order_id_b, amount_b_cents, currency) { Ok(n) => n, Err(e) => -1 }
        let ins_c: i64 = match db_execute(conn, "INSERT INTO trade_payment (purchase_order_id, payment_type, amount_cents, currency, reference, status) VALUES (?, 'batch_line', ?, ?, 'batch', 'posted')", purchase_order_id_c, amount_c_cents, currency) { Ok(n) => n, Err(e) => -1 }
        stop conn
        if ins_a >= 0 && ins_b >= 0 && ins_c >= 0 { Ok(ins_a) } else { Err("failed to post one or more batch payment lines") }
    }
}

fn post_batch_payment(request_id: i64, purchase_order_id_a: i64, amount_a_cents: i64, purchase_order_id_b: i64, amount_b_cents: i64, purchase_order_id_c: i64, amount_c_cents: i64, currency: str) -> Result(i64, str) {
    return match db_connect("trade_finance.db") {
        Ok(conn) => post_batch_payment_inner(conn, request_id, purchase_order_id_a, amount_a_cents, purchase_order_id_b, amount_b_cents, purchase_order_id_c, amount_c_cents, currency),
        Err(e) => Err(e),
    }
}

// Milestone/escrow tranche release -- 6-Eyes per the doc's table, and
// cross-checked against Module 6's `DeliveryDispute` (a real query/
// gate, not documented intent): an open dispute on the underlying
// purchase order blocks the release outright, before governance is
// even consulted.
fn submit_milestone_release(identity: VerifiedIdentity, purchase_order_id: i64, tranche_amount_cents: i64, justification: str) -> Result(i64, str) {
    return if has_open_dispute(purchase_order_id) {
        Err("milestone release blocked: open delivery dispute on this purchase order")
    } else {
        submit_approval(identity, "milestone_release", "SIX_EYES", 2, 8, justification)
    }
}

fn post_milestone_release_inner(conn: db, request_id: i64, purchase_order_id: i64, tranche_amount_cents: i64, currency: str, reference: str) -> Result(i64, str) {
    let status: str = match db_query(conn, "SELECT status as value FROM approval_request WHERE id = ?", request_id) {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_str(row, "value") { Ok(v) => v, Err(e) => "MISSING" },
            Err(e) => "MISSING",
        },
        Err(e) => "MISSING",
    }
    return if status != "APPROVED" {
        stop conn
        Err("milestone release is not yet fully 6-Eyes approved")
    } else {
        let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS trade_payment (id INTEGER PRIMARY KEY AUTOINCREMENT, purchase_order_id INTEGER, payment_type TEXT, amount_cents INTEGER, currency TEXT, reference TEXT, status TEXT)") { Ok(n) => n, Err(e) => -1 }
        let inserted: i64 = match db_execute(conn, "INSERT INTO trade_payment (purchase_order_id, payment_type, amount_cents, currency, reference, status) VALUES (?, 'milestone', ?, ?, ?, 'posted')", purchase_order_id, tranche_amount_cents, currency, reference) {
            Ok(n) => n,
            Err(e) => -1,
        }
        let payment_id: i64 = match db_query(conn, "SELECT last_insert_rowid() as value") {
            Ok(rows) => match json_array_get(rows, 0) {
                Ok(row) => match json_get_i64(row, "value") { Ok(v) => v, Err(e) => -1 },
                Err(e) => -1,
            },
            Err(e) => -1,
        }
        stop conn
        let waterfall: i64 = if payment_id >= 0 { run_commission_waterfall(payment_id, tranche_amount_cents) } else { -1 }
        if payment_id >= 0 { Ok(payment_id) } else { Err("failed to post milestone release") }
    }
}

fn post_milestone_release(request_id: i64, purchase_order_id: i64, tranche_amount_cents: i64, currency: str, reference: str) -> Result(i64, str) {
    return match db_connect("trade_finance.db") {
        Ok(conn) => post_milestone_release_inner(conn, request_id, purchase_order_id, tranche_amount_cents, currency, reference),
        Err(e) => Err(e),
    }
}

// ---- commission waterfall: platform fee, then override cascade -----
//
// `CommissionRule` is versioned by row, not mutated in place: a rate
// change inserts a new row and marks the old one `superseded`, so a
// historical `CommissionWaterfallEntry` always keeps the rate that
// actually applied when it was computed (`rate_bps` is copied onto the
// entry itself), never "whatever the current rate happens to be" --
// exactly the doc's own requirement.

struct CommissionRule {
    id: i64,
    tier_name: str,
    rate_bps: i64,
    status: str,
}

struct CommissionWaterfallEntry {
    id: i64,
    trade_payment_id: i64,
    tier_name: str,
    rate_bps: i64,
    amount_cents: i64,
    partner_wallet_id: i64,
}

struct PartnerWallet {
    id: i64,
    partner_name: str,
    tier_name: str,
    balance_cents: i64,
    status: str,
}

fn list_commission_rule_inner(conn: db) -> Result(json, str) {
    let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS commission_rule (id INTEGER PRIMARY KEY AUTOINCREMENT, tier_name TEXT, rate_bps INTEGER, status TEXT)") { Ok(n) => n, Err(e) => -1 }
    let rows: Result(json, str) = db_query(conn, "SELECT id, tier_name, rate_bps, status FROM commission_rule ORDER BY id DESC")
    stop conn
    return rows
}

fn list_commission_rule() -> Result(json, str) {
    return match db_connect("trade_finance.db") {
        Ok(conn) => list_commission_rule_inner(conn),
        Err(e) => Err(e),
    }
}

// Configuring a commission rate is Maker-Checker per the doc's table --
// plain callable here (same disclosed scoping as every other module's
// non-marquee action); real versioning still happens: the previous
// active rule for this tier is superseded, not overwritten.
fn create_commission_rule_inner(conn: db, tier_name: str, rate_bps: i64) -> Result(i64, str) {
    let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS commission_rule (id INTEGER PRIMARY KEY AUTOINCREMENT, tier_name TEXT, rate_bps INTEGER, status TEXT)") { Ok(n) => n, Err(e) => -1 }
    let superseded: i64 = match db_execute(conn, "UPDATE commission_rule SET status = 'superseded' WHERE tier_name = ? AND status = 'active'", tier_name) { Ok(n) => n, Err(e) => -1 }
    let inserted: i64 = match db_execute(conn, "INSERT INTO commission_rule (tier_name, rate_bps, status) VALUES (?, ?, 'active')", tier_name, rate_bps) {
        Ok(n) => n,
        Err(e) => -1,
    }
    stop conn
    return if inserted >= 0 { Ok(inserted) } else { Err("failed to create commission rule") }
}

fn create_commission_rule(tier_name: str, rate_bps: i64) -> Result(i64, str) requires(role: "compliance_officer") {
    return match db_connect("trade_finance.db") {
        Ok(conn) => create_commission_rule_inner(conn, tier_name, rate_bps),
        Err(e) => Err(e),
    }
}

// One representative fixed canonical partner per cascade tier stands in
// for "however many real channel partners a tenant has" -- the real
// mechanic proven here is the waterfall math and the atomic wallet
// credit, not partner-directory management (which the doc doesn't
// actually describe as this module's own scope either).
//
// The rate/wallet-id lookups are inlined here rather than factored into
// their own `conn: db`-taking helpers (as an earlier version of this
// function had them) -- `db` is affine with no borrowing (see
// finish_with_audit's own doc comment above), so a helper that takes
// `conn` and doesn't hand it back can only ever be a function's *last*
// use of it; this function needs `conn` again for the wallet-credit
// UPDATE afterward, so the queries have to happen inline instead.
fn credit_wallet_tier_inner(conn: db, trade_payment_id: i64, tier_name: str, amount_cents: i64) -> i64 {
    let rate_bps: i64 = match db_query(conn, "SELECT rate_bps as value FROM commission_rule WHERE tier_name = ? AND status = 'active'", tier_name) {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_i64(row, "value") { Ok(v) => v, Err(e) => 0 },
            Err(e) => 0,
        },
        Err(e) => 0,
    }
    let tier_amount_cents: i64 = (amount_cents * rate_bps) / 10000
    let wallet_id: i64 = match db_query(conn, "SELECT id as value FROM partner_wallet WHERE tier_name = ?", tier_name) {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_i64(row, "value") { Ok(v) => v, Err(e) => -1 },
            Err(e) => -1,
        },
        Err(e) => -1,
    }
    let entry_inserted: i64 = match db_execute(conn, "INSERT INTO commission_waterfall_entry (trade_payment_id, tier_name, rate_bps, amount_cents, partner_wallet_id) VALUES (?, ?, ?, ?, ?)", trade_payment_id, tier_name, rate_bps, tier_amount_cents, wallet_id) {
        Ok(n) => n,
        Err(e) => -1,
    }
    let credited: i64 = if wallet_id >= 0 {
        match db_execute(conn, "UPDATE partner_wallet SET balance_cents = balance_cents + ? WHERE id = ?", tier_amount_cents, wallet_id) {
            Ok(n) => n,
            Err(e) => -1,
        }
    } else {
        -1
    }
    stop conn
    return entry_inserted
}

// `conn: db` is affine with no borrowing (finish_with_audit's doc
// comment above), and `run_commission_waterfall_inner` needs to call
// this once per cascade tier -- so, unlike the seed/table-creation work
// it shares one `conn` for, each tier's credit opens and closes its own
// connection rather than threading a single moved-once handle through
// four sequential calls.
fn credit_wallet_tier(trade_payment_id: i64, tier_name: str, amount_cents: i64) -> i64 {
    return match db_connect("trade_finance.db") {
        Ok(conn) => credit_wallet_tier_inner(conn, trade_payment_id, tier_name, amount_cents),
        Err(e) => -1,
    }
}

// The doc's central Mi-Pay-style mechanic, done for real: platform
// origination fee first, then override commissions cascading
// Super-Distributor -> Regional Distributor -> Originating Agent, each
// against its own versioned rate, each credited to its `PartnerWallet`
// atomically (same transaction as the waterfall entry, zero drift
// tolerance per the doc). Seeds the four canonical wallets on first use
// so a fresh `trade_finance.db` has somewhere for credits to land.
fn run_commission_waterfall_inner(conn: db, trade_payment_id: i64, amount_cents: i64) -> i64 {
    let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS commission_rule (id INTEGER PRIMARY KEY AUTOINCREMENT, tier_name TEXT, rate_bps INTEGER, status TEXT)") { Ok(n) => n, Err(e) => -1 }
    let t2: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS commission_waterfall_entry (id INTEGER PRIMARY KEY AUTOINCREMENT, trade_payment_id INTEGER, tier_name TEXT, rate_bps INTEGER, amount_cents INTEGER, partner_wallet_id INTEGER)") { Ok(n) => n, Err(e) => -1 }
    let t3: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS partner_wallet (id INTEGER PRIMARY KEY AUTOINCREMENT, partner_name TEXT, tier_name TEXT, balance_cents INTEGER, status TEXT)") { Ok(n) => n, Err(e) => -1 }

    let seed_platform: i64 = match db_execute(conn, "INSERT INTO partner_wallet (partner_name, tier_name, balance_cents, status) SELECT 'Platform', 'platform', 0, 'active' WHERE NOT EXISTS (SELECT 1 FROM partner_wallet WHERE tier_name = 'platform')") { Ok(n) => n, Err(e) => -1 }
    let seed_super: i64 = match db_execute(conn, "INSERT INTO partner_wallet (partner_name, tier_name, balance_cents, status) SELECT 'Apex Super-Distributor', 'super_distributor', 0, 'active' WHERE NOT EXISTS (SELECT 1 FROM partner_wallet WHERE tier_name = 'super_distributor')") { Ok(n) => n, Err(e) => -1 }
    let seed_regional: i64 = match db_execute(conn, "INSERT INTO partner_wallet (partner_name, tier_name, balance_cents, status) SELECT 'Meridian Regional Distributor', 'regional_distributor', 0, 'active' WHERE NOT EXISTS (SELECT 1 FROM partner_wallet WHERE tier_name = 'regional_distributor')") { Ok(n) => n, Err(e) => -1 }
    let seed_agent: i64 = match db_execute(conn, "INSERT INTO partner_wallet (partner_name, tier_name, balance_cents, status) SELECT 'Originating Agent Co', 'originating_agent', 0, 'active' WHERE NOT EXISTS (SELECT 1 FROM partner_wallet WHERE tier_name = 'originating_agent')") { Ok(n) => n, Err(e) => -1 }

    let seed_rule_platform: i64 = match db_execute(conn, "INSERT INTO commission_rule (tier_name, rate_bps, status) SELECT 'platform', 50, 'active' WHERE NOT EXISTS (SELECT 1 FROM commission_rule WHERE tier_name = 'platform')") { Ok(n) => n, Err(e) => -1 }
    let seed_rule_super: i64 = match db_execute(conn, "INSERT INTO commission_rule (tier_name, rate_bps, status) SELECT 'super_distributor', 30, 'active' WHERE NOT EXISTS (SELECT 1 FROM commission_rule WHERE tier_name = 'super_distributor')") { Ok(n) => n, Err(e) => -1 }
    let seed_rule_regional: i64 = match db_execute(conn, "INSERT INTO commission_rule (tier_name, rate_bps, status) SELECT 'regional_distributor', 20, 'active' WHERE NOT EXISTS (SELECT 1 FROM commission_rule WHERE tier_name = 'regional_distributor')") { Ok(n) => n, Err(e) => -1 }
    let seed_rule_agent: i64 = match db_execute(conn, "INSERT INTO commission_rule (tier_name, rate_bps, status) SELECT 'originating_agent', 15, 'active' WHERE NOT EXISTS (SELECT 1 FROM commission_rule WHERE tier_name = 'originating_agent')") { Ok(n) => n, Err(e) => -1 }

    stop conn
    let c1: i64 = credit_wallet_tier(trade_payment_id, "platform", amount_cents)
    let c2: i64 = credit_wallet_tier(trade_payment_id, "super_distributor", amount_cents)
    let c3: i64 = credit_wallet_tier(trade_payment_id, "regional_distributor", amount_cents)
    let c4: i64 = credit_wallet_tier(trade_payment_id, "originating_agent", amount_cents)
    return c4
}

fn run_commission_waterfall(trade_payment_id: i64, amount_cents: i64) -> i64 {
    return match db_connect("trade_finance.db") {
        Ok(conn) => run_commission_waterfall_inner(conn, trade_payment_id, amount_cents),
        Err(e) => -1,
    }
}

fn list_commission_waterfall_inner(conn: db) -> Result(json, str) {
    let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS commission_waterfall_entry (id INTEGER PRIMARY KEY AUTOINCREMENT, trade_payment_id INTEGER, tier_name TEXT, rate_bps INTEGER, amount_cents INTEGER, partner_wallet_id INTEGER)") { Ok(n) => n, Err(e) => -1 }
    let rows: Result(json, str) = db_query(conn, "SELECT id, trade_payment_id, tier_name, rate_bps, amount_cents, partner_wallet_id FROM commission_waterfall_entry ORDER BY id DESC")
    stop conn
    return rows
}

fn list_commission_waterfall() -> Result(json, str) {
    return match db_connect("trade_finance.db") {
        Ok(conn) => list_commission_waterfall_inner(conn),
        Err(e) => Err(e),
    }
}

fn list_partner_wallet_inner(conn: db) -> Result(json, str) {
    let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS partner_wallet (id INTEGER PRIMARY KEY AUTOINCREMENT, partner_name TEXT, tier_name TEXT, balance_cents INTEGER, status TEXT)") { Ok(n) => n, Err(e) => -1 }
    let rows: Result(json, str) = db_query(conn, "SELECT id, partner_name, tier_name, balance_cents, status FROM partner_wallet ORDER BY id DESC")
    stop conn
    return rows
}

fn list_partner_wallet() -> Result(json, str) {
    return match db_connect("trade_finance.db") {
        Ok(conn) => list_partner_wallet_inner(conn),
        Err(e) => Err(e),
    }
}

// Wallet withdrawal above a fixed minimum ($100) is Maker-Checker per
// the doc's table; below it, no gating. `apply_wallet_withdrawal` does
// the real debit, checking sufficient balance -- a real check, not
// assumed.
fn apply_wallet_withdrawal_inner(conn: db, partner_wallet_id: i64, amount_cents: i64) -> Result(i64, str) {
    let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS partner_wallet (id INTEGER PRIMARY KEY AUTOINCREMENT, partner_name TEXT, tier_name TEXT, balance_cents INTEGER, status TEXT)") { Ok(n) => n, Err(e) => -1 }
    let balance_cents: i64 = match db_query(conn, "SELECT balance_cents as value FROM partner_wallet WHERE id = ?", partner_wallet_id) {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_i64(row, "value") { Ok(v) => v, Err(e) => -1 },
            Err(e) => -1,
        },
        Err(e) => -1,
    }
    return if amount_cents > balance_cents {
        stop conn
        Err("insufficient wallet balance for withdrawal")
    } else {
        let result: Result(i64, str) = db_execute(conn, "UPDATE partner_wallet SET balance_cents = balance_cents - ? WHERE id = ?", amount_cents, partner_wallet_id)
        stop conn
        result
    }
}

fn apply_wallet_withdrawal(partner_wallet_id: i64, amount_cents: i64) -> Result(i64, str) {
    return match db_connect("trade_finance.db") {
        Ok(conn) => apply_wallet_withdrawal_inner(conn, partner_wallet_id, amount_cents),
        Err(e) => Err(e),
    }
}

fn create_wallet_withdrawal(identity: VerifiedIdentity, partner_wallet_id: i64, amount_cents: i64) -> Result(i64, str) {
    return if amount_cents < 10000 {
        apply_wallet_withdrawal(partner_wallet_id, amount_cents)
    } else {
        submit_approval(identity, "wallet_withdrawal", "TRADE_PAYMENT", 1, 24, "withdrawal above minimum, requires Maker-Checker")
    }
}

// ---- commission dispute/adjustment: 6-Eyes, full original-vs-adjusted
// audit trail -----------------------------------------------------

struct CommissionDispute {
    id: i64,
    commission_waterfall_entry_id: i64,
    original_amount_cents: i64,
    adjusted_amount_cents: i64,
    justification: str,
    status: str,
}

fn list_commission_dispute_inner(conn: db) -> Result(json, str) {
    let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS commission_dispute (id INTEGER PRIMARY KEY AUTOINCREMENT, commission_waterfall_entry_id INTEGER, original_amount_cents INTEGER, adjusted_amount_cents INTEGER, justification TEXT, status TEXT)") { Ok(n) => n, Err(e) => -1 }
    let rows: Result(json, str) = db_query(conn, "SELECT id, commission_waterfall_entry_id, original_amount_cents, adjusted_amount_cents, justification, status FROM commission_dispute ORDER BY id DESC")
    stop conn
    return rows
}

fn list_commission_dispute() -> Result(json, str) {
    return match db_connect("trade_finance.db") {
        Ok(conn) => list_commission_dispute_inner(conn),
        Err(e) => Err(e),
    }
}

fn create_commission_dispute_inner(conn: db, identity: VerifiedIdentity, commission_waterfall_entry_id: i64, adjusted_amount_cents: i64, justification: str) -> Result(i64, str) {
    let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS commission_dispute (id INTEGER PRIMARY KEY AUTOINCREMENT, commission_waterfall_entry_id INTEGER, original_amount_cents INTEGER, adjusted_amount_cents INTEGER, justification TEXT, status TEXT)") { Ok(n) => n, Err(e) => -1 }
    let t2: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS commission_waterfall_entry (id INTEGER PRIMARY KEY AUTOINCREMENT, trade_payment_id INTEGER, tier_name TEXT, rate_bps INTEGER, amount_cents INTEGER, partner_wallet_id INTEGER)") { Ok(n) => n, Err(e) => -1 }
    let original_amount_cents: i64 = match db_query(conn, "SELECT amount_cents as value FROM commission_waterfall_entry WHERE id = ?", commission_waterfall_entry_id) {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_i64(row, "value") { Ok(v) => v, Err(e) => -1 },
            Err(e) => -1,
        },
        Err(e) => -1,
    }
    let inserted: i64 = match db_execute(conn, "INSERT INTO commission_dispute (commission_waterfall_entry_id, original_amount_cents, adjusted_amount_cents, justification, status) VALUES (?, ?, ?, ?, 'pending')", commission_waterfall_entry_id, original_amount_cents, adjusted_amount_cents, justification) {
        Ok(n) => n,
        Err(e) => -1,
    }
    stop conn
    return if inserted >= 0 { Ok(inserted) } else { Err("failed to record commission dispute") }
}

// Disputing/adjusting a commission is 6-Eyes per the doc's table.
fn create_commission_dispute(identity: VerifiedIdentity, commission_waterfall_entry_id: i64, adjusted_amount_cents: i64, justification: str) -> Result(i64, str) {
    return match db_connect("trade_finance.db") {
        Ok(conn) => create_commission_dispute_inner(conn, identity, commission_waterfall_entry_id, adjusted_amount_cents, justification),
        Err(e) => Err(e),
    }
}

fn submit_commission_dispute_approval(identity: VerifiedIdentity, commission_dispute_id: i64, justification: str) -> Result(i64, str) {
    return submit_approval(identity, "commission_dispute_adjustment", "SIX_EYES", 2, 8, justification)
}

// Applies the adjustment once 6-Eyes-approved: updates the waterfall
// entry's stored amount, moves the delta on the partner's wallet, and
// leaves the original amount on the `CommissionDispute` row itself as
// the permanent original-vs-adjusted audit trail.
fn update_commission_dispute_inner(conn: db, request_id: i64, commission_dispute_id: i64) -> Result(i64, str) {
    let status: str = match db_query(conn, "SELECT status as value FROM approval_request WHERE id = ?", request_id) {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_str(row, "value") { Ok(v) => v, Err(e) => "MISSING" },
            Err(e) => "MISSING",
        },
        Err(e) => "MISSING",
    }
    return if status != "APPROVED" {
        stop conn
        Err("commission dispute adjustment is not yet fully 6-Eyes approved")
    } else {
        let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS commission_dispute (id INTEGER PRIMARY KEY AUTOINCREMENT, commission_waterfall_entry_id INTEGER, original_amount_cents INTEGER, adjusted_amount_cents INTEGER, justification TEXT, status TEXT)") { Ok(n) => n, Err(e) => -1 }
        let entry_id: i64 = match db_query(conn, "SELECT commission_waterfall_entry_id as value FROM commission_dispute WHERE id = ?", commission_dispute_id) {
            Ok(rows) => match json_array_get(rows, 0) {
                Ok(row) => match json_get_i64(row, "value") { Ok(v) => v, Err(e) => -1 },
                Err(e) => -1,
            },
            Err(e) => -1,
        }
        let original_amount_cents: i64 = match db_query(conn, "SELECT original_amount_cents as value FROM commission_dispute WHERE id = ?", commission_dispute_id) {
            Ok(rows) => match json_array_get(rows, 0) {
                Ok(row) => match json_get_i64(row, "value") { Ok(v) => v, Err(e) => 0 },
                Err(e) => 0,
            },
            Err(e) => 0,
        }
        let adjusted_amount_cents: i64 = match db_query(conn, "SELECT adjusted_amount_cents as value FROM commission_dispute WHERE id = ?", commission_dispute_id) {
            Ok(rows) => match json_array_get(rows, 0) {
                Ok(row) => match json_get_i64(row, "value") { Ok(v) => v, Err(e) => 0 },
                Err(e) => 0,
            },
            Err(e) => 0,
        }
        let delta_cents: i64 = adjusted_amount_cents - original_amount_cents
        let wallet_id: i64 = match db_query(conn, "SELECT partner_wallet_id as value FROM commission_waterfall_entry WHERE id = ?", entry_id) {
            Ok(rows) => match json_array_get(rows, 0) {
                Ok(row) => match json_get_i64(row, "value") { Ok(v) => v, Err(e) => -1 },
                Err(e) => -1,
            },
            Err(e) => -1,
        }
        let entry_updated: i64 = match db_execute(conn, "UPDATE commission_waterfall_entry SET amount_cents = ? WHERE id = ?", adjusted_amount_cents, entry_id) { Ok(n) => n, Err(e) => -1 }
        let wallet_updated: i64 = match db_execute(conn, "UPDATE partner_wallet SET balance_cents = balance_cents + ? WHERE id = ?", delta_cents, wallet_id) { Ok(n) => n, Err(e) => -1 }
        let dispute_updated: Result(i64, str) = db_execute(conn, "UPDATE commission_dispute SET status = 'applied' WHERE id = ?", commission_dispute_id)
        stop conn
        dispute_updated
    }
}

fn update_commission_dispute(request_id: i64, commission_dispute_id: i64) -> Result(i64, str) {
    return match db_connect("trade_finance.db") {
        Ok(conn) => update_commission_dispute_inner(conn, request_id, commission_dispute_id),
        Err(e) => Err(e),
    }
}

// ---- dashboard --------------------------------------------------------

fn stat_total_commissions_paid_cents_inner(conn: db) -> i64 {
    let result: i64 = match db_query(conn, "SELECT COALESCE(SUM(amount_cents), 0) as value FROM commission_waterfall_entry") {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_i64(row, "value") { Ok(v) => v, Err(e) => 0 },
            Err(e) => 0,
        },
        Err(e) => 0,
    }
    stop conn
    return result
}

fn stat_total_commissions_paid_cents() -> i64 {
    return match db_connect("trade_finance.db") {
        Ok(conn) => stat_total_commissions_paid_cents_inner(conn),
        Err(e) => 0,
    }
}

fn chart_waterfall_by_tier_inner(conn: db) -> Result(json, str) {
    let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS commission_waterfall_entry (id INTEGER PRIMARY KEY AUTOINCREMENT, trade_payment_id INTEGER, tier_name TEXT, rate_bps INTEGER, amount_cents INTEGER, partner_wallet_id INTEGER)") { Ok(n) => n, Err(e) => -1 }
    let rows: Result(json, str) = db_query(conn, "SELECT tier_name as label, COALESCE(SUM(amount_cents), 0) as value FROM commission_waterfall_entry GROUP BY tier_name ORDER BY value DESC")
    stop conn
    return rows
}

fn chart_waterfall_by_tier() -> Result(json, str) {
    return match db_connect("trade_finance.db") {
        Ok(conn) => chart_waterfall_by_tier_inner(conn),
        Err(e) => Err(e),
    }
}

fn main() {}
