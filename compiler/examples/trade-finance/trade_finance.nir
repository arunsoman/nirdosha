struct VirtualIban {
    id: i64,
    buyer_counterparty_id: i64,
    seller_counterparty_id: i64,
    iban_number: str,
    partner_bank_note: str,
    status: str,
}

fn list_virtual_iban_inner(conn: db) -> Result(json, ErrorCode) {
    let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS virtual_iban (id INTEGER PRIMARY KEY AUTOINCREMENT, buyer_counterparty_id INTEGER, seller_counterparty_id INTEGER, iban_number TEXT, partner_bank_note TEXT, status TEXT)") { Ok(n) => n, Err(e) => -1 }
    let rows: Result(json, str) = db_query(conn, "SELECT id, buyer_counterparty_id, seller_counterparty_id, iban_number, partner_bank_note, status FROM virtual_iban ORDER BY id DESC")
    stop conn
    return match rows { Ok(v) => Ok(v), Err(e) => Err(DbError()) }
}

