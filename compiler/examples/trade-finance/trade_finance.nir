// =========================================================================
// Module 9: Integration, Analytics & External Reporting
// =========================================================================
module "Module 9: Integration, Analytics & External Reporting" {
//
// Exposes the platform to the outside world and turns Modules 1-8's
// operational data into dashboards and regulator-ready exports.
// `ApiKey`/`WebhookSubscription` are real, queryable records (governance
// tier documented, plain callable -- same per-module scoping every
// earlier module uses) but nothing is actually dispatched
// (`[SUBSTITUTED]`: no outbound HTTP delivery loop, no separate
// gateway/sandbox process -- `nirdosha serve`'s own endpoints already are
// the API). This module's marquee governance wiring is the regulatory
// export trigger (6-Eyes per the doc's table, the one action explicitly
// called out as high-risk). `mock_basel_extract`/`mock_aml_export` return
// a real *computed* SQL aggregate (`Result(i64, ErrorCode)`, not a literal
// stub) rather than a hand-built JSON blob: Nirdosha has no i64->str
// cast (LANGUAGE.md §3), so a dynamic number can never be spliced into a
// JSON string literal -- the same constraint every other module in this
// file works around by returning a plain number or persisting to a
// `list_`-able table instead.

struct ApiKey {
    id: i64,
    partner_name: str,
    scope: str,
    rate_limit_per_min: i64,
    status: str,
}

fn list_api_key_inner(conn: db) -> Result(json, ErrorCode) {
    let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS api_key (id INTEGER PRIMARY KEY AUTOINCREMENT, partner_name TEXT, scope TEXT, rate_limit_per_min INTEGER, status TEXT)") { Ok(n) => n, Err(e) => -1 }
    let rows: Result(json, str) = db_query(conn, "SELECT id, partner_name, scope, rate_limit_per_min, status FROM api_key ORDER BY id DESC")
    stop conn
    return match rows { Ok(v) => Ok(v), Err(e) => Err(DbError()) }
}

fn list_api_key() -> Result(json, ErrorCode) requires(role: "system_admin") {
    return match db_connect("trade_finance.db") {
        Ok(conn) => list_api_key_inner(conn),
        Err(e) => Err(DbError()),
    }
}

// Generating a partner API key is Maker-Checker per the doc's table --
// plain callable, same disclosed scoping as this module's other
// non-marquee actions.
fn create_api_key_inner(conn: db, partner_name: Text, scope: Text, rate_limit_per_min: i64) -> Result(i64, ErrorCode) {
    let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS api_key (id INTEGER PRIMARY KEY AUTOINCREMENT, partner_name TEXT, scope TEXT, rate_limit_per_min INTEGER, status TEXT)") { Ok(n) => n, Err(e) => -1 }
    let inserted: i64 = match db_execute(conn, "INSERT INTO api_key (partner_name, scope, rate_limit_per_min, status) VALUES (?, ?, ?, 'active')", partner_name.value, scope.value, rate_limit_per_min) {
        Ok(n) => n,
        Err(e) => -1,
    }
    stop conn
    return if inserted >= 0 { Ok(inserted) } else { Err(FailedToGenerateApiKey()) }
}

fn create_api_key(partner_name: Text, scope: Text, rate_limit_per_min: i64) -> Result(i64, ErrorCode) {
    return match db_connect("trade_finance.db") {
        Ok(conn) => create_api_key_inner(conn, partner_name, scope, rate_limit_per_min),
        Err(e) => Err(DbError()),
    }
}

// Revoking an API key is Maker-Checker per the doc's table.
fn delete_api_key_inner(conn: db, api_key_id: i64) -> Result(i64, ErrorCode) {
    let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS api_key (id INTEGER PRIMARY KEY AUTOINCREMENT, partner_name TEXT, scope TEXT, rate_limit_per_min INTEGER, status TEXT)") { Ok(n) => n, Err(e) => -1 }
    let result: Result(i64, str) = db_execute(conn, "UPDATE api_key SET status = 'revoked' WHERE id = ?", api_key_id)
    stop conn
    return match result { Ok(v) => Ok(v), Err(e) => Err(DbError()) }
}

fn delete_api_key(api_key_id: i64) -> Result(i64, ErrorCode) {
    return match db_connect("trade_finance.db") {
        Ok(conn) => delete_api_key_inner(conn, api_key_id),
        Err(e) => Err(DbError()),
    }
}

