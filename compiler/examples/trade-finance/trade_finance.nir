// Seeds a small canonical Chart of Accounts on first use, same
// "INSERT ... SELECT ... WHERE NOT EXISTS" idiom Module 4 already uses to
// seed its four canonical wallets.
fn ensure_default_accounts_inner(conn: db) -> i64 {
    let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS account (id INTEGER PRIMARY KEY AUTOINCREMENT, code TEXT, name TEXT, account_type TEXT, status TEXT)") { Ok(n) => n, Err(e) => -1 }
    let s1: i64 = match db_execute(conn, "INSERT INTO account (code, name, account_type, status) SELECT 'cash', 'Cash', 'Asset', 'active' WHERE NOT EXISTS (SELECT 1 FROM account WHERE code = 'cash')") { Ok(n) => n, Err(e) => -1 }
    let s2: i64 = match db_execute(conn, "INSERT INTO account (code, name, account_type, status) SELECT 'trade_receivable', 'Trade Receivable', 'Asset', 'active' WHERE NOT EXISTS (SELECT 1 FROM account WHERE code = 'trade_receivable')") { Ok(n) => n, Err(e) => -1 }
    let s3: i64 = match db_execute(conn, "INSERT INTO account (code, name, account_type, status) SELECT 'trade_payable', 'Trade Payable', 'Liability', 'active' WHERE NOT EXISTS (SELECT 1 FROM account WHERE code = 'trade_payable')") { Ok(n) => n, Err(e) => -1 }
    let s4: i64 = match db_execute(conn, "INSERT INTO account (code, name, account_type, status) SELECT 'commission_income', 'Commission Income', 'Revenue', 'active' WHERE NOT EXISTS (SELECT 1 FROM account WHERE code = 'commission_income')") { Ok(n) => n, Err(e) => -1 }
    let s5: i64 = match db_execute(conn, "INSERT INTO account (code, name, account_type, status) SELECT 'interest_income', 'Interest Income', 'Revenue', 'active' WHERE NOT EXISTS (SELECT 1 FROM account WHERE code = 'interest_income')") { Ok(n) => n, Err(e) => -1 }
    let s6: i64 = match db_execute(conn, "INSERT INTO account (code, name, account_type, status) SELECT 'interest_receivable', 'Interest Receivable', 'Asset', 'active' WHERE NOT EXISTS (SELECT 1 FROM account WHERE code = 'interest_receivable')") { Ok(n) => n, Err(e) => -1 }
    let s7: i64 = match db_execute(conn, "INSERT INTO account (code, name, account_type, status) SELECT 'commission_expense', 'Commission Expense', 'Expense', 'active' WHERE NOT EXISTS (SELECT 1 FROM account WHERE code = 'commission_expense')") { Ok(n) => n, Err(e) => -1 }
    let s8: i64 = match db_execute(conn, "INSERT INTO account (code, name, account_type, status) SELECT 'contingent_lc_undrawn', 'Contingent: Undrawn LC', 'Contingent', 'active' WHERE NOT EXISTS (SELECT 1 FROM account WHERE code = 'contingent_lc_undrawn')") { Ok(n) => n, Err(e) => -1 }
    stop conn
    return s8
}

// `debit_cents`/`credit_cents` are supplied independently rather than one
// shared `amount_cents` -- this is what makes the structural rejection
// below a real, exercisable check rather than a helper that is always
// trivially balanced. Callers proving an automatic event mapping (a
// trade payment clearing, a commission entry, a milestone release) pass
// the same amount on both sides by construction; the manual-adjustment
// path further down is the one that can actually hand this two different
// numbers.
fn post_journal_entry_inner(conn: db, event_type: JournalEventType, source_module: Text, source_id: i64, debit_account: Text, debit_cents: i64, credit_account: Text, credit_cents: i64) -> Result(i64, ErrorCode) {
    let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS journal_entry (id INTEGER PRIMARY KEY AUTOINCREMENT, event_type TEXT, source_module TEXT, source_id INTEGER, status TEXT)") { Ok(n) => n, Err(e) => -1 }
    let t2: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS journal_line (id INTEGER PRIMARY KEY AUTOINCREMENT, journal_entry_id INTEGER, account_code TEXT, debit_cents INTEGER, credit_cents INTEGER)") { Ok(n) => n, Err(e) => -1 }

    return if debit_cents != credit_cents {
        stop conn
        Err(UnbalancedPostingRejected())
    } else {
        let entry_inserted: i64 = match db_execute(conn, "INSERT INTO journal_entry (event_type, source_module, source_id, status) VALUES (?, ?, ?, 'posted')", event_type, source_module.value, source_id) {
            Ok(n) => n,
            Err(e) => -1,
        }
        let entry_id: i64 = match db_query(conn, "SELECT last_insert_rowid() as value") {
            Ok(rows) => match json_array_get(rows, 0) {
                Ok(row) => match json_get_i64(row, "value") { Ok(v) => v, Err(e) => -1 },
                Err(e) => -1,
            },
            Err(e) => -1,
        }
        let debit_line: i64 = match db_execute(conn, "INSERT INTO journal_line (journal_entry_id, account_code, debit_cents, credit_cents) VALUES (?, ?, ?, 0)", entry_id, debit_account.value, debit_cents) {
            Ok(n) => n,
            Err(e) => -1,
        }
        let credit_line: i64 = match db_execute(conn, "INSERT INTO journal_line (journal_entry_id, account_code, debit_cents, credit_cents) VALUES (?, ?, 0, ?)", entry_id, credit_account.value, credit_cents) {
            Ok(n) => n,
            Err(e) => -1,
        }
        stop conn
        if entry_id >= 0 { Ok(entry_id) } else { Err(FailedToPostJournalEntry()) }
    }
}

fn ensure_default_accounts() -> i64 {
    return match db_connect("trade_finance.db") {
        Ok(conn) => ensure_default_accounts_inner(conn),
        Err(e) => -1,
    }
}

fn post_journal_entry(event_type: JournalEventType, source_module: Text, source_id: i64, debit_account: Text, debit_cents: i64, credit_account: Text, credit_cents: i64) -> Result(i64, ErrorCode) {
    let seeded: i64 = ensure_default_accounts()
    return match db_connect("trade_finance.db") {
        Ok(conn) => post_journal_entry_inner(conn, event_type, source_module, source_id, debit_account, debit_cents, credit_account, credit_cents),
        Err(e) => Err(DbError()),
    }
}

// Manual GL adjustment: below a threshold, Maker-Checker; at/above it,
// 6-Eyes (doc's table) -- reuses Module 4's `required_eyes_for_amount`
// rule rather than re-deriving a second threshold function.
fn submit_manual_journal_entry(identity: VerifiedIdentity, debit_account: Text, debit_cents: i64, credit_account: Text, credit_cents: i64, justification: Text) -> Result(i64, ErrorCode) {
    let bigger: i64 = if debit_cents > credit_cents { debit_cents } else { credit_cents }
    return submit_approval(identity, ActionTypeManualJournalEntry(), ApprovalRiskTierTradePayment(), required_eyes_for_amount(bigger), 24, justification)
}

fn apply_manual_journal_entry_inner(conn: db, request_id: i64, debit_account: Text, debit_cents: i64, credit_account: Text, credit_cents: i64) -> Result(i64, ErrorCode) {
    let status: str = match db_query(conn, "SELECT status as value FROM approval_request WHERE id = ?", request_id) {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_str(row, "value") { Ok(v) => v, Err(e) => "MISSING" },
            Err(e) => "MISSING",
        },
        Err(e) => "MISSING",
    }
    stop conn
    return if status != "APPROVED" {
        Err(ManualJournalEntryIsNotYetFullyApproved())
    } else {
        post_journal_entry(JournalEventTypeManualAdjustment(), Text("module7"), request_id, debit_account, debit_cents, credit_account, credit_cents)
    }
}

fn apply_manual_journal_entry(request_id: i64, debit_account: Text, debit_cents: i64, credit_account: Text, credit_cents: i64) -> Result(i64, ErrorCode) {
    return match db_connect("trade_finance.db") {
        Ok(conn) => apply_manual_journal_entry_inner(conn, request_id, debit_account, debit_cents, credit_account, credit_cents),
        Err(e) => Err(DbError()),
    }
}

// Chart of Accounts structural change is 6-Eyes per the doc's table.
fn submit_create_account(identity: VerifiedIdentity, code: Text, name: Text, account_type: AccountType, justification: Text) -> Result(i64, ErrorCode) {
    return submit_approval(identity, ActionTypeCreateAccount(), ApprovalRiskTierSixEyes(), 2, 8, justification)
}

fn apply_create_account_inner(conn: db, request_id: i64, code: Text, name: Text, account_type: AccountType) -> Result(i64, ErrorCode) {
    let status: str = match db_query(conn, "SELECT status as value FROM approval_request WHERE id = ?", request_id) {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_str(row, "value") { Ok(v) => v, Err(e) => "MISSING" },
            Err(e) => "MISSING",
        },
        Err(e) => "MISSING",
    }
    return if status != "APPROVED" {
        stop conn
        Err(ChartOfAccountsChangeIsNotYetFully6EyesApproved())
    } else {
        let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS account (id INTEGER PRIMARY KEY AUTOINCREMENT, code TEXT, name TEXT, account_type TEXT, status TEXT)") { Ok(n) => n, Err(e) => -1 }
        let inserted: i64 = match db_execute(conn, "INSERT INTO account (code, name, account_type, status) VALUES (?, ?, ?, 'active')", code.value, name.value, account_type) {
            Ok(n) => n,
            Err(e) => -1,
        }
        stop conn
        if inserted >= 0 { Ok(inserted) } else { Err(FailedToCreateAccount()) }
    }
}

fn apply_create_account(request_id: i64, code: Text, name: Text, account_type: AccountType) -> Result(i64, ErrorCode) {
    return match db_connect("trade_finance.db") {
        Ok(conn) => apply_create_account_inner(conn, request_id, code, name, account_type),
        Err(e) => Err(DbError()),
    }
}

// ---- Module 2 credit-limit hold/release: real hold on posting, real
// release on reconciliation match --------------------------------------
//
// `check_credit_hold` (Module 2) only ever read `utilized_cents`; nothing
// previously wrote to it, so a real "instant credit-limit release on
// match" (this module's own requirement) had no hold to release. These
// two functions close that loop: a trade payment posting now increases
// utilization, and a successful reconciliation match here releases it --
// matching the doc's Module 7 bullet exactly ("real call back into
// Module 2's CreditLimit").

fn increase_credit_utilization_inner(conn: db, counterparty_id: i64, amount_cents: i64) -> i64 {
    let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS credit_limit (id INTEGER PRIMARY KEY AUTOINCREMENT, counterparty_id INTEGER, facility_cap_cents INTEGER, utilized_cents INTEGER, status TEXT)") { Ok(n) => n, Err(e) => -1 }
    let result: i64 = match db_execute(conn, "UPDATE credit_limit SET utilized_cents = utilized_cents + ? WHERE counterparty_id = ? AND status = 'active'", amount_cents, counterparty_id) {
        Ok(n) => n,
        Err(e) => -1,
    }
    stop conn
    return result
}

fn increase_credit_utilization(counterparty_id: i64, amount_cents: i64) -> i64 {
    return match db_connect("trade_finance.db") {
        Ok(conn) => increase_credit_utilization_inner(conn, counterparty_id, amount_cents),
        Err(e) => -1,
    }
}

fn release_credit_utilization_inner(conn: db, counterparty_id: i64, amount_cents: i64) -> i64 {
    let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS credit_limit (id INTEGER PRIMARY KEY AUTOINCREMENT, counterparty_id INTEGER, facility_cap_cents INTEGER, utilized_cents INTEGER, status TEXT)") { Ok(n) => n, Err(e) => -1 }
    let result: i64 = match db_execute(conn, "UPDATE credit_limit SET utilized_cents = MAX(0, utilized_cents - ?) WHERE counterparty_id = ? AND status = 'active'", amount_cents, counterparty_id) {
        Ok(n) => n,
        Err(e) => -1,
    }
    stop conn
    return result
}

fn release_credit_utilization(counterparty_id: i64, amount_cents: i64) -> i64 {
    return match db_connect("trade_finance.db") {
        Ok(conn) => release_credit_utilization_inner(conn, counterparty_id, amount_cents),
        Err(e) => -1,
    }
}

// ---- reconciliation ----------------------------------------------------

struct ReconciliationMatch {
    id: i64,
    payment_ref: str,
    match_type: str,
    matched_trade_payment_id: i64,
}

fn list_reconciliation_match_inner(conn: db) -> Result(json, ErrorCode) {
    let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS reconciliation_match (id INTEGER PRIMARY KEY AUTOINCREMENT, payment_ref TEXT, match_type TEXT, matched_trade_payment_id INTEGER)") { Ok(n) => n, Err(e) => -1 }
    let rows: Result(json, str) = db_query(conn, "SELECT id, payment_ref, match_type, matched_trade_payment_id FROM reconciliation_match ORDER BY id DESC")
    stop conn
    return match rows { Ok(v) => Ok(v), Err(e) => Err(DbError()) }
}

fn list_reconciliation_match() -> Result(json, ErrorCode) requires(role: "compliance_officer") {
    return match db_connect("trade_finance.db") {
        Ok(conn) => list_reconciliation_match_inner(conn),
        Err(e) => Err(DbError()),
    }
}

struct ExceptionQueueItem {
    id: i64,
    payment_ref: str,
    amount_cents: i64,
    source_feed: str,
    reason: str,
    status: str,
}

fn list_exception_queue_item_inner(conn: db) -> Result(json, ErrorCode) {
    let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS exception_queue_item (id INTEGER PRIMARY KEY AUTOINCREMENT, payment_ref TEXT, amount_cents INTEGER, source_feed TEXT, reason TEXT, status TEXT)") { Ok(n) => n, Err(e) => -1 }
    let rows: Result(json, str) = db_query(conn, "SELECT id, payment_ref, amount_cents, source_feed, reason, status FROM exception_queue_item ORDER BY id DESC")
    stop conn
    return match rows { Ok(v) => Ok(v), Err(e) => Err(DbError()) }
}

fn list_exception_queue_item() -> Result(json, ErrorCode) requires(role: "compliance_officer") {
    return match db_connect("trade_finance.db") {
        Ok(conn) => list_exception_queue_item_inner(conn),
        Err(e) => Err(DbError()),
    }
}

// The one shared "clear a matched payment" terminal step -- called both
// by `mock_ingest_bank_feed`'s deterministic-match path below and by
// Module 8's direct virtual-account routing, matching the doc's own
// "payments landing on a virtual account... route straight into Module
// 7's reconciliation engine" requirement with one real shared function
// rather than two copies of the same logic.
fn settle_trade_payment_reconciliation_inner(conn: db, trade_payment_id: i64, reference: Text, match_type: MatchType) -> Result(i64, ErrorCode) {
    let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS reconciliation_match (id INTEGER PRIMARY KEY AUTOINCREMENT, payment_ref TEXT, match_type TEXT, matched_trade_payment_id INTEGER)") { Ok(n) => n, Err(e) => -1 }
    let t2: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS trade_payment (id INTEGER PRIMARY KEY AUTOINCREMENT, purchase_order_id INTEGER, payment_type TEXT, amount_cents INTEGER, currency TEXT, reference TEXT, status TEXT)") { Ok(n) => n, Err(e) => -1 }

    let amount_cents: i64 = match db_query(conn, "SELECT amount_cents as value FROM trade_payment WHERE id = ?", trade_payment_id) {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_i64(row, "value") { Ok(v) => v, Err(e) => -1 },
            Err(e) => -1,
        },
        Err(e) => -1,
    }
    let purchase_order_id: i64 = match db_query(conn, "SELECT purchase_order_id as value FROM trade_payment WHERE id = ?", trade_payment_id) {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_i64(row, "value") { Ok(v) => v, Err(e) => -1 },
            Err(e) => -1,
        },
        Err(e) => -1,
    }
    let buyer_counterparty_id: i64 = match db_query(conn, "SELECT buyer_counterparty_id as value FROM purchase_order WHERE id = ?", purchase_order_id) {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_i64(row, "value") { Ok(v) => v, Err(e) => -1 },
            Err(e) => -1,
        },
        Err(e) => -1,
    }

    let settled: i64 = match db_execute(conn, "UPDATE trade_payment SET status = 'settled' WHERE id = ? AND status = 'posted'", trade_payment_id) {
        Ok(n) => n,
        Err(e) => -1,
    }
    let match_inserted: i64 = match db_execute(conn, "INSERT INTO reconciliation_match (payment_ref, match_type, matched_trade_payment_id) VALUES (?, ?, ?)", reference.value, match_type, trade_payment_id) {
        Ok(n) => n,
        Err(e) => -1,
    }
    stop conn

    let released: i64 = if buyer_counterparty_id >= 0 { release_credit_utilization(buyer_counterparty_id, amount_cents) } else { -1 }
    let posted: Result(i64, ErrorCode) = post_journal_entry(JournalEventTypePaymentClearing(), Text("module7"), trade_payment_id, Text("cash"), amount_cents, Text("trade_receivable"), amount_cents)

    return if settled > 0 { Ok(match_inserted) } else { Err(NoPostedTradePaymentFoundToSettleForThisReference()) }
}

fn settle_trade_payment_reconciliation(trade_payment_id: i64, reference: Text, match_type: MatchType) -> Result(i64, ErrorCode) {
    return match db_connect("trade_finance.db") {
        Ok(conn) => settle_trade_payment_reconciliation_inner(conn, trade_payment_id, reference, match_type),
        Err(e) => Err(DbError()),
    }
}

// `[MOCK]` -- stands in for real ISO 20022 camt.053/054 / MT940/MT950
// webhook ingestion; a simplified (reference, amount, debtor code) shape
// instead of a real wire format (see todo.md). Deterministic matching
// only -- an unmatched payment routes straight to the exception queue,
// per the doc's own fallback path (`[SUBSTITUTED]` for Levenshtein fuzzy
// matching, which has no available Nirdosha library).
fn mock_ingest_bank_feed_inner(conn: db, reference: Text, amount_cents: i64, debtor_code: Text, source_feed: Text) -> Result(i64, ErrorCode) {
    let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS trade_payment (id INTEGER PRIMARY KEY AUTOINCREMENT, purchase_order_id INTEGER, payment_type TEXT, amount_cents INTEGER, currency TEXT, reference TEXT, status TEXT)") { Ok(n) => n, Err(e) => -1 }
    let t2: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS exception_queue_item (id INTEGER PRIMARY KEY AUTOINCREMENT, payment_ref TEXT, amount_cents INTEGER, source_feed TEXT, reason TEXT, status TEXT)") { Ok(n) => n, Err(e) => -1 }

    let matched_id: i64 = match db_query(conn, "SELECT id as value FROM trade_payment WHERE reference = ? AND amount_cents = ? AND status = 'posted' LIMIT 1", reference.value, amount_cents) {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_i64(row, "value") { Ok(v) => v, Err(e) => -1 },
            Err(e) => -1,
        },
        Err(e) => -1,
    }
    stop conn

    return if matched_id >= 0 {
        settle_trade_payment_reconciliation(matched_id, reference, MatchTypeDeterministic())
    } else {
        match db_connect("trade_finance.db") {
            Ok(conn2) => open_exception_queue_item_inner(conn2, reference, amount_cents, source_feed),
            Err(e) => Err(DbError()),
        }
    }
}

fn open_exception_queue_item_inner(conn: db, payment_ref: Text, amount_cents: i64, source_feed: Text) -> Result(i64, ErrorCode) {
    let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS exception_queue_item (id INTEGER PRIMARY KEY AUTOINCREMENT, payment_ref TEXT, amount_cents INTEGER, source_feed TEXT, reason TEXT, status TEXT)") { Ok(n) => n, Err(e) => -1 }
    let inserted: i64 = match db_execute(conn, "INSERT INTO exception_queue_item (payment_ref, amount_cents, source_feed, reason, status) VALUES (?, ?, ?, 'no deterministic match on reference+amount', 'open')", payment_ref.value, amount_cents, source_feed.value) {
        Ok(n) => n,
        Err(e) => -1,
    }
    stop conn
    return if inserted >= 0 { Ok(inserted) } else { Err(FailedToRouteUnmatchedPaymentToExceptionQueue()) }
}

fn mock_ingest_bank_feed(reference: Text, amount_cents: i64, debtor_code: Text, source_feed: Text) -> Result(i64, ErrorCode) {
    return match db_connect("trade_finance.db") {
        Ok(conn) => mock_ingest_bank_feed_inner(conn, reference, amount_cents, debtor_code, source_feed),
        Err(e) => Err(DbError()),
    }
}

// Manually matching an exception-queue payment is Maker-Checker per the
// doc's table.
fn submit_resolve_exception(identity: VerifiedIdentity, exception_id: i64, trade_payment_id: i64, justification: Text) -> Result(i64, ErrorCode) {
    return submit_approval(identity, ActionTypeResolveException(), ApprovalRiskTierTradePayment(), 1, 24, justification)
}

fn resolve_exception_inner(conn: db, request_id: i64, exception_id: i64, trade_payment_id: i64) -> Result(i64, ErrorCode) {
    let status: str = match db_query(conn, "SELECT status as value FROM approval_request WHERE id = ?", request_id) {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_str(row, "value") { Ok(v) => v, Err(e) => "MISSING" },
            Err(e) => "MISSING",
        },
        Err(e) => "MISSING",
    }
    let reference: str = match db_query(conn, "SELECT payment_ref as value FROM exception_queue_item WHERE id = ?", exception_id) {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_str(row, "value") { Ok(v) => v, Err(e) => "" },
            Err(e) => "",
        },
        Err(e) => "",
    }
    return if status != "APPROVED" {
        stop conn
        Err(ExceptionResolutionIsNotYetFullyApproved())
    } else {
        let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS exception_queue_item (id INTEGER PRIMARY KEY AUTOINCREMENT, payment_ref TEXT, amount_cents INTEGER, source_feed TEXT, reason TEXT, status TEXT)") { Ok(n) => n, Err(e) => -1 }
        let closed: i64 = match db_execute(conn, "UPDATE exception_queue_item SET status = 'resolved' WHERE id = ?", exception_id) { Ok(n) => n, Err(e) => -1 }
        stop conn
        settle_trade_payment_reconciliation(trade_payment_id, Text(reference), MatchTypeManual())
    }
}

fn resolve_exception(request_id: i64, exception_id: i64, trade_payment_id: i64) -> Result(i64, ErrorCode) {
    return match db_connect("trade_finance.db") {
        Ok(conn) => resolve_exception_inner(conn, request_id, exception_id, trade_payment_id),
        Err(e) => Err(DbError()),
    }
}

// ---- daily interest accrual: explicit callable action, no scheduler
// primitive (same substitution as Module 4's wallet-settlement sweep) --
//
// Walks every funded, not-yet-accrued discounting bundle using the same
// while-loop-over-JSON-array pattern `verify_audit_chain_rows` already
// established for an unbounded result set, and posts one real balanced
// journal entry per bundle.
// A helper taking `conn: db` and stopping it can only ever be a
// function's *last* use of that handle (finish_with_audit's own doc
// comment above) -- so, like Module 4's `credit_wallet_tier`, each
// bundle's accrued-flag update opens and closes its own connection
// rather than threading the loop's single moved-once `conn` through N
// iterations.
fn mark_bundle_accrued_inner(conn: db, bundle_id: i64) -> i64 {
    let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS discounting_bundle (id INTEGER PRIMARY KEY AUTOINCREMENT, invoice_id_a INTEGER, invoice_id_b INTEGER, invoice_id_c INTEGER, advance_rate_bps INTEGER, total_advance_cents INTEGER, interest_cents INTEGER, status TEXT, accrued INTEGER)") { Ok(n) => n, Err(e) => -1 }
    let result: i64 = match db_execute(conn, "UPDATE discounting_bundle SET accrued = 1 WHERE id = ?", bundle_id) { Ok(n) => n, Err(e) => -1 }
    stop conn
    return result
}

fn mark_bundle_accrued(bundle_id: i64) -> i64 {
    return match db_connect("trade_finance.db") {
        Ok(conn) => mark_bundle_accrued_inner(conn, bundle_id),
        Err(e) => -1,
    }
}

// Pure over the already-fetched JSON array (no `db` handle of its own),
// same shape as `verify_audit_chain_rows` above -- the loop-friendly way
// to walk an unbounded result set this file has already established.
fn accrue_daily_interest_rows(rows: json) -> i64 {
    let n: i64 = match json_array_len(rows) { Ok(k) => k, Err(e) => 0 }
    let i: i64 = 0
    let accrued_count: i64 = 0
    while i < n {
        let row: json = match json_array_get(rows, i) { Ok(r) => r, Err(e) => rows }
        let bundle_id: i64 = match json_get_i64(row, "id") { Ok(v) => v, Err(e) => -1 }
        let interest_cents: i64 = match json_get_i64(row, "interest_cents") { Ok(v) => v, Err(e) => 0 }
        let posted: Result(i64, ErrorCode) = post_journal_entry(JournalEventTypeInterestAccrual(), Text("module7"), bundle_id, Text("interest_receivable"), interest_cents, Text("interest_income"), interest_cents)
        let marked: i64 = mark_bundle_accrued(bundle_id)
        accrued_count = accrued_count + 1
        i = i + 1
    }
    return accrued_count
}

fn accrue_daily_interest_inner(conn: db) -> i64 {
    let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS discounting_bundle (id INTEGER PRIMARY KEY AUTOINCREMENT, invoice_id_a INTEGER, invoice_id_b INTEGER, invoice_id_c INTEGER, advance_rate_bps INTEGER, total_advance_cents INTEGER, interest_cents INTEGER, status TEXT, accrued INTEGER)") { Ok(n) => n, Err(e) => -1 }
    let result: i64 = match db_query(conn, "SELECT id, interest_cents FROM discounting_bundle WHERE status = 'funded' AND accrued = 0") {
        Ok(rows) => accrue_daily_interest_rows(rows),
        Err(e) => 0,
    }
    stop conn
    return result
}

fn accrue_daily_interest() -> i64 {
    return match db_connect("trade_finance.db") {
        Ok(conn) => accrue_daily_interest_inner(conn),
        Err(e) => 0,
    }
}

// ---- `[MOCK]` FX -- stands in for a live SOFR-style benchmark or FX
// feed; fixed illustrative cross-rates, bps-scaled (x10000) so the
// result stays an exact i64 (no int<->float cast, LANGUAGE.md §3).
// Written as a nested `match` rather than `==` pairs -- both work
// (`interpreter.rs::eval_binary` now has a `Value::Enum` arm), `match`
// just reads better for a full currency-pair lookup table than a long
// `if`/`==`/`&&` chain would.
fn mock_fx_rate_bps(from_currency: Currency, to_currency: Currency) -> i64 {
    return match from_currency {
        CurrencyEur => match to_currency {
            CurrencyUsd => 10800,
            CurrencyEur => 10000,
            CurrencyGbp => 10000,
        },
        CurrencyUsd => match to_currency {
            CurrencyEur => 9250,
            CurrencyUsd => 10000,
            CurrencyGbp => 10000,
        },
        CurrencyGbp => match to_currency {
            CurrencyUsd => 12600,
            CurrencyEur => 10000,
            CurrencyGbp => 10000,
        },
    }
}

// ---- dashboard --------------------------------------------------------

fn stat_gl_balance_status_inner(conn: db) -> i64 {
    let unbalanced: i64 = match db_query(conn, "SELECT COUNT(*) as value FROM (SELECT journal_entry_id, SUM(debit_cents) as d, SUM(credit_cents) as c FROM journal_line GROUP BY journal_entry_id) WHERE d != c") {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_i64(row, "value") { Ok(v) => v, Err(e) => 0 },
            Err(e) => 0,
        },
        Err(e) => 0,
    }
    stop conn
    return if unbalanced == 0 { 1 } else { 0 }
}

// `1` means every posted journal entry balances (the structural
// guarantee holding); `0` would mean a real defect slipped past
// `post_journal_entry`'s own rejection, which should be impossible by
// construction -- a real proof-of-correctness tile, not decoration.
fn stat_gl_balance_status() -> i64 {
    return match db_connect("trade_finance.db") {
        Ok(conn) => stat_gl_balance_status_inner(conn),
        Err(e) => 0,
    }
}

fn stat_reconciliation_match_rate_bps_inner(conn: db) -> i64 {
    let matched: i64 = match db_query(conn, "SELECT COUNT(*) as value FROM reconciliation_match") {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_i64(row, "value") { Ok(v) => v, Err(e) => 0 },
            Err(e) => 0,
        },
        Err(e) => 0,
    }
    let exceptions: i64 = match db_query(conn, "SELECT COUNT(*) as value FROM exception_queue_item") {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_i64(row, "value") { Ok(v) => v, Err(e) => 0 },
            Err(e) => 0,
        },
        Err(e) => 0,
    }
    let total: i64 = matched + exceptions
    stop conn
    return if total == 0 { 0 } else { (matched * 10000) / total }
}

fn stat_reconciliation_match_rate_bps() -> i64 {
    return match db_connect("trade_finance.db") {
        Ok(conn) => stat_reconciliation_match_rate_bps_inner(conn),
        Err(e) => 0,
    }
}

fn stat_exception_queue_depth_inner(conn: db) -> i64 {
    let result: i64 = match db_query(conn, "SELECT COUNT(*) as value FROM exception_queue_item WHERE status = 'open'") {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_i64(row, "value") { Ok(v) => v, Err(e) => 0 },
            Err(e) => 0,
        },
        Err(e) => 0,
    }
    stop conn
    return result
}

fn stat_exception_queue_depth() -> i64 {
    return match db_connect("trade_finance.db") {
        Ok(conn) => stat_exception_queue_depth_inner(conn),
        Err(e) => 0,
    }
}

fn chart_gl_by_account_type_inner(conn: db) -> Result(json, ErrorCode) {
    let rows: Result(json, str) = db_query(conn, "SELECT a.account_type as label, COALESCE(SUM(jl.debit_cents - jl.credit_cents), 0) as value FROM account a LEFT JOIN journal_line jl ON jl.account_code = a.code GROUP BY a.account_type ORDER BY value DESC")
    stop conn
    return match rows { Ok(v) => Ok(v), Err(e) => Err(DbError()) }
}

fn chart_gl_by_account_type() -> Result(json, ErrorCode) {
