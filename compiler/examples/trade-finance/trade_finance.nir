// Registering/modifying a production webhook is Maker-Checker per the
// doc's table -- plain callable, real record, no dispatch loop
// (`[SUBSTITUTED]`, see module header comment).
fn create_webhook_subscription_inner(conn: db, partner_name: Text, event_type: Text, target_url: Text) -> Result(i64, ErrorCode) {
    let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS webhook_subscription (id INTEGER PRIMARY KEY AUTOINCREMENT, partner_name TEXT, event_type TEXT, target_url TEXT, status TEXT)") { Ok(n) => n, Err(e) => -1 }
    let inserted: i64 = match db_execute(conn, "INSERT INTO webhook_subscription (partner_name, event_type, target_url, status) VALUES (?, ?, ?, 'active')", partner_name.value, event_type.value, target_url.value) {
        Ok(n) => n,
        Err(e) => -1,
    }
    stop conn
    return if inserted >= 0 { Ok(inserted) } else { Err(FailedToRegisterWebhookSubscription()) }
}

fn create_webhook_subscription(partner_name: Text, event_type: Text, target_url: Text) -> Result(i64, ErrorCode) {
