fn stat_double_discounting_catches_inner(conn: db) -> i64 {
    // The check itself rejects at insert time rather than recording a
    // row (real, exact-match rejection -- see `create_invoice_inner`
    // above), so there is nothing to count from a table; this tile
    // instead surfaces the number of invoices currently held for fraud
    // review as the nearest real, queryable risk-control signal.
    let result: i64 = match db_query(conn, "SELECT COUNT(*) as value FROM fraud_case WHERE disposition = 'open'") {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_i64(row, "value") { Ok(v) => v, Err(e) => 0 },
            Err(e) => 0,
        },
        Err(e) => 0,
    }
    stop conn
    return result
}

