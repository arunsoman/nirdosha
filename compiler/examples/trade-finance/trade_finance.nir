// Real cross-module gate, called synchronously (a real function call,
// not just documented intent) by Module 4's milestone-release function
// and Module 5's discounting-eligibility function below.
fn has_open_dispute_inner(conn: db, purchase_order_id: i64) -> bool {
    let open_count: i64 = match db_query(conn, "SELECT COUNT(*) as value FROM delivery_dispute WHERE purchase_order_id = ? AND status = 'open'", purchase_order_id) {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_i64(row, "value") { Ok(v) => v, Err(e) => 0 },
            Err(e) => 0,
        },
        Err(e) => 0,
    }
    stop conn
    return open_count > 0
}

