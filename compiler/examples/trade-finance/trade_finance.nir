}

// Provisioning is Maker-Checker per the doc's table -- plain callable
// here, same disclosed per-module scoping as every earlier module's
// non-marquee actions. `iban_number` is caller-supplied rather than
// generated: Nirdosha has no string concatenation (LANGUAGE.md §2), so
// there is no way to compose e.g. a country-code prefix with a freshly
// minted numeric id into one string internally.
fn create_virtual_iban_inner(conn: db, buyer_counterparty_id: i64, seller_counterparty_id: i64, iban_number: Text, partner_bank_note: Text) -> Result(i64, ErrorCode) {
    let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS virtual_iban (id INTEGER PRIMARY KEY AUTOINCREMENT, buyer_counterparty_id INTEGER, seller_counterparty_id INTEGER, iban_number TEXT, partner_bank_note TEXT, status TEXT)") { Ok(n) => n, Err(e) => -1 }
    let inserted: i64 = match db_execute(conn, "INSERT INTO virtual_iban (buyer_counterparty_id, seller_counterparty_id, iban_number, partner_bank_note, status) VALUES (?, ?, ?, ?, 'active')", buyer_counterparty_id, seller_counterparty_id, iban_number.value, partner_bank_note.value) {
        Ok(n) => n,
        Err(e) => -1,
    }
    stop conn
    return if inserted >= 0 { Ok(inserted) } else { Err(FailedToProvisionVirtualIban()) }
}

fn create_virtual_iban(buyer_counterparty_id: i64, seller_counterparty_id: i64, iban_number: Text, partner_bank_note: Text) -> Result(i64, ErrorCode) {
    return match db_connect("trade_finance.db") {
        Ok(conn) => create_virtual_iban_inner(conn, buyer_counterparty_id, seller_counterparty_id, iban_number, partner_bank_note),
        Err(e) => Err(DbError()),
    }
}

// Closing an IBAN with zero recent transaction history is a plain
// operator action; closing one with real history is 6-Eyes per the
// doc's table -- exactly the doc's own distinction, checked for real
// against `payment_execution.virtual_iban_id` rather than assumed. Same
// dual-path idiom Module 4's `create_wallet_withdrawal` already uses
// (act now below a bar, else route through governance).
fn close_virtual_iban(identity: VerifiedIdentity, virtual_iban_id: i64, justification: Text) -> Result(i64, ErrorCode) {
    return match db_connect("trade_finance.db") {
        Ok(conn) => close_virtual_iban_inner(conn, identity, virtual_iban_id, justification),
        Err(e) => Err(DbError()),
    }
}

fn close_virtual_iban_inner(conn: db, identity: VerifiedIdentity, virtual_iban_id: i64, justification: Text) -> Result(i64, ErrorCode) {
    let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS payment_execution (id INTEGER PRIMARY KEY AUTOINCREMENT, trade_payment_id INTEGER, rail_selected TEXT, corridor TEXT, amount_cents INTEGER, currency TEXT, status TEXT, virtual_iban_id INTEGER)") { Ok(n) => n, Err(e) => -1 }
    let t2: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS virtual_iban (id INTEGER PRIMARY KEY AUTOINCREMENT, buyer_counterparty_id INTEGER, seller_counterparty_id INTEGER, iban_number TEXT, partner_bank_note TEXT, status TEXT)") { Ok(n) => n, Err(e) => -1 }
    let history_count: i64 = match db_query(conn, "SELECT COUNT(*) as value FROM payment_execution WHERE virtual_iban_id = ?", virtual_iban_id) {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_i64(row, "value") { Ok(v) => v, Err(e) => 0 },
            Err(e) => 0,
        },
        Err(e) => 0,
    }
    return if history_count == 0 {
        let result: Result(i64, str) = db_execute(conn, "UPDATE virtual_iban SET status = 'closed' WHERE id = ?", virtual_iban_id)
        stop conn
        match result { Ok(v) => Ok(v), Err(e) => Err(DbError()) }
    } else {
        stop conn
        submit_approval(identity, ActionTypeCloseVirtualIban(), ApprovalRiskTierSixEyes(), 2, 8, justification)
    }
}

fn apply_close_virtual_iban_inner(conn: db, request_id: i64, virtual_iban_id: i64) -> Result(i64, ErrorCode) {
    let status: str = match db_query(conn, "SELECT status as value FROM approval_request WHERE id = ?", request_id) {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_str(row, "value") { Ok(v) => v, Err(e) => "MISSING" },
            Err(e) => "MISSING",
        },
        Err(e) => "MISSING",
    }
    return if status != "APPROVED" {
        stop conn
        Err(VirtualIbanClosureIsNotYetFully6EyesApproved())
    } else {
        let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS virtual_iban (id INTEGER PRIMARY KEY AUTOINCREMENT, buyer_counterparty_id INTEGER, seller_counterparty_id INTEGER, iban_number TEXT, partner_bank_note TEXT, status TEXT)") { Ok(n) => n, Err(e) => -1 }
        let result: Result(i64, str) = db_execute(conn, "UPDATE virtual_iban SET status = 'closed' WHERE id = ?", virtual_iban_id)
        stop conn
        match result { Ok(v) => Ok(v), Err(e) => Err(DbError()) }
    }
}

fn apply_close_virtual_iban(request_id: i64, virtual_iban_id: i64) -> Result(i64, ErrorCode) {
    return match db_connect("trade_finance.db") {
        Ok(conn) => apply_close_virtual_iban_inner(conn, request_id, virtual_iban_id),
        Err(e) => Err(DbError()),
    }
}

