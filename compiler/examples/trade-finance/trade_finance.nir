}

// =========================================================================
// Module 5: Invoice Discounting & Supply Chain Finance
// =========================================================================
module "Module 5: Invoice Discounting & Supply Chain Finance" {
//
// One specific financing product inside the broader B2B payments platform
// (Module 4): converts a seller's unpaid receivable into immediate
// liquidity. Double-discounting prevention is a real SQL exact-match
// query on (invoice_number, tax_id, supplier_code, face_value_cents) --
// zero false negatives by construction (todo.md's own description);
// Nirdosha has no i64->str cast (LANGUAGE.md §3), so the amount
// participates directly in the SQL match rather than folding it into a
// sha256_hex-built composite key the way Module 1's audit chain hashes
// its (all-str) fields -- same real guarantee, no Redis-backed hash index
// (`[SUBSTITUTED]`). Fraud scoring is a real, disclosed heuristic
// (`[SUBSTITUTED]` for the doc's PyOD/scikit-learn anomaly pipeline): a
// face value far outside a fixed illustrative band routes to a
// `FraudCase`. Discounting eligibility is gated synchronously on Module
// 6's `has_open_dispute` -- a real function call, not documented intent.

struct Invoice {
    id: i64,
    purchase_order_id: i64,
    invoice_number: str,
    tax_id: str,
    supplier_code: str,
    face_value_cents: i64,
    fraud_score_bps: i64,
    eligibility_status: str,
}

fn list_invoice_inner(conn: db) -> Result(json, ErrorCode) {
    let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS invoice (id INTEGER PRIMARY KEY AUTOINCREMENT, purchase_order_id INTEGER, invoice_number TEXT, tax_id TEXT, supplier_code TEXT, face_value_cents INTEGER, fraud_score_bps INTEGER, eligibility_status TEXT)") { Ok(n) => n, Err(e) => -1 }
    let rows: Result(json, str) = db_query(conn, "SELECT id, purchase_order_id, invoice_number, tax_id, supplier_code, face_value_cents, fraud_score_bps, eligibility_status FROM invoice ORDER BY id DESC")
    stop conn
    return match rows { Ok(v) => Ok(v), Err(e) => Err(DbError()) }
}

fn list_invoice() -> Result(json, ErrorCode) requires(role: "corporate_seller") {
    return match db_connect("trade_finance.db") {
        Ok(conn) => list_invoice_inner(conn),
        Err(e) => Err(DbError()),
    }
}

