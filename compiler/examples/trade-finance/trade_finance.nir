        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_i64(row, "value") { Ok(v) => v, Err(e) => 0 },
            Err(e) => 0,
        },
        Err(e) => 0,
    }
    let total: i64 = match db_query(conn, "SELECT COUNT(*) as value FROM match_result") {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_i64(row, "value") { Ok(v) => v, Err(e) => 0 },
            Err(e) => 0,
        },
        Err(e) => 0,
    }
    stop conn
    return if total == 0 { 0 } else { (confirmed * 10000) / total }
}

fn stat_match_rate_bps() -> i64 {
