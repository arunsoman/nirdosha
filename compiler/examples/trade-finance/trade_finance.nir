fn mock_generate_swift_message_inner(conn: db, msg_type: str, reference: str, fields_note: str) -> str {
    let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS swift_message_log (id INTEGER PRIMARY KEY AUTOINCREMENT, msg_type TEXT, reference TEXT, fields_note TEXT, status TEXT)") { Ok(n) => n, Err(e) => -1 }
    let inserted: i64 = match db_execute(conn, "INSERT INTO swift_message_log (msg_type, reference, fields_note, status) VALUES (?, ?, ?, 'generated')", msg_type, reference, fields_note) {
        Ok(n) => n,
        Err(e) => -1,
    }
    stop conn
    // Literal-pattern `match` over `str` (a real switch, not a nested
    // if-else chain -- see `examples/identity_mock.nir`'s `login` for
    // the same conversion, and `nirdosha_row11_amendment.md` §3.4's
    // addendum for why `str` is a valid `match` scrutinee now).
    return match msg_type {
        "MT700" => "MT700 generated (mock): irrevocable documentary credit issuance",
        "MT707" => "MT707 generated (mock): amendment to documentary credit",
        "MT710" => "MT710 generated (mock): advice of a third bank's documentary credit",
        "MT760" => "MT760 generated (mock): guarantee/standby letter of credit",
        _ => "SWIFT message generated (mock)",
    }
}

// `[MOCK]` -- stands in for real Prowide/SWIFT Alliance Access
