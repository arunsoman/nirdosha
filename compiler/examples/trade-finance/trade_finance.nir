// =========================================================================
// Module 8: Payments, Settlement & Banking Gateways
// =========================================================================
module "Module 8: Payments, Settlement & Banking Gateways" {
//
// The platform's outbound/inbound funds-movement layer. Rail selection is
// a real deterministic rule (currency + cross-border flag), matching the
// doc's own routing logic rather than a stub; `mock_execute_rail` is the
// same class of illustrative confirmation `examples/payments_mock.nir`
// already uses. This module's marquee governance wiring is payment
// execution (Maker-Checker standard, 6-Eyes high-value cross-border, per
// the doc's table) -- reusing Module 4's `required_eyes_for_amount`
// rather than a second threshold function.

// Real, deterministic rail-selection rule -- not a stub. Cross-border
// always routes to SWIFT; domestic routes by currency to the doc's named
// rails (FedNow/SEPA Instant/RTGS/ACH fallback).
fn select_rail(currency: Currency, cross_border: bool) -> RailType {
    return if cross_border {
        SWIFT()
    } else {
        match currency {
            CurrencyUsd => FedNow(),
            CurrencyEur => SEPA_INSTANT(),
            CurrencyGbp => RTGS(),
        }
    }
}

// `[MOCK]` -- stands in for real FedNow/ACH/SEPA Instant/RTGS/SWIFT
// connectivity; a deterministic mock confirmation, same shape as
// `examples/payments_mock.nir`'s `charge`.
fn mock_execute_rail(rail: RailType, amount_cents: i64, currency: Currency) -> Result(Text, ErrorCode) {
    return match rail {
        SWIFT => Ok(Text("mock-swift-confirmation")),
        FedNow => Ok(Text("mock-fednow-confirmation")),
        SEPA_INSTANT => Ok(Text("mock-sepa-instant-confirmation")),
        RTGS => Ok(Text("mock-rtgs-confirmation")),
        ACH => Ok(Text("mock-ach-confirmation")),
    }
}

// `[MOCK]` -- stands in for real Prowide ISO 20022 pacs.008 generation;
// same real-semantic-fields-not-wire-bytes treatment as Module 3's
// `mock_generate_swift_message`, and reuses its `SwiftMessageLog` table
// rather than a second copy. `currency` isn't embedded in the logged
// text -- there's no enum-to-`str` conversion in this language, and a
// mock's log text isn't load-bearing.
fn mock_generate_pacs008(reference: Text, amount_cents: i64, currency: Currency) -> Text {
    return mock_generate_swift_message(MsgTypeOther(), reference, Text("pacs008 payment"))
}

struct PaymentExecution {
    id: i64,
    trade_payment_id: i64,
    rail_selected: str,
    corridor: str,
    amount_cents: i64,
    currency: str,
    status: str,
    virtual_iban_id: i64,
}

fn list_payment_execution_inner(conn: db) -> Result(json, ErrorCode) {
    let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS payment_execution (id INTEGER PRIMARY KEY AUTOINCREMENT, trade_payment_id INTEGER, rail_selected TEXT, corridor TEXT, amount_cents INTEGER, currency TEXT, status TEXT, virtual_iban_id INTEGER)") { Ok(n) => n, Err(e) => -1 }
    let rows: Result(json, str) = db_query(conn, "SELECT id, trade_payment_id, rail_selected, corridor, amount_cents, currency, status, virtual_iban_id FROM payment_execution ORDER BY id DESC")
    stop conn
    return match rows { Ok(v) => Ok(v), Err(e) => Err(DbError()) }
}

fn list_payment_execution() -> Result(json, ErrorCode) requires(role: "bank_ops") {
    return match db_connect("trade_finance.db") {
        Ok(conn) => list_payment_execution_inner(conn),
        Err(e) => Err(DbError()),
    }
}

// Rail selection for high-value transactions is itself 6-Eyes-gated per
// the doc; standard-value is Maker-Checker. `cross_border` and
// `virtual_iban_id` (-1 = none) are supplied by the caller -- Nirdosha
// has no lookup-by-relationship join ergonomic beyond an explicit id.
fn submit_payment_execution(identity: VerifiedIdentity, trade_payment_id: i64, amount_cents: i64, currency: Currency, cross_border: bool, virtual_iban_id: i64, justification: Text) -> Result(i64, ErrorCode) {
    let required: i64 = if cross_border { required_eyes_for_amount(amount_cents) } else { if amount_cents >= 5000000 { 2 } else { 1 } }
    return submit_approval(identity, ActionTypePaymentExecution(), ApprovalRiskTierTradePayment(), required, 24, justification)
}

fn post_payment_execution_inner(conn: db, request_id: i64, trade_payment_id: i64, amount_cents: i64, currency: Currency, cross_border: bool, virtual_iban_id: i64) -> Result(i64, ErrorCode) {
    let status: str = match db_query(conn, "SELECT status as value FROM approval_request WHERE id = ?", request_id) {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_str(row, "value") { Ok(v) => v, Err(e) => "MISSING" },
            Err(e) => "MISSING",
        },
        Err(e) => "MISSING",
    }
    return if status != "APPROVED" {
        stop conn
        Err(PaymentExecutionIsNotYetFullyApproved())
    } else {
        let rail: RailType = select_rail(currency, cross_border)
        let corridor: str = if cross_border { "cross_border" } else { "domestic" }
        let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS payment_execution (id INTEGER PRIMARY KEY AUTOINCREMENT, trade_payment_id INTEGER, rail_selected TEXT, corridor TEXT, amount_cents INTEGER, currency TEXT, status TEXT, virtual_iban_id INTEGER)") { Ok(n) => n, Err(e) => -1 }
        let inserted: i64 = match db_execute(conn, "INSERT INTO payment_execution (trade_payment_id, rail_selected, corridor, amount_cents, currency, status, virtual_iban_id) VALUES (?, ?, ?, ?, ?, 'settled', ?)", trade_payment_id, rail, corridor, amount_cents, currency, virtual_iban_id) {
            Ok(n) => n,
            Err(e) => -1,
        }
        let execution_id: i64 = match db_query(conn, "SELECT last_insert_rowid() as value") {
            Ok(rows) => match json_array_get(rows, 0) {
                Ok(row) => match json_get_i64(row, "value") { Ok(v) => v, Err(e) => -1 },
                Err(e) => -1,
            },
            Err(e) => -1,
        }
        stop conn
        let executed: Result(Text, ErrorCode) = mock_execute_rail(rail, amount_cents, currency)
        let swift_logged: Text = if cross_border { mock_generate_pacs008(Text("payment-execution"), amount_cents, currency) } else { Text("domestic rail, no SWIFT message") }
        // Direct virtual-account routing bypasses the generic bank-feed
        // webhook queue entirely (doc §8.2) -- a real call into Module
        // 7's own settlement primitive, not documented intent.
        let routed: Result(i64, ErrorCode) = if virtual_iban_id >= 0 {
            settle_trade_payment_reconciliation(trade_payment_id, Text("vam-direct"), MatchTypeVirtualAccountDirect())
        } else {
            Ok(0)
        }
        if execution_id >= 0 { Ok(execution_id) } else { Err(FailedToRecordPaymentExecution()) }
    }
}

fn post_payment_execution(request_id: i64, trade_payment_id: i64, amount_cents: i64, currency: Currency, cross_border: bool, virtual_iban_id: i64) -> Result(i64, ErrorCode) {
    return match db_connect("trade_finance.db") {
        Ok(conn) => post_payment_execution_inner(conn, request_id, trade_payment_id, amount_cents, currency, cross_border, virtual_iban_id),
        Err(e) => Err(DbError()),
    }
}

// Variant names match `select_rail`'s own literal output strings exactly
// (Module 8, below) -- same real rail vocabulary, not a second one.
enum RailType {
    FedNow,
    SEPA_INSTANT,
    SWIFT,
    ACH,
    RTGS,
}

struct CorridorHealth {
    id: i64,
    corridor_name: str,
    rail_type: RailType,
    status: str,
    degraded: bool,
}

fn list_corridor_health_inner(conn: db) -> Result(json, ErrorCode) {
    let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS corridor_health (id INTEGER PRIMARY KEY AUTOINCREMENT, corridor_name TEXT, rail_type TEXT, status TEXT, degraded INTEGER)") { Ok(n) => n, Err(e) => -1 }
    let s1: i64 = match db_execute(conn, "INSERT INTO corridor_health (corridor_name, rail_type, status, degraded) SELECT 'US-Domestic', 'FedNow', 'healthy', 0 WHERE NOT EXISTS (SELECT 1 FROM corridor_health WHERE corridor_name = 'US-Domestic')") { Ok(n) => n, Err(e) => -1 }
    let s2: i64 = match db_execute(conn, "INSERT INTO corridor_health (corridor_name, rail_type, status, degraded) SELECT 'EU-Domestic', 'SEPA_INSTANT', 'healthy', 0 WHERE NOT EXISTS (SELECT 1 FROM corridor_health WHERE corridor_name = 'EU-Domestic')") { Ok(n) => n, Err(e) => -1 }
    let s3: i64 = match db_execute(conn, "INSERT INTO corridor_health (corridor_name, rail_type, status, degraded) SELECT 'Cross-Border', 'SWIFT', 'healthy', 0 WHERE NOT EXISTS (SELECT 1 FROM corridor_health WHERE corridor_name = 'Cross-Border')") { Ok(n) => n, Err(e) => -1 }
    let rows: Result(json, str) = db_query(conn, "SELECT id, corridor_name, rail_type, status, degraded FROM corridor_health ORDER BY id ASC")
    stop conn
    return match rows { Ok(v) => Ok(v), Err(e) => Err(DbError()) }
}

// `[SUBSTITUTED]` -- a manually/periodically updated status record, not a
// live probe against real rails (none exist to probe). Seeded with the
// doc's three named corridors on first use, same idiom as Module 4's
// wallet seeding.
fn list_corridor_health() -> Result(json, ErrorCode) requires(role: "bank_ops") {
    return match db_connect("trade_finance.db") {
        Ok(conn) => list_corridor_health_inner(conn),
        Err(e) => Err(DbError()),
    }
}

fn update_corridor_health_inner(conn: db, corridor_id: i64, status: Text, degraded: bool) -> Result(i64, ErrorCode) {
    let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS corridor_health (id INTEGER PRIMARY KEY AUTOINCREMENT, corridor_name TEXT, rail_type TEXT, status TEXT, degraded INTEGER)") { Ok(n) => n, Err(e) => -1 }
    let result: Result(i64, str) = db_execute(conn, "UPDATE corridor_health SET status = ?, degraded = ? WHERE id = ?", status.value, degraded, corridor_id)
    stop conn
    return match result { Ok(v) => Ok(v), Err(e) => Err(DbError()) }
}

fn update_corridor_health(corridor_id: i64, status: Text, degraded: bool) -> Result(i64, ErrorCode) {
    return match db_connect("trade_finance.db") {
        Ok(conn) => update_corridor_health_inner(conn, corridor_id, status, degraded),
        Err(e) => Err(DbError()),
    }
}

