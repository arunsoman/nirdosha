// Row 12: first-class functions & user identity as a relying party.
//
// This example demonstrates the corrected Row 12 model: Nirdosha validates
// tokens issued by external IdPs (mock OIDC/JWT and API key), derives
// authorization views from verified claims, manages application sessions
// separately from identity, issues/consumes refresh tokens, and checks
// revocation. The runtime never mints identity tokens; it only consumes
// and validates them.

// Every `str` in this file's original function signatures was genuine
// free text (a JWT, a cookie, a claim value, a status message) with no
// closed vocabulary to enum-ify -- so the "enum favoring" ban's carrier
// struct, `Text`, is the fix throughout, not a new `enum`.
struct Text {
    value: str,
}

fn handle_authorized(identity: VerifiedIdentity) -> Text {
    let session: ApplicationSession = create_application_session(identity)
    let cookie: str = session_cookie(session)
    print("session cookie:", cookie)
    return match extract_claim(identity, "department") {
        Ok(claim_view) => Text(claim_view.value),
        Err(e) => Text(e),
    }
}

fn handle_identity(identity: VerifiedIdentity) -> Text {
    if identity_expired(identity, 1800000000) {
        return Text("token expired")
    }
    if check_revocation(identity) {
        return Text("token revoked")
    }
    return match check_role(identity, "physician") {
        Ok(role_view) => handle_authorized(identity),
        Err(e) => Text(e),
    }
}

fn handle_fresh_identity(identity: VerifiedIdentity) -> Text {
    let refresh: RefreshTokenHandle = new_refresh_token(2000000000)
    return match exchange_refresh_token(identity, refresh, 1700000000) {
        Ok(refreshed_identity) => handle_identity(refreshed_identity),
        Err(e) => Text(e),
    }
}

fn handle_oidc_login(token: Text, issuer: Text, audience: Text, jwks: Text) -> Text {
    return match oidc_validate_token(token.value, issuer.value, audience.value, jwks.value) {
        Ok(identity) => handle_fresh_identity(identity),
        Err(e) => Text(e),
    }
}

fn handle_api_key(api_key: Text, expected_hash: Text) -> Text {
    return match validate_api_key(api_key.value, expected_hash.value) {
        Ok(identity) => handle_identity(identity),
        Err(e) => Text(e),
    }
}

fn main() {
    // A mock OIDC ID token, signed by the JWKS below. The token encodes:
    //   sub: alice
    //   iss: https://example.com
    //   aud: my-app
    //   exp: 2000000000
    //   iat: 1700000000
    //   roles: ["physician"]
    //   department: "cardiology"
    let token: str = "eyJhbGciOiAiSFMyNTYiLCAia2lkIjogImtleTEifQ.eyJzdWIiOiAiYWxpY2UiLCAiaXNzIjogImh0dHBzOi8vZXhhbXBsZS5jb20iLCAiYXVkIjogIm15LWFwcCIsICJleHAiOiAyMDAwMDAwMDAwLCAiaWF0IjogMTcwMDAwMDAwMCwgInJvbGVzIjogWyJwaHlzaWNpYW4iXSwgImRlcGFydG1lbnQiOiAiY2FyZGlvbG9neSJ9.nrFdeqNDwXWLeGzud6X9Q4ITzCXULzZBBK8y51LGYXs"

    // The IdP's verification keys. Nirdosha holds *verification* keys only,
    // never signing keys.
    let jwks: str = "{\"keys\":[{\"kid\":\"key1\",\"kty\":\"oct\",\"k\":\"bXktc2VjcmV0LWtleQ\"}]}"

    let issuer: str = "https://example.com"
    let audience: str = "my-app"

    print("--- OIDC path ---")
    let oidc_result: Text = handle_oidc_login(Text(token), Text(issuer), Text(audience), Text(jwks))
    print("OIDC result:", oidc_result.value)

    print("--- API key path ---")
    let api_key: str = "my-secret-api-key"
    let expected_hash: str = "325ededd6c3b9988f623c7f964abb9b016b76b0f8b3474df0f7d7c23b941381f"
    let api_result: Text = handle_api_key(Text(api_key), Text(expected_hash))
    print("API key result:", api_result.value)

    print("done")
}
