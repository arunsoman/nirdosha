// A revenue assurance app, entirely in Nirdosha -- data model, business
// logic, and its own web UI (`emit-ui`, derived, not hand-written).
//
//     nirdosha serve examples/rev-assurence/rev_assurance.nir --port 8081 \
//       --jwks-file <jwks.json> --issuer https://mock-idp.local \
//       --audience store-app --identity-base http://localhost:9090
//
// (reuses `examples/identity_mock.nir` as its login server -- see that
// file's header; run it on port 9090 first, same JWKS.)
//
// ---- what this actually does -------------------------------------------
//
// Revenue assurance, minimally but honestly: usage records (what a
// subscriber actually consumed, rated at the correct price) and billing
// records (what was actually invoiced) are ingested separately, per
// (subscriber, service, period). `reconcile_period` finds every mismatch
// between the two as a single SQL statement -- a `Discrepancy` row per
// leak -- rather than looping over JSON in Nirdosha source (which would
// need a "dummy" JSON value on every failure path; see
// `examples/store.nir`'s own header comment on why that's awkward here).
// Analysts then work the resulting case list from the derived UI.
//
// `db` is affine with no borrowing (`examples/db.nir`'s doc comment), so
// every function below opens, uses, and `stop`s its own connection to
// `rev_assurance.db`, same discipline `examples/store.nir` already
// follows.
//
// `create_/update_*` and `reconcile_period` are `requires(role:
// "analyst")` -- raw usage/billing ingestion and case handling are
// controlled actions; the dashboard and case list are open to any
// signed-in-or-not viewer, same as `examples/store.nir`'s product catalog.

struct UsageRecord {
    id: i64,
    subscriber_id: str,
    service_type: str,
    period: str,
    usage_units: i64,
    rated_amount_cents: i64,
}

struct BillingRecord {
    id: i64,
    subscriber_id: str,
    service_type: str,
    period: str,
    billed_amount_cents: i64,
}

struct Discrepancy {
    id: i64,
    subscriber_id: str,
    service_type: str,
    period: str,
    expected_cents: i64,
    billed_cents: i64,
    leakage_cents: i64,
    status: str,
}

// ---- usage records: ingest (analyst) + view --------------------------

fn list_usage_record_inner(conn: db) -> Result(json, str) {
    let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS usage_records (id INTEGER PRIMARY KEY AUTOINCREMENT, subscriber_id TEXT, service_type TEXT, period TEXT, usage_units INTEGER, rated_amount_cents INTEGER)") {
        Ok(n) => n,
        Err(e) => -1,
    }
    let t2: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS billing_records (id INTEGER PRIMARY KEY AUTOINCREMENT, subscriber_id TEXT, service_type TEXT, period TEXT, billed_amount_cents INTEGER)") {
        Ok(n) => n,
        Err(e) => -1,
    }
    let t3: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS discrepancies (id INTEGER PRIMARY KEY AUTOINCREMENT, subscriber_id TEXT, service_type TEXT, period TEXT, expected_cents INTEGER, billed_cents INTEGER, leakage_cents INTEGER, status TEXT)") {
        Ok(n) => n,
        Err(e) => -1,
    }
    let rows: Result(json, str) = db_query(conn, "SELECT id, subscriber_id, service_type, period, usage_units, rated_amount_cents FROM usage_records ORDER BY id DESC")
    stop conn
    return rows
}

fn list_usage_record() -> Result(json, str) {
    return match db_connect("rev_assurance.db") {
        Ok(conn) => list_usage_record_inner(conn),
        Err(e) => Err(e),
    }
}

fn create_usage_record_inner(conn: db, u: UsageRecord) -> Result(i64, str) {
    let t1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS usage_records (id INTEGER PRIMARY KEY AUTOINCREMENT, subscriber_id TEXT, service_type TEXT, period TEXT, usage_units INTEGER, rated_amount_cents INTEGER)") {
        Ok(n) => n,
        Err(e) => -1,
    }
    let t2: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS billing_records (id INTEGER PRIMARY KEY AUTOINCREMENT, subscriber_id TEXT, service_type TEXT, period TEXT, billed_amount_cents INTEGER)") {
        Ok(n) => n,
        Err(e) => -1,
    }
    let t3: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS discrepancies (id INTEGER PRIMARY KEY AUTOINCREMENT, subscriber_id TEXT, service_type TEXT, period TEXT, expected_cents INTEGER, billed_cents INTEGER, leakage_cents INTEGER, status TEXT)") {
        Ok(n) => n,
        Err(e) => -1,
    }
    let result: Result(i64, str) = db_execute(conn, "INSERT INTO usage_records (subscriber_id, service_type, period, usage_units, rated_amount_cents) VALUES (?, ?, ?, ?, ?)", u.subscriber_id, u.service_type, u.period, u.usage_units, u.rated_amount_cents)
    stop conn
    return result
}

fn create_usage_record(u: UsageRecord) -> Result(i64, str) requires(role: "analyst") {
    return match db_connect("rev_assurance.db") {
        Ok(conn) => create_usage_record_inner(conn, u),
        Err(e) => Err(e),
    }
}

