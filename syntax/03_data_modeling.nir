// Level 3 -- data modeling: struct, enum, match, generics, Vector/Matrix,
// and the built-in Money/Measure prelude types.

// `str` at a function boundary is banned (level 2's `classify`); genuine
// free text still needs a home, so it gets wrapped in a one-field
// carrier struct. `str` itself is completely ordinary everywhere else --
// a ctor argument, a struct field, a local variable.
struct Text {
    value: str,
}

// Layer 1 struct/enum: fixed concrete fields, ordinary-call construction,
// `.field` access, and exhaustive `match` over a closed variant set.
struct Point {
    x: f64,
    y: f64,
}

enum Shape {
    Circle(f64),
    Rectangle(f64, f64),
}

fn area(s: Shape) -> f64 {
    return match s {
        Circle(r) => 3.14159 * r * r,
        Rectangle(w, h) => w * h,
    }
}

// Layer 6: generics. Type identity is structural-per-instantiation --
// `Duo(i64, i64)` is a real, concrete type, the same way `Vector(f64, 3)`
// already is.
struct Duo(A, B) {
    first: A,
    second: B,
}

enum Either(A, B) {
    Left(A),
    Right(B),
}

fn sum_pair(p: Duo(i64, i64)) -> i64 {
    return p.first + p.second
}

fn pick(e: Either(i64, i64)) -> i64 {
    return match e {
        Left(n) => n,
        Right(n) => n,
    }
}

// Layer 7: the Option(T)/Result(T, E) prelude -- built in, no
// declaration needed.
fn unwrap_option(o: Option(i64), default: i64) -> i64 {
    return match o {
        Some(n) => n,
        None => default,
    }
}

fn main() {
    let p: Point = Point(3.0, 4.0)
    print(norm([p.x, p.y])) // 5

    let c: Shape = Circle(2.0)
    let r: Shape = Rectangle(3.0, 4.0)
    print(area(c)) // 12.56636
    print(area(r)) // 12

    let duo: Duo(i64, i64) = Duo(2, 3)
    print(sum_pair(duo)) // 5

    let e: Either(i64, i64) = Left(1)
    print(pick(e)) // 1

    let some: Option(i64) = Some(41)
    let none: Option(i64) = None()
    print(unwrap_option(some, 0)) // 41
    print(unwrap_option(none, 0)) // 0

    // Vector/Matrix: literals, indexing, elementwise ops, and Phase 2's
    // dense linear-algebra builtins.
    let v: Vector(f64, 3) = [1.0, 2.0, 3.0]
    let w: Vector(f64, 3) = [4.0, 5.0, 6.0]
    print(v + w)     // [5, 7, 9]
    print(dot(v, w)) // 32
    print(v[0])      // 1

    let m: Matrix(f64, 2, 2) = [[1.0, 2.0], [3.0, 4.0]]
    print(transpose(m)) // [[1, 3], [2, 4]]
    print(det(m))        // -2

    // Money/CurrencyCode -- a real prelude type, no declaration needed:
    // `amount` is a type-checked `dec128` (`dec_from_str` is fallible --
    // malformed input is a real `Result`, not a silent 0), `currency` is
    // a closed, exhaustively-matchable enum, not a bare `str` tag.
    let amount: dec128 = match dec_from_str("19.99") {
        Ok(d) => d,
        Err(e) => dec_from_i64(0, 0),
    }
    let price: Money = Money(amount, USD())
    print(price.amount)
    print(price.currency)

    // Measure/UnitCode -- same shape, for physical quantities. Field is
    // `unit_code`, not `unit` -- `unit` itself lexes as the `unit` type
    // keyword, so it can never be a field name (ast.rs's own comment on
    // this exact prelude struct). `dec_from_i64(value, scale)` is
    // infallible -- "2" at scale 0.
    let weight: Measure = Measure(dec_from_i64(2, 0), Kilogram())
    print(weight.value)
    print(weight.unit_code)
}
