// Independent LALR(1) cross-check for GRAMMAR.md's EBNF — see
// grammar_check/README.md for what this proves and why it's a separate
// crate. Transliterated production-for-production from GRAMMAR.md; if
// the two ever drift, one of them is wrong. Semantic actions are all
// `()` on purpose — the only thing this crate exists to check is
// whether `lalrpop` can build a conflict-free parser table for this
// grammar's *shape*, not to duplicate parser.rs's AST construction.

use std::str::FromStr;

grammar;

match {
    "fn", "let", "return", "if", "else", "while", "box",
    "true", "false",
    "i8", "i16", "i32", "i64", "u8", "u16", "u32", "u64", "usize", "bool", "unit",
    // Row 11/12/`docs/WORKFLOW.md`/Track E1 declaration keywords -- real
    // reserved keywords in `token.rs` (unlike `field`/`action`/
    // `paginate`/`tile`/`chart`/`panel`/`data`/`on_entry`/`on_exit`/
    // `on`/`terminal`/`link` below, which stay modeled as plain `IDENT`
    // -- see the note above `ScreenItem` for why lalrpop can't
    // faithfully reserve a *contextual* keyword the way `parser.rs`
    // does).
    "struct", "enum", "screen", "dashboard", "module", "workflow", "workspace", "state", "validate",
    "(", ")", "{", "}", ":", ",", "->", "=",
    "+", "-", "*", "/",
    "==", "!=", "<=", ">=", "<", ">",
    "&&", "||", "!", "&",
} else {
    r"[0-9]+" => INT,
    r"[a-zA-Z_][a-zA-Z0-9_]*" => IDENT,
    // A minimal string-literal lexeme -- no escape handling (`kv_entry`/
    // `action`/`dashboard`/`module`'s STRING slots, GRAMMAR.md's
    // `str_lit`). Semantic actions are all `()` (see the file header),
    // so the *content* of a string never matters here, only that one
    // token exists to occupy this slot in the grammar's shape.
    r#""[^"]*""# => STR,
} else {
    r"\s+" => { },
    r"//[^\n\r]*" => { },
}

pub Program: () = { Item* => () };

// Every top-level declaration kind `GRAMMAR.md`'s own `item` production
// lists. `struct_decl`/`enum_decl` were added alongside the Row 12/
// `WORKFLOW.md`/Track E1 constructs below because `module_decl` and
// `workflow_decl`'s own `data_block` directly embed them -- there was
// no way to model those without also modeling these.
Item: () = {
    FnDecl => (),
    StructDecl => (),
    EnumDecl => (),
    ScreenDecl => (),
    DashboardDecl => (),
    ModuleDecl => (),
    WorkflowDecl => (),
    WorkspaceDecl => (),
    ValidateDecl => (),
};

// ---- Row 11: struct/enum (product/sum types) --------------------------

StructDecl: () = { "struct" IDENT TypeParamList? "{" FieldList ","? "}" => () };
FieldList: () = { Field => (), FieldList "," Field => () };
Field: () = { IDENT ":" Type => () };
TypeParamList: () = { "(" IdentList ")" => () };
IdentList: () = { IDENT => (), IdentList "," IDENT => () };

EnumDecl: () = { "enum" IDENT TypeParamList? "{" VariantList ","? "}" => () };
VariantList: () = { Variant => (), VariantList "," Variant => () };
Variant: () = {
    IDENT => (),
    IDENT "(" TypeArgList ")" => (),
};
TypeArgList: () = { Type => (), TypeArgList "," Type => () };

// ---- Row 12's UI DSL: `screen`/`dashboard` -----------------------------
//
// `field`/`action`/`paginate` (inside `ScreenItem`) and `tile`/`chart`
// (inside `DashboardItem`) are deliberately modeled as plain `IDENT`,
// not new reserved tokens -- `GRAMMAR.md`'s own note on `screen_decl`:
// they're matched by identifier TEXT only in this one leading position
// in the real parser, not globally reserved (`action` is a real struct
// field name in `examples/trade-finance/trade_finance.nir`). lalrpop's
// lexer dispatches purely on token KIND, with no way to say "this IDENT,
// only when its text is exactly 'field'" -- so reserving these as their
// own literal tokens here would misrepresent them as globally reserved,
// the opposite of what's actually true. Using plain `IDENT` instead
// keeps the model honest about that, at the cost of not being able to
// tell lalrpop's conflict checker "these four `ScreenItem` alternatives
// are text-disambiguated" -- they remain shape-disambiguated instead
// (each has a different *second* token after the leading `IDENT`:
// `"{"` / another `IDENT` / `STR` / `":"` -- see each alternative
// below), which is sufficient for LALR(1) either way.
ScreenDecl: () = { "screen" IDENT "{" ScreenItem* "}" => () };
ScreenItem: () = {
    PaginateBlock => (),
    FieldOverride => (),
    ActionDecl => (),
    KvEntry => (),
};
// "paginate" "{" kv_entry* "}"
PaginateBlock: () = { IDENT "{" KvEntry* "}" => () };
// "field" IDENT "{" kv_entry* "}"
FieldOverride: () = { IDENT IDENT "{" KvEntry* "}" => () };
// "action" STRING "->" IDENT ("{" kv_entry* "}")?
ActionDecl: () = {
    IDENT STR "->" IDENT => (),
    IDENT STR "->" IDENT "{" KvEntry* "}" => (),
};
KvEntry: () = { IDENT ":" Expr => () };

DashboardDecl: () = { "dashboard" "{" DashboardItem* "}" => () };
// ("tile" | "chart") STRING "->" IDENT -- all three contextual, same
// shape; `visual`'s trailing `{ kv_entry* }` is optional (Track E2).
DashboardItem: () = {
    IDENT STR "->" IDENT => (),
    IDENT STR "->" IDENT "{" KvEntry* "}" => (),
};

// ---- `module "Name" { ... }` -- nav grouping, not scoping --------------

ModuleDecl: () = { "module" STR "{" ModuleItem* "}" => () };
ModuleItem: () = {
    FnDecl => (),
    StructDecl => (),
    EnumDecl => (),
};

// ---- `validate <fn_name> { pre: ... post: ... }` (`docs/ROADMAP.md` Track
// F, F3; `docs/NEXT_GEN.md` §F3) -- a Hoare contract on an existing `fn`,
// declared separately, same shape as `ScreenDecl` above. `pre`/`post`
// stay plain `IDENT` (matched by identifier text only inside
// `parser.rs::parse_validate_decl`), the same "keyword only within
// this one leading position" treatment `field`/`action`/`paginate`
// already get inside `ScreenItem` -- so this production is just
// `KvEntry*`, nothing new for lalrpop to disambiguate.

ValidateDecl: () = { "validate" IDENT "{" KvEntry* "}" => () };

// ---- `docs/WORKFLOW.md`'s durable state machine -----------------------------
//
// `data`/`on_entry`/`on_exit`/`on`/`terminal`/`link` all stay plain
// `IDENT` for the same reason `field`/`action`/`paginate` do above.
// `EntryOrExitBlock` deliberately collapses `on_entry_block`/
// `on_exit_block` into one production: both are `IDENT "{"
// ActionCall* "}"`, structurally IDENTICAL once the leading keyword's
// *text* is erased to plain `IDENT` -- lalrpop can't have two
// alternatives of the same shape mean different things, so modeling
// them as two separate (but shape-identical) alternatives would itself
// be a real, spurious ambiguity this crate's own purpose is to catch,
// not a faithful transliteration. One collapsed production is the
// honest model; the real parser's actual text-based distinction between
// "on_entry" and "on_exit" isn't (can't be) represented here.
WorkflowDecl: () = { "workflow" IDENT "{" DataBlock? StateDecl+ "}" => () };
// "data" "{" field ("," field)* ","? "}"
DataBlock: () = { IDENT "{" FieldList ","? "}" => () };
// "state" IDENT "terminal"? "{" state_item* "}"
StateDecl: () = {
    "state" IDENT "{" StateItem* "}" => (),
    "state" IDENT IDENT "{" StateItem* "}" => (),
};
StateItem: () = {
    EntryOrExitBlock => (),
    Transition => (),
    KvEntry => (),
};
EntryOrExitBlock: () = { IDENT "{" ActionCall* "}" => () };
// action_call ::= ident "(" (expr ("," expr)*)? ")" -- same argument-list
// shape a call already has (`Args`/`ArgList` above `Call`), reused as-is
// (a separate, structurally-identical nonterminal was tried here and
// made no difference to the conflict count below -- confirming this
// isn't an `Args`-specific merging artifact, see the note above
// `Item`'s own conflict-count discussion in the README).
ActionCall: () = { IDENT "(" Args ")" => () };
// "on" "link"? IDENT "->" IDENT
Transition: () = {
    IDENT IDENT "->" IDENT => (),
    IDENT IDENT IDENT "->" IDENT => (),
};

// ---- Track E1: `workspace`/`panel` -- composite multi-panel screens ---

WorkspaceDecl: () = { "workspace" IDENT "{" WorkspaceItem* "}" => () };
WorkspaceItem: () = {
    PanelDecl => (),
    KvEntry => (),
};
// "panel" STRING "{" panel_item* "}"
PanelDecl: () = { IDENT STR "{" PanelItem* "}" => () };
PanelItem: () = {
    ActionDecl => (),
    KvEntry => (),
};

FnDecl: () = {
    "fn" IDENT "(" Params ")" RetType Block => (),
};

Params: () = {
    => (),
    ParamList,
};

ParamList: () = {
    Param,
    ParamList "," Param,
};

Param: () = { IDENT ":" Type };

RetType: () = {
    => (),
    "->" Type,
};

// `IDENT`/`IDENT "(" TypeArgList ")"` (added alongside `StructDecl`/
// `EnumDecl` above, for `Field`'s own sake) is a declared struct/enum
// name, optionally applied to concrete generic type arguments --
// GRAMMAR.md's real `type` production's `ident ("(" type ...)? ")"`
// alternative. Still deliberately narrower than GRAMMAR.md's full `type`
// in one direction: `thread`/`chan`/`sandbox`/`Vector`/`Matrix`/`str`/
// `tcp`/`tcp_listener`/`f64`/the `fn(...)->...` type-former are not
// modeled here -- out of scope for what this pass set out to fix
// (Row 12/`WORKFLOW.md`/Track E1's declaration-level constructs), a
// real remaining gap, left disclosed rather than silently implied.
Type: () = {
    "&" Type,
    "box" Type,
    IDENT => (),
    IDENT "(" TypeArgList ")" => (),
    "i8", "i16", "i32", "i64", "u8", "u16", "u32", "u64", "usize", "bool", "unit",
};

// `Block` has two forms, not one — this is the actual finding this
// cross-check exists to surface, not a workaround. GRAMMAR.md's EBNF
// (`return_stmt ::= "return" expr?`) reads as if a bare `return` could
// appear anywhere in a statement list. It can't, and never could:
// `parser.rs`'s `parse_return_stmt` only treats `return` as bare when
// the very next token is `}` — any other token means "greedily parse a
// full expression," the same maximal-munch strategy that resolves this
// for every other statement form too (nothing separates statements, so
// "where does this expression end" always has to be answered by
// grabbing as much as possible, never by backtracking). That rule was
// implicit in the hand-written parser's control flow and *not* stated
// anywhere in GRAMMAR.md — this cross-check is what surfaced the gap.
// Modeling it explicitly (bare `return` only immediately before `}`,
// nowhere else) is what actually resolves the conflicts below, not a
// precedence hack layered on top of the looser, ambiguous EBNF.
Block: () = {
    "{" Stmt* "}" => (),
    "{" Stmt* "return" "}" => (),
};

Stmt: () = {
    LetStmt,
    "return" Expr => (),
    WhileStmt,
    ExprStmt,
};

LetStmt: () = { "let" IDENT ":" Type "=" Expr => () };
WhileStmt: () = { "while" Expr Block => () };
ExprStmt: () = { Expr };

// expr ::= if_expr | assignment
Expr: () = {
    IfExpr,
    Assignment,
};

IfExpr: () = {
    "if" Expr Block => (),
    "if" Expr Block "else" Block => (),
    "if" Expr Block "else" IfExpr => (),
};

// assignment ::= ident "=" assignment | logic_or
//
// This is the one production worth flagging explicitly: `IDENT` starts
// both alternatives (the second, through the whole precedence chain down
// to `Primary`). If lalrpop builds this without a shift-reduce conflict,
// that's the independent proof that GRAMMAR.md's own claim — "parse a
// full `logic_or`, then check for a trailing `=` on a bare `Ident`" is
// the LL(1)-faithful way to write this — corresponds to a grammar that's
// *also* genuinely unambiguous for a completely different parsing
// strategy (LALR's bottom-up table construction), not merely
// convenient for a hand-written top-down parser to fake its way through.
Assignment: () = {
    IDENT "=" Assignment => (),
    LogicOr,
};

LogicOr: () = {
    LogicAnd,
    LogicOr "||" LogicAnd => (),
};
LogicAnd: () = {
    Equality,
    LogicAnd "&&" Equality => (),
};
Equality: () = {
    Comparison,
    Equality "==" Comparison => (),
    Equality "!=" Comparison => (),
};
Comparison: () = {
    Additive,
    Comparison "<" Additive => (),
    Comparison ">" Additive => (),
    Comparison "<=" Additive => (),
    Comparison ">=" Additive => (),
};
Additive: () = {
    Multiplicative,
    Additive "+" Multiplicative => (),
    Additive "-" Multiplicative => (),
};
Multiplicative: () = {
    Unary,
    Multiplicative "*" Unary => (),
    Multiplicative "/" Unary => (),
};
Unary: () = {
    Call,
    "!" Unary => (),
    "-" Unary => (),
    "*" Unary => (),
    "box" Unary => (),
    "&" Unary => (),
};
// Exactly zero or one call, not repeated — `f()()` is a real parse error
// in `parser.rs` (checked directly, not assumed; see GRAMMAR.md's `call`
// production). An earlier revision of both this file and GRAMMAR.md had
// this as left-recursive repetition, which was simply wrong, found by
// testing the actual parser, not by re-deriving the grammar more
// carefully.
Call: () = {
    Primary,
    Primary "(" Args ")" => (),
};
Args: () = {
    => (),
    ArgList,
};
ArgList: () = {
    Expr,
    ArgList "," Expr,
};

Primary: () = {
    INT => (),
    "true" => (),
    "false" => (),
    IDENT => (),
    "(" Expr ")" => (),
};
