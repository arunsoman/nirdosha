// 4x4 matrix multiply, repeated N times with slightly varying inputs
// (so the JIT/optimizer can't constant-fold the whole loop away), one
// scalar accumulated per iteration as a checksum.
fn main() {
    let n: i64 = 0
    let n_max: i64 = 200000
    let t: f64 = 0.0
    let checksum: f64 = 0.0
    while n < n_max {
        let a: Matrix(f64, 4, 4) = [
            [t, t + 1.0, t + 2.0, t + 3.0],
            [t + 4.0, t + 5.0, t + 6.0, t + 7.0],
            [t + 8.0, t + 9.0, t + 10.0, t + 11.0],
            [t + 12.0, t + 13.0, t + 14.0, t + 15.0]
        ]
        let b: Matrix(f64, 4, 4) = [
            [t + 1.0, t, t + 3.0, t + 2.0],
            [t + 5.0, t + 4.0, t + 7.0, t + 6.0],
            [t + 9.0, t + 8.0, t + 11.0, t + 10.0],
            [t + 13.0, t + 12.0, t + 15.0, t + 14.0]
        ]
        let c: Matrix(f64, 4, 4) = a * b
        checksum = checksum + c[0, 0]
        t = t + 0.0001
        n = n + 1
    }
    print(checksum)
}
