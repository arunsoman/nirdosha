// 4x4 determinant (Gaussian elimination w/ partial pivoting), repeated
// N times with slightly varying inputs so the result can't be
// constant-folded away.
fn main() {
    let n: i64 = 0
    let n_max: i64 = 200000
    let t: f64 = 0.0
    let checksum: f64 = 0.0
    while n < n_max {
        let m: Matrix(f64, 4, 4) = [
            [t + 4.0, t + 1.0, t + 2.0, t + 0.5],
            [t + 1.0, t + 5.0, t + 0.3, t + 1.2],
            [t + 2.0, t + 0.3, t + 6.0, t + 0.7],
            [t + 0.5, t + 1.2, t + 0.7, t + 7.0]
        ]
        checksum = checksum + det(m)
        t = t + 0.0001
        n = n + 1
    }
    print(checksum)
}
