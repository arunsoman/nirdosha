                    status,
                    total_cents
                 FROM orders
                 ORDER BY id DESC"
            )

            stop(conn)

            match result {
                Ok(rows) => Ok(rows),
                Err(e) => Err(DbError(e))
            }
        }

        Err(e) => Err(DbError(e))
    }
}


