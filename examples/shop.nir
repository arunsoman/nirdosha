enum ErrorCode {
    DbError(str),
    NotFound(str),
    InvalidInput(str),
    OutOfStock(str),
    EmptyCart(str),
    OrderError(str)
}

enum OrderStatus {
    Pending,
    Confirmed,
    Packed,
    Shipped,
    Delivered,
    Cancelled
}

struct Category {
    id: i64,
    name: str
}

struct Product {
    id: i64,
    category_id: i64,
    name: str,
    description: str,
    price_cents: i64,
    stock: i64,
    active: bool
}

struct Cart {
    id: i64,
    customer_id: i64
}

struct CartItem {
    id: i64,
    cart_id: i64,
    product_id: i64,
    quantity: i64
}

struct Order {
    id: i64,
    customer_id: i64,
    status: str,
    total_cents: i64
}

struct OrderItem {
    id: i64,
    order_id: i64,
    product_id: i64,
    quantity: i64,
    price_cents: i64
}

struct Customer {
    id: i64,
    name: str,
    email: str
}


fn initialize_database() -> Result(i64, ErrorCode) {

    return match db_connect("shop.db") {

        Ok(conn) => {

            let categories: Result(i64, str) = db_execute(
                conn,
                "CREATE TABLE IF NOT EXISTS category (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    name TEXT NOT NULL
                )"
            )

            let products: Result(i64, str) = db_execute(
                conn,
                "CREATE TABLE IF NOT EXISTS product (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    category_id INTEGER NOT NULL,
                    name TEXT NOT NULL,
                    description TEXT NOT NULL,
                    price_cents INTEGER NOT NULL,
                    stock INTEGER NOT NULL,
                    active INTEGER NOT NULL DEFAULT 1
                )"
            )

            let customers: Result(i64, str) = db_execute(
                conn,
                "CREATE TABLE IF NOT EXISTS customer (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    name TEXT NOT NULL,
                    email TEXT NOT NULL
                )"
            )

            let carts: Result(i64, str) = db_execute(
                conn,
                "CREATE TABLE IF NOT EXISTS cart (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    customer_id INTEGER NOT NULL
                )"
            )

            let cart_items: Result(i64, str) = db_execute(
                conn,
                "CREATE TABLE IF NOT EXISTS cart_item (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    cart_id INTEGER NOT NULL,
                    product_id INTEGER NOT NULL,
                    quantity INTEGER NOT NULL
                )"
            )

            let orders: Result(i64, str) = db_execute(
                conn,
                "CREATE TABLE IF NOT EXISTS orders (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    customer_id INTEGER NOT NULL,
                    status TEXT NOT NULL,
                    total_cents INTEGER NOT NULL
                )"
            )

            let order_items: Result(i64, str) = db_execute(
                conn,
                "CREATE TABLE IF NOT EXISTS order_item (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    order_id INTEGER NOT NULL,
                    product_id INTEGER NOT NULL,
                    quantity INTEGER NOT NULL,
                    price_cents INTEGER NOT NULL
                )"
            )

            stop(conn)

            match categories {
                Ok(n) => Ok(n),
                Err(e) => Err(DbError(e))
            }
        }

        Err(e) => Err(DbError(e))
    }
}


fn list_category() -> Result(json, ErrorCode) {

    return match db_connect("shop.db") {

        Ok(conn) => {

            let result: Result(json, str) = db_query(
                conn,
                "SELECT id, name FROM category ORDER BY name"
            )

            stop(conn)

            match result {
                Ok(rows) => Ok(rows),
                Err(e) => Err(DbError(e))
            }
        }

        Err(e) => Err(DbError(e))
    }
}


fn create_category(c: Category) -> Result(i64, ErrorCode)
requires(role: "admin") {

    return match db_connect("shop.db") {

        Ok(conn) => {

            let result: Result(i64, str) = db_execute(
                conn,
                "INSERT INTO category (name) VALUES (?)",
                c.name
            )

            stop(conn)

            match result {
                Ok(n) => Ok(n),
                Err(e) => Err(DbError(e))
            }
        }

        Err(e) => Err(DbError(e))
    }
}


fn list_product() -> Result(json, ErrorCode) {

    return match db_connect("shop.db") {

        Ok(conn) => {

            let result: Result(json, str) = db_query(
                conn,
                "SELECT
                    id,
                    category_id,
                    name,
                    description,
                    price_cents,
                    stock,
                    active
                 FROM product
                 WHERE active = 1
                 ORDER BY id DESC"
            )

            stop(conn)

            match result {
                Ok(rows) => Ok(rows),
                Err(e) => Err(DbError(e))
            }
        }

        Err(e) => Err(DbError(e))
    }
}


fn create_product(p: Product) -> Result(i64, ErrorCode)
requires(role: "admin") {

    return match db_connect("shop.db") {

        Ok(conn) => {

            let result: Result(i64, str) = db_execute(
                conn,
                "INSERT INTO product
                 (category_id, name, description, price_cents, stock, active)
                 VALUES (?, ?, ?, ?, ?, ?)",
                p.category_id,
                p.name,
                p.description,
                p.price_cents,
                p.stock,
                p.active
            )

            stop(conn)

            match result {
                Ok(n) => Ok(n),
                Err(e) => Err(DbError(e))
            }
        }

        Err(e) => Err(DbError(e))
    }
}


fn update_product(p: Product) -> Result(i64, ErrorCode)
requires(role: "admin") {

    return match db_connect("shop.db") {

        Ok(conn) => {

            let result: Result(i64, str) = db_execute(
                conn,
                "UPDATE product
                 SET category_id = ?,
                     name = ?,
                     description = ?,
                     price_cents = ?,
                     stock = ?,
                     active = ?
                 WHERE id = ?",
                p.category_id,
                p.name,
                p.description,
                p.price_cents,
                p.stock,
                p.active,
                p.id
            )

            stop(conn)

            match result {
                Ok(n) => Ok(n),
                Err(e) => Err(DbError(e))
            }
        }

        Err(e) => Err(DbError(e))
    }
}


