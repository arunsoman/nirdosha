// A real online store (catalog + cart + checkout), served with
// `nirdosha serve examples/shop.nir --port 8080 --jwks-file <jwks.json>
// --issuer https://mock-idp.local --audience shop-app --identity-base
// http://localhost:9090`.
//
// Every DB-touching function follows `examples/store.nir`'s
// `X_inner(conn, ...)` / `X(...)` split: `db` is affine with no
// borrowing, so each request opens its own connection, does its work,
// and `stop`s it exactly once. Multi-statement work (table creation,
// row lookups, the cart-checkout loop) lives in `X_inner`'s plain
// function body -- a `block`, which supports a full `stmt*` -- never
// inside a `match` arm, since `match_arm ::= ... "=>" expr` only ever
// accepts a single `expr` (`docs/GRAMMAR.md`'s `match_expr` production), not
// a `block`. Every branch that reaches a `stop(conn)` produces its
// result immediately afterward with no further `conn` use on that path
// -- confirmed empirically (same discipline `store.nir`'s header notes:
// the ownership checker can't prove `conn` still reaches a later use
// once a branch has consumed it, so no branch's `stop(conn)` is
// followed by anything but that branch's own return value).
//
// `create_order`'s checkout loop is the one place this file goes beyond
// `store.nir`, which deliberately limits checkout to a single item
// "avoiding a `json`-typed value ever needing a dummy fallback inside a
// loop" (see that file's header). Here the loop never early-`return`s
// or early-`stop`s -- each iteration updates stock and records an
// order_item only while an `all_ok` flag is still true, and folds any
// per-item failure into that flag instead, so `stop(conn)` still only
// ever happens once, after the loop, unconditionally.

enum ErrorCode {
    DbError(str),
    NotFound(str),
    InvalidInput(str),
    OutOfStock(str),
    EmptyCart(str),
    OrderError(str)
}

enum OrderStatus {
    Pending,
    Confirmed,
    Packed,
    Shipped,
    Delivered,
    Cancelled
}

struct Category {
    id: i64,
    name: str
}

struct Product {
    id: i64,
    category_id: i64,
    name: str,
    description: str,
    price_cents: i64,
    stock: i64,
    active: bool
}

struct Cart {
    id: i64,
    customer_id: i64
}

struct CartItem {
    id: i64,
    cart_id: i64,
    product_id: i64,
    quantity: i64
}

struct Order {
    id: i64,
    customer_id: i64,
    status: str,
    total_cents: i64
}

struct OrderItem {
    id: i64,
    order_id: i64,
    product_id: i64,
    quantity: i64,
    price_cents: i64
}

struct Customer {
    id: i64,
    name: str,
    email: str
}

// `str` may not be, or be part of, a function's parameter or return
// type (the "enum favoring" rule, `TypeErrorKind::StrInFnSignature`) --
// `Text` is the one-field carrier struct that lets `update_order_status`
// still take a free-text status, same convention `examples/strings.nir`
// documents.
struct Text {
    value: str
}

// ---- schema -------------------------------------------------------------

fn initialize_database_inner(conn: db) -> Result(i64, ErrorCode) {
    let categories: Result(i64, str) = db_execute(
        conn,
        "CREATE TABLE IF NOT EXISTS category (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            name TEXT NOT NULL
        )"
    )

    let products: Result(i64, str) = db_execute(
        conn,
        "CREATE TABLE IF NOT EXISTS product (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            category_id INTEGER NOT NULL,
            name TEXT NOT NULL,
            description TEXT NOT NULL,
            price_cents INTEGER NOT NULL,
            stock INTEGER NOT NULL,
            active INTEGER NOT NULL DEFAULT 1
        )"
    )

    let customers: Result(i64, str) = db_execute(
        conn,
        "CREATE TABLE IF NOT EXISTS customer (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            name TEXT NOT NULL,
            email TEXT NOT NULL
        )"
    )

    let carts: Result(i64, str) = db_execute(
        conn,
        "CREATE TABLE IF NOT EXISTS cart (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            customer_id INTEGER NOT NULL
        )"
    )

    let cart_items: Result(i64, str) = db_execute(
        conn,
        "CREATE TABLE IF NOT EXISTS cart_item (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            cart_id INTEGER NOT NULL,
            product_id INTEGER NOT NULL,
            quantity INTEGER NOT NULL
        )"
    )

    let orders: Result(i64, str) = db_execute(
        conn,
        "CREATE TABLE IF NOT EXISTS orders (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            customer_id INTEGER NOT NULL,
            status TEXT NOT NULL,
            total_cents INTEGER NOT NULL
        )"
    )

    let order_items: Result(i64, str) = db_execute(
        conn,
        "CREATE TABLE IF NOT EXISTS order_item (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            order_id INTEGER NOT NULL,
            product_id INTEGER NOT NULL,
            quantity INTEGER NOT NULL,
            price_cents INTEGER NOT NULL
        )"
    )

    stop(conn)

    return match categories {
        Ok(n) => Ok(n),
        Err(e) => Err(DbError(e)),
    }
}

fn initialize_database() -> Result(i64, ErrorCode) {
    return match db_connect("shop.db") {
        Ok(conn) => initialize_database_inner(conn),
        Err(e) => Err(DbError(e)),
    }
}

// ---- catalog: category ---------------------------------------------------

fn list_category_inner(conn: db) -> Result(json, ErrorCode) {
    let result: Result(json, str) = db_query(conn, "SELECT id, name FROM category ORDER BY name")
    stop(conn)
    return match result {
        Ok(rows) => Ok(rows),
        Err(e) => Err(DbError(e)),
    }
}

fn list_category() -> Result(json, ErrorCode) {
    return match db_connect("shop.db") {
        Ok(conn) => list_category_inner(conn),
        Err(e) => Err(DbError(e)),
    }
}

fn create_category_inner(conn: db, c: Category) -> Result(i64, ErrorCode) {
    let result: Result(i64, str) = db_execute(conn, "INSERT INTO category (name) VALUES (?)", c.name)
    stop(conn)
    return match result {
        Ok(n) => Ok(n),
        Err(e) => Err(DbError(e)),
    }
}

fn create_category(c: Category) -> Result(i64, ErrorCode) requires(role: "admin") {
    return match db_connect("shop.db") {
        Ok(conn) => create_category_inner(conn, c),
        Err(e) => Err(DbError(e)),
    }
}

// ---- catalog: product -----------------------------------------------------

fn list_product_inner(conn: db) -> Result(json, ErrorCode) {
    let result: Result(json, str) = db_query(
        conn,
        "SELECT
            id,
            category_id,
            name,
            description,
            price_cents,
            stock,
            active
         FROM product
         WHERE active = 1
         ORDER BY id DESC"
    )
    stop(conn)
    return match result {
        Ok(rows) => Ok(rows),
        Err(e) => Err(DbError(e)),
    }
}

fn list_product() -> Result(json, ErrorCode) {
    return match db_connect("shop.db") {
        Ok(conn) => list_product_inner(conn),
        Err(e) => Err(DbError(e)),
    }
}

fn create_product_inner(conn: db, p: Product) -> Result(i64, ErrorCode) {
    let result: Result(i64, str) = db_execute(
        conn,
        "INSERT INTO product
         (category_id, name, description, price_cents, stock, active)
         VALUES (?, ?, ?, ?, ?, ?)",
        p.category_id,
        p.name,
        p.description,
        p.price_cents,
        p.stock,
        p.active
    )
    stop(conn)
    return match result {
        Ok(n) => Ok(n),
        Err(e) => Err(DbError(e)),
    }
}

fn create_product(p: Product) -> Result(i64, ErrorCode) requires(role: "admin") {
    return match db_connect("shop.db") {
        Ok(conn) => create_product_inner(conn, p),
        Err(e) => Err(DbError(e)),
    }
}

fn update_product_inner(conn: db, p: Product) -> Result(i64, ErrorCode) {
    let result: Result(i64, str) = db_execute(
        conn,
        "UPDATE product
         SET category_id = ?,
             name = ?,
             description = ?,
             price_cents = ?,
             stock = ?,
             active = ?
         WHERE id = ?",
        p.category_id,
        p.name,
        p.description,
        p.price_cents,
        p.stock,
        p.active,
        p.id
    )
    stop(conn)
    return match result {
        Ok(n) => Ok(n),
        Err(e) => Err(DbError(e)),
    }
}

fn update_product(p: Product) -> Result(i64, ErrorCode) requires(role: "admin") {
    return match db_connect("shop.db") {
        Ok(conn) => update_product_inner(conn, p),
        Err(e) => Err(DbError(e)),
    }
}

