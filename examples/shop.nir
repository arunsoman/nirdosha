// ---- cart -------------------------------------------------------------

fn create_cart_inner(conn: db, c: Cart) -> Result(i64, ErrorCode) {
    let result: Result(i64, str) = db_execute(
        conn,
        "INSERT INTO cart (customer_id)
         VALUES (?)",
        c.customer_id
    )
    stop(conn)
    return match result {
        Ok(n) => Ok(n),
        Err(e) => Err(DbError(e)),
    }
}

fn create_cart(c: Cart) -> Result(i64, ErrorCode) {
    return match db_connect("shop.db") {
        Ok(conn) => create_cart_inner(conn, c),
        Err(e) => Err(DbError(e)),
    }
}

// `product`'s live stock decides accept/reject -- never trusts a
// client-supplied quantity blindly. Every terminal branch below calls
// `stop(conn)` exactly once and immediately produces its own result, no
// further `conn` use after -- the discipline this file's header
// explains.
fn create_cart_item_inner(conn: db, item: CartItem) -> Result(i64, ErrorCode) {
    return match db_query(
        conn,
        "SELECT stock
         FROM product
         WHERE id = ? AND active = 1",
        item.product_id
    ) {
        Ok(rows) => if (match json_array_len(rows) { Ok(n) => n, Err(e) => 0 }) == 0 {
            stop(conn)
            Err(NotFound("product not found"))
        } else {
            let stock: i64 = match json_array_get(rows, 0) {
                Ok(row) => match json_get_i64(row, "stock") {
                    Ok(s) => s,
                    Err(e) => -1,
                },
                Err(e) => -1,
            }

            if item.quantity <= 0 {
                stop(conn)
                Err(InvalidInput("quantity must be positive"))
            } else {
                if stock < 0 || item.quantity > stock {
                    stop(conn)
                    Err(OutOfStock("insufficient stock"))
                } else {
                    let inserted: Result(i64, str) = db_execute(
                        conn,
                        "INSERT INTO cart_item
                         (cart_id, product_id, quantity)
                         VALUES (?, ?, ?)",
                        item.cart_id,
                        item.product_id,
                        item.quantity
                    )
                    stop(conn)
                    match inserted {
                        Ok(n) => Ok(n),
                        Err(e) => Err(DbError(e)),
                    }
                }
            }
        },
        Err(e) => Err(DbError(e)),
    }
}

fn create_cart_item(item: CartItem) -> Result(i64, ErrorCode) {
    return match db_connect("shop.db") {
        Ok(conn) => create_cart_item_inner(conn, item),
        Err(e) => Err(DbError(e)),
    }
}

fn list_cart_items_inner(conn: db, cart_id: i64) -> Result(json, ErrorCode) {
    let result: Result(json, str) = db_query(
        conn,
        "SELECT
            ci.id,
            ci.cart_id,
            ci.product_id,
            p.name,
            ci.quantity,
            p.price_cents,
            ci.quantity * p.price_cents AS line_total
         FROM cart_item ci
         JOIN product p ON p.id = ci.product_id
         WHERE ci.cart_id = ?
         ORDER BY ci.id",
        cart_id
    )
    stop(conn)
    return match result {
        Ok(rows) => Ok(rows),
        Err(e) => Err(DbError(e)),
    }
}

fn list_cart_items(cart_id: i64) -> Result(json, ErrorCode) {
    return match db_connect("shop.db") {
        Ok(conn) => list_cart_items_inner(conn, cart_id),
        Err(e) => Err(DbError(e)),
    }
}

fn remove_cart_item_inner(conn: db, item_id: i64) -> Result(i64, ErrorCode) {
    let result: Result(i64, str) = db_execute(
        conn,
        "DELETE FROM cart_item
         WHERE id = ?",
        item_id
    )
    stop(conn)
    return match result {
        Ok(n) => Ok(n),
        Err(e) => Err(DbError(e)),
    }
}

fn remove_cart_item(item_id: i64) -> Result(i64, ErrorCode) {
    return match db_connect("shop.db") {
        Ok(conn) => remove_cart_item_inner(conn, item_id),
        Err(e) => Err(DbError(e)),
    }
}

// ---- checkout -------------------------------------------------------------

// Every cart line becomes an `order_item`, decrementing that product's
// stock -- guarded by the same `stock >= ?` conditional-update pattern
// `store.nir`'s single-item checkout uses, so a concurrent sale can't
// oversell. The loop never early-`return`s or early-`stop`s: each
// iteration only writes while `all_ok` is still true, folding any
// failure (missing row, insert error, or a stock race) into that flag
// instead -- `stop(conn)` still happens exactly once, after the loop,
// on every path.
fn create_order_inner(conn: db, customer_id: i64, cart_id: i64) -> Result(i64, ErrorCode) {
    return match db_query(
        conn,
        "SELECT
            ci.product_id,
            ci.quantity,
            p.price_cents,
            p.stock
         FROM cart_item ci
         JOIN product p ON p.id = ci.product_id
         WHERE ci.cart_id = ?",
        cart_id
    ) {
        Ok(rows) => if (match json_array_len(rows) { Ok(n) => n, Err(e) => 0 }) == 0 {
            stop(conn)
            Err(EmptyCart("cart is empty"))
        } else {
            let count: i64 = match json_array_len(rows) {
                Ok(n) => n,
                Err(e) => 0,
            }

            let order_inserted: Result(i64, str) = db_execute(
                conn,
                "INSERT INTO orders
                 (customer_id, status, total_cents)
                 VALUES (?, ?, 0)",
                customer_id,
                "Pending"
            )

            let order_id: i64 = match order_inserted {
                Ok(n) => match db_query(conn, "SELECT last_insert_rowid() as oid") {
                    Ok(idrows) => match json_array_get(idrows, 0) {
                        Ok(row) => match json_get_i64(row, "oid") {
                            Ok(i) => i,
                            Err(e) => -1,
                        },
                        Err(e) => -1,
                    },
                    Err(e) => -1,
                },
                Err(e) => -1,
            }

            let index: i64 = 0
            let running_total: i64 = 0
            let all_ok: bool = order_id >= 0

            while index < count {
                let product_id: i64 = match json_array_get(rows, index) {
                    Ok(row) => match json_get_i64(row, "product_id") {
                        Ok(v) => v,
                        Err(e) => -1,
                    },
                    Err(e) => -1,
                }
                let quantity: i64 = match json_array_get(rows, index) {
                    Ok(row) => match json_get_i64(row, "quantity") {
                        Ok(v) => v,
                        Err(e) => -1,
                    },
                    Err(e) => -1,
                }
                let price_cents: i64 = match json_array_get(rows, index) {
                    Ok(row) => match json_get_i64(row, "price_cents") {
                        Ok(v) => v,
                        Err(e) => -1,
                    },
                    Err(e) => -1,
                }

                let item_valid: bool = all_ok && product_id >= 0 && quantity > 0 && price_cents >= 0

                let stock_updated: Result(i64, str) = if item_valid {
                    db_execute(
                        conn,
                        "UPDATE product
                         SET stock = stock - ?
                         WHERE id = ? AND stock >= ?",
                        quantity,
                        product_id,
                        quantity
                    )
                } else {
                    Err("skipped")
                }

                let item_ok: bool = match stock_updated {
                    Ok(n) => n == 1,
                    Err(e) => false,
                }

                let recorded: Result(i64, str) = if item_ok {
                    db_execute(
                        conn,
                        "INSERT INTO order_item
                         (order_id, product_id, quantity, price_cents)
                         VALUES (?, ?, ?, ?)",
                        order_id,
                        product_id,
                        quantity,
                        price_cents
                    )
                } else {
                    Err("skipped")
                }

                let recorded_ok: bool = match recorded {
                    Ok(n) => true,
                    Err(e) => false,
                }

                if item_ok && recorded_ok {
                    running_total = running_total + (quantity * price_cents)
                } else {
                    all_ok = false
                }

                index = index + 1
            }

            let finalized: Result(i64, str) = if all_ok {
                db_execute(
                    conn,
                    "UPDATE orders
                     SET total_cents = ?,
                         status = ?
                     WHERE id = ?",
                    running_total,
                    "Confirmed",
                    order_id
                )
            } else {
                Err("skipped")
            }

            let finalized_ok: bool = match finalized {
                Ok(n) => true,
                Err(e) => false,
            }

            let cleared: Result(i64, str) = if finalized_ok {
                db_execute(conn, "DELETE FROM cart_item WHERE cart_id = ?", cart_id)
            } else {
                Err("skipped")
            }

            let cleared_ok: bool = match cleared {
                Ok(n) => true,
                Err(e) => false,
            }

            stop(conn)

            if order_id < 0 {
                Err(DbError("failed to create order"))
            } else {
                if all_ok == false {
                    Err(OutOfStock("insufficient stock for one or more items"))
                } else {
                    if finalized_ok == false || cleared_ok == false {
                        Err(OrderError("failed to finalize order"))
                    } else {
                        Ok(order_id)
                    }
                }
            }
        },
        Err(e) => Err(DbError(e)),
    }
}

fn create_order(customer_id: i64, cart_id: i64) -> Result(i64, ErrorCode) {
    return match db_connect("shop.db") {
        Ok(conn) => create_order_inner(conn, customer_id, cart_id),
        Err(e) => Err(DbError(e)),
    }
}

// ---- orders -------------------------------------------------------------

fn list_order_inner(conn: db) -> Result(json, ErrorCode) {
    let result: Result(json, str) = db_query(
        conn,
        "SELECT
            id,
            customer_id,
            status,
            total_cents
         FROM orders
         ORDER BY id DESC"
    )
    stop(conn)
    return match result {
        Ok(rows) => Ok(rows),
        Err(e) => Err(DbError(e)),
    }
}

fn list_order() -> Result(json, ErrorCode) {
    return match db_connect("shop.db") {
        Ok(conn) => list_order_inner(conn),
        Err(e) => Err(DbError(e)),
    }
}

fn list_order_item_inner(conn: db) -> Result(json, ErrorCode) {
    let result: Result(json, str) = db_query(
        conn,
        "SELECT
            id,
            order_id,
            product_id,
            quantity,
            price_cents
         FROM order_item
         ORDER BY order_id DESC, id"
    )
    stop(conn)
    return match result {
        Ok(rows) => Ok(rows),
        Err(e) => Err(DbError(e)),
    }
}

fn list_order_item() -> Result(json, ErrorCode) {
    return match db_connect("shop.db") {
        Ok(conn) => list_order_item_inner(conn),
        Err(e) => Err(DbError(e)),
    }
}

fn update_order_status_inner(conn: db, order_id: i64, status: Text) -> Result(i64, ErrorCode) {
    let result: Result(i64, str) = db_execute(
        conn,
        "UPDATE orders
         SET status = ?
         WHERE id = ?",
        status.value,
        order_id
    )
    stop(conn)
    return match result {
        Ok(n) => Ok(n),
        Err(e) => Err(DbError(e)),
    }
}

fn update_order_status(order_id: i64, status: Text) -> Result(i64, ErrorCode) requires(role: "admin") {
    return match db_connect("shop.db") {
        Ok(conn) => update_order_status_inner(conn, order_id, status),
        Err(e) => Err(DbError(e)),
    }
}

fn main() {
    let result: Result(i64, ErrorCode) = initialize_database()

    match result {
        Ok(n) => print("shopping database ready"),
        Err(e) => print("shopping database initialization failed"),
    }
}
