fn update_order_status(order_id: i64, status: str)
    -> Result(i64, ErrorCode)
requires(role: "admin") {

    return match db_connect("shop.db") {

        Ok(conn) => {

            let result: Result(i64, str) = db_execute(
                conn,
                "UPDATE orders
                 SET status = ?
                 WHERE id = ?",
                status,
                order_id
            )

            stop(conn)

            match result {
                Ok(n) => Ok(n),
                Err(e) => Err(DbError(e))
            }
        }

        Err(e) => Err(DbError(e))
    }
}


fn main() {

    let result: Result(i64, ErrorCode) = initialize_database()

    match result {

        Ok(n) => print("shopping database ready"),

        Err(e) => print("shopping database initialization failed")
    }
}