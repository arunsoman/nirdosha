fn create_cart_item(item: CartItem) -> Result(i64, ErrorCode) {

    return match db_connect("shop.db") {

        Ok(conn) => {

            let product: Result(json, str) = db_query(
                conn,
                "SELECT stock
                 FROM product
                 WHERE id = ? AND active = 1",
                item.product_id
            )

            let result: Result(i64, str) = match product {

                Ok(rows) => {

                    let count: i64 = json_array_len(rows)

                    if count == 0 {

                        Err("product not found")

                    } else {

                        let row: Result(json, str) = json_array_get(rows, 0)

                        match row {

                            Ok(r) => {

                                match json_get_i64(r, "stock") {

                                    Ok(stock) => {

                                        if item.quantity <= 0 {

                                            Err("quantity must be positive")

                                        } else {
                                            if item.quantity > stock {

                                                Err("insufficient stock")

                                            } else {

                                                db_execute(
                                                    conn,
                                                    "INSERT INTO cart_item
                                                     (cart_id, product_id, quantity)
                                                     VALUES (?, ?, ?)",
                                                    item.cart_id,
                                                    item.product_id,
                                                    item.quantity
                                                )
                                            }
                                        }
                                    }

                                    Err(e) => Err(e)
                                }
                            }

                            Err(e) => Err(e)
                        }
                    }
                }

                Err(e) => Err(e)
            }

            stop(conn)

            match result {
                Ok(n) => Ok(n),
                Err(e) => Err(InvalidInput(e))
            }
        }

        Err(e) => Err(DbError(e))
    }
}


fn list_cart_items(cart_id: i64) -> Result(json, ErrorCode) {

    return match db_connect("shop.db") {

        Ok(conn) => {

            let result: Result(json, str) = db_query(
                conn,
                "SELECT
                    ci.id,
                    ci.cart_id,
                    ci.product_id,
                    p.name,
                    ci.quantity,
                    p.price_cents,
                    ci.quantity * p.price_cents AS line_total
                 FROM cart_item ci
                 JOIN product p ON p.id = ci.product_id
                 WHERE ci.cart_id = ?
                 ORDER BY ci.id",
                cart_id
            )

            stop(conn)

            match result {
                Ok(rows) => Ok(rows),
                Err(e) => Err(DbError(e))
            }
        }

        Err(e) => Err(DbError(e))
    }
}


fn remove_cart_item(item_id: i64) -> Result(i64, ErrorCode) {

    return match db_connect("shop.db") {

        Ok(conn) => {

            let result: Result(i64, str) = db_execute(
                conn,
                "DELETE FROM cart_item
                 WHERE id = ?",
                item_id
            )

            stop(conn)

            match result {
                Ok(n) => Ok(n),
                Err(e) => Err(DbError(e))
            }
        }

        Err(e) => Err(DbError(e))
    }
}


fn create_order(customer_id: i64, cart_id: i64) -> Result(i64, ErrorCode) {

    return match db_connect("shop.db") {

        Ok(conn) => {

            let cart: Result(json, str) = db_query(
                conn,
                "SELECT
                    ci.product_id,
                    ci.quantity,
                    p.price_cents,
                    p.stock
                 FROM cart_item ci
                 JOIN product p ON p.id = ci.product_id
                 WHERE ci.cart_id = ?",
                cart_id
            )

            let result: Result(i64, str) = match cart {

                Ok(rows) => {

                    let count: i64 = json_array_len(rows)

                    if count == 0 {

                        Err("cart is empty")

                    } else {

                        let order_result: Result(i64, str) = db_execute(
                            conn,
                            "INSERT INTO orders
                             (customer_id, status, total_cents)
                             VALUES (?, ?, 0)",
                            customer_id,
                            "Pending"
                        )

                        match order_result {

                            Ok(order_id) => {

                                let index: i64 = 0

                                let total: i64 = 0

                                while index < count {

                                    let row_result: Result(json, str) =
                                        json_array_get(rows, index)

                                    match row_result {

                                        Ok(row) => {

                                            let product_result: Result(i64, str) =
                                                json_get_i64(row, "product_id")

                                            let quantity_result: Result(i64, str) =
                                                json_get_i64(row, "quantity")

                                            let price_result: Result(i64, str) =
                                                json_get_i64(row, "price_cents")

                                            match product_result {

                                                Ok(product_id) => {

                                                    match quantity_result {

                                                        Ok(quantity) => {

                                                            match price_result {

                                                                Ok(price) => {

                                                                    let line_total: i64 =
                                                                        quantity * price

                                                                    let inserted:
                                                                        Result(i64, str) =
                                                                        db_execute(
                                                                            conn,
                                                                            "INSERT INTO order_item
                                                                             (order_id,
                                                                              product_id,
                                                                              quantity,
                                                                              price_cents)
                                                                             VALUES (?, ?, ?, ?)",
                                                                            order_id,
                                                                            product_id,
                                                                            quantity,
                                                                            price
                                                                        )

                                                                    match inserted {

                                                                        Ok(n) => {

                                                                            let stock_update:
                                                                                Result(i64, str) =
                                                                                db_execute(
                                                                                    conn,
                                                                                    "UPDATE product
                                                                                     SET stock = stock - ?
                                                                                     WHERE id = ?
                                                                                     AND stock >= ?",
                                                                                    quantity,
                                                                                    product_id,
                                                                                    quantity
                                                                                )

                                                                            match stock_update {

                                                                                Ok(updated) => {

                                                                                    if updated == 1 {

                                                                                        index = index + 1

                                                                                        total =
                                                                                            total + line_total
                                                                                    } else {

                                                                                        stop(conn)

                                                                                        return Err(
                                                                                            OutOfStock(
                                                                                                "product stock changed"
                                                                                            )
                                                                                        )
                                                                                    }
                                                                                }

                                                                                Err(e) => {

                                                                                    stop(conn)

                                                                                    return Err(
                                                                                        DbError(e)
                                                                                    )
                                                                                }
                                                                            }
                                                                        }

                                                                        Err(e) => {

                                                                            stop(conn)

                                                                            return Err(
                                                                                OrderError(e)
                                                                            )
                                                                        }
                                                                    }
                                                                }

                                                                Err(e) => {

                                                                    stop(conn)

                                                                    return Err(
                                                                        OrderError(e)
                                                                    )
                                                                }
                                                            }
                                                        }

                                                        Err(e) => {

                                                            stop(conn)

                                                            return Err(
                                                                OrderError(e)
                                                            )
                                                        }
                                                    }
                                                }

                                                Err(e) => {

                                                    stop(conn)

                                                    return Err(
                                                        OrderError(e)
                                                    )
                                                }
                                            }
                                        }

                                        Err(e) => {

                                            stop(conn)

                                            return Err(
                                                OrderError(e)
                                            )
                                        }
                                    }
                                }

                                let updated_order: Result(i64, str) =
                                    db_execute(
                                        conn,
                                        "UPDATE orders
                                         SET total_cents = ?,
                                             status = ?
                                         WHERE id = ?",
                                        total,
                                        "Confirmed",
                                        order_id
                                    )

                                match updated_order {

                                    Ok(n) => {

                                        let cleared: Result(i64, str) =
                                            db_execute(
                                                conn,
                                                "DELETE FROM cart_item
                                                 WHERE cart_id = ?",
                                                cart_id
                                            )

                                        match cleared {
                                            Ok(x) => Ok(order_id),
                                            Err(e) => Err(OrderError(e))
                                        }
                                    }

                                    Err(e) => Err(OrderError(e))
                                }
                            }

                            Err(e) => Err(OrderError(e))
                        }
                    }
                }

                Err(e) => Err(DbError(e))
            }

            stop(conn)

            result
        }

        Err(e) => Err(DbError(e))
    }
}


fn list_order() -> Result(json, ErrorCode) {

    return match db_connect("shop.db") {

        Ok(conn) => {

            let result: Result(json, str) = db_query(
                conn,
                "SELECT
                    id,
