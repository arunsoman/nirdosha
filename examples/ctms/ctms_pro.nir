fn create_consent_record_inner(conn: db, c: ConsentRecord) -> Result(i64, ErrorCode) {
    let c1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS consent_record (id INTEGER PRIMARY KEY AUTOINCREMENT, subject_ref TEXT, status TEXT, recorded_unix INTEGER)") { Ok(n) => n, Err(e) => -1 }
    let result: Result(i64, ErrorCode) = match db_execute(conn, "INSERT INTO consent_record (subject_ref, status, recorded_unix) VALUES (?, ?, ?)", c.subject_ref, c.status, c.recorded_unix) { Ok(n) => Ok(n), Err(e) => Err(DbError(e)) }
    stop conn
