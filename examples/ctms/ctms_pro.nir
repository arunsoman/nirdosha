    let result: Result(i64, ErrorCode) = match db_execute(conn, "UPDATE compliance_policy SET name = ?, threshold_cents = ?, active = ? WHERE id = ?", p.name, p.threshold_cents, p.active, p.id) { Ok(n) => Ok(n), Err(e) => Err(DbError(e)) }
