fn stat_shared_volume_count_inner(conn: db) -> Result(i64, ErrorCode) {
    let c: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS data_sharing_log_entry (id INTEGER PRIMARY KEY AUTOINCREMENT, who TEXT, what TEXT, destination TEXT, occurred_unix INTEGER, signature_status TEXT)") { Ok(n) => n, Err(e) => -1 }
    let result: Result(i64, ErrorCode) = match db_query(conn, "SELECT COUNT(*) AS value FROM data_sharing_log_entry") {
        Ok(rows) => match json_array_get(rows, 0) { Ok(row) => match json_get_i64(row, "value") { Ok(n) => Ok(n), Err(e) => Ok(0) }, Err(e) => Ok(0) },
        Err(e) => Err(DbError(e)),
    }
    stop conn
    return result
}
