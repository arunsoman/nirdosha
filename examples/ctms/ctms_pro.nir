// =========================================================================
// Module 7: Crypto Risk Monitoring (Phase 2)
// Doc: "Fiat-Crypto Identifier Engine" (MCC filtering, merchant name
// matching, keyword scanner) / "Monitoring & Risk Scoring Engine" /
// wallet-level "Wallet Monitor, Crypto Risk Scorer" (clustering,
// tumbler detection, Travel Rule compliance, sanctions screening).
// =========================================================================

module "Crypto Risk Monitoring" {
    struct Wallet {
        id: i64,
        address: str,
        risk_score: i64,
    }

    struct WalletLink {
        id: i64,
        source_wallet_id: i64,
        target_wallet_id: i64,
        hop_count: i64,
    }

    struct CardCryptoTxn {
        id: i64,
        card_ref: str,
        merchant_name: str,
        mcc_code: str,
        amount_cents: i64,
        occurred_unix: i64,
        risk_priority: Severity,
    }

    struct MerchantEntry {
        id: i64,
        merchant_name: str,
        entry_kind: str,
        keyword: str,
    }

    struct TravelRuleCheck {
        id: i64,
        wallet_address: str,
        counterparty_info: str,
        validation_status: ReviewStatus,
        checked_unix: i64,
    }

    struct CryptoComplianceReport {
        id: i64,
        report_kind: str,
        schedule_rule: str,
        dispatch_history: str,
    }

    struct WalletSanctionsHit {
        id: i64,
        wallet_address: str,
        list_source: str,
        match_confidence: i64,
        status: ScreeningStatus,
    }

    struct CryptoLegalHold {
        id: i64,
        wallet_address: str,
        status: HoldStatus,
        applied_unix: i64,
    }
}

