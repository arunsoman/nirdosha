module "Compliance & Regulatory Management" {
    struct CompliancePolicy {
        id: i64,
        name: str,
        threshold_cents: i64,
        active: bool,
    }

    struct ComplianceFlagEntry {
        id: i64,
        rule_matched: str,
        entity_ref: str,
        threshold_value: i64,
        severity: Severity,
        flagged_unix: i64,
        status: CaseStatus,
    }

    struct ComplianceReportTemplate {
        id: i64,
        template_name: str,
        report_kind: str,
        schedule_rule: str,
        field_mapping: str,
    }

    struct LegalHold {
        id: i64,
        investigation_id: i64,
        applied_by: str,
        status: HoldStatus,
        expiry_unix: i64,
    }

    struct FilingDeadline {
        id: i64,
        jurisdiction: str,
        report_kind: str,
        due_unix: i64,
        filed: bool,
    }

    struct WatchlistEntry {
        id: i64,
        entity_ref: str,
        reason: str,
        source: str,
        added_unix: i64,
        listed: bool,
    }
}

