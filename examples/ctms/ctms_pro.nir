    let result: Result(i64, ErrorCode) = match db_execute(conn, "INSERT INTO investigation (subject_name, status, severity, risk_score, sla_deadline_unix, assigned_to) VALUES (?, ?, ?, ?, ?, ?)", m.subject_name, m.status, m.severity, m.risk_score, m.sla_deadline_unix, m.assigned_to) { Ok(n) => Ok(n), Err(e) => Err(DbError(e)) }
    stop conn
