}

// =========================================================================
// Module 3: Investigative Case Management System
// Doc: "Case Intake Service" / "Assignment and Workflow Manager" /
// "Investigation Workspace" / "Collaboration & Escalation Tools" /
// "Evidence Management" / "Decision Engine" / "Audit & Reporting Layer".
// The core entity is named `Investigation`, not `Case` -- `CASE` is a
// reserved SQL keyword and this file hand-writes real SQL against it
// (same avoidance `ctms.nir` already used, naming it `Matter` there;
// `Investigation` is the doc's own term for the same thing -- "Stage 1:
// Investigation & Enrichment").
// =========================================================================

struct Investigation {
    id: i64,
    subject_name: str,
    status: CaseStatus,
    severity: Severity,
    risk_score: i64,
    // Doc: "SLA-based queues (e.g., P1 must be touched within 30 mins)".
    sla_deadline_unix: i64,
    assigned_to: str,
}

fn list_investigation_inner(conn: db) -> Result(json, ErrorCode) {
    let c: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS investigation (id INTEGER PRIMARY KEY AUTOINCREMENT, subject_name TEXT, status TEXT, severity TEXT, risk_score INTEGER, sla_deadline_unix INTEGER, assigned_to TEXT)") { Ok(n) => n, Err(e) => -1 }
    let rows: Result(json, ErrorCode) = match db_query(conn, "SELECT id, subject_name, status, severity, risk_score, sla_deadline_unix, assigned_to FROM investigation ORDER BY sla_deadline_unix") { Ok(r) => Ok(r), Err(e) => Err(DbError(e)) }
    stop conn
    return rows
}
fn list_investigation() -> Result(json, ErrorCode) requires(role: "investigator") {
    return match db_connect("ctms_pro.db") { Ok(conn) => list_investigation_inner(conn), Err(e) => Err(DbError(e)) }
}
