    let c: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS schema_version_entry (id INTEGER PRIMARY KEY AUTOINCREMENT, source_id INTEGER, version_number INTEGER, field_diff TEXT, backward_compatible INTEGER, approved INTEGER)") { Ok(n) => n, Err(e) => -1 }
    let result: Result(i64, ErrorCode) = match db_execute(conn, "INSERT INTO schema_version_entry (source_id, version_number, field_diff, backward_compatible, approved) VALUES (?, ?, ?, ?, 0)", s.source_id, s.version_number, s.field_diff, s.backward_compatible) { Ok(n) => Ok(n), Err(e) => Err(DbError(e)) }
    stop conn
