// ---- Dashboard tiles/visuals this module contributes (folded into the
// one program-wide `dashboard{}` block at the very end of this file --
// `typeck.rs`'s single-`dashboard{}`-per-program rule). ------------------

fn stat_active_source_count_inner(conn: db) -> Result(i64, ErrorCode) {
    let c: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS data_source (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT, source_type TEXT, format TEXT, connection_status TEXT, last_ingestion_unix INTEGER, active INTEGER)") { Ok(n) => n, Err(e) => -1 }
    let result: Result(i64, ErrorCode) = match db_query(conn, "SELECT COUNT(*) AS value FROM data_source WHERE active = 1") {
        Ok(rows) => match json_array_get(rows, 0) { Ok(row) => match json_get_i64(row, "value") { Ok(n) => Ok(n), Err(e) => Ok(0) }, Err(e) => Ok(0) },
        Err(e) => Err(DbError(e)),
    }
    stop conn
    return result
}
fn stat_active_source_count() -> Result(i64, ErrorCode) requires(role: "ingestion_admin") {
    return match db_connect("ctms_pro.db") { Ok(conn) => stat_active_source_count_inner(conn), Err(e) => Err(DbError(e)) }
}
fn stat_unreviewed_ingestion_error_count_inner(conn: db) -> Result(i64, ErrorCode) {
    let c: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS ingestion_error_entry (id INTEGER PRIMARY KEY AUTOINCREMENT, source_id INTEGER, error_type TEXT, record_snippet TEXT, rejection_reason TEXT, occurred_unix INTEGER, reviewed INTEGER)") { Ok(n) => n, Err(e) => -1 }
    let result: Result(i64, ErrorCode) = match db_query(conn, "SELECT COUNT(*) AS value FROM ingestion_error_entry WHERE reviewed = 0") {
        Ok(rows) => match json_array_get(rows, 0) { Ok(row) => match json_get_i64(row, "value") { Ok(n) => Ok(n), Err(e) => Ok(0) }, Err(e) => Ok(0) },
        Err(e) => Err(DbError(e)),
    }
    stop conn
    return result
}
fn stat_unreviewed_ingestion_error_count() -> Result(i64, ErrorCode) requires(role: "ingestion_admin") {
    return match db_connect("ctms_pro.db") { Ok(conn) => stat_unreviewed_ingestion_error_count_inner(conn), Err(e) => Err(DbError(e)) }
}
// "Alert volumes by severity" / per-source ingestion volume -- a real
// `GROUP BY`, `chart_<name>() -> json` shaped `{label,value}[]`.
fn chart_ingestion_volume_by_source_inner(conn: db) -> Result(json, ErrorCode) {
    let c: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS lineage_entry (id INTEGER PRIMARY KEY AUTOINCREMENT, source_id INTEGER, record_ref TEXT, transformation_applied TEXT, ingested_unix INTEGER)") { Ok(n) => n, Err(e) => -1 }
    let result: Result(json, ErrorCode) = match db_query(conn, "SELECT CAST(source_id AS TEXT) AS label, COUNT(*) AS value FROM lineage_entry GROUP BY source_id ORDER BY source_id") { Ok(r) => Ok(r), Err(e) => Err(DbError(e)) }
    stop conn
    return result
}
fn chart_ingestion_volume_by_source() -> Result(json, ErrorCode) requires(role: "ingestion_admin") {
    return match db_connect("ctms_pro.db") { Ok(conn) => chart_ingestion_volume_by_source_inner(conn), Err(e) => Err(DbError(e)) }
}

// =========================================================================
// Module 2: Real-Time Fraud Detection and AI Modelling
// Doc: "Detection Engine" (Rule-Based / Anomaly / ML), "Behavioural
// Profiling Subsystem", "Risk Scoring Engine", "Feedback Loop and Model
// Trainer".
// =========================================================================

module "Fraud Detection" {
    struct Alert {
        id: i64,
        transaction_ref: str,
        entity_ref: str,
        risk_score: i64,
        triggering_rule: str,
        severity: Severity,
        status: AlertStatus,
        assigned_to: str,
        detected_unix: i64,
    }

    struct AlertSignal {
        id: i64,
        alert_id: i64,
        signal_name: str,
        contribution_score: i64,
    }

    struct FraudRule {
        id: i64,
        name: str,
        condition_expr: str,
        jurisdiction_scope: str,
        active: bool,
        version_number: i64,
    }

    struct ScoringWeight {
        id: i64,
        signal_name: str,
        weight_percent: i64,
    }

    struct BehaviouralProfile {
        id: i64,
        entity_ref: str,
        baseline_txn_count: i64,
        deviation_score: i64,
        flagged: bool,
    }

    struct MlModel {
        id: i64,
        name: str,
        model_type: str,
        accuracy_percent: i64,
        version_number: i64,
        promoted: bool,
    }

    struct AnalystFeedback {
        id: i64,
        alert_id: i64,
        label: Decision,
        submitted_by: str,
        submitted_unix: i64,
    }
}

// ---- Alert: the Suspicious-Transaction Alert Queue. --------------------

fn list_alert_inner(conn: db) -> Result(json, ErrorCode) {
    let c: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS alert (id INTEGER PRIMARY KEY AUTOINCREMENT, transaction_ref TEXT, entity_ref TEXT, risk_score INTEGER, triggering_rule TEXT, severity TEXT, status TEXT, assigned_to TEXT, detected_unix INTEGER)") { Ok(n) => n, Err(e) => -1 }
    let rows: Result(json, ErrorCode) = match db_query(conn, "SELECT id, transaction_ref, entity_ref, risk_score, triggering_rule, severity, status, assigned_to, detected_unix FROM alert ORDER BY detected_unix DESC") { Ok(r) => Ok(r), Err(e) => Err(DbError(e)) }
    stop conn
    return rows
}
fn list_alert() -> Result(json, ErrorCode) requires(role: "fraud_analyst") {
    return match db_connect("ctms_pro.db") { Ok(conn) => list_alert_inner(conn), Err(e) => Err(DbError(e)) }
}
fn get_alert_inner(conn: db, id: i64) -> Result(json, ErrorCode) {
