    let result: Result(i64, ErrorCode) = match db_execute(conn, "INSERT INTO validation_rule (name, condition_expr, rejection_reason, active) VALUES (?, ?, ?, ?)", r.name, r.condition_expr, r.rejection_reason, r.active) { Ok(n) => Ok(n), Err(e) => Err(DbError(e)) }
