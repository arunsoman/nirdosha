fn create_schema_version_entry(s: SchemaVersionEntry) -> Result(i64, ErrorCode) requires(role: "ingestion_admin") {
    return match db_connect("ctms_pro.db") { Ok(conn) => create_schema_version_entry_inner(conn, s), Err(e) => Err(DbError(e)) }
}
fn approve_schema_version_inner(conn: db, id: i64) -> Result(json, ErrorCode) {
    let c: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS schema_version_entry (id INTEGER PRIMARY KEY AUTOINCREMENT, source_id INTEGER, version_number INTEGER, field_diff TEXT, backward_compatible INTEGER, approved INTEGER)") { Ok(n) => n, Err(e) => -1 }
    let updated: Result(i64, ErrorCode) = match db_execute(conn, "UPDATE schema_version_entry SET approved = 1 WHERE id = ?", id) { Ok(n) => Ok(n), Err(e) => Err(DbError(e)) }
    let confirm: Result(json, ErrorCode) = match updated {
        Ok(n) => match db_query(conn, "SELECT id, approved FROM schema_version_entry WHERE id = ?", id) {
            Ok(r) => match json_array_get(r, 0) { Ok(one) => Ok(one), Err(e) => Err(DbError(e)) },
            Err(e) => Err(DbError(e)),
        },
        Err(e) => Err(e),
    }
    stop conn
    return confirm
}
fn approve_schema_version(id: i64) -> Result(json, ErrorCode) requires(role: "ingestion_admin") {
    return match db_connect("ctms_pro.db") { Ok(conn) => approve_schema_version_inner(conn, id), Err(e) => Err(DbError(e)) }
}

screen SchemaVersionEntry {
    title: "Schema Registry & Drift"
    field source_id {
        render: "searchable_select"
        source: DataSource
    }
    action "Approve" -> approve_schema_version {
        style: "filled"
        confirm: "Approve this schema version? Consumers will start reading it immediately."
        show_result: true
    }

    layout {
        row {
            column {
                field source_id
                field version_number
                field field_diff
            }
            column {
                field backward_compatible
                field approved
                action "Approve"
            }
        }
    }
}

// ---- LineageEntry: per-record lineage/audit trail (read-mostly). -----

fn list_lineage_entry_inner(conn: db) -> Result(json, ErrorCode) {
    let c: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS lineage_entry (id INTEGER PRIMARY KEY AUTOINCREMENT, source_id INTEGER, record_ref TEXT, transformation_applied TEXT, ingested_unix INTEGER)") { Ok(n) => n, Err(e) => -1 }
    let rows: Result(json, ErrorCode) = match db_query(conn, "SELECT id, source_id, record_ref, transformation_applied, ingested_unix FROM lineage_entry ORDER BY ingested_unix DESC") { Ok(r) => Ok(r), Err(e) => Err(DbError(e)) }
    stop conn
    return rows
}
fn list_lineage_entry() -> Result(json, ErrorCode) requires(role: "ingestion_admin") {
    return match db_connect("ctms_pro.db") { Ok(conn) => list_lineage_entry_inner(conn), Err(e) => Err(DbError(e)) }
}
fn create_lineage_entry_inner(conn: db, l: LineageEntry) -> Result(i64, ErrorCode) {
