}
fn update_validation_rule_inner(conn: db, r: ValidationRule) -> Result(i64, ErrorCode) {
    let c: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS validation_rule (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT, condition_expr TEXT, rejection_reason TEXT, active INTEGER)") { Ok(n) => n, Err(e) => -1 }
    let result: Result(i64, ErrorCode) = match db_execute(conn, "UPDATE validation_rule SET name = ?, condition_expr = ?, rejection_reason = ?, active = ? WHERE id = ?", r.name, r.condition_expr, r.rejection_reason, r.active, r.id) { Ok(n) => Ok(n), Err(e) => Err(DbError(e)) }
