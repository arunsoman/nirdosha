// Track E4 preview: how many alerts on record would this rule's own
// jurisdiction scope have matched, without touching `fraud_rule` itself.
fn simulate_fraud_rule_inner(conn: db, id: i64) -> Result(json, ErrorCode) {
    let c1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS fraud_rule (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT, condition_expr TEXT, jurisdiction_scope TEXT, active INTEGER, version_number INTEGER)") { Ok(n) => n, Err(e) => -1 }
    let c2: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS alert (id INTEGER PRIMARY KEY AUTOINCREMENT, transaction_ref TEXT, entity_ref TEXT, risk_score INTEGER, triggering_rule TEXT, severity TEXT, status TEXT, assigned_to TEXT, detected_unix INTEGER)") { Ok(n) => n, Err(e) => -1 }
    let result: Result(json, ErrorCode) = match db_query(
        conn,
        "SELECT (SELECT name FROM fraud_rule WHERE id = ?) AS rule, (SELECT COUNT(*) FROM alert WHERE triggering_rule = (SELECT name FROM fraud_rule WHERE id = ?)) AS would_have_matched",
        id, id
    ) {
        Ok(rows) => match json_array_get(rows, 0) { Ok(one) => Ok(one), Err(e) => Err(DbError(e)) },
        Err(e) => Err(DbError(e)),
    }
    stop conn
    return result
}
fn simulate_fraud_rule(id: i64) -> Result(json, ErrorCode) requires(role: "fraud_analyst") {
    return match db_connect("ctms_pro.db") { Ok(conn) => simulate_fraud_rule_inner(conn, id), Err(e) => Err(DbError(e)) }
}

screen FraudRule {
