// Doc: "MCC Filtering... 6051/4829" + "Keyword Scanner" -- a real,
// hand-written detection preview against the merchant dictionary below.
fn simulate_card_crypto_detection_inner(conn: db, id: i64) -> Result(json, ErrorCode) {
    let c1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS card_crypto_txn (id INTEGER PRIMARY KEY AUTOINCREMENT, card_ref TEXT, merchant_name TEXT, mcc_code TEXT, amount_cents INTEGER, occurred_unix INTEGER, risk_priority TEXT)") { Ok(n) => n, Err(e) => -1 }
    let c2: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS merchant_entry (id INTEGER PRIMARY KEY AUTOINCREMENT, merchant_name TEXT, entry_kind TEXT, keyword TEXT)") { Ok(n) => n, Err(e) => -1 }
    let result: Result(json, ErrorCode) = match db_query(
        conn,
        "SELECT merchant_name, mcc_code, (mcc_code IN ('6051','4829')) AS mcc_flagged, (EXISTS (SELECT 1 FROM merchant_entry WHERE merchant_entry.merchant_name = card_crypto_txn.merchant_name)) AS known_exchange FROM card_crypto_txn WHERE id = ?",
        id
    ) {
        Ok(rows) => match json_array_get(rows, 0) { Ok(one) => Ok(one), Err(e) => Err(DbError(e)) },
        Err(e) => Err(DbError(e)),
    }
    stop conn
    return result
}
fn simulate_card_crypto_detection(id: i64) -> Result(json, ErrorCode) requires(role: "fraud_analyst") {
    return match db_connect("ctms_pro.db") { Ok(conn) => simulate_card_crypto_detection_inner(conn, id), Err(e) => Err(DbError(e)) }
}

screen CardCryptoTxn {
    title: "Fiat-Crypto Correlation"
    field risk_priority {
        render: "badge"
    }
    action "Run Detection Simulation" -> simulate_card_crypto_detection {
        style: "outlined"
        show_result: true
    }

    layout {
        row {
            column {
                group "Transaction" {
                    field card_ref
                    field merchant_name
                    field mcc_code
                    field amount_cents
                }
            }
            column {
                group "Risk" {
                    field risk_priority
                    field occurred_unix
                }
                divider {}
                action "Run Detection Simulation"
            }
        }
    }
}

