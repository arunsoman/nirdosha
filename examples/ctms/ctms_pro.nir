    let c: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS investigation (id INTEGER PRIMARY KEY AUTOINCREMENT, subject_name TEXT, status TEXT, severity TEXT, risk_score INTEGER, sla_deadline_unix INTEGER, assigned_to TEXT)") { Ok(n) => n, Err(e) => -1 }
    let row: Result(json, ErrorCode) = match db_query(conn, "SELECT id, subject_name, status, severity, risk_score, sla_deadline_unix, assigned_to FROM investigation WHERE id = ?", id) {
        Ok(r) => match json_array_get(r, 0) { Ok(one) => Ok(one), Err(e) => Err(DbError(e)) },
        Err(e) => Err(DbError(e)),
    }
    stop conn
    return row
}
fn get_investigation(id: i64) -> Result(json, ErrorCode) requires(role: "investigator") {
    return match db_connect("ctms_pro.db") { Ok(conn) => get_investigation_inner(conn, id), Err(e) => Err(DbError(e)) }
}
