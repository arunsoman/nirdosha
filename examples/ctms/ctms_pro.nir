}
// Decision Engine (doc): "Users select resolution (Confirmed Fraud,
// False Positive, Suspicious -- Re-monitor)". A real `Decision` enum
// parameter, not free text -- a `workspace` `panel` action renders a
// genuine multi-field form (unlike a plain `screen` action, which only
// auto-fills one param from the row), so this can be a proper closed
// choice this time instead of `ctms.nir`'s disclosed free-text gap.
fn record_investigation_decision_inner(conn: db, id: i64, resolution: Decision, justification: Text) -> Result(json, ErrorCode) {
    let c: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS investigation (id INTEGER PRIMARY KEY AUTOINCREMENT, subject_name TEXT, status TEXT, severity TEXT, risk_score INTEGER, sla_deadline_unix INTEGER, assigned_to TEXT)") { Ok(n) => n, Err(e) => -1 }
    let new_status: CaseStatus = match resolution {
        DecisionConfirmedFraud() => CaseStatusEscalated(),
        DecisionFalsePositive() => CaseStatusClosed(),
        DecisionSuspiciousReMonitor() => CaseStatusInProgress(),
    }
    let result: Result(i64, ErrorCode) = match db_execute(conn, "UPDATE investigation SET status = ? WHERE id = ?", new_status, id) { Ok(n) => Ok(n), Err(e) => Err(DbError(e)) }
    let confirm: Result(json, ErrorCode) = match result {
        Ok(n) => match db_query(conn, "SELECT id, status FROM investigation WHERE id = ?", id) {
            Ok(r) => match json_array_get(r, 0) { Ok(one) => Ok(one), Err(e) => Err(DbError(e)) },
            Err(e) => Err(DbError(e)),
        },
        Err(e) => Err(e),
    }
    stop conn
    return confirm
}
fn record_investigation_decision(id: i64, resolution: Decision, justification: Text) -> Result(json, ErrorCode) requires(role: "investigator") {
    return match db_connect("ctms_pro.db") { Ok(conn) => record_investigation_decision_inner(conn, id, resolution, justification), Err(e) => Err(DbError(e)) }
}
// Doc: "Audit-Ready Documentation & Export -- Downloadable dossier of
// all case artifacts (PDF/CSV/JSON)". No file/blob type in Nirdosha yet
// (same disclosed gap `ctms.nir` already named) -- this returns the
// JSON summary a real signed PDF/CSV bundle would be built from.
fn export_investigation_dossier_inner(conn: db, id: i64) -> Result(json, ErrorCode) {
    let c: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS investigation (id INTEGER PRIMARY KEY AUTOINCREMENT, subject_name TEXT, status TEXT, severity TEXT, risk_score INTEGER, sla_deadline_unix INTEGER, assigned_to TEXT)") { Ok(n) => n, Err(e) => -1 }
    let result: Result(json, ErrorCode) = match db_query(conn, "SELECT id, subject_name, status, severity, risk_score FROM investigation WHERE id = ?", id) {
        Ok(r) => match json_array_get(r, 0) { Ok(one) => Ok(one), Err(e) => Err(DbError(e)) },
        Err(e) => Err(DbError(e)),
    }
    stop conn
    return result
}
fn export_investigation_dossier(id: i64) -> Result(json, ErrorCode) requires(role: "investigator") {
    return match db_connect("ctms_pro.db") { Ok(conn) => export_investigation_dossier_inner(conn, id), Err(e) => Err(DbError(e)) }
}

screen Investigation {
    title: "Investigation Queue"
    field status {
        render: "badge"
    }
    field severity {
        render: "badge"
    }
    field sla_deadline_unix {
        label: "SLA"
        render: "countdown"
    }
    action "Export Dossier" -> export_investigation_dossier {
        style: "outlined"
        show_result: true
    }

    layout {
        row {
            column {
                group "Investigation" {
                    field subject_name
                    field status
                    field severity
                    field risk_score
                }
            }
            column {
                group "Routing" {
                    field assigned_to
                    field sla_deadline_unix
                }
                divider {}
                action "Export Dossier"
            }
        }
    }
}

// ---- Transaction: workspace-panel-only (scoped per investigation). ---

fn create_investigation_transaction_inner(conn: db, investigation_id: i64, amount_cents: i64, geo_country: Text, geo_lat: f64, geo_lng: f64, created_unix: i64) -> Result(i64, ErrorCode) {
    let c: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS investigation_transaction (id INTEGER PRIMARY KEY AUTOINCREMENT, investigation_id INTEGER, amount_cents INTEGER, geo_country TEXT, created_unix INTEGER, geo_lat REAL, geo_lng REAL)") { Ok(n) => n, Err(e) => -1 }
    let result: Result(i64, ErrorCode) = match db_execute(
        conn,
        "INSERT INTO investigation_transaction (investigation_id, amount_cents, geo_country, created_unix, geo_lat, geo_lng) VALUES (?, ?, ?, ?, ?, ?)",
        investigation_id, amount_cents, geo_country.value, created_unix, geo_lat, geo_lng
    ) { Ok(n) => Ok(n), Err(e) => Err(DbError(e)) }
    stop conn
    return result
}
fn create_investigation_transaction(investigation_id: i64, amount_cents: i64, geo_country: Text, geo_lat: f64, geo_lng: f64, created_unix: i64) -> Result(i64, ErrorCode) requires(role: "investigator") {
    return match db_connect("ctms_pro.db") { Ok(conn) => create_investigation_transaction_inner(conn, investigation_id, amount_cents, geo_country, geo_lat, geo_lng, created_unix), Err(e) => Err(DbError(e)) }
}
// Timeline contract: `{ts, label}[]`.
fn list_transaction_for_investigation_inner(conn: db, investigation_id: i64) -> Result(json, ErrorCode) {
    let c: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS investigation_transaction (id INTEGER PRIMARY KEY AUTOINCREMENT, investigation_id INTEGER, amount_cents INTEGER, geo_country TEXT, created_unix INTEGER, geo_lat REAL, geo_lng REAL)") { Ok(n) => n, Err(e) => -1 }
    let rows: Result(json, ErrorCode) = match db_query(
        conn,
        "SELECT created_unix AS ts, (CAST(amount_cents AS TEXT) || ' cents -- ' || geo_country) AS label FROM investigation_transaction WHERE investigation_id = ? ORDER BY created_unix",
        investigation_id
    ) { Ok(r) => Ok(r), Err(e) => Err(DbError(e)) }
    stop conn
    return rows
}
fn list_transaction_for_investigation(investigation_id: i64) -> Result(json, ErrorCode) requires(role: "investigator") {
    return match db_connect("ctms_pro.db") { Ok(conn) => list_transaction_for_investigation_inner(conn, investigation_id), Err(e) => Err(DbError(e)) }
}

