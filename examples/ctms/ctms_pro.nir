// ---- Module 2 dashboard contributions. ---------------------------------

fn stat_open_alert_count_inner(conn: db) -> Result(i64, ErrorCode) {
    let c: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS alert (id INTEGER PRIMARY KEY AUTOINCREMENT, transaction_ref TEXT, entity_ref TEXT, risk_score INTEGER, triggering_rule TEXT, severity TEXT, status TEXT, assigned_to TEXT, detected_unix INTEGER)") { Ok(n) => n, Err(e) => -1 }
    let result: Result(i64, ErrorCode) = match db_query(conn, "SELECT COUNT(*) AS value FROM alert WHERE status = 'AlertStatusOpen'") {
        Ok(rows) => match json_array_get(rows, 0) { Ok(row) => match json_get_i64(row, "value") { Ok(n) => Ok(n), Err(e) => Ok(0) }, Err(e) => Ok(0) },
        Err(e) => Err(DbError(e)),
    }
    stop conn
    return result
}
fn stat_open_alert_count() -> Result(i64, ErrorCode) requires(role: "fraud_analyst") {
    return match db_connect("ctms_pro.db") { Ok(conn) => stat_open_alert_count_inner(conn), Err(e) => Err(DbError(e)) }
}
// "Alert volumes by severity" -- doc's own dashboard widget, named
// verbatim.
fn chart_alert_volume_by_severity_inner(conn: db) -> Result(json, ErrorCode) {
    let c: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS alert (id INTEGER PRIMARY KEY AUTOINCREMENT, transaction_ref TEXT, entity_ref TEXT, risk_score INTEGER, triggering_rule TEXT, severity TEXT, status TEXT, assigned_to TEXT, detected_unix INTEGER)") { Ok(n) => n, Err(e) => -1 }
    let result: Result(json, ErrorCode) = match db_query(conn, "SELECT severity AS label, COUNT(*) AS value FROM alert GROUP BY severity") { Ok(r) => Ok(r), Err(e) => Err(DbError(e)) }
    stop conn
    return result
}
fn chart_alert_volume_by_severity() -> Result(json, ErrorCode) requires(role: "fraud_analyst") {
    return match db_connect("ctms_pro.db") { Ok(conn) => chart_alert_volume_by_severity_inner(conn), Err(e) => Err(DbError(e)) }
}

