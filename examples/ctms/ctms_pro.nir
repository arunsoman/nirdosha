}
fn create_alert_inner(conn: db, a: Alert) -> Result(i64, ErrorCode) {
    let c: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS alert (id INTEGER PRIMARY KEY AUTOINCREMENT, transaction_ref TEXT, entity_ref TEXT, risk_score INTEGER, triggering_rule TEXT, severity TEXT, status TEXT, assigned_to TEXT, detected_unix INTEGER)") { Ok(n) => n, Err(e) => -1 }
    let result: Result(i64, ErrorCode) = match db_execute(conn, "INSERT INTO alert (transaction_ref, entity_ref, risk_score, triggering_rule, severity, status, assigned_to, detected_unix) VALUES (?, ?, ?, ?, ?, ?, ?, ?)", a.transaction_ref, a.entity_ref, a.risk_score, a.triggering_rule, a.severity, a.status, a.assigned_to, a.detected_unix) { Ok(n) => Ok(n), Err(e) => Err(DbError(e)) }
    stop conn
    return result
}
fn create_alert(a: Alert) -> Result(i64, ErrorCode) requires(role: "fraud_analyst") {
    return match db_connect("ctms_pro.db") { Ok(conn) => create_alert_inner(conn, a), Err(e) => Err(DbError(e)) }
}
// Split into two `UPDATE`s -- `db_execute`'s parameterized bind arity
// tops out at 10 total args (conn + query + 8 values), and this
// struct's 8 non-id fields plus `id` itself is 9 binds (11 total), one
// past the ceiling.
fn update_alert_inner(conn: db, a: Alert) -> Result(i64, ErrorCode) {
    let c: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS alert (id INTEGER PRIMARY KEY AUTOINCREMENT, transaction_ref TEXT, entity_ref TEXT, risk_score INTEGER, triggering_rule TEXT, severity TEXT, status TEXT, assigned_to TEXT, detected_unix INTEGER)") { Ok(n) => n, Err(e) => -1 }
    let step1: Result(i64, ErrorCode) = match db_execute(conn, "UPDATE alert SET transaction_ref = ?, entity_ref = ?, risk_score = ?, triggering_rule = ? WHERE id = ?", a.transaction_ref, a.entity_ref, a.risk_score, a.triggering_rule, a.id) { Ok(n) => Ok(n), Err(e) => Err(DbError(e)) }
    let result: Result(i64, ErrorCode) = match step1 {
        Ok(n) => match db_execute(conn, "UPDATE alert SET severity = ?, status = ?, assigned_to = ?, detected_unix = ? WHERE id = ?", a.severity, a.status, a.assigned_to, a.detected_unix, a.id) { Ok(m) => Ok(m), Err(e) => Err(DbError(e)) },
        Err(e) => Err(e),
    }
    stop conn
    return result
}
fn update_alert(a: Alert) -> Result(i64, ErrorCode) requires(role: "fraud_analyst") {
    return match db_connect("ctms_pro.db") { Ok(conn) => update_alert_inner(conn, a), Err(e) => Err(DbError(e)) }
}
// Doc: "Assignment and Workflow Manager" -- assign to an investigator by
// name (free text: this app has no `AppUser` FK wired to `Alert` yet,
// same disclosed shape `ctms.nir` already used for `add_matter_note`'s
// hardcoded author).
fn assign_alert_inner(conn: db, id: i64, investigator: Text) -> Result(json, ErrorCode) {
    let c: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS alert (id INTEGER PRIMARY KEY AUTOINCREMENT, transaction_ref TEXT, entity_ref TEXT, risk_score INTEGER, triggering_rule TEXT, severity TEXT, status TEXT, assigned_to TEXT, detected_unix INTEGER)") { Ok(n) => n, Err(e) => -1 }
    let updated: Result(i64, ErrorCode) = match db_execute(conn, "UPDATE alert SET assigned_to = ?, status = 'AlertStatusAssigned' WHERE id = ?", investigator.value, id) { Ok(n) => Ok(n), Err(e) => Err(DbError(e)) }
    let confirm: Result(json, ErrorCode) = match updated {
        Ok(n) => match db_query(conn, "SELECT id, assigned_to, status FROM alert WHERE id = ?", id) {
            Ok(r) => match json_array_get(r, 0) { Ok(one) => Ok(one), Err(e) => Err(DbError(e)) },
            Err(e) => Err(DbError(e)),
        },
        Err(e) => Err(e),
    }
    stop conn
    return confirm
}
fn assign_alert(id: i64, investigator: Text) -> Result(json, ErrorCode) requires(role: "supervisor") {
    return match db_connect("ctms_pro.db") { Ok(conn) => assign_alert_inner(conn, id, investigator), Err(e) => Err(DbError(e)) }
}
fn dismiss_alert_inner(conn: db, id: i64) -> Result(json, ErrorCode) {
    let c: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS alert (id INTEGER PRIMARY KEY AUTOINCREMENT, transaction_ref TEXT, entity_ref TEXT, risk_score INTEGER, triggering_rule TEXT, severity TEXT, status TEXT, assigned_to TEXT, detected_unix INTEGER)") { Ok(n) => n, Err(e) => -1 }
    let updated: Result(i64, ErrorCode) = match db_execute(conn, "UPDATE alert SET status = 'AlertStatusDismissed' WHERE id = ?", id) { Ok(n) => Ok(n), Err(e) => Err(DbError(e)) }
    let confirm: Result(json, ErrorCode) = match updated {
        Ok(n) => match db_query(conn, "SELECT id, status FROM alert WHERE id = ?", id) {
            Ok(r) => match json_array_get(r, 0) { Ok(one) => Ok(one), Err(e) => Err(DbError(e)) },
            Err(e) => Err(DbError(e)),
        },
        Err(e) => Err(e),
    }
    stop conn
    return confirm
}
fn dismiss_alert(id: i64) -> Result(json, ErrorCode) requires(role: "fraud_analyst") {
    return match db_connect("ctms_pro.db") { Ok(conn) => dismiss_alert_inner(conn, id), Err(e) => Err(DbError(e)) }
}
fn escalate_alert_inner(conn: db, id: i64) -> Result(json, ErrorCode) {
    let c: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS alert (id INTEGER PRIMARY KEY AUTOINCREMENT, transaction_ref TEXT, entity_ref TEXT, risk_score INTEGER, triggering_rule TEXT, severity TEXT, status TEXT, assigned_to TEXT, detected_unix INTEGER)") { Ok(n) => n, Err(e) => -1 }
    let updated: Result(i64, ErrorCode) = match db_execute(conn, "UPDATE alert SET status = 'AlertStatusEscalated' WHERE id = ?", id) { Ok(n) => Ok(n), Err(e) => Err(DbError(e)) }
    let confirm: Result(json, ErrorCode) = match updated {
        Ok(n) => match db_query(conn, "SELECT id, status FROM alert WHERE id = ?", id) {
            Ok(r) => match json_array_get(r, 0) { Ok(one) => Ok(one), Err(e) => Err(DbError(e)) },
            Err(e) => Err(DbError(e)),
        },
        Err(e) => Err(e),
    }
    stop conn
    return confirm
}
fn escalate_alert(id: i64) -> Result(json, ErrorCode) requires(role: "fraud_analyst") {
    return match db_connect("ctms_pro.db") { Ok(conn) => escalate_alert_inner(conn, id), Err(e) => Err(DbError(e)) }
}

screen Alert {
    title: "Suspicious-Transaction Alert Queue"
    field severity {
        render: "badge"
    }
    field status {
        render: "badge"
    }
    action "Assign" -> assign_alert {
        style: "outlined"
        show_result: true
    }
    action "Dismiss" -> dismiss_alert {
        style: "outlined"
        confirm: "Dismiss this alert as a false lead?"
        show_result: true
    }
    action "Escalate to Case" -> escalate_alert {
        style: "filled"
        show_result: true
    }

    layout {
        row {
            column {
                group "Alert" {
                    field transaction_ref
                    field entity_ref
                    field triggering_rule
                    field risk_score
                }
            }
            column {
                group "Triage" {
                    field severity
                    field status
                    field assigned_to
                    field detected_unix
                }
                divider {}
                tabs {
                    tab "Actions" {
                        action "Assign"
                        action "Dismiss"
                        action "Escalate to Case"
                    }
                }
            }
        }
    }
}

