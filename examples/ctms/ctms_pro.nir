// ---- MlModel: model management. ----------------------------------------

fn list_ml_model_inner(conn: db) -> Result(json, ErrorCode) {
    let c: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS ml_model (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT, model_type TEXT, accuracy_percent INTEGER, version_number INTEGER, promoted INTEGER)") { Ok(n) => n, Err(e) => -1 }
    let rows: Result(json, ErrorCode) = match db_query(conn, "SELECT id, name, model_type, accuracy_percent, version_number, promoted FROM ml_model ORDER BY id DESC") { Ok(r) => Ok(r), Err(e) => Err(DbError(e)) }
    stop conn
    return rows
}
fn list_ml_model() -> Result(json, ErrorCode) requires(role: "fraud_analyst") {
    return match db_connect("ctms_pro.db") { Ok(conn) => list_ml_model_inner(conn), Err(e) => Err(DbError(e)) }
}
fn create_ml_model_inner(conn: db, m: MlModel) -> Result(i64, ErrorCode) {
    let c: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS ml_model (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT, model_type TEXT, accuracy_percent INTEGER, version_number INTEGER, promoted INTEGER)") { Ok(n) => n, Err(e) => -1 }
    let result: Result(i64, ErrorCode) = match db_execute(conn, "INSERT INTO ml_model (name, model_type, accuracy_percent, version_number, promoted) VALUES (?, ?, ?, ?, 0)", m.name, m.model_type, m.accuracy_percent, m.version_number) { Ok(n) => Ok(n), Err(e) => Err(DbError(e)) }
    stop conn
    return result
}
fn create_ml_model(m: MlModel) -> Result(i64, ErrorCode) requires(role: "fraud_analyst") {
    return match db_connect("ctms_pro.db") { Ok(conn) => create_ml_model_inner(conn, m), Err(e) => Err(DbError(e)) }
}
fn promote_ml_model_inner(conn: db, id: i64) -> Result(json, ErrorCode) {
    let c: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS ml_model (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT, model_type TEXT, accuracy_percent INTEGER, version_number INTEGER, promoted INTEGER)") { Ok(n) => n, Err(e) => -1 }
    let updated: Result(i64, ErrorCode) = match db_execute(conn, "UPDATE ml_model SET promoted = 1 WHERE id = ?", id) { Ok(n) => Ok(n), Err(e) => Err(DbError(e)) }
    let confirm: Result(json, ErrorCode) = match updated {
        Ok(n) => match db_query(conn, "SELECT id, name, promoted FROM ml_model WHERE id = ?", id) {
            Ok(r) => match json_array_get(r, 0) { Ok(one) => Ok(one), Err(e) => Err(DbError(e)) },
            Err(e) => Err(DbError(e)),
        },
        Err(e) => Err(e),
    }
    stop conn
    return confirm
}
fn promote_ml_model(id: i64) -> Result(json, ErrorCode) requires(role: "fraud_analyst") {
    return match db_connect("ctms_pro.db") { Ok(conn) => promote_ml_model_inner(conn, id), Err(e) => Err(DbError(e)) }
}

screen MlModel {
    title: "ML Model Management"
    action "Promote" -> promote_ml_model {
        style: "filled"
        confirm: "Promote this model version to production scoring?"
        show_result: true
    }

    layout {
        row {
            column {
                field name
                field model_type
            }
            column {
                field accuracy_percent
                field version_number
                field promoted
                action "Promote"
            }
        }
    }
}

