    let row: Result(json, ErrorCode) = match db_query(conn, "SELECT id, transaction_ref, entity_ref, risk_score, triggering_rule, severity, status, assigned_to, detected_unix FROM alert WHERE id = ?", id) {
        Ok(r) => match json_array_get(r, 0) { Ok(one) => Ok(one), Err(e) => Err(DbError(e)) },
        Err(e) => Err(DbError(e)),
    }
