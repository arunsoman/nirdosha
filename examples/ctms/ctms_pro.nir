    return match db_connect("ctms_pro.db") { Ok(conn) => create_consent_record_inner(conn, c), Err(e) => Err(DbError(e)) }
}
fn revoke_consent_inner(conn: db, id: i64) -> Result(json, ErrorCode) {
    let c: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS consent_record (id INTEGER PRIMARY KEY AUTOINCREMENT, subject_ref TEXT, status TEXT, recorded_unix INTEGER)") { Ok(n) => n, Err(e) => -1 }
    let updated: Result(i64, ErrorCode) = match db_execute(conn, "UPDATE consent_record SET status = 'ConsentStatusRevoked' WHERE id = ?", id) { Ok(n) => Ok(n), Err(e) => Err(DbError(e)) }
    let confirm: Result(json, ErrorCode) = match updated {
        Ok(n) => match db_query(conn, "SELECT id, status FROM consent_record WHERE id = ?", id) {
            Ok(r) => match json_array_get(r, 0) { Ok(one) => Ok(one), Err(e) => Err(DbError(e)) },
            Err(e) => Err(DbError(e)),
        },
        Err(e) => Err(e),
    }
    stop conn
    return confirm
}
fn revoke_consent(id: i64) -> Result(json, ErrorCode) requires(role: "compliance_officer") {
    return match db_connect("ctms_pro.db") { Ok(conn) => revoke_consent_inner(conn, id), Err(e) => Err(DbError(e)) }
}

screen ConsentRecord {
    title: "Consent Register"
    field status {
        render: "badge"
    }
    action "Revoke" -> revoke_consent {
        style: "outlined"
        confirm: "Revoke this subject's consent? This is logged and cannot be undone."
        show_result: true
    }

    layout {
        row {
            field subject_ref
            field status
            field recorded_unix
            action "Revoke"
        }
    }
}

