}

screen ValidationRule {
    title: "Validation & Rules Engine Config"

    layout {
        row {
            column {
                field name
                field condition_expr
            }
            column {
                field rejection_reason
                field active
            }
        }
    }
}

// ---- IngestionErrorEntry: triage queue for `ValidationError`. --------

fn list_ingestion_error_entry_inner(conn: db) -> Result(json, ErrorCode) {
    let c: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS ingestion_error_entry (id INTEGER PRIMARY KEY AUTOINCREMENT, source_id INTEGER, error_type TEXT, record_snippet TEXT, rejection_reason TEXT, occurred_unix INTEGER, reviewed INTEGER)") { Ok(n) => n, Err(e) => -1 }
    let rows: Result(json, ErrorCode) = match db_query(conn, "SELECT id, source_id, error_type, record_snippet, rejection_reason, occurred_unix, reviewed FROM ingestion_error_entry ORDER BY occurred_unix DESC") { Ok(r) => Ok(r), Err(e) => Err(DbError(e)) }
    stop conn
    return rows
}
fn list_ingestion_error_entry() -> Result(json, ErrorCode) requires(role: "ingestion_admin") {
    return match db_connect("ctms_pro.db") { Ok(conn) => list_ingestion_error_entry_inner(conn), Err(e) => Err(DbError(e)) }
}
fn create_ingestion_error_entry_inner(conn: db, e: IngestionErrorEntry) -> Result(i64, ErrorCode) {
    let c: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS ingestion_error_entry (id INTEGER PRIMARY KEY AUTOINCREMENT, source_id INTEGER, error_type TEXT, record_snippet TEXT, rejection_reason TEXT, occurred_unix INTEGER, reviewed INTEGER)") { Ok(n) => n, Err(e) => -1 }
    let result: Result(i64, ErrorCode) = match db_execute(conn, "INSERT INTO ingestion_error_entry (source_id, error_type, record_snippet, rejection_reason, occurred_unix, reviewed) VALUES (?, ?, ?, ?, ?, 0)", e.source_id, e.error_type, e.record_snippet, e.rejection_reason, e.occurred_unix) { Ok(n) => Ok(n), Err(err) => Err(DbError(err)) }
    stop conn
    return result
}
fn create_ingestion_error_entry(e: IngestionErrorEntry) -> Result(i64, ErrorCode) requires(role: "ingestion_admin") {
    return match db_connect("ctms_pro.db") { Ok(conn) => create_ingestion_error_entry_inner(conn, e), Err(err) => Err(DbError(err)) }
}
fn mark_ingestion_error_reviewed_inner(conn: db, id: i64) -> Result(json, ErrorCode) {
    let c: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS ingestion_error_entry (id INTEGER PRIMARY KEY AUTOINCREMENT, source_id INTEGER, error_type TEXT, record_snippet TEXT, rejection_reason TEXT, occurred_unix INTEGER, reviewed INTEGER)") { Ok(n) => n, Err(e) => -1 }
    let updated: Result(i64, ErrorCode) = match db_execute(conn, "UPDATE ingestion_error_entry SET reviewed = 1 WHERE id = ?", id) { Ok(n) => Ok(n), Err(e) => Err(DbError(e)) }
    let confirm: Result(json, ErrorCode) = match updated {
        Ok(n) => match db_query(conn, "SELECT id, reviewed FROM ingestion_error_entry WHERE id = ?", id) {
            Ok(r) => match json_array_get(r, 0) { Ok(one) => Ok(one), Err(e) => Err(DbError(e)) },
            Err(e) => Err(DbError(e)),
        },
        Err(e) => Err(e),
    }
    stop conn
    return confirm
}
fn mark_ingestion_error_reviewed(id: i64) -> Result(json, ErrorCode) requires(role: "ingestion_admin") {
    return match db_connect("ctms_pro.db") { Ok(conn) => mark_ingestion_error_reviewed_inner(conn, id), Err(e) => Err(DbError(e)) }
}

screen IngestionErrorEntry {
    title: "Ingestion Error Queue"
    field source_id {
        render: "searchable_select"
        source: DataSource
    }
    action "Mark Reviewed" -> mark_ingestion_error_reviewed {
        style: "outlined"
        show_result: true
    }

    layout {
        row {
            column {
                group "Error" {
                    field source_id
                    field error_type
                    field record_snippet
                }
            }
            column {
                group "Disposition" {
                    field rejection_reason
                    field occurred_unix
                    field reviewed
                }
                divider {}
                action "Mark Reviewed"
            }
        }
    }
}

// ---- SchemaVersionEntry: schema registry + drift tracking. ------------

