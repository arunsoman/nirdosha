// ---- RegulatoryReport: the Regulatory Reporting Queue. -----------------

fn list_regulatory_report_inner(conn: db) -> Result(json, ErrorCode) {
    let c: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS regulatory_report (id INTEGER PRIMARY KEY AUTOINCREMENT, report_type TEXT, jurisdiction TEXT, status TEXT, due_unix INTEGER, transmission_status TEXT)") { Ok(n) => n, Err(e) => -1 }
    let rows: Result(json, ErrorCode) = match db_query(conn, "SELECT id, report_type, jurisdiction, status, due_unix, transmission_status FROM regulatory_report ORDER BY due_unix") { Ok(r) => Ok(r), Err(e) => Err(DbError(e)) }
    stop conn
    return rows
}
fn list_regulatory_report() -> Result(json, ErrorCode) requires(role: "compliance_officer") {
    return match db_connect("ctms_pro.db") { Ok(conn) => list_regulatory_report_inner(conn), Err(e) => Err(DbError(e)) }
}
fn create_regulatory_report_inner(conn: db, r: RegulatoryReport) -> Result(i64, ErrorCode) {
    let c: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS regulatory_report (id INTEGER PRIMARY KEY AUTOINCREMENT, report_type TEXT, jurisdiction TEXT, status TEXT, due_unix INTEGER, transmission_status TEXT)") { Ok(n) => n, Err(e) => -1 }
    let result: Result(i64, ErrorCode) = match db_execute(conn, "INSERT INTO regulatory_report (report_type, jurisdiction, status, due_unix, transmission_status) VALUES (?, ?, ?, ?, ?)", r.report_type, r.jurisdiction, r.status, r.due_unix, r.transmission_status) { Ok(n) => Ok(n), Err(e) => Err(DbError(e)) }
    stop conn
    return result
}
fn create_regulatory_report(r: RegulatoryReport) -> Result(i64, ErrorCode) requires(role: "compliance_officer") {
    return match db_connect("ctms_pro.db") { Ok(conn) => create_regulatory_report_inner(conn, r), Err(e) => Err(DbError(e)) }
}
fn transmit_regulatory_report_inner(conn: db, id: i64) -> Result(json, ErrorCode) {
    let c: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS regulatory_report (id INTEGER PRIMARY KEY AUTOINCREMENT, report_type TEXT, jurisdiction TEXT, status TEXT, due_unix INTEGER, transmission_status TEXT)") { Ok(n) => n, Err(e) => -1 }
    let updated: Result(i64, ErrorCode) = match db_execute(conn, "UPDATE regulatory_report SET status = 'ReportStatusFiled', transmission_status = 'SignatureStatusValid' WHERE id = ?", id) { Ok(n) => Ok(n), Err(e) => Err(DbError(e)) }
    let confirm: Result(json, ErrorCode) = match updated {
        Ok(n) => match db_query(conn, "SELECT id, status, transmission_status FROM regulatory_report WHERE id = ?", id) {
            Ok(r) => match json_array_get(r, 0) { Ok(one) => Ok(one), Err(e) => Err(DbError(e)) },
            Err(e) => Err(DbError(e)),
        },
        Err(e) => Err(e),
    }
    stop conn
    return confirm
}
fn transmit_regulatory_report(id: i64) -> Result(json, ErrorCode) requires(role: "compliance_officer") {
    return match db_connect("ctms_pro.db") { Ok(conn) => transmit_regulatory_report_inner(conn, id), Err(e) => Err(DbError(e)) }
}

screen RegulatoryReport {
    title: "Regulatory Reporting Queue"
    field status {
        render: "badge"
    }
    field transmission_status {
        render: "badge"
    }
    action "Generate/Transmit" -> transmit_regulatory_report {
        style: "filled"
        show_result: true
    }

    layout {
        row {
            column {
                field report_type
                field jurisdiction
                field due_unix
            }
            column {
                field status
                field transmission_status
                action "Generate/Transmit"
            }
        }
    }
}

