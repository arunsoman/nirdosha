    let c: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS schema_version_entry (id INTEGER PRIMARY KEY AUTOINCREMENT, source_id INTEGER, version_number INTEGER, field_diff TEXT, backward_compatible INTEGER, approved INTEGER)") { Ok(n) => n, Err(e) => -1 }
    let rows: Result(json, ErrorCode) = match db_query(conn, "SELECT id, source_id, version_number, field_diff, backward_compatible, approved FROM schema_version_entry ORDER BY id DESC") { Ok(r) => Ok(r), Err(e) => Err(DbError(e)) }
    stop conn
    return rows
}
fn list_schema_version_entry() -> Result(json, ErrorCode) requires(role: "ingestion_admin") {
    return match db_connect("ctms_pro.db") { Ok(conn) => list_schema_version_entry_inner(conn), Err(e) => Err(DbError(e)) }
