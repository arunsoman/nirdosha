}
fn delete_compliance_policy_inner(conn: db, id: i64) -> Result(i64, ErrorCode) {
    let result: Result(i64, ErrorCode) = match db_execute(conn, "DELETE FROM compliance_policy WHERE id = ?", id) { Ok(n) => Ok(n), Err(e) => Err(DbError(e)) }
    stop conn
    return result
}
fn delete_compliance_policy(id: i64) -> Result(i64, ErrorCode) requires(role: "admin") {
    return match db_connect("ctms_pro.db") { Ok(conn) => delete_compliance_policy_inner(conn, id), Err(e) => Err(DbError(e)) }
}
fn simulate_policy_threshold_inner(conn: db, id: i64) -> Result(json, ErrorCode) {
    let c1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS compliance_policy (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT, threshold_cents INTEGER, active INTEGER)") { Ok(n) => n, Err(e) => -1 }
    let c2: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS investigation_transaction (id INTEGER PRIMARY KEY AUTOINCREMENT, investigation_id INTEGER, amount_cents INTEGER, geo_country TEXT, created_unix INTEGER, geo_lat REAL, geo_lng REAL)") { Ok(n) => n, Err(e) => -1 }
    let result: Result(json, ErrorCode) = match db_query(
        conn,
        "SELECT (SELECT name FROM compliance_policy WHERE id = ?) AS policy, (SELECT threshold_cents FROM compliance_policy WHERE id = ?) AS threshold_cents, (SELECT COUNT(*) FROM investigation_transaction WHERE amount_cents > (SELECT threshold_cents FROM compliance_policy WHERE id = ?)) AS would_flag_count",
        id, id, id
    ) {
        Ok(rows) => match json_array_get(rows, 0) { Ok(one) => Ok(one), Err(e) => Err(DbError(e)) },
        Err(e) => Err(DbError(e)),
    }
    stop conn
    return result
}
fn simulate_policy_threshold(id: i64) -> Result(json, ErrorCode) requires(role: "compliance_officer") {
    return match db_connect("ctms_pro.db") { Ok(conn) => simulate_policy_threshold_inner(conn, id), Err(e) => Err(DbError(e)) }
}

screen CompliancePolicy {
    title: "Policy Management Engine"
    action "Simulate" -> simulate_policy_threshold {
        style: "outlined"
        show_result: true
    }

    layout {
        row {
            column {
                field name
                field threshold_cents
                field active
            }
            column {
                action "Simulate"
            }
        }
    }
}

