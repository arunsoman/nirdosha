fn graph_wallet_clusters_inner(conn: db) -> Result(json, ErrorCode) {
    let c1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS wallet (id INTEGER PRIMARY KEY AUTOINCREMENT, address TEXT, risk_score INTEGER)") { Ok(n) => n, Err(e) => -1 }
    let c2: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS wallet_link (id INTEGER PRIMARY KEY AUTOINCREMENT, source_wallet_id INTEGER, target_wallet_id INTEGER, hop_count INTEGER)") { Ok(n) => n, Err(e) => -1 }
    let result: Result(json, ErrorCode) = match db_query(
        conn,
        "SELECT json_object('nodes', (SELECT json_group_array(json_object('id', id, 'label', address, 'risk', risk_score)) FROM wallet), 'edges', (SELECT json_group_array(json_object('source', source_wallet_id, 'target', target_wallet_id, 'weight', hop_count)) FROM wallet_link)) AS value"
    ) {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_str(row, "value") {
                Ok(s) => match json_parse(s) { Ok(v) => Ok(v), Err(e) => Err(DbError(e)) },
                Err(e) => Err(DbError(e)),
            },
            Err(e) => Err(DbError(e)),
        },
        Err(e) => Err(DbError(e)),
    }
    stop conn
    return result
}
