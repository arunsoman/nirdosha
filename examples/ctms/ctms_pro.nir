    let result: Result(i64, ErrorCode) = match db_execute(conn, "INSERT INTO alert_signal (alert_id, signal_name, contribution_score) VALUES (?, ?, ?)", alert_id, signal_name.value, contribution_score) { Ok(n) => Ok(n), Err(e) => Err(DbError(e)) }
