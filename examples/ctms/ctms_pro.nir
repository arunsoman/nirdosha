// "Similar Alerts" panel -- same triggering rule, excluding itself.
fn list_similar_alerts_for_alert_inner(conn: db, alert_id: i64) -> Result(json, ErrorCode) {
    let c: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS alert (id INTEGER PRIMARY KEY AUTOINCREMENT, transaction_ref TEXT, entity_ref TEXT, risk_score INTEGER, triggering_rule TEXT, severity TEXT, status TEXT, assigned_to TEXT, detected_unix INTEGER)") { Ok(n) => n, Err(e) => -1 }
    let rows: Result(json, ErrorCode) = match db_query(
        conn,
        "SELECT detected_unix AS ts, (triggering_rule || ' -- risk ' || CAST(risk_score AS TEXT)) AS label FROM alert WHERE triggering_rule = (SELECT triggering_rule FROM alert WHERE id = ?) AND id != ? ORDER BY detected_unix DESC",
        alert_id, alert_id
    ) { Ok(r) => Ok(r), Err(e) => Err(DbError(e)) }
    stop conn
    return rows
}
fn list_similar_alerts_for_alert(alert_id: i64) -> Result(json, ErrorCode) requires(role: "fraud_analyst") {
    return match db_connect("ctms_pro.db") { Ok(conn) => list_similar_alerts_for_alert_inner(conn, alert_id), Err(e) => Err(DbError(e)) }
}

