    let result: Result(json, ErrorCode) = match db_query(conn, "SELECT entity_ref AS label, deviation_score AS value FROM behavioural_profile ORDER BY deviation_score DESC LIMIT 10") { Ok(r) => Ok(r), Err(e) => Err(DbError(e)) }
