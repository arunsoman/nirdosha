fn graph_case_links_inner(conn: db) -> Result(json, ErrorCode) {
    let c1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS investigation (id INTEGER PRIMARY KEY AUTOINCREMENT, subject_name TEXT, status TEXT, severity TEXT, risk_score INTEGER, sla_deadline_unix INTEGER, assigned_to TEXT)") { Ok(n) => n, Err(e) => -1 }
    let c2: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS case_link (id INTEGER PRIMARY KEY AUTOINCREMENT, source_investigation_id INTEGER, target_investigation_id INTEGER, link_reason TEXT)") { Ok(n) => n, Err(e) => -1 }
    let result: Result(json, ErrorCode) = match db_query(
        conn,
        "SELECT json_object('nodes', (SELECT json_group_array(json_object('id', id, 'label', subject_name, 'risk', risk_score)) FROM investigation), 'edges', (SELECT json_group_array(json_object('source', source_investigation_id, 'target', target_investigation_id, 'weight', 1)) FROM case_link)) AS value"
    ) {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_str(row, "value") {
                Ok(s) => match json_parse(s) { Ok(v) => Ok(v), Err(e) => Err(DbError(e)) },
                Err(e) => Err(DbError(e)),
            },
            Err(e) => Err(DbError(e)),
        },
        Err(e) => Err(DbError(e)),
    }
    stop conn
    return result
}
fn graph_case_links() -> Result(json, ErrorCode) requires(role: "investigator") {
    return match db_connect("ctms_pro.db") { Ok(conn) => graph_case_links_inner(conn), Err(e) => Err(DbError(e)) }
}

// ---- Track E5: the Case Workflow/Stage Tracker, the doc's own
// 4-stage "Multi-Stage Workflow Model" verbatim. -------------------------

workflow CaseLifecycle {
    data {
        investigation_id: i64,
    }

    state Investigation_Enrichment {
        owner: role("investigator")
        label: "Investigation & Enrichment"
        on Escalate -> ComplianceEscalation
        on Resolve -> Resolution
    }
    state ComplianceEscalation {
        owner: role("compliance_officer")
        label: "Compliance Escalation / Legal Hold"
        on Resolve -> Resolution
    }
    state Resolution {
        owner: role("investigator")
        label: "Resolution"
        on FileReport -> RegulatoryFiling
    }
    state RegulatoryFiling terminal {
        owner: role("compliance_officer")
        label: "Regulatory Filing"
    }
}

// ---- Module 3 dashboard contributions. ---------------------------------

fn stat_open_investigation_count_inner(conn: db) -> Result(i64, ErrorCode) {
    let c: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS investigation (id INTEGER PRIMARY KEY AUTOINCREMENT, subject_name TEXT, status TEXT, severity TEXT, risk_score INTEGER, sla_deadline_unix INTEGER, assigned_to TEXT)") { Ok(n) => n, Err(e) => -1 }
    let result: Result(i64, ErrorCode) = match db_query(conn, "SELECT COUNT(*) AS value FROM investigation WHERE status = 'CaseStatusOpen'") {
        Ok(rows) => match json_array_get(rows, 0) { Ok(row) => match json_get_i64(row, "value") { Ok(n) => Ok(n), Err(e) => Ok(0) }, Err(e) => Ok(0) },
        Err(e) => Err(DbError(e)),
    }
    stop conn
    return result
}
fn stat_open_investigation_count() -> Result(i64, ErrorCode) requires(role: "investigator") {
    return match db_connect("ctms_pro.db") { Ok(conn) => stat_open_investigation_count_inner(conn), Err(e) => Err(DbError(e)) }
}
fn stat_investigation_nearing_sla_breach_inner(conn: db) -> Result(i64, ErrorCode) {
    let c: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS investigation (id INTEGER PRIMARY KEY AUTOINCREMENT, subject_name TEXT, status TEXT, severity TEXT, risk_score INTEGER, sla_deadline_unix INTEGER, assigned_to TEXT)") { Ok(n) => n, Err(e) => -1 }
    let result: Result(i64, ErrorCode) = match db_query(
        conn,
        "SELECT COUNT(*) AS value FROM investigation WHERE status != 'CaseStatusClosed' AND (sla_deadline_unix - strftime('%s','now')) BETWEEN 0 AND 3600"
    ) {
        Ok(rows) => match json_array_get(rows, 0) { Ok(row) => match json_get_i64(row, "value") { Ok(n) => Ok(n), Err(e) => Ok(0) }, Err(e) => Ok(0) },
        Err(e) => Err(DbError(e)),
    }
    stop conn
    return result
}
fn stat_investigation_nearing_sla_breach() -> Result(i64, ErrorCode) requires(role: "investigator") {
    return match db_connect("ctms_pro.db") { Ok(conn) => stat_investigation_nearing_sla_breach_inner(conn), Err(e) => Err(DbError(e)) }
}

