    let rows: Result(json, ErrorCode) = match db_query(conn, "SELECT id, signal_name, contribution_score FROM alert_signal WHERE alert_id = ? ORDER BY contribution_score DESC", alert_id) { Ok(r) => Ok(r), Err(e) => Err(DbError(e)) }
