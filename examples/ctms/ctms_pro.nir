// ---- Module 7 dashboard contributions. ---------------------------------

fn stat_sanctioned_wallet_count_inner(conn: db) -> Result(i64, ErrorCode) {
    let c: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS wallet_sanctions_hit (id INTEGER PRIMARY KEY AUTOINCREMENT, wallet_address TEXT, list_source TEXT, match_confidence INTEGER, status TEXT)") { Ok(n) => n, Err(e) => -1 }
    let result: Result(i64, ErrorCode) = match db_query(conn, "SELECT COUNT(*) AS value FROM wallet_sanctions_hit WHERE status = 'ScreeningStatusConfirmedMatch'") {
        Ok(rows) => match json_array_get(rows, 0) { Ok(row) => match json_get_i64(row, "value") { Ok(n) => Ok(n), Err(e) => Ok(0) }, Err(e) => Ok(0) },
        Err(e) => Err(DbError(e)),
    }
    stop conn
    return result
}
fn stat_sanctioned_wallet_count() -> Result(i64, ErrorCode) requires(role: "compliance_officer") {
    return match db_connect("ctms_pro.db") { Ok(conn) => stat_sanctioned_wallet_count_inner(conn), Err(e) => Err(DbError(e)) }
}

