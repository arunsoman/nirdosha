// ---- Module 5: Advanced Analytics, Reporting, and BI -------------------
//
// Executive/BI Home, Investigator Analytics View: fold into the one
// program-wide `dashboard { }` block below, same "one dashboard per
// program" constraint Module 3's role Homes already ran into. Geo
// Heatmap: already built (Module 3's own "Transaction Geography"
// visual, `heatmap_transaction_geo`) -- not rebuilt here. Graph Network
// Explorer: already built (`graph_case_links`) -- reused, not rebuilt.
// Self-Service Query Interface: **deliberately not built** --
// `UI_CONSTRUCTS.md` SS7's own disclosed non-goal (an ad-hoc query
// builder needs to compose arbitrary WHERE/SELECT text from user input,
// which needs string concatenation Nirdosha's own expression grammar
// doesn't have -- this isn't a small gap to route around, it's blocked
// on a real language-level absence). Left honestly absent, not faked.

module "Analytics & BI" {
    struct AnalyticsReportSchedule {
        id: i64,
        template_name: str,
        schedule_kind: str,
        dispatch_channel: str,
        last_dispatched_unix: i64,
    }

    struct DriftAlert {
        id: i64,
        entity_ref: str,
        drift_score: i64,
        acknowledged: bool,
        detected_unix: i64,
    }

    struct AnalyticsAccessLogEntry {
        id: i64,
        accessed_by: str,
        asset_name: str,
        accessed_unix: i64,
        action_kind: str,
    }
}

