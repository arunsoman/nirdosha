// CTMS -- Track E1 proof-of-concept for `workspace`/`panel`
// (`ROADMAP.md` Track E1, `examples/ctms/UI_CONSTRUCTS.md` SS1). This is
// deliberately NOT the full CTMS rebuild -- that's Track E6, blocked on
// E1-E5 all landing. This file exists to prove the Investigation
// Workspace worked example for real: a `Matter` (an investigative case
// -- named `Matter`, not `Case`, since `CASE` is a reserved SQL keyword
// and this file's own `list_matter`/etc. hand-write real SQL against it)
// with two composed panels (a transaction list, a notes list with an
// "Add Note" action), backed by real SQLite tables, typechecked and
// served by the real compiler -- not a mockup.
//
// Serve it:
//   nirdosha serve examples/identity_mock.nir --port 9090 &
//   nirdosha serve examples/ctms/ctms.nir --port 8080 \
//     --jwks-file examples/store_jwks.json --issuer https://mock-idp.local \
//     --audience store-app --identity-base http://localhost:9090 \
//     --db ctms.db
// Then: create a Matter on its own screen, click "Open Workspace" on its
// row (or use the "Investigation Workspace" nav entry), sign in as a
// role with "investigator" to use the "Add Note" panel action.

enum ErrorCode {
    DbError(str),
}

struct Text {
    value: str,
}

struct Matter {
    id: i64,
    subject_name: str,
    status: str,
    risk_score: i64,
    // Track E3's `field { render: "countdown" }` -- a unix-seconds SLA
    // deadline, rendered as a live "23m left"/"OVERDUE" chip on the
    // Matter Queue instead of a raw integer (`LANGUAGE.md` SS11c/SS3).
    sla_deadline_unix: i64,
}

struct Transaction {
    id: i64,
    matter_id: i64,
    amount_cents: i64,
    geo_country: str,
    created_unix: i64,
    geo_lat: f64,
    geo_lng: f64,
}

// A wallet's own cluster-graph neighbors (Track E2's `render: "graph"`,
// Module 7's Wallet Cluster Graph). Deliberately its own struct/table,
// not folded into `Transaction` -- a wallet-to-wallet link isn't a
// transaction, it's an inferred relationship between two wallets
// (shared cluster, common counterparty, etc.), real CTMS's own "hop"
// concept (`UI_CONSTRUCTS.md` SS2's worked example).
struct Wallet {
    id: i64,
    address: str,
    risk_score: i64,
}

struct WalletLink {
    id: i64,
    source_wallet_id: i64,
    target_wallet_id: i64,
    hop_count: i64,
}

// ---- Matter: CRUD, SQLite-backed ---------------------------------------

fn list_matter_inner(conn: db) -> Result(json, ErrorCode) {
    let created: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS matter (id INTEGER PRIMARY KEY AUTOINCREMENT, subject_name TEXT, status TEXT, risk_score INTEGER, sla_deadline_unix INTEGER)") {
        Ok(n) => n,
        Err(e) => -1,
    }
    let rows: Result(json, ErrorCode) = match db_query(conn, "SELECT id, subject_name, status, risk_score, sla_deadline_unix FROM matter ORDER BY id") {
        Ok(r) => Ok(r),
        Err(e) => Err(DbError(e)),
    }
    stop conn
    return rows
}

fn list_matter() -> Result(json, ErrorCode) requires(public) {
    return match db_connect("ctms.db") {
        Ok(conn) => list_matter_inner(conn),
        Err(e) => Err(DbError(e)),
    }
}

fn get_matter_inner(conn: db, id: i64) -> Result(json, ErrorCode) {
    let created: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS matter (id INTEGER PRIMARY KEY AUTOINCREMENT, subject_name TEXT, status TEXT, risk_score INTEGER, sla_deadline_unix INTEGER)") {
        Ok(n) => n,
        Err(e) => -1,
    }
    let row: Result(json, ErrorCode) = match db_query(conn, "SELECT id, subject_name, status, risk_score, sla_deadline_unix FROM matter WHERE id = ?", id) {
        Ok(r) => match json_array_get(r, 0) {
            Ok(one) => Ok(one),
            Err(e) => Err(DbError(e)),
        },
        Err(e) => Err(DbError(e)),
    }
    stop conn
    return row
}

fn get_matter(id: i64) -> Result(json, ErrorCode) requires(public) {
    return match db_connect("ctms.db") {
        Ok(conn) => get_matter_inner(conn, id),
        Err(e) => Err(DbError(e)),
    }
}

