// ML feature parsing: json_parse + json_get_f64 into Vector(f64, 3).
fn extract_features(j: json) -> Vector(f64, 3) requires(public) {
    let f0: f64 = match json_get_f64(j, "f0") {
        Ok(v) => v,
        Err(e) => 0.0,
    }
    let f1: f64 = match json_get_f64(j, "f1") {
        Ok(v) => v,
        Err(e) => 0.0,
    }
    let f2: f64 = match json_get_f64(j, "f2") {
        Ok(v) => v,
        Err(e) => 0.0,
    }
    return [f0, f1, f2]
}

fn parse_ml_features(json_str: Text) -> Result(Vector(f64, 3), ErrorCode) requires(public) {
    let parsed: Result(json, ErrorCode) = match json_parse(json_str.value) {
        Ok(j) => Ok(j),
        Err(e) => Err(JsonError(e)),
    }
    return match parsed {
        Ok(j) => Ok(extract_features(j)),
        Err(e) => Err(e),
    }
}

