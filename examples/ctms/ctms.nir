// Track E3 -- the Matter Queue's live SLA countdown. No grammar change:
// `field { render: "countdown" }` is an ordinary `kv_entry` inside the
// same `field <name> { ... }` block `label`/`pattern`/`min`/`max`
// already use (`LANGUAGE.md` SS11c/SS3).
// Decision Panel / Case Export -- Track E4 preview-shaped actions on the
// Matter Queue screen itself, alongside its Track E3 SLA countdown.
fn record_matter_decision_inner(conn: db, id: i64, resolution: Text, justification: Text) -> Result(json, ErrorCode) {
    let c: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS matter (id INTEGER PRIMARY KEY AUTOINCREMENT, subject_name TEXT, status TEXT, risk_score INTEGER, sla_deadline_unix INTEGER)") { Ok(n) => n, Err(e) => -1 }
    let result: Result(i64, ErrorCode) = match db_execute(conn, "UPDATE matter SET status = ? WHERE id = ?", resolution.value, id) { Ok(n) => Ok(n), Err(e) => Err(DbError(e)) }
    let confirm: Result(json, ErrorCode) = match result {
        Ok(n) => match db_query(conn, "SELECT id, status FROM matter WHERE id = ?", id) {
            Ok(r) => match json_array_get(r, 0) { Ok(one) => Ok(one), Err(e) => Err(DbError(e)) },
            Err(e) => Err(DbError(e)),
        },
        Err(e) => Err(e),
    }
    stop conn
    return confirm
}
fn record_matter_decision(id: i64, resolution: Text, justification: Text) -> Result(json, ErrorCode) requires(role: "investigator") {
    return match db_connect("ctms.db") {
        Ok(conn) => record_matter_decision_inner(conn, id, resolution, justification),
        Err(e) => Err(DbError(e)),
    }
}
fn export_matter_dossier_inner(conn: db, id: i64) -> Result(json, ErrorCode) {
    let c: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS matter (id INTEGER PRIMARY KEY AUTOINCREMENT, subject_name TEXT, status TEXT, risk_score INTEGER, sla_deadline_unix INTEGER)") { Ok(n) => n, Err(e) => -1 }
    // A real dossier would bundle a signed PDF/CSV/JSON artifact --
    // Nirdosha has no file/blob type yet (`MOBILE.md`'s D3 already names
    // this same gap). This returns the JSON summary a real one would be
    // built from, honestly short of the real deliverable, not silently
    // pretending to produce one.
    let result: Result(json, ErrorCode) = match db_query(conn, "SELECT id, subject_name, status, risk_score FROM matter WHERE id = ?", id) {
        Ok(r) => match json_array_get(r, 0) { Ok(one) => Ok(one), Err(e) => Err(DbError(e)) },
        Err(e) => Err(DbError(e)),
    }
    stop conn
    return result
}
fn export_matter_dossier(id: i64) -> Result(json, ErrorCode) requires(role: "investigator") {
    return match db_connect("ctms.db") { Ok(conn) => export_matter_dossier_inner(conn, id), Err(e) => Err(DbError(e)) }
}

screen Matter {
    title: "Matter Queue"
    field sla_deadline_unix {
        label: "SLA"
        render: "countdown"
    }
    action "Export Dossier" -> export_matter_dossier {
        style: "outlined"
        show_result: true
    }
}

// ---- Transaction: seed/query only -- no screen of its own, it's only
// ever browsed through a Matter's own workspace panel below. ------------

// `CREATE TABLE IF NOT EXISTS` repeated inline in every `txn`-touching
// fn below, not factored into a shared helper: `db` is affine with "no
// borrowing story yet" (`examples/db.nir`'s own doc comment) -- passing
// `conn` into a helper fn moves it away from the caller for good, so
// each fn that needs it re-issues the (idempotent) statement itself,
// the same repetition every other example in this codebase already has.
fn create_transaction_inner(conn: db, t: Transaction) -> Result(i64, ErrorCode) {
    let created: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS txn (id INTEGER PRIMARY KEY AUTOINCREMENT, matter_id INTEGER, amount_cents INTEGER, geo_country TEXT, created_unix INTEGER, geo_lat REAL, geo_lng REAL)") {
        Ok(n) => n,
        Err(e) => -1,
    }
    let result: Result(i64, ErrorCode) = match db_execute(
        conn,
        "INSERT INTO txn (matter_id, amount_cents, geo_country, created_unix, geo_lat, geo_lng) VALUES (?, ?, ?, ?, ?, ?)",
        t.matter_id, t.amount_cents, t.geo_country, t.created_unix, t.geo_lat, t.geo_lng
    ) {
        Ok(n) => Ok(n),
        Err(e) => Err(DbError(e)),
    }
    stop conn
    return result
}

fn create_transaction(t: Transaction) -> Result(i64, ErrorCode) requires(role: "investigator") {
    return match db_connect("ctms.db") {
        Ok(conn) => create_transaction_inner(conn, t),
        Err(e) => Err(DbError(e)),
    }
}

// The Investigation Workspace's "Transactions" panel source -- shaped
// as `{ts, label}[]` (Track E2's timeline contract, `LANGUAGE.md`
// SS11c) rather than raw columns, since this fn's only consumer is that
// one `panel { render: "timeline" }`. Exactly one `i64` param,
// `Result(json, _)` return -- `typeck.rs::check_workspace`'s required
// shape (LANGUAGE.md SS15). `||`/`CAST` below are ordinary SQL, executed
// server-side by SQLite -- Nirdosha's own expression grammar still has
// no `str` concatenation operator at all (`UI_CONSTRUCTS.md` SS7's own
// disclosed limit); this sidesteps it by pushing the formatting into the
// query text, the same way `stat_`/`chart_` conventions already lean on
// SQL column aliasing instead of Nirdosha-side data wrangling.
fn list_transaction_for_matter_inner(conn: db, matter_id: i64) -> Result(json, ErrorCode) {
    let created: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS txn (id INTEGER PRIMARY KEY AUTOINCREMENT, matter_id INTEGER, amount_cents INTEGER, geo_country TEXT, created_unix INTEGER, geo_lat REAL, geo_lng REAL)") {
        Ok(n) => n,
        Err(e) => -1,
    }
    let rows: Result(json, ErrorCode) = match db_query(
        conn,
        "SELECT created_unix AS ts, (CAST(amount_cents AS TEXT) || ' cents -- ' || geo_country) AS label FROM txn WHERE matter_id = ? ORDER BY created_unix",
        matter_id
    ) {
        Ok(r) => Ok(r),
        Err(e) => Err(DbError(e)),
    }
    stop conn
    return rows
}

fn list_transaction_for_matter(matter_id: i64) -> Result(json, ErrorCode) requires(role: "investigator") {
    return match db_connect("ctms.db") {
        Ok(conn) => list_transaction_for_matter_inner(conn, matter_id),
        Err(e) => Err(DbError(e)),
    }
}

