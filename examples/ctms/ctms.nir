fn update_compliance_policy_inner(conn: db, p: CompliancePolicy) -> Result(i64, ErrorCode) {
    let c1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS compliance_policy (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT, threshold_cents INTEGER, active INTEGER)") {
        Ok(n) => n,
        Err(e) => -1,
    }
    let result: Result(i64, ErrorCode) = match db_execute(conn, "UPDATE compliance_policy SET name = ?, threshold_cents = ?, active = ? WHERE id = ?", p.name, p.threshold_cents, p.active, p.id) {
