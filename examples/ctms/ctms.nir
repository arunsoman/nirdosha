// Crypto Transaction Simulation Sandbox -- Track E4 preview action,
// folded into the same screen rather than a dedicated tool screen
// Nirdosha has no separate "sandbox" construct for.
fn simulate_card_crypto_detection_inner(conn: db, id: i64) -> Result(json, ErrorCode) {
    let c: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS card_crypto_txn (id INTEGER PRIMARY KEY AUTOINCREMENT, card_ref TEXT, merchant_name TEXT, mcc_code TEXT, amount_cents INTEGER, occurred_unix INTEGER, risk_priority TEXT)") { Ok(n) => n, Err(e) => -1 }
    let result: Result(json, ErrorCode) = match db_query(conn, "SELECT merchant_name, mcc_code, (CASE WHEN mcc_code IN ('6051', '4829') THEN 'flag' ELSE 'pass' END) AS detection_result FROM card_crypto_txn WHERE id = ?", id) {
        Ok(r) => match json_array_get(r, 0) { Ok(one) => Ok(one), Err(e) => Err(DbError(e)) },
        Err(e) => Err(DbError(e)),
    }
    stop conn
    return result
}
fn simulate_card_crypto_detection(id: i64) -> Result(json, ErrorCode) requires(role: "fraud_analyst") {
