fn add_matter_evidence_inner(conn: db, matter_id: i64, evidence_type: Text, uploader: Text, content_hash: Text) -> Result(i64, ErrorCode) {
    let c: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS matter_evidence (id INTEGER PRIMARY KEY AUTOINCREMENT, matter_id INTEGER, evidence_type TEXT, uploader TEXT, content_hash TEXT, version_number INTEGER)") { Ok(n) => n, Err(e) => -1 }
    let result: Result(i64, ErrorCode) = match db_execute(conn, "INSERT INTO matter_evidence (matter_id, evidence_type, uploader, content_hash, version_number) VALUES (?, ?, ?, ?, 1)", matter_id, evidence_type.value, uploader.value, content_hash.value) { Ok(n) => Ok(n), Err(e) => Err(DbError(e)) }
    stop conn
    return result
}
fn add_matter_evidence(matter_id: i64, evidence_type: Text, uploader: Text, content_hash: Text) -> Result(i64, ErrorCode) requires(role: "investigator") {
