// The dashboard-tile companion to Track E3's per-row countdown chip
// (`UI_CONSTRUCTS.md` SS3's own "Open questions": "just an ordinary
// stat_<name>() -> i64 counting function -- no render involvement at
// all"). `strftime('%s','now')` is SQLite's own clock, not Nirdosha's --
// this language has no wall-clock builtin at all (`LANGUAGE.md` SS9's
// deliberate no-wall-clock determinism stance), the same way this file
// already leans on SQL's own `||`/`json_object` for what Nirdosha's own
// expression grammar can't do, pushed into the query text rather than
// the language itself.
fn stat_cases_nearing_sla_breach_inner(conn: db) -> Result(i64, ErrorCode) {
    let created: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS matter (id INTEGER PRIMARY KEY AUTOINCREMENT, subject_name TEXT, status TEXT, risk_score INTEGER, sla_deadline_unix INTEGER)") {
        Ok(n) => n,
        Err(e) => -1,
    }
    let result: Result(i64, ErrorCode) = match db_query(
        conn,
        "SELECT COUNT(*) AS value FROM matter WHERE status = 'open' AND (sla_deadline_unix - strftime('%s','now')) BETWEEN 0 AND 3600"
    ) {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_i64(row, "value") {
                Ok(n) => Ok(n),
                Err(e) => Ok(0),
            },
            Err(e) => Ok(0),
        },
        Err(e) => Err(DbError(e)),
    }
    stop conn
    return result
}

fn stat_cases_nearing_sla_breach() -> Result(i64, ErrorCode) requires(public) {
    return match db_connect("ctms.db") {
        Ok(conn) => stat_cases_nearing_sla_breach_inner(conn),
        Err(e) => Err(DbError(e)),
    }
}

// `render: "graph"`'s required `{"nodes":[...], "edges":[...]}` envelope
// (`LANGUAGE.md` SS11c) is built entirely in SQL -- SQLite's own bundled
// `json_object`/`json_group_array` functions -- since Nirdosha itself has
// no builtin to combine two `db_query` results into one nested JSON
// object. The one `db_query` call returns a single row whose one column
// IS that envelope, stringified; `json_get_str` reads the string back
// out, `json_parse` turns it back into a real `json` value (not a
// further-nested string) before this fn returns it. A real,
// non-obvious finding from actually testing this against the compiled
// `db_query` path, not assumed from the SQL alone.
fn graph_wallet_clusters_inner(conn: db) -> Result(json, ErrorCode) {
    let c1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS wallet (id INTEGER PRIMARY KEY AUTOINCREMENT, address TEXT, risk_score INTEGER)") {
        Ok(n) => n,
        Err(e) => -1,
    }
    let c2: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS wallet_link (id INTEGER PRIMARY KEY AUTOINCREMENT, source_wallet_id INTEGER, target_wallet_id INTEGER, hop_count INTEGER)") {
        Ok(n) => n,
        Err(e) => -1,
    }
    let result: Result(json, ErrorCode) = match db_query(
        conn,
        "SELECT json_object('nodes', (SELECT json_group_array(json_object('id', id, 'label', address, 'risk', risk_score)) FROM wallet), 'edges', (SELECT json_group_array(json_object('source', source_wallet_id, 'target', target_wallet_id, 'weight', hop_count)) FROM wallet_link)) AS value"
    ) {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_str(row, "value") {
                Ok(s) => match json_parse(s) {
                    Ok(v) => Ok(v),
                    Err(e) => Err(DbError(e)),
                },
                Err(e) => Err(DbError(e)),
            },
            Err(e) => Err(DbError(e)),
        },
        Err(e) => Err(DbError(e)),
    }
    stop conn
    return result
}

fn graph_wallet_clusters() -> Result(json, ErrorCode) requires(public) {
    return match db_connect("ctms.db") {
        Ok(conn) => graph_wallet_clusters_inner(conn),
        Err(e) => Err(DbError(e)),
    }
}

// `render: "heatmap"`'s `[{"lat","lng","weight","label"?}]` contract --
// one point per transaction, weighted by its own amount.
fn heatmap_transaction_geo_inner(conn: db) -> Result(json, ErrorCode) {
    let created: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS txn (id INTEGER PRIMARY KEY AUTOINCREMENT, matter_id INTEGER, amount_cents INTEGER, geo_country TEXT, created_unix INTEGER, geo_lat REAL, geo_lng REAL)") {
        Ok(n) => n,
        Err(e) => -1,
    }
    let rows: Result(json, ErrorCode) = match db_query(conn, "SELECT geo_lat AS lat, geo_lng AS lng, amount_cents AS weight, geo_country AS label FROM txn") {
        Ok(r) => Ok(r),
        Err(e) => Err(DbError(e)),
    }
    stop conn
    return rows
}

fn heatmap_transaction_geo() -> Result(json, ErrorCode) requires(public) {
    return match db_connect("ctms.db") {
        Ok(conn) => heatmap_transaction_geo_inner(conn),
        Err(e) => Err(DbError(e)),
    }
}

// ---- CompliancePolicy: CRUD (Module 6's Policy Management Engine),
// plus Track E4's "simulate before apply" action. --------------------

struct CompliancePolicy {
