    let result: Result(i64, ErrorCode) = match db_execute(conn, "INSERT INTO matter (subject_name, status, risk_score, sla_deadline_unix) VALUES (?, ?, ?, ?)", m.subject_name, m.status, m.risk_score, m.sla_deadline_unix) {
        Ok(n) => Ok(n),
        Err(e) => Err(DbError(e)),
    }
