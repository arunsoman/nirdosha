// ============================================================
// Section 9: Crypto Risk Monitoring (Phase 2)
// ============================================================
// Demonstrates: tcp connect/send/recv/stop to blockchain indexer,
// MCC filtering (i32 arithmetic), json_parse + json_get_i64, Wallet CRUD.

fn fetch_wallet_risk_from_indexer(wallet_address: Text) -> Result(i64, ErrorCode) requires(role: "crypto") {
    let conn: tcp = connect("indexer.internal", 8080)
    send(conn, wallet_address.value)
    let raw: str = recv(conn)
    stop(conn)
    let parsed: Result(json, ErrorCode) = match json_parse(raw) {
        Ok(j) => Ok(j),
        Err(e) => Err(JsonError(e)),
    }
    return match parsed {
        Ok(j) => match json_get_i64(j, "risk_score") {
            Ok(s) => Ok(s),
            Err(e) => Err(JsonError(e)),
        },
        Err(e) => Err(e),
    }
}

fn score_wallet_risk(score: i64) -> CryptoRiskLevel requires(public) {
    return if score >= 90 {
        Blocked()
    } else {
        if score >= 70 { CryptoHigh() } else { if score >= 40 { CryptoMedium() } else { CryptoLow() } }
    }
}

// Rule 6 demo: i32 literals flex to i32, but typed i32 values never coerce.
fn is_crypto_mcc(mcc: i32) -> bool requires(public) {
    let target_a: i32 = 6051
    let target_b: i32 = 4829
    return mcc == target_a || mcc == target_b
}

fn detect_crypto_card_purchase(card_txn: CardTxn) -> bool requires(public) {
    return is_crypto_mcc(card_txn.mcc)
}

