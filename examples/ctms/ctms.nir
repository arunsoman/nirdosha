// Track E4's own worked example (`UI_CONSTRUCTS.md` SS4), applied for
// real: how many transactions would breach *this* policy's threshold if
// it were active right now -- run against the same `txn` table the real
// apply path would use, without ever touching `compliance_policy`
// itself. `id` here names the policy being simulated, not a transaction.
fn simulate_policy_threshold_inner(conn: db, id: i64) -> Result(json, ErrorCode) {
    let c1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS compliance_policy (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT, threshold_cents INTEGER, active INTEGER)") {
        Ok(n) => n,
        Err(e) => -1,
    }
    let c2: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS txn (id INTEGER PRIMARY KEY AUTOINCREMENT, matter_id INTEGER, amount_cents INTEGER, geo_country TEXT, created_unix INTEGER, geo_lat REAL, geo_lng REAL)") {
        Ok(n) => n,
        Err(e) => -1,
    }
    let result: Result(json, ErrorCode) = match db_query(
        conn,
        "SELECT (SELECT name FROM compliance_policy WHERE id = ?) AS policy, (SELECT threshold_cents FROM compliance_policy WHERE id = ?) AS threshold_cents, (SELECT COUNT(*) FROM txn WHERE amount_cents > (SELECT threshold_cents FROM compliance_policy WHERE id = ?)) AS would_flag_count",
        id, id, id
    ) {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(one) => Ok(one),
            Err(e) => Err(DbError(e)),
        },
        Err(e) => Err(DbError(e)),
    }
    stop conn
    return result
}

fn simulate_policy_threshold(id: i64) -> Result(json, ErrorCode) requires(role: "compliance_officer") {
    return match db_connect("ctms.db") {
        Ok(conn) => simulate_policy_threshold_inner(conn, id),
        Err(e) => Err(DbError(e)),
    }
}

