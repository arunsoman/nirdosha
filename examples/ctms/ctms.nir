
// CTMS (Counter-Terrorism Financing & Transaction Monitoring System)
// Complete Nirdosha implementation covering all CTMS modules and
// exercising every Nirdosha language feature.
//
// Modules:
//   1. Financial Data Ingestion and Standardization
//   2. Real-Time Fraud Detection and AI Modelling
//   3. Investigative Case Management System
//   4. Regulatory and Secure Data Exchange
//   5. Advanced Analytics, Reporting, and BI
//   6. Compliance and Regulatory Management
//   7. Crypto Risk Monitoring (Phase 2)
//   8. RTFDS (Real-Time Fraud Detection Management System)
//   9. Identity and Access Management (IAM)
//  10. Audit and Logging Infrastructure
//
// Language features exercised: all int widths, f64, bool, str (struct
// field only), box, borrow, thread, chan, sandbox, tcp, tcp_listener,
// file, db, Vector, Matrix, Option, Result, struct, enum, match (variant
// + literal patterns), if/else (stmt + expr), while, first-class fns,
// spawn/join, send/recv, all JSON builtins, all HTTP builtins, OIDC,
// check_role, extract_claim, acquire, requires(public/role/claim),
// VerifiedIdentity parameter.

// ============================================================
// Section 1: Shared types
// ============================================================

// ErrorCode: every Result error slot is an enum variant carrying str,
// never a bare str (rule 2 — str ban is recursive through Result).
enum ErrorCode {
    DbError(str),
    HttpError(str),
    JsonError(str),
    IoError(str),
    AuthError(str),
    InvalidInput(str),
    NotFound(str),
    CryptoRisk(str),
    ComplianceBreach(str),
    NetworkError(str),
}

// Text wraps free-form str so it can cross function boundaries.
// str is fine as a struct field — the ban is only at fn param/return.
struct Text { value: str }

// Categorical enums (replace what would otherwise be str params).
enum TransactionSource {
    CoreBanking,
    PaymentGateway,
    CryptoExchange,
    Insurance,
    Microfinance,
    RegulatoryApi,
}

enum TransactionType {
    Credit,
    Debit,
    Transfer,
    CryptoPurchase,
    CardPayment,
}

enum CaseStatus {
    Open,
    UnderInvestigation,
    Escalated,
    LegalHold,
    Resolved,
    Closed,
}

enum CaseResolution {
    ConfirmedFraud,
    FalsePositive,
    SuspiciousRemonitor,
    Pending,
}

enum AlertSeverity {
    Low,
    Medium,
    High,
    Critical,
}

// `SAR` (Suspicious Activity Report) can't be used here -- it collides
// with the prelude `CurrencyCode` enum's `SAR` (Saudi Riyal); enum
// variants share one flat namespace program-wide, prelude included.
enum ReportType {
    SarReport,
    STR,
    CTR,
    CBTR,
    RBA,
}

// Own variant names, distinct from AlertSeverity's Low/Medium/High --
// enum variants share one flat namespace with functions/constructors
// across the whole program, so two enums can't reuse the same name.
enum CryptoRiskLevel {
    CryptoLow,
    CryptoMedium,
    CryptoHigh,
    Blocked,
}

// Entity structs.
struct Transaction {
    id: i64,
    source: TransactionSource,
    txn_type: TransactionType,
    amount_cents: i64,
    currency_code: str,
    account_from: str,
    account_to: str,
    merchant_mcc: i32,
    timestamp_unix: i64,
    ip_address: str,
    device_fingerprint: str,
    geo_country: str,
}

struct Alert {
    id: i64,
    transaction_id: i64,
    severity: AlertSeverity,
    rule_id: i64,
    risk_score: i64,
    description: str,
}

struct Case {
    id: i64,
    alert_id: i64,
    status: CaseStatus,
    resolution: CaseResolution,
    assigned_investigator: str,
    created_unix: i64,
    sla_deadline_unix: i64,
    risk_score: i64,
}

struct Wallet {
    address: str,
    cluster_id: i64,
    risk_score: i64,
    is_sanctioned: bool,
}

struct CardTxn {
    id: i64,
    card_id: str,
    merchant_name: str,
    mcc: i32,
    amount_cents: i64,
    description: str,
    timestamp_unix: i64,
}

struct CompliancePolicy {
    id: i64,
    name: str,
    threshold_cents: i64,
    jurisdiction: str,
    active: bool,
}

struct AuditEntry {
    id: i64,
    actor: str,
    action: str,
    target: str,
    timestamp_unix: i64,
    hash_prev: str,
}

// ============================================================
// Section 2: Utility helpers and label functions
// ============================================================
// All label functions return Text (not str) to comply with rule 2.
// All use variant-pattern match (rule 8: exhaustive, no wildcard for
// variant arms). All use positional construction (rule 7) with () on
// zero-payload variants (rule 1).

// Rule 1 demo: variant construction needs () even for zero-payload.
fn make_alert(id: i64, txn_id: i64, sev: AlertSeverity, score: i64) -> Alert requires(public) {
    return Alert(id, txn_id, sev, 1001, score, "auto-generated alert")
}

// Rule 8 demo: literal-pattern match on str requires trailing _ wildcard.
fn severity_from_label(label: Text) -> AlertSeverity requires(public) {
    let v: str = label.value
    return match v {
        "low" => Low(),
        "medium" => Medium(),
        "high" => High(),
        "critical" => Critical(),
        _ => Low(),
    }
}

fn severity_label(s: AlertSeverity) -> Text requires(public) {
    return match s {
        Low => Text("low"),
        Medium => Text("medium"),
        High => Text("high"),
        Critical => Text("critical"),
    }
}

fn status_label(s: CaseStatus) -> Text requires(public) {
    return match s {
        Open => Text("open"),
        UnderInvestigation => Text("under_investigation"),
        Escalated => Text("escalated"),
        LegalHold => Text("legal_hold"),
        Resolved => Text("resolved"),
        Closed => Text("closed"),
    }
}

fn resolution_label(r: CaseResolution) -> Text requires(public) {
    return match r {
        ConfirmedFraud => Text("confirmed_fraud"),
        FalsePositive => Text("false_positive"),
        SuspiciousRemonitor => Text("suspicious_remonitor"),
        Pending => Text("pending"),
    }
}

fn report_label(r: ReportType) -> Text requires(public) {
    return match r {
        SarReport => Text("SAR"),
        STR => Text("STR"),
        CTR => Text("CTR"),
        CBTR => Text("CBTR"),
        RBA => Text("RBA"),
    }
}

fn crypto_risk_label(r: CryptoRiskLevel) -> Text requires(public) {
    return match r {
        CryptoLow => Text("low"),
        CryptoMedium => Text("medium"),
        CryptoHigh => Text("high"),
        Blocked => Text("blocked"),
    }
}

fn source_label(s: TransactionSource) -> Text requires(public) {
    return match s {
        CoreBanking => Text("core_banking"),
        PaymentGateway => Text("payment_gateway"),
        CryptoExchange => Text("crypto_exchange"),
        Insurance => Text("insurance"),
        Microfinance => Text("microfinance"),
        RegulatoryApi => Text("regulatory_api"),
    }
}

fn txn_type_label(t: TransactionType) -> Text requires(public) {
    return match t {
        Credit => Text("credit"),
        Debit => Text("debit"),
        Transfer => Text("transfer"),
        CryptoPurchase => Text("crypto_purchase"),
        CardPayment => Text("card_payment"),
    }
}

// Rule 6 demo: no implicit int conversion — pick one width and stick.
fn add_i64(a: i64, b: i64) -> i64 requires(public) { return a + b }
fn add_i32(a: i32, b: i32) -> i32 requires(public) { return a + b }

// Rule 5 demo: first-class function (no closure, captures nothing).
fn double(n: i64) -> i64 requires(public) { return n + n }

fn apply_to_5(f: fn(i64) -> i64) -> i64 requires(public) {
    return f(5)
}

fn apply_first_class(n: i64) -> i64 requires(public) {
    return apply_to_5(double) + n
}

// Option demo.
fn maybe_wallet_risk(score: i64) -> Option(i64) requires(public) {
    return if score >= 0 {
        Some(score)
    } else {
        None()
    }
}

fn unwrap_or_default(opt: Option(i64), default: i64) -> i64 requires(public) {
    return match opt {
        Some(v) => v,
        None => default,
    }
}

// ============================================================
// Section 3: Financial Data Ingestion and Standardization
// ============================================================
// Demonstrates: struct/enum params, db_execute with bind params,
// multi-step sentinel pattern (rule 9 third idiom), requires(public).

// Validation runs WITHOUT a db handle so early-return can't poison conn.
fn validate_transaction(t: Transaction) -> Result(i64, ErrorCode) requires(public) {
    return if t.amount_cents <= 0 {
        Err(InvalidInput("amount must be positive"))
    } else {
        if t.timestamp_unix <= 0 {
            Err(InvalidInput("timestamp required"))
        } else {
            Ok(1)
        }
    }
}

fn validate_text(t: Text) -> Result(i64, ErrorCode) requires(public) {
    return if t.value == "" {
        Err(InvalidInput("text cannot be empty"))
    } else {
        Ok(1)
    }
}

// Inner: owns conn, runs all DB work, stops conn once, returns.
fn create_transaction_inner(conn: db, t: Transaction) -> Result(i64, ErrorCode) requires(public) {
    let source_text: Text = source_label(t.source)
    let txn_type_text: Text = txn_type_label(t.txn_type)
    let r1: i64 = match db_execute(
        conn,
        "CREATE TABLE IF NOT EXISTS transaction (id INTEGER PRIMARY KEY, source TEXT, txn_type TEXT, amount_cents INTEGER, currency TEXT, account_from TEXT, account_to TEXT, mcc INTEGER, ts INTEGER, ip TEXT, device TEXT, geo TEXT)"
    ) {
        Ok(n) => n,
        Err(e) => -1,
    }
    // 12 columns need binding, but db_execute takes at most 8 bind
    // values -- split into an INSERT of the first 8, then an UPDATE
    // for the rest by id, and combine both sentinels (rule 9's "run
    // N independent steps, one combined check" idiom).
    let r2a: i64 = match db_execute(
        conn,
        "INSERT INTO transaction (id, source, txn_type, amount_cents, currency, account_from, account_to, mcc) VALUES (?, ?, ?, ?, ?, ?, ?, ?)",
        t.id,
        source_text.value,
        txn_type_text.value,
        t.amount_cents,
        t.currency_code,
        t.account_from,
        t.account_to,
        t.merchant_mcc
    ) {
        Ok(n) => n,
        Err(e) => -1,
    }
    let r2b: i64 = match db_execute(
        conn,
        "UPDATE transaction SET ts = ?, ip = ?, device = ?, geo = ? WHERE id = ?",
        t.timestamp_unix,
        t.ip_address,
        t.device_fingerprint,
        t.geo_country,
        t.id
    ) {
        Ok(n) => n,
        Err(e) => -1,
    }
    let r2: i64 = if r2a >= 0 && r2b >= 0 { r2b } else { -1 }
    let all_ok: bool = r1 >= 0 && r2 >= 0
    let result: Result(i64, ErrorCode) = if all_ok {
        Ok(r2)
    } else {
        Err(DbError("one or more ingestion statements failed"))
    }
    stop(conn)
    return result
}

// Named `create_transaction` (not `ingest_transaction`) so it matches
// `ui_gen.rs`'s `create_<struct_snake>` naming convention and gets a
// real screen -- `ingest_transaction` never did, since nothing in the
// UI generator looks for that name. `requires(role: "ingestion_admin")`
// matches the PRD's own "Ingestion Admin" actor row ("Configures
// sources, schemas, policies via ETL & NiFi console").
fn create_transaction(t: Transaction) -> Result(i64, ErrorCode) requires(role: "ingestion_admin") {
    return match validate_transaction(t) {
        Ok(_) => match db_connect("ctms.db") {
            Ok(conn) => create_transaction_inner(conn, t),
            Err(e) => Err(DbError(e)),
        },
        Err(e) => Err(e),
    }
}

fn list_transaction_inner(conn: db) -> Result(json, ErrorCode) requires(public) {
    let _created: i64 = match db_execute(
        conn,
        "CREATE TABLE IF NOT EXISTS transaction (id INTEGER PRIMARY KEY, source TEXT, txn_type TEXT, amount_cents INTEGER, currency TEXT, account_from TEXT, account_to TEXT, mcc INTEGER, ts INTEGER, ip TEXT, device TEXT, geo TEXT)"
    ) {
        Ok(n) => n,
        Err(e) => -1,
    }
    // Column aliases match `Transaction`'s own field names exactly --
    // the generated list screen looks a row up by struct field name
    // (`row[f.name]`), not by this table's own abbreviated column names.
    let rows: Result(json, ErrorCode) = match db_query(
        conn,
        "SELECT id, source, txn_type, amount_cents, currency AS currency_code, account_from, account_to, mcc AS merchant_mcc, ts AS timestamp_unix, ip AS ip_address, device AS device_fingerprint, geo AS geo_country FROM transaction ORDER BY id"
    ) {
        Ok(r) => Ok(r),
        Err(e) => Err(DbError(e)),
    }
    stop(conn)
    return rows
}

// Fraud analysts review ingested transactions -- same "analyst" role
// `score_transaction`/`detect_dormant_burst` already use for this kind
// of read access.
fn list_transaction() -> Result(json, ErrorCode) requires(role: "analyst") {
    return match db_connect("ctms.db") {
        Ok(conn) => list_transaction_inner(conn),
        Err(e) => Err(DbError(e)),
    }
}

// ============================================================
// Section 4: Real-Time Fraud Detection and AI Modelling
// ============================================================
// Demonstrates: Vector(T, N), Matrix(T, R, C), while loops (rule 5),
// no compound assignment (rule 10), thread spawn/join, chan send/recv,
// first-class functions, box and borrow.

// Smurfing detection: N small txns in a fixed-size Vector.
// Rule 5: while loop, no `for`. Rule 10: no `+=`, write `x = x + y`.
fn detect_smurfing(amounts: Vector(i64, 10), threshold_cents: i64, min_count: i64) -> AlertSeverity requires(public) {
    let i: i64 = 0
    let count: i64 = 0
    while i < 10 {
        let a: i64 = amounts[i]
        let _matched: bool = if a > 0 && a < threshold_cents {
            count = count + 1
            true
        } else {
            false
        }
        i = i + 1
    }
    return if count >= min_count {
        High()
    } else {
        if count > 0 { Medium() } else { Low() }
    }
}

// ML feature scoring: Matrix(4,3) weights x Vector(3) features.
fn score_features(weights: Matrix(f64, 4, 3), features: Vector(f64, 3)) -> f64 requires(public) {
    let row: i64 = 0
    let total: f64 = 0.0
    while row < 4 {
        let col: i64 = 0
        let row_sum: f64 = 0.0
        while col < 3 {
            let w: f64 = weights[row, col]
            let f: f64 = features[col]
            row_sum = row_sum + w * f
            col = col + 1
        }
        total = total + row_sum
        row = row + 1
    }
    return total
}

// Thread demo: spawn a top-level fn (no closure), join back.
fn compute_async_score(seed: i64) -> i64 requires(public) {
    let t: thread i64 = spawn double(seed)
    let v: i64 = join(t)
    return v
}

// Channel demo: feed candidates to a background thread, join.
fn detect_circular_worker(c: chan i64) -> i64 requires(public) {
    let total: i64 = 0
    let keep_going: bool = true
    while keep_going {
        let v: i64 = recv(c)
        let _unused: bool = if v < 0 {
            keep_going = false
            true
        } else {
            total = total + v
            true
        }
    }
    return total
}

fn detect_circular(seeds: Vector(i64, 8)) -> i64 requires(public) {
    let c: chan i64 = chan
    let i: i64 = 0
    while i < 8 {
        send(c, seeds[i])
        i = i + 1
    }
    send(c, -1)
    let t: thread i64 = spawn detect_circular_worker(c)
    return join(t)
}

// Dormant account burst detection.
fn detect_dormant_burst_inner(conn: db, account_id: i64, current_ts: i64) -> Result(i64, ErrorCode) requires(public) {
    let rows_result: Result(json, ErrorCode) = match db_query(
        conn,
        "SELECT COUNT(*) AS txn_count FROM transaction WHERE account_from = ? AND timestamp_unix > ? - 86400",
        account_id,
        current_ts
    ) {
        Ok(r) => Ok(r),
        Err(e) => Err(DbError(e)),
    }
    let result: Result(i64, ErrorCode) = match rows_result {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_i64(row, "txn_count") {
                Ok(c) => Ok(if c > 10 { 80 } else { 20 }),
                Err(e) => Err(JsonError(e)),
            },
            Err(e) => Err(NotFound("no rows")),
        },
        Err(e) => Err(e),
    }
    stop(conn)
    return result
}

fn detect_dormant_burst(account_id: i64, current_ts: i64) -> Result(i64, ErrorCode) requires(role: "analyst") {
    return match db_connect("ctms.db") {
        Ok(conn) => detect_dormant_burst_inner(conn, account_id, current_ts),
        Err(e) => Err(DbError(e)),
    }
}

// High-risk geo check: literal-pattern match on str with trailing _.
fn is_high_risk_geo(country: Text) -> bool requires(public) {
    let c: str = country.value
    return match c {
        "IR" => true,
        "KP" => true,
        "SY" => true,
        "MM" => true,
        _ => false,
    }
}

// Score a single transaction by reading from DB.
// Rule 9: match arms are single expressions (helper split for multi-step).
fn score_transaction_inner(conn: db, txn_id: i64) -> Result(i64, ErrorCode) requires(public) {
    let row_result: Result(json, ErrorCode) = match db_query(
        conn,
        "SELECT amount_cents, account_from, account_to FROM transaction WHERE id = ?",
        txn_id
    ) {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => Ok(row),
            Err(e) => Err(JsonError(e)),
        },
        Err(e) => Err(DbError(e)),
    }
    let result: Result(i64, ErrorCode) = match row_result {
        Ok(row) => match json_get_i64(row, "amount_cents") {
            Ok(amt) => Ok(if amt > 1000000 { 90 } else { if amt > 100000 { 60 } else { 20 } }),
            Err(e) => Err(JsonError(e)),
        },
        Err(e) => Err(e),
    }
    stop(conn)
    return result
}

fn score_transaction(txn_id: i64) -> Result(i64, ErrorCode) requires(role: "analyst") {
    return match db_connect("ctms.db") {
        Ok(conn) => score_transaction_inner(conn, txn_id),
        Err(e) => Err(DbError(e)),
    }
}

// ============================================================
// Section 5: Investigative Case Management System
// ============================================================
// Demonstrates: full CRUD (list/create/update/delete), helper-function
// split per rule 9, requires(role: ...) gating at different levels.

fn list_case_inner(conn: db) -> Result(json, ErrorCode) requires(public) {
    let _created: i64 = match db_execute(
        conn,
        "CREATE TABLE IF NOT EXISTS case_record (id INTEGER PRIMARY KEY, alert_id INTEGER, status TEXT, resolution TEXT, investigator TEXT, created INTEGER, sla_deadline INTEGER, risk_score INTEGER)"
    ) {
        Ok(n) => n,
        Err(e) => -1,
    }
    // Column aliases match `Case`'s own field names exactly -- the
    // generated list screen looks a row up by struct field name
    // (`row[f.name]`, ui_gen_template.html), not by whatever the SQL
    // schema happens to call the column.
    let rows: Result(json, ErrorCode) = match db_query(
        conn,
        "SELECT id, alert_id, status, resolution, investigator AS assigned_investigator, created AS created_unix, sla_deadline AS sla_deadline_unix, risk_score FROM case_record ORDER BY id"
    ) {
        Ok(r) => Ok(r),
        Err(e) => Err(DbError(e)),
    }
    stop(conn)
    return rows
}

fn list_case() -> Result(json, ErrorCode) requires(role: "investigator") {
    return match db_connect("ctms.db") {
        Ok(conn) => list_case_inner(conn),
        Err(e) => Err(DbError(e)),
    }
}

fn create_case_inner(conn: db, c: Case) -> Result(i64, ErrorCode) requires(public) {
    let status_text: Text = status_label(c.status)
    let resolution_text: Text = resolution_label(c.resolution)
    let r: i64 = match db_execute(
        conn,
        "INSERT INTO case_record (alert_id, status, resolution, investigator, created, sla_deadline, risk_score) VALUES (?, ?, ?, ?, ?, ?, ?)",
        c.alert_id,
        status_text.value,
        resolution_text.value,
        c.assigned_investigator,
        c.created_unix,
        c.sla_deadline_unix,
        c.risk_score
    ) {
        Ok(n) => n,
        Err(e) => -1,
    }
    let result: Result(i64, ErrorCode) = if r >= 0 { Ok(r) } else { Err(DbError("insert failed")) }
    stop(conn)
    return result
}

fn create_case(c: Case) -> Result(i64, ErrorCode) requires(role: "investigator") {
    return match db_connect("ctms.db") {
        Ok(conn) => create_case_inner(conn, c),
        Err(e) => Err(DbError(e)),
    }
}

fn update_case_status_inner(conn: db, case_id: i64, new_status: CaseStatus) -> Result(i64, ErrorCode) requires(public) {
    let status_text: Text = status_label(new_status)
    let r: i64 = match db_execute(
        conn,
        "UPDATE case_record SET status = ? WHERE id = ?",
        status_text.value,
        case_id
    ) {
        Ok(n) => n,
        Err(e) => -1,
    }
    let result: Result(i64, ErrorCode) = if r >= 0 { Ok(r) } else { Err(DbError("update failed")) }
    stop(conn)
    return result
}

fn update_case_status(case_id: i64, new_status: CaseStatus) -> Result(i64, ErrorCode) requires(role: "supervisor") {
    return match db_connect("ctms.db") {
        Ok(conn) => update_case_status_inner(conn, case_id, new_status),
        Err(e) => Err(DbError(e)),
    }
}

fn close_case_inner(conn: db, case_id: i64, resolution: CaseResolution) -> Result(i64, ErrorCode) requires(public) {
    let resolution_text: Text = resolution_label(resolution)
    let r: i64 = match db_execute(
        conn,
        "UPDATE case_record SET status = ?, resolution = ? WHERE id = ?",
        "closed",
        resolution_text.value,
        case_id
    ) {
        Ok(n) => n,
        Err(e) => -1,
    }
    let result: Result(i64, ErrorCode) = if r >= 0 { Ok(r) } else { Err(DbError("close failed")) }
    stop(conn)
    return result
}

fn close_case(case_id: i64, resolution: CaseResolution) -> Result(i64, ErrorCode) requires(role: "compliance") {
    return match db_connect("ctms.db") {
        Ok(conn) => close_case_inner(conn, case_id, resolution),
        Err(e) => Err(DbError(e)),
    }
}

fn delete_case_inner(conn: db, case_id: i64) -> Result(i64, ErrorCode) requires(public) {
    let r: i64 = match db_execute(conn, "DELETE FROM case_record WHERE id = ?", case_id) {
        Ok(n) => n,
        Err(e) => -1,
    }
    let result: Result(i64, ErrorCode) = if r >= 0 { Ok(r) } else { Err(DbError("delete failed")) }
    stop(conn)
    return result
}

fn delete_case(case_id: i64) -> Result(i64, ErrorCode) requires(role: "admin") {
    return match db_connect("ctms.db") {
        Ok(conn) => delete_case_inner(conn, case_id),
        Err(e) => Err(DbError(e)),
    }
}

// ============================================================
// Section 6: Regulatory and Secure Data Exchange
// ============================================================
// Demonstrates: https_get, https_post, http_get, http_post, file I/O
// (open/send/recv/stop with "r"/"w"/"a" modes), requires(role: ...).

fn fetch_sanctions_list() -> Result(Text, ErrorCode) requires(role: "admin") {
    return match https_get("sanctions.example.gov", 443, "/ofac.json") {
        Ok(resp) => Ok(Text("sanctions-fetched")),
        Err(e) => Err(HttpError(e)),
    }
}

fn submit_report_to_regulator(report_payload: Text) -> Result(i64, ErrorCode) requires(role: "compliance") {
    return match https_post("fiu.example.gov", 443, "/reports", report_payload.value) {
        Ok(resp) => Ok(1),
        Err(e) => Err(HttpError(e)),
    }
}

fn fetch_pep_list() -> Result(i64, ErrorCode) requires(role: "admin") {
    return match http_get("pep.internal", 8080, "/pep.json") {
        Ok(resp) => Ok(1),
        Err(e) => Err(HttpError(e)),
    }
}

