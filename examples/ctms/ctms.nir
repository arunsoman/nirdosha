fn count_alerts_by_severity_inner(conn: db) -> Result(Vector(i64, 4), ErrorCode) requires(public) {
    let _created: i64 = match db_execute(
        conn,
        "CREATE TABLE IF NOT EXISTS alert (id INTEGER PRIMARY KEY, transaction_id INTEGER, severity TEXT, rule_id INTEGER, risk_score INTEGER, description TEXT)"
    ) {
        Ok(n) => n,
        Err(e) => -1,
    }
