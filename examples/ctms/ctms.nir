fn simulate_fraud_rule_inner(conn: db, id: i64) -> Result(json, ErrorCode) {
    let c1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS fraud_rule (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT, condition_expr TEXT, jurisdiction_scope TEXT, active INTEGER, version_number INTEGER)") { Ok(n) => n, Err(e) => -1 }
    let c2: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS txn (id INTEGER PRIMARY KEY AUTOINCREMENT, matter_id INTEGER, amount_cents INTEGER, geo_country TEXT, created_unix INTEGER, geo_lat REAL, geo_lng REAL)") { Ok(n) => n, Err(e) => -1 }
    let result: Result(json, ErrorCode) = match db_query(
        conn,
        "SELECT (SELECT name FROM fraud_rule WHERE id = ?) AS rule, (SELECT COUNT(*) FROM txn) AS would_scan_count",
        id
    ) {
        Ok(rows) => match json_array_get(rows, 0) { Ok(one) => Ok(one), Err(e) => Err(DbError(e)) },
        Err(e) => Err(DbError(e)),
    }
    stop conn
    return result
}
fn simulate_fraud_rule(id: i64) -> Result(json, ErrorCode) requires(role: "fraud_analyst") {
    return match db_connect("ctms.db") { Ok(conn) => simulate_fraud_rule_inner(conn, id), Err(e) => Err(DbError(e)) }
}

screen FraudRule {
    title: "Rule Engine Configuration"
    action "Test Against Sample" -> simulate_fraud_rule {
        style: "outlined"
        show_result: true
    }
}

