    name: str,
    threshold_cents: i64,
    active: bool,
}

fn list_compliance_policy_inner(conn: db) -> Result(json, ErrorCode) {
    let c1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS compliance_policy (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT, threshold_cents INTEGER, active INTEGER)") {
        Ok(n) => n,
        Err(e) => -1,
    }
    let rows: Result(json, ErrorCode) = match db_query(conn, "SELECT id, name, threshold_cents, active FROM compliance_policy ORDER BY id") {
        Ok(r) => Ok(r),
        Err(e) => Err(DbError(e)),
    }
    stop conn
    return rows
}

fn list_compliance_policy() -> Result(json, ErrorCode) requires(public) {
