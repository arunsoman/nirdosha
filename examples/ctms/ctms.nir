fn parse_wallet_row(row: json) -> Wallet requires(public) {
    let addr: str = match json_get_str(row, "address") {
        Ok(s) => s,
        Err(e) => "",
    }
    let cluster: i64 = match json_get_i64(row, "cluster_id") {
        Ok(c) => c,
        Err(e) => 0,
    }
    let risk: i64 = match json_get_i64(row, "risk_score") {
        Ok(r) => r,
        Err(e) => 0,
    }
    let sanctioned: bool = match json_get_bool(row, "is_sanctioned") {
        Ok(b) => b,
        Err(e) => false,
    }
    return Wallet(addr, cluster, risk, sanctioned)
}

fn find_wallet_by_address_inner(conn: db, address: Text) -> Result(Wallet, ErrorCode) requires(public) {
    let rows_result: Result(json, ErrorCode) = match db_query(
        conn,
        "SELECT address, cluster_id, risk_score, is_sanctioned FROM wallet WHERE address = ?",
        address.value
    ) {
        Ok(r) => Ok(r),
        Err(e) => Err(DbError(e)),
    }
    let result: Result(Wallet, ErrorCode) = match rows_result {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => Ok(parse_wallet_row(row)),
            Err(e) => Err(NotFound("wallet not found")),
        },
        Err(e) => Err(e),
    }
    stop(conn)
    return result
}

