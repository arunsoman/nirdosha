        Ok(n) => n,
        Err(e) => -1,
    }
    let result: Result(i64, ErrorCode) = match db_execute(conn, "INSERT INTO compliance_policy (name, threshold_cents, active) VALUES (?, ?, ?)", p.name, p.threshold_cents, p.active) {
        Ok(n) => Ok(n),
        Err(e) => Err(DbError(e)),
