// ---- Dashboard: tiles + Track E2's `visual`/`render` ------------------

fn stat_open_matters_inner(conn: db) -> Result(i64, ErrorCode) {
    let c1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS matter (id INTEGER PRIMARY KEY AUTOINCREMENT, subject_name TEXT, status TEXT, risk_score INTEGER, sla_deadline_unix INTEGER)") {
        Ok(n) => n,
        Err(e) => -1,
    }
    let result: Result(i64, ErrorCode) = match db_query(conn, "SELECT COUNT(*) AS value FROM matter WHERE status = 'open'") {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_i64(row, "value") {
                Ok(n) => Ok(n),
                Err(e) => Ok(0),
            },
            Err(e) => Ok(0),
        },
        Err(e) => Err(DbError(e)),
    }
    stop conn
    return result
}

