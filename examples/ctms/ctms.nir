    let c: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS matter_evidence (id INTEGER PRIMARY KEY AUTOINCREMENT, matter_id INTEGER, evidence_type TEXT, uploader TEXT, content_hash TEXT, version_number INTEGER)") { Ok(n) => n, Err(e) => -1 }
    let rows: Result(json, ErrorCode) = match db_query(conn, "SELECT id, evidence_type, uploader, content_hash, version_number FROM matter_evidence WHERE matter_id = ? ORDER BY id", matter_id) { Ok(r) => Ok(r), Err(e) => Err(DbError(e)) }
    stop conn
