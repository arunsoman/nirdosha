// Trend matrix: 7 days x 4 severity buckets.
// A `Vector(Vector(i64, 4), 7)` parameter (a Vector of Vectors) can
// never actually be constructed by a caller -- `infer_array_lit` caps
// array literals at 2 dimensions: an array of same-shaped Vectors is
// always classified as a `Matrix`, never a `Vector` of `Vector`s (see
// its doc comment). So this takes one `Vector(i64, 4)` per day
// directly, and there's no indexed-assignment (`m[r][c] = ...`) to
// build the matrix cell-by-cell either -- the whole thing is one
// literal instead.
fn build_trend_matrix(
    d0: Vector(i64, 4),
    d1: Vector(i64, 4),
    d2: Vector(i64, 4),
    d3: Vector(i64, 4),
    d4: Vector(i64, 4),
    d5: Vector(i64, 4),
    d6: Vector(i64, 4)
) -> Matrix(i64, 7, 4) requires(public) {
    return [
        [d0[0], d0[1], d0[2], d0[3]],
        [d1[0], d1[1], d1[2], d1[3]],
        [d2[0], d2[1], d2[2], d2[3]],
        [d3[0], d3[1], d3[2], d3[3]],
        [d4[0], d4[1], d4[2], d4[3]],
        [d5[0], d5[1], d5[2], d5[3]],
        [d6[0], d6[1], d6[2], d6[3]]
    ]
}

