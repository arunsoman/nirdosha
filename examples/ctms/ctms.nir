fn stat_active_source_count_inner(conn: db) -> Result(i64, ErrorCode) {
    let c: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS data_source (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT, source_type TEXT, format TEXT, connection_status TEXT, last_ingestion_unix INTEGER, active INTEGER)") { Ok(n) => n, Err(e) => -1 }
    let result: Result(i64, ErrorCode) = match db_query(conn, "SELECT COUNT(*) AS value FROM data_source WHERE active = 1") {
        Ok(rows) => match json_array_get(rows, 0) { Ok(row) => match json_get_i64(row, "value") { Ok(n) => Ok(n), Err(e) => Ok(0) }, Err(e) => Ok(0) },
        Err(e) => Err(DbError(e)),
    }
    stop conn
    return result
}
fn stat_active_source_count() -> Result(i64, ErrorCode) requires(public) {
    return match db_connect("ctms.db") { Ok(conn) => stat_active_source_count_inner(conn), Err(e) => Err(DbError(e)) }
}
fn stat_schema_drift_alert_count_inner(conn: db) -> Result(i64, ErrorCode) {
    let c: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS schema_version_entry (id INTEGER PRIMARY KEY AUTOINCREMENT, source_id INTEGER, version_number INTEGER, field_diff TEXT, backward_compatible INTEGER, approved INTEGER)") { Ok(n) => n, Err(e) => -1 }
    let result: Result(i64, ErrorCode) = match db_query(conn, "SELECT COUNT(*) AS value FROM schema_version_entry WHERE backward_compatible = 0") {
        Ok(rows) => match json_array_get(rows, 0) { Ok(row) => match json_get_i64(row, "value") { Ok(n) => Ok(n), Err(e) => Ok(0) }, Err(e) => Ok(0) },
        Err(e) => Err(DbError(e)),
    }
    stop conn
    return result
}
fn stat_schema_drift_alert_count() -> Result(i64, ErrorCode) requires(public) {
    return match db_connect("ctms.db") { Ok(conn) => stat_schema_drift_alert_count_inner(conn), Err(e) => Err(DbError(e)) }
}

// ---- Module 2: Real-Time Fraud Detection and AI Modelling -------------

module "Fraud Detection" {
    struct Alert {
        id: i64,
        transaction_ref: str,
        risk_score: i64,
        triggering_rule: str,
        severity: str,
        detected_unix: i64,
        status: str,
    }

    struct AlertSignal {
        id: i64,
        alert_id: i64,
        signal_name: str,
        contribution_score: i64,
    }

    struct FraudRule {
        id: i64,
        name: str,
        condition_expr: str,
        jurisdiction_scope: str,
        active: bool,
        version_number: i64,
    }

    struct ScoringWeight {
        id: i64,
        signal_name: str,
        weight_percent: i64,
    }

    struct BehaviouralProfile {
        id: i64,
        entity_ref: str,
        baseline_txn_count: i64,
        deviation_score: i64,
        flagged: bool,
    }

    struct MlModel {
        id: i64,
        name: str,
        model_type: str,
        accuracy_percent: i64,
        version_number: i64,
        promoted: bool,
    }

    struct AnalystFeedback {
        id: i64,
        alert_id: i64,
        label: str,
        submitted_by: str,
        submitted_unix: i64,
    }

    struct WatchlistEntry {
        id: i64,
        entity_ref: str,
        reason: str,
        source: str,
        added_unix: i64,
        listed: bool,
    }
}

fn list_alert_inner(conn: db) -> Result(json, ErrorCode) {
    let c: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS alert (id INTEGER PRIMARY KEY AUTOINCREMENT, transaction_ref TEXT, risk_score INTEGER, triggering_rule TEXT, severity TEXT, detected_unix INTEGER, status TEXT)") { Ok(n) => n, Err(e) => -1 }
    let rows: Result(json, ErrorCode) = match db_query(conn, "SELECT id, transaction_ref, risk_score, triggering_rule, severity, detected_unix, status FROM alert ORDER BY detected_unix DESC") { Ok(r) => Ok(r), Err(e) => Err(DbError(e)) }
    stop conn
    return rows
}
fn list_alert() -> Result(json, ErrorCode) requires(public) {
    return match db_connect("ctms.db") { Ok(conn) => list_alert_inner(conn), Err(e) => Err(DbError(e)) }
}
fn get_alert_inner(conn: db, id: i64) -> Result(json, ErrorCode) {
    let c: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS alert (id INTEGER PRIMARY KEY AUTOINCREMENT, transaction_ref TEXT, risk_score INTEGER, triggering_rule TEXT, severity TEXT, detected_unix INTEGER, status TEXT)") { Ok(n) => n, Err(e) => -1 }
    let row: Result(json, ErrorCode) = match db_query(conn, "SELECT id, transaction_ref, risk_score, triggering_rule, severity, detected_unix, status FROM alert WHERE id = ?", id) {
        Ok(r) => match json_array_get(r, 0) { Ok(one) => Ok(one), Err(e) => Err(DbError(e)) },
        Err(e) => Err(DbError(e)),
    }
    stop conn
    return row
}
fn get_alert(id: i64) -> Result(json, ErrorCode) requires(public) {
    return match db_connect("ctms.db") { Ok(conn) => get_alert_inner(conn, id), Err(e) => Err(DbError(e)) }
}
fn create_alert_inner(conn: db, a: Alert) -> Result(i64, ErrorCode) {
    let c: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS alert (id INTEGER PRIMARY KEY AUTOINCREMENT, transaction_ref TEXT, risk_score INTEGER, triggering_rule TEXT, severity TEXT, detected_unix INTEGER, status TEXT)") { Ok(n) => n, Err(e) => -1 }
    let result: Result(i64, ErrorCode) = match db_execute(conn, "INSERT INTO alert (transaction_ref, risk_score, triggering_rule, severity, detected_unix, status) VALUES (?, ?, ?, ?, ?, ?)", a.transaction_ref, a.risk_score, a.triggering_rule, a.severity, a.detected_unix, a.status) { Ok(n) => Ok(n), Err(e) => Err(DbError(e)) }
    stop conn
    return result
}
