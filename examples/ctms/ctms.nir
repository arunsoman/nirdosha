// ============================================================
// Section 7: Advanced Analytics, Reporting, and BI
// ============================================================
// Demonstrates: db_query row-by-row iteration via json_array_len +
// while, Vector/Matrix for trend analysis, nested Result unwrapping.

// Vector/Matrix values have no indexed-assignment form (`=`'s
// left-hand side must be a plain variable name) -- accumulate the four
// buckets as ordinary i64 locals across the loop, then build the
// Vector literal once at the end.
fn count_alerts_by_severity_helper(rows: json) -> Vector(i64, 4) requires(public) {
    let low: i64 = 0
    let medium: i64 = 0
    let high: i64 = 0
    let critical: i64 = 0
    let n: i64 = match json_array_len(rows) {
        Ok(len) => len,
        Err(e) => 0,
    }
    let i: i64 = 0
    while i < n {
        let row: json = match json_array_get(rows, i) {
            Ok(r) => r,
            Err(e) => rows,
        }
        let sev_text: Text = match json_get_str(row, "severity") {
            Ok(s) => Text(s),
            Err(e) => Text("low"),
        }
        let count: i64 = match json_get_i64(row, "n") {
            Ok(c) => c,
            Err(e) => 0,
        }
        let sev: AlertSeverity = severity_from_label(sev_text)
        // Plain `x = if ... {...} else {...}` doesn't parse -- a bare
        // reassignment's RHS is `parse_assignment`, which never re-enters
        // `parse_expr`'s if/match dispatch; wrap it in parens (a
        // parenthesized expr *does* go through `parse_expr` again) to
        // use `if` on the right of a reassignment at all.
        low = (if sev == Low() { count } else { low })
        medium = (if sev == Medium() { count } else { medium })
        high = (if sev == High() { count } else { high })
        critical = (if sev == Critical() { count } else { critical })
        i = i + 1
    }
    return [low, medium, high, critical]
}

// Alert CRUD -- named `create_alert`/`list_alert` (not `make_alert`,
// which stays as its own pure in-memory constructor demo above) so
// `ui_gen.rs`'s naming convention picks Alert up as a real screen.
// `CREATE TABLE IF NOT EXISTS alert` here also makes
// `count_alerts_by_severity_inner`'s own `FROM alert` query below safe
// to run standalone (e.g. plain `nirdosha ctms.nir`, no `--db`
// migrations) instead of implicitly depending on a table `nirdosha
// serve --db` happens to auto-migrate into existence first.
fn create_alert_inner(conn: db, a: Alert) -> Result(i64, ErrorCode) requires(public) {
    let _created: i64 = match db_execute(
        conn,
        "CREATE TABLE IF NOT EXISTS alert (id INTEGER PRIMARY KEY, transaction_id INTEGER, severity TEXT, rule_id INTEGER, risk_score INTEGER, description TEXT)"
    ) {
        Ok(n) => n,
        Err(e) => -1,
    }
    let severity_text: Text = severity_label(a.severity)
    let r: i64 = match db_execute(
        conn,
        "INSERT INTO alert (transaction_id, severity, rule_id, risk_score, description) VALUES (?, ?, ?, ?, ?)",
        a.transaction_id,
        severity_text.value,
        a.rule_id,
        a.risk_score,
        a.description
    ) {
        Ok(n) => n,
        Err(e) => -1,
    }
    let result: Result(i64, ErrorCode) = if r >= 0 { Ok(r) } else { Err(DbError("alert insert failed")) }
    stop(conn)
    return result
}

fn create_alert(a: Alert) -> Result(i64, ErrorCode) requires(role: "analyst") {
    return match db_connect("ctms.db") {
        Ok(conn) => create_alert_inner(conn, a),
        Err(e) => Err(DbError(e)),
    }
}

