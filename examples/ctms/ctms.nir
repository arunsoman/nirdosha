    let result: Result(i64, ErrorCode) = match db_query(conn, "SELECT COUNT(*) AS value FROM rtfds_event WHERE action_taken = 'blocked'") {
        Ok(rows) => match json_array_get(rows, 0) { Ok(row) => match json_get_i64(row, "value") { Ok(n) => Ok(n), Err(e) => Ok(0) }, Err(e) => Ok(0) },
        Err(e) => Err(DbError(e)),
    }
