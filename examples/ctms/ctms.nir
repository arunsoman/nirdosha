        Err(e) => Err(DbError(e)),
    }
}

// Travel Rule: counterparty KYC must be present.
fn check_travel_rule(sender_kyc: Text, receiver_kyc: Text) -> Result(i64, ErrorCode) requires(role: "crypto") {
    return if sender_kyc.value == "" {
        Err(CryptoRisk("travel rule violation: missing sender KYC"))
    } else {
        if receiver_kyc.value == "" {
            Err(CryptoRisk("travel rule violation: missing receiver KYC"))
        } else {
            Ok(1)
        }
    }
}

// ============================================================
// Section 10: RTFDS (Real-Time Fraud Detection Management System)
// ============================================================
// Demonstrates: tcp_listener (listen/accept), sandbox (spawn/stop).

fn accept_fraud_event() -> Result(Text, ErrorCode) requires(role: "fraud_analyst") {
    let l: tcp_listener = listen(9090)
    let incoming: tcp = accept(l)
    let payload: str = recv(incoming)
    stop(incoming)
    stop(l)
    return Ok(Text(payload))
}

// A function run with `sandbox` must return `unit` -- there's no way
// to hand a value back to the caller through its own return slot
// across a real process boundary. Send the result over a `chan`
// argument instead (SANDBOXING.md), same pattern as
// examples/sandbox_channels.nir.
fn analyze_payload(payload_id: i64, c: chan i64) -> unit requires(public) {
    send(c, payload_id)
    return
}

fn run_sandbox_analysis(payload_id: i64) -> Result(i64, ErrorCode) requires(role: "fraud_analyst") {
    let c: chan i64 = chan
    let s: sandbox = sandbox analyze_payload(payload_id, c)
    let result: i64 = recv(c)
    let code: i64 = stop(s)
    return Ok(result)
}

// ============================================================
// Section 11: Identity and Access Management (IAM)
// ============================================================
// Demonstrates: oidc_validate_token, check_role, extract_claim,
// acquire for privileged functions, VerifiedIdentity parameter
// (silences rule 12 without any requires(...)).

fn validate_user_token(token: Text, issuer: Text, audience: Text, jwks: Text) -> Result(VerifiedIdentity, ErrorCode) requires(public) {
    return match oidc_validate_token(token.value, issuer.value, audience.value, jwks.value) {
        Ok(id) => Ok(id),
        Err(e) => Err(AuthError(e)),
    }
}

// Privileged function: requires(role: "admin"). Must be acquired.
fn privileged_admin_action(n: i64) -> i64 requires(role: "admin") {
    return n + 1
}

// `acquire` now returns `Result(fn(...) -> ..., str)` (the proof might
// not match at runtime), not a bare fn value -- unwrap it like any
// other fallible builtin.
fn invoke_admin_action_helper(role_view: RoleView, n: i64) -> i64 requires(public) {
    return match acquire privileged_admin_action(role_view) {
        Ok(f) => f(n),
        Err(e) => -1,
    }
}

// VerifiedIdentity parameter — third bucket for rule 12 (no requires needed).
fn invoke_admin_action(identity: VerifiedIdentity, n: i64) -> Result(i64, ErrorCode) {
    return match check_role(identity, "admin") {
        Ok(role_view) => Ok(invoke_admin_action_helper(role_view, n)),
        Err(e) => Err(AuthError(e)),
    }
}

fn privileged_legal_hold_action(case_id: i64) -> i64 requires(claim: "legal_hold", "true") {
    return case_id
}

fn invoke_legal_hold_helper(claim_view: ClaimView, case_id: i64) -> i64 requires(public) {
    return match acquire privileged_legal_hold_action(claim_view) {
        Ok(f) => f(case_id),
        Err(e) => -1,
    }
}

fn invoke_legal_hold(identity: VerifiedIdentity, case_id: i64) -> Result(i64, ErrorCode) {
    return match extract_claim(identity, "legal_hold") {
        Ok(claim_view) => Ok(invoke_legal_hold_helper(claim_view, case_id)),
        Err(e) => Err(AuthError(e)),
    }
}

// ============================================================
// Section 12: Audit and Logging Infrastructure
// ============================================================
// Demonstrates: file open in append mode for WORM-like logging.

fn append_audit_log_inner(f: file, entry: AuditEntry) -> Result(i64, ErrorCode) requires(public) {
    send(f, entry.action)
    stop(f)
    return Ok(entry.id)
}

fn append_audit_log(entry: AuditEntry) -> Result(i64, ErrorCode) requires(role: "auditor") {
    let f: file = open("audit.log", "a")
    return append_audit_log_inner(f, entry)
}

fn read_audit_log() -> Result(Text, ErrorCode) requires(role: "auditor") {
    let f: file = open("audit.log", "r")
    let contents: str = recv(f)
    stop(f)
    return Ok(Text(contents))
}

// ============================================================
// Section 13: Integer width and type demos
// ============================================================
// Every integer width, f64, bool — no implicit conversion (rule 6).

fn sum_u8(a: u8, b: u8) -> u8 requires(public) { return a + b }
fn sum_u16(a: u16, b: u16) -> u16 requires(public) { return a + b }
fn sum_u32(a: u32, b: u32) -> u32 requires(public) { return a + b }
fn sum_u64(a: u64, b: u64) -> u64 requires(public) { return a + b }
fn sum_i8(a: i8, b: i8) -> i8 requires(public) { return a + b }
fn sum_i16(a: i16, b: i16) -> i16 requires(public) { return a + b }
fn sum_i32(a: i32, b: i32) -> i32 requires(public) { return a + b }
fn sum_i64(a: i64, b: i64) -> i64 requires(public) { return a + b }
fn sum_usize(a: usize, b: usize) -> usize requires(public) { return a + b }
fn sum_f64(a: f64, b: f64) -> f64 requires(public) { return a + b }
fn any_true(a: bool, b: bool) -> bool requires(public) { return a || b }

// ============================================================
// Section 14: box and borrow demos
// ============================================================
// box T: single-owner, affine — using by name moves it.
// &T: read-only borrow of a plain identifier only.

fn read_boxed_value(b: box i64) -> i64 requires(public) {
    let v: i64 = *b
    return v
}

fn borrow_and_read(x: i64) -> i64 requires(public) {
    let r: &i64 = &x
    return *r
}

// ============================================================
// Section 15: main
// ============================================================

fn main() requires(public) {
    print("CTMS ready")
}
