    let updated: Result(i64, ErrorCode) = match db_execute(conn, "UPDATE regulatory_report SET transmission_status = 'transmitted' WHERE id = ?", id) { Ok(n) => Ok(n), Err(e) => Err(DbError(e)) }
    let result: Result(json, ErrorCode) = match updated {
