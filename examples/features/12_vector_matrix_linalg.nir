// Feature: `Vector(T, N)`/`Matrix(T, R, C)` and Phase 2's dense
// linear-algebra builtins (LANGUAGE.md §2, §5). Fixed-length/-shape,
// `N`/`R`/`C` compile-time literals -- `Vector(f64, 3) != Vector(f64, 4)`,
// different types. Every dense builtin below requires `T = f64`.

fn main() {
    let v: Vector(f64, 3) = [1.0, 2.0, 3.0]
    let w: Vector(f64, 3) = [4.0, 5.0, 6.0]

    print(dot(v, w))     // 1*4 + 2*5 + 3*6 = 32
    print(cross(v, w))   // [-3, 6, -3]
    print(len(v))        // 3
    print(sum(v))        // 6
    print(norm(v))       // sqrt(14)
    print(norm1(v))      // 6
    print(norm_inf(v))   // 3

    let m: Matrix(f64, 2, 2) = [[1.0, 2.0], [3.0, 4.0]]
    print(transpose(m))       // [[1, 3], [2, 4]]
    print(trace(m))           // 5
    print(det(m))             // -2
    print(inv(m))             // [[-2, 1], [1.5, -0.5]]
    print(is_square(m))       // true
    print(frobenius_norm(m))  // sqrt(1+4+9+16)

    let sym: Matrix(f64, 2, 2) = [[1.0, 2.0], [2.0, 1.0]]
    print(is_symmetric(sym))  // true
    let diag: Matrix(f64, 2, 2) = [[5.0, 0.0], [0.0, 5.0]]
    print(is_diag(diag))      // true

    print(zeros(3))     // [0, 0, 0]
    print(ones(2, 2))   // [[1, 1], [1, 1]]
    print(identity(3))  // 3x3 identity

    // Solve [[2,0],[0,3]] * x = [4,9] -- x = [2, 3]
    let a: Matrix(f64, 2, 2) = [[2.0, 0.0], [0.0, 3.0]]
    let b: Vector(f64, 2) = [4.0, 9.0]
    print(solve(a, b)) // [2, 3]
    print(rank(a))     // 2
}
