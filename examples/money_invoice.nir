// A real invoicing app, served with `nirdosha serve examples/money_invoice.nir
// --port 8080 --db money_invoice.db`.
//
// Demonstrates `LANGUAGE.md` §6c's `dec128`/`CurrencyCode`/`Money` end to
// end. As of 2026-08-27 all three are real **prelude** types
// (`ast.rs::prelude_enums`/`prelude_structs`) -- built into every `.nir`
// program automatically, the same way `Option`/`Result` already are, not
// a convention this file has to paste in. `InvoiceLine.amount`/`.currency`
// stay flat scalar columns (a real `dec128`/`CurrencyCode`, not an `f64`
// a caller has to promise not to misuse, not an `i64` a caller has to
// remember is "really cents") so `nirdosha serve --db`'s auto-migration
// can still derive one SQL table from this struct (`migrate.rs`'s
// "additive-only" schema deriver has no single-column shape for a nested
// struct field, so a literal `Money`-typed column would opt this table
// out of auto-migration entirely) -- `combine_lines` below is where a
// real `Money` value gets constructed and returned, not just its two
// flattened parts.
//
// `combine_lines` is `LANGUAGE.md` §6c's `add_money` example, made into
// a real callable endpoint: `POST /api/combine_lines` with body
// `{"a": {...InvoiceLine...}, "b": {...InvoiceLine...}}` adds two lines'
// `amount`s only if their `currency` matches -- a real, if narrow,
// demonstration that mixing currencies is caught (at the point they're
// combined, not by the compiler -- §6c's own documented tradeoff), not
// silently summed the way two `f64`/`_cents` fields could be -- and
// returns a real `Money(amount, currency)`, prelude-constructed exactly
// like any other struct.
//
// CRUD (`list_/create_/delete_invoice_line`) is plain SQLite-backed
// storage, same discipline `examples/store.nir` already documents: `db`
// is affine with no borrowing, so every function opens, uses, and
// `stop`s its own connection.

enum ErrorCode {
    DbError(str),
    CurrencyMismatch,
}

struct InvoiceLine {
    id: i64,
    description: str,
    amount: dec128,
    currency: CurrencyCode,
}

// ---- CRUD, SQLite-backed ------------------------------------------------

fn list_invoiceline_inner(conn: db) -> Result(json, ErrorCode) {
    let created: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS invoice_line (id INTEGER PRIMARY KEY AUTOINCREMENT, description TEXT, amount TEXT, currency TEXT)") {
        Ok(n) => n,
        Err(e) => -1,
    }
    let rows: Result(json, ErrorCode) = match db_query(conn, "SELECT id, description, amount, currency FROM invoice_line ORDER BY id") {
        Ok(r) => Ok(r),
        Err(e) => Err(DbError(e)),
    }
    stop conn
    return rows
}

fn list_invoice_line() -> Result(json, ErrorCode) requires(public) {
    return match db_connect("money_invoice.db") {
        Ok(conn) => list_invoiceline_inner(conn),
        Err(e) => Err(DbError(e)),
    }
}

fn create_invoiceline_inner(conn: db, line: InvoiceLine) -> Result(i64, ErrorCode) {
    let created: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS invoice_line (id INTEGER PRIMARY KEY AUTOINCREMENT, description TEXT, amount TEXT, currency TEXT)") {
        Ok(n) => n,
        Err(e) => -1,
    }
    // `line.amount` (dec128) and `line.currency` (CurrencyCode) bind
    // directly -- `sql_bind_params`'s `Value::Dec128`/zero-payload-
    // `Value::Enum` arms, no manual `.to_string()` needed at the call
    // site.
    let result: Result(i64, ErrorCode) = match db_execute(conn, "INSERT INTO invoice_line (description, amount, currency) VALUES (?, ?, ?)", line.description, line.amount, line.currency) {
        Ok(n) => Ok(n),
        Err(e) => Err(DbError(e)),
    }
    stop conn
    return result
}

fn create_invoice_line(line: InvoiceLine) -> Result(i64, ErrorCode) requires(public) {
    return match db_connect("money_invoice.db") {
        Ok(conn) => create_invoiceline_inner(conn, line),
        Err(e) => Err(DbError(e)),
    }
}

fn delete_invoiceline_inner(conn: db, id: i64) -> Result(i64, ErrorCode) {
    let created: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS invoice_line (id INTEGER PRIMARY KEY AUTOINCREMENT, description TEXT, amount TEXT, currency TEXT)") {
        Ok(n) => n,
        Err(e) => -1,
    }
    let result: Result(i64, ErrorCode) = match db_execute(conn, "DELETE FROM invoice_line WHERE id = ?", id) {
        Ok(n) => Ok(n),
        Err(e) => Err(DbError(e)),
    }
    stop conn
    return result
}

fn delete_invoice_line(id: i64) -> Result(i64, ErrorCode) requires(public) {
    return match db_connect("money_invoice.db") {
        Ok(conn) => delete_invoiceline_inner(conn, id),
        Err(e) => Err(DbError(e)),
    }
}

// ---- the actual point of this demo --------------------------------------

// `LANGUAGE.md` §6c's `add_money`, as a real endpoint returning a real
// prelude `Money` value -- `POST /api/combine_lines` with
// `{"a": {...}, "b": {...}}`.
fn combine_lines(a: InvoiceLine, b: InvoiceLine) -> Result(Money, ErrorCode) requires(public) {
    if a.currency != b.currency {
        return Err(CurrencyMismatch())
    }
    return Ok(Money(a.amount + b.amount, a.currency))
}

screen InvoiceLine {
    title: "Invoice Lines"
    field amount {
        label: "Amount"
    }
    field currency {
        label: "Currency"
    }
}
