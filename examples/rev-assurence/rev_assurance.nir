// Revenue Assurance MVP
// SQLite implementation
//
// Covers:
// - Network usage / mediation records
// - Billing records
// - Recharge records
// - Reconciliation runs
// - Revenue leakage detection
// - Exception management
// - Dashboard queries
//
// Monetary values are represented as integer cents.
// Quantities are represented as integer units.
//
// The program uses only SQLite builtins and parameterized SQL.
// No string concatenation is used.

enum ErrorCode {
    DbError(str),
    ValidationError(str),
    NotFound(str),
}

enum ReconciliationStatus {
    Matched,
    UsageMismatch,
    BillingMismatch,
    MissingBilling,
    MissingUsage,
    RechargeMismatch,
}

enum ExceptionStatus {
    Open,
    Investigating,
    Resolved,
    Ignored,
}

struct Text {
    value: str,
}

struct UsageRecord {
    id: i64,
    subscriber_id: str,
    event_type: str,
    usage_units: i64,
    event_time: str,
}

struct BillingRecord {
    id: i64,
    usage_id: i64,
    subscriber_id: str,
    billed_units: i64,
    billed_amount_cents: i64,
    bill_time: str,
}

struct RechargeRecord {
    id: i64,
    subscriber_id: str,
    recharge_amount_cents: i64,
    recharge_reference: str,
    recharge_time: str,
}

struct ReconciliationResult {
    id: i64,
    usage_id: i64,
    billing_id: i64,
    status: str,
    expected_amount_cents: i64,
    actual_amount_cents: i64,
    leakage_cents: i64,
}

struct AssuranceException {
    id: i64,
    reconciliation_id: i64,
    severity: str,
    status: str,
    description: str,
}


// ------------------------------------------------------------
// Database initialization
// ------------------------------------------------------------

fn initialize_database_inner(conn: db) -> Result(i64, ErrorCode) {

    let r1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS usage_record (id INTEGER PRIMARY KEY AUTOINCREMENT, subscriber_id TEXT NOT NULL, event_type TEXT NOT NULL, usage_units INTEGER NOT NULL, event_time TEXT NOT NULL)") {
        Ok(n) => n,
        Err(e) => -1,
    }
    let r2: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS billing_record (id INTEGER PRIMARY KEY AUTOINCREMENT, usage_id INTEGER NOT NULL, subscriber_id TEXT NOT NULL, billed_units INTEGER NOT NULL, billed_amount_cents INTEGER NOT NULL, bill_time TEXT NOT NULL)") {
        Ok(n) => n,
        Err(e) => -1,
    }
    let r3: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS recharge_record (id INTEGER PRIMARY KEY AUTOINCREMENT, subscriber_id TEXT NOT NULL, recharge_amount_cents INTEGER NOT NULL, recharge_reference TEXT NOT NULL, recharge_time TEXT NOT NULL)") {
        Ok(n) => n,
        Err(e) => -1,
    }
    let r4: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS reconciliation_result (id INTEGER PRIMARY KEY AUTOINCREMENT, usage_id INTEGER NOT NULL, billing_id INTEGER NOT NULL, status TEXT NOT NULL, expected_amount_cents INTEGER NOT NULL, actual_amount_cents INTEGER NOT NULL, leakage_cents INTEGER NOT NULL)") {
        Ok(n) => n,
        Err(e) => -1,
    }
    let r5: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS assurance_exception (id INTEGER PRIMARY KEY AUTOINCREMENT, reconciliation_id INTEGER NOT NULL, severity TEXT NOT NULL, status TEXT NOT NULL, description TEXT NOT NULL)") {
        Ok(n) => n,
        Err(e) => -1,
    }
    let r6: i64 = match db_execute(conn, "CREATE INDEX IF NOT EXISTS idx_usage_subscriber ON usage_record(subscriber_id)") {
        Ok(n) => n,
        Err(e) => -1,
    }
    let r7: i64 = match db_execute(conn, "CREATE INDEX IF NOT EXISTS idx_billing_usage ON billing_record(usage_id)") {
        Ok(n) => n,
        Err(e) => -1,
    }
    let r8: i64 = match db_execute(conn, "CREATE INDEX IF NOT EXISTS idx_billing_subscriber ON billing_record(subscriber_id)") {
        Ok(n) => n,
        Err(e) => -1,
    }
    let r9: i64 = match db_execute(conn, "CREATE INDEX IF NOT EXISTS idx_recharge_subscriber ON recharge_record(subscriber_id)") {
        Ok(n) => n,
        Err(e) => -1,
    }

    let all_ok: bool = r1 >= 0 && r2 >= 0 && r3 >= 0 && r4 >= 0 && r5 >= 0 && r6 >= 0 && r7 >= 0 && r8 >= 0 && r9 >= 0
    let result: Result(i64, ErrorCode) = if all_ok {
        Ok(r9)
    } else {
        Err(DbError("one or more setup statements failed"))
    }

    stop(conn)
    return result
}

fn initialize_database() -> Result(i64, ErrorCode) {

    return match db_connect("revenue_assurance.db") {
        Ok(conn) => initialize_database_inner(conn),
        Err(e) => Err(DbError(e)),
    }
}


// ------------------------------------------------------------
// Usage ingestion
// ------------------------------------------------------------

fn create_usage_record_inner(conn: db, r: UsageRecord) -> Result(i64, ErrorCode) {
    let result: Result(i64, ErrorCode) = match db_execute(conn, "INSERT INTO usage_record (subscriber_id, event_type, usage_units, event_time) VALUES (?, ?, ?, ?)", r.subscriber_id, r.event_type, r.usage_units, r.event_time) {
        Ok(n) => Ok(n),
        Err(e) => Err(DbError(e)),
    }
    stop(conn)
    return result
}

fn create_usage_record(r: UsageRecord) -> Result(i64, ErrorCode) {

    if r.usage_units < 0 {
        return Err(ValidationError("usage_units cannot be negative"))
    } else {
        return match db_connect("revenue_assurance.db") {
            Ok(conn) => create_usage_record_inner(conn, r),
            Err(e) => Err(DbError(e)),
        }
    }
}


// ------------------------------------------------------------
// Billing ingestion
// ------------------------------------------------------------

fn create_billing_record_inner(conn: db, r: BillingRecord) -> Result(i64, ErrorCode) {
    let result: Result(i64, ErrorCode) = match db_execute(conn, "INSERT INTO billing_record (usage_id, subscriber_id, billed_units, billed_amount_cents, bill_time) VALUES (?, ?, ?, ?, ?)", r.usage_id, r.subscriber_id, r.billed_units, r.billed_amount_cents, r.bill_time) {
        Ok(n) => Ok(n),
        Err(e) => Err(DbError(e)),
    }
    stop(conn)
    return result
}

fn create_billing_record(r: BillingRecord) -> Result(i64, ErrorCode) {

    if r.billed_units < 0 {
        return Err(ValidationError("billed_units cannot be negative"))
    } else {
        if r.billed_amount_cents < 0 {
            return Err(ValidationError("billed_amount_cents cannot be negative"))
        } else {
            return match db_connect("revenue_assurance.db") {
                Ok(conn) => create_billing_record_inner(conn, r),
                Err(e) => Err(DbError(e)),
            }
        }
    }
}


// ------------------------------------------------------------
// Recharge ingestion
// ------------------------------------------------------------

fn create_recharge_record_inner(conn: db, r: RechargeRecord) -> Result(i64, ErrorCode) {
    let result: Result(i64, ErrorCode) = match db_execute(conn, "INSERT INTO recharge_record (subscriber_id, recharge_amount_cents, recharge_reference, recharge_time) VALUES (?, ?, ?, ?)", r.subscriber_id, r.recharge_amount_cents, r.recharge_reference, r.recharge_time) {
        Ok(n) => Ok(n),
        Err(e) => Err(DbError(e)),
    }
    stop(conn)
    return result
}

fn create_recharge_record(r: RechargeRecord) -> Result(i64, ErrorCode) {

    if r.recharge_amount_cents < 0 {
        return Err(ValidationError("recharge amount cannot be negative"))
    } else {
        return match db_connect("revenue_assurance.db") {
            Ok(conn) => create_recharge_record_inner(conn, r),
            Err(e) => Err(DbError(e)),
        }
    }
}


// ------------------------------------------------------------
// Revenue Assurance reconciliation
//
// Expected charging rule:
//
// expected amount = usage_units * 1 cent
//
// This is deliberately simple for the MVP. A production version
// can replace this with a tariff/rating engine.
// ------------------------------------------------------------

fn run_reconciliation_inner(conn: db) -> Result(i64, ErrorCode) {

    let cleared: i64 = match db_execute(conn, "DELETE FROM reconciliation_result") {
        Ok(n) => n,
        Err(e) => -1,
    }
    let inserted: i64 = match db_execute(conn, "INSERT INTO reconciliation_result (usage_id, billing_id, status, expected_amount_cents, actual_amount_cents, leakage_cents) SELECT u.id, COALESCE(b.id, 0), CASE WHEN b.id IS NULL THEN 'MissingBilling' WHEN b.billed_units != u.usage_units THEN 'UsageMismatch' WHEN b.billed_amount_cents != u.usage_units THEN 'BillingMismatch' ELSE 'Matched' END, u.usage_units, COALESCE(b.billed_amount_cents, 0), CASE WHEN b.id IS NULL THEN u.usage_units WHEN u.usage_units > b.billed_amount_cents THEN u.usage_units - b.billed_amount_cents ELSE 0 END FROM usage_record u LEFT JOIN billing_record b ON b.usage_id = u.id") {
        Ok(n) => n,
        Err(e) => -1,
    }
    let exceptions: i64 = match db_execute(conn, "DELETE FROM assurance_exception") {
        Ok(n) => n,
        Err(e) => -1,
    }
    let generated: i64 = match db_execute(conn, "INSERT INTO assurance_exception (reconciliation_id, severity, status, description) SELECT id, CASE WHEN leakage_cents >= 10000 THEN 'CRITICAL' WHEN leakage_cents >= 1000 THEN 'HIGH' WHEN leakage_cents > 0 THEN 'MEDIUM' ELSE 'LOW' END, 'Open', CASE WHEN status = 'MissingBilling' THEN 'Usage exists without corresponding billing record' WHEN status = 'UsageMismatch' THEN 'Billed usage does not match network usage' WHEN status = 'BillingMismatch' THEN 'Billed amount does not match expected revenue' ELSE 'No discrepancy' END FROM reconciliation_result WHERE leakage_cents > 0 OR status != 'Matched'") {
        Ok(n) => n,
        Err(e) => -1,
    }

    let all_ok: bool = cleared >= 0 && inserted >= 0 && exceptions >= 0 && generated >= 0
    let result: Result(i64, ErrorCode) = if all_ok {
        Ok(generated)
    } else {
        Err(DbError("reconciliation step failed"))
    }

    stop(conn)
    return result
}

fn run_reconciliation() -> Result(i64, ErrorCode) {

    return match db_connect("revenue_assurance.db") {
        Ok(conn) => run_reconciliation_inner(conn),
        Err(e) => Err(DbError(e)),
    }
}


// ------------------------------------------------------------
// Reconciliation result listing
// ------------------------------------------------------------

fn list_reconciliation_inner(conn: db) -> Result(json, ErrorCode) {
    let result: Result(json, ErrorCode) = match db_query(conn, "SELECT id, usage_id, billing_id, status, expected_amount_cents, actual_amount_cents, leakage_cents FROM reconciliation_result ORDER BY id") {
        Ok(rows) => Ok(rows),
        Err(e) => Err(DbError(e)),
    }
    stop(conn)
    return result
}

fn list_reconciliation() -> Result(json, ErrorCode) {

    return match db_connect("revenue_assurance.db") {
        Ok(conn) => list_reconciliation_inner(conn),
        Err(e) => Err(DbError(e)),
    }
}


// ------------------------------------------------------------
// Exception listing
// ------------------------------------------------------------

fn list_assurance_exception_inner(conn: db) -> Result(json, ErrorCode) {
    let result: Result(json, ErrorCode) = match db_query(conn, "SELECT id, reconciliation_id, severity, status, description FROM assurance_exception ORDER BY id DESC") {
        Ok(rows) => Ok(rows),
        Err(e) => Err(DbError(e)),
    }
    stop(conn)
    return result
}

fn list_assurance_exception() -> Result(json, ErrorCode) {

    return match db_connect("revenue_assurance.db") {
        Ok(conn) => list_assurance_exception_inner(conn),
        Err(e) => Err(DbError(e)),
    }
}


// ------------------------------------------------------------
// Exception status update
// ------------------------------------------------------------

fn update_exception_status_inner(conn: db, id: i64, status: Text) -> Result(i64, ErrorCode) {
    let result: Result(i64, ErrorCode) = match db_execute(conn, "UPDATE assurance_exception SET status = ? WHERE id = ?", status.value, id) {
        Ok(n) => Ok(n),
        Err(e) => Err(DbError(e)),
    }
    stop(conn)
    return result
}

fn update_exception_status(id: i64, status: Text) -> Result(i64, ErrorCode) {

    return match db_connect("revenue_assurance.db") {
        Ok(conn) => update_exception_status_inner(conn, id, status),
        Err(e) => Err(DbError(e)),
    }
}


// ------------------------------------------------------------
// Dashboard
//
// Returns one aggregate JSON row containing:
//
// total usage records
// total billing records
// total reconciliations
// matched records
// discrepancy count
// total expected revenue
// actual billed revenue
// total leakage
// open exceptions
// critical exceptions
// ------------------------------------------------------------

fn revenue_assurance_dashboard_inner(conn: db) -> Result(json, ErrorCode) {
    let result: Result(json, ErrorCode) = match db_query(conn, "SELECT (SELECT COUNT(*) FROM usage_record) AS total_usage_records, (SELECT COUNT(*) FROM billing_record) AS total_billing_records, (SELECT COUNT(*) FROM reconciliation_result) AS total_reconciliations, (SELECT COUNT(*) FROM reconciliation_result WHERE status = 'Matched') AS matched_records, (SELECT COUNT(*) FROM reconciliation_result WHERE status != 'Matched') AS discrepancy_records, (SELECT COALESCE(SUM(expected_amount_cents), 0) FROM reconciliation_result) AS expected_revenue_cents, (SELECT COALESCE(SUM(actual_amount_cents), 0) FROM reconciliation_result) AS actual_revenue_cents, (SELECT COALESCE(SUM(leakage_cents), 0) FROM reconciliation_result) AS leakage_cents, (SELECT COUNT(*) FROM assurance_exception WHERE status = 'Open') AS open_exceptions, (SELECT COUNT(*) FROM assurance_exception WHERE status = 'Open' AND severity = 'CRITICAL') AS critical_exceptions") {
        Ok(rows) => Ok(rows),
        Err(e) => Err(DbError(e)),
    }
    stop(conn)
    return result
}

fn revenue_assurance_dashboard() -> Result(json, ErrorCode) {

    return match db_connect("revenue_assurance.db") {
        Ok(conn) => revenue_assurance_dashboard_inner(conn),
        Err(e) => Err(DbError(e)),
    }
}


// ------------------------------------------------------------
// Leakage by subscriber
// ------------------------------------------------------------

fn leakage_by_subscriber_inner(conn: db) -> Result(json, ErrorCode) {
    let result: Result(json, ErrorCode) = match db_query(conn, "SELECT u.subscriber_id, COUNT(*) AS usage_records, COALESCE(SUM(r.expected_amount_cents), 0) AS expected_revenue_cents, COALESCE(SUM(r.actual_amount_cents), 0) AS actual_revenue_cents, COALESCE(SUM(r.leakage_cents), 0) AS leakage_cents FROM usage_record u LEFT JOIN reconciliation_result r ON r.usage_id = u.id GROUP BY u.subscriber_id ORDER BY leakage_cents DESC") {
        Ok(rows) => Ok(rows),
        Err(e) => Err(DbError(e)),
    }
    stop(conn)
    return result
}

fn leakage_by_subscriber() -> Result(json, ErrorCode) {

    return match db_connect("revenue_assurance.db") {
        Ok(conn) => leakage_by_subscriber_inner(conn),
        Err(e) => Err(DbError(e)),
    }
}


// ------------------------------------------------------------
// Leakage by reconciliation status
// ------------------------------------------------------------

fn leakage_by_status_inner(conn: db) -> Result(json, ErrorCode) {
    let result: Result(json, ErrorCode) = match db_query(conn, "SELECT status, COUNT(*) AS record_count, COALESCE(SUM(expected_amount_cents), 0) AS expected_revenue_cents, COALESCE(SUM(actual_amount_cents), 0) AS actual_revenue_cents, COALESCE(SUM(leakage_cents), 0) AS leakage_cents FROM reconciliation_result GROUP BY status ORDER BY leakage_cents DESC") {
        Ok(rows) => Ok(rows),
        Err(e) => Err(DbError(e)),
    }
    stop(conn)
    return result
}

fn leakage_by_status() -> Result(json, ErrorCode) {

    return match db_connect("revenue_assurance.db") {
        Ok(conn) => leakage_by_status_inner(conn),
        Err(e) => Err(DbError(e)),
    }
}


// ------------------------------------------------------------
// Seed data for demonstration
// ------------------------------------------------------------

fn seed_demo_data_inner(conn: db) -> Result(i64, ErrorCode) {

    let a: i64 = match db_execute(conn, "INSERT INTO usage_record (subscriber_id, event_type, usage_units, event_time) VALUES (?, ?, ?, ?)", "SUB001", "VOICE", 100, "2026-08-25T09:00:00") {
        Ok(n) => n,
        Err(e) => -1,
    }
    let b: i64 = match db_execute(conn, "INSERT INTO usage_record (subscriber_id, event_type, usage_units, event_time) VALUES (?, ?, ?, ?)", "SUB002", "DATA", 500, "2026-08-25T09:05:00") {
        Ok(n) => n,
        Err(e) => -1,
    }
    let c: i64 = match db_execute(conn, "INSERT INTO usage_record (subscriber_id, event_type, usage_units, event_time) VALUES (?, ?, ?, ?)", "SUB003", "SMS", 50, "2026-08-25T09:10:00") {
        Ok(n) => n,
        Err(e) => -1,
    }
    let d: i64 = match db_execute(conn, "INSERT INTO billing_record (usage_id, subscriber_id, billed_units, billed_amount_cents, bill_time) VALUES (?, ?, ?, ?, ?)", 1, "SUB001", 100, 100, "2026-08-25T09:01:00") {
        Ok(n) => n,
        Err(e) => -1,
    }
    let e: i64 = match db_execute(conn, "INSERT INTO billing_record (usage_id, subscriber_id, billed_units, billed_amount_cents, bill_time) VALUES (?, ?, ?, ?, ?)", 2, "SUB002", 450, 450, "2026-08-25T09:06:00") {
        Ok(n) => n,
        Err(e) => -1,
    }
    let f: i64 = match db_execute(conn, "INSERT INTO billing_record (usage_id, subscriber_id, billed_units, billed_amount_cents, bill_time) VALUES (?, ?, ?, ?, ?)", 3, "SUB003", 50, 25, "2026-08-25T09:11:00") {
        Ok(n) => n,
        Err(e) => -1,
    }
    let g: i64 = match db_execute(conn, "INSERT INTO recharge_record (subscriber_id, recharge_amount_cents, recharge_reference, recharge_time) VALUES (?, ?, ?, ?)", "SUB001", 10000, "RCH001", "2026-08-25T08:00:00") {
        Ok(n) => n,
        Err(e) => -1,
    }
    let h: i64 = match db_execute(conn, "INSERT INTO recharge_record (subscriber_id, recharge_amount_cents, recharge_reference, recharge_time) VALUES (?, ?, ?, ?)", "SUB002", 20000, "RCH002", "2026-08-25T08:10:00") {
        Ok(n) => n,
        Err(e) => -1,
    }

    let all_ok: bool = a >= 0 && b >= 0 && c >= 0 && d >= 0 && e >= 0 && f >= 0 && g >= 0 && h >= 0
    let result: Result(i64, ErrorCode) = if all_ok {
        Ok(h)
    } else {
        Err(DbError("seed step failed"))
    }

    stop(conn)
