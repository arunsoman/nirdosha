}

fn seed_demo_data() -> Result(i64, ErrorCode) {

    return match db_connect("revenue_assurance.db") {
        Ok(conn) => seed_demo_data_inner(conn),
        Err(e) => Err(DbError(e)),
    }
}


// ------------------------------------------------------------
// Main
// ------------------------------------------------------------

fn main() {

    let initialized: Result(i64, ErrorCode) = initialize_database()

    print("Revenue Assurance platform ready")
}
