// Vendor Ops -- a launch-demo app purpose-built to show off the UI DSL's
// newer richness in one small, coherent screen: `module`-grouped nav
// (Vendors / Payouts), field-level format validation (`email`/`phone`/
// `min`/`max`) enforced client- *and* server-side, field-level RBAC
// (`risk_score` is admin-only -- an `analyst` login sees it redacted to
// null, not just hidden by convention), a role-gated custom action
// (`Approve` on a payout), and a real dashboard tile + chart. Themed via
// `--theme examples/vendor_ops_theme.json` (see LANGUAGE.md SS11b).
//
// Serve it (from the repo root -- `db_connect("vendor_ops.db")` below is
// a relative path, so it must match `--db`'s own relative path exactly,
// same convention `examples/trade-finance/trade_finance.nir` uses):
//   nirdosha serve examples/identity_mock.nir --port 9090 &
//   nirdosha serve examples/vendor_ops.nir --port 8080 \
//     --jwks-file examples/store_jwks.json --issuer https://mock-idp.local \
//     --audience store-app --identity-base http://localhost:9090 \
//     --db vendor_ops.db --theme examples/vendor_ops_theme.json
//
// Same `DbError(str)` escape-hatch convention `examples/store.nir` uses
// for the enum-favoring-`str`-ban's error channel.
enum ErrorCode {
    DbError(str),
}

module "Vendors" {
    struct Vendor {
        id: i64,
        name: str,
        email: str,
        phone: str,
        risk_score: i64,
        status: str,
    }
}

module "Payouts" {
    struct Payout {
        id: i64,
        vendor_id: i64,
        amount_cents: i64,
        status: str,
    }
}

// ---- Vendors: CRUD, SQLite-backed --------------------------------------

fn list_vendor_inner(conn: db) -> Result(json, ErrorCode) {
    let created: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS vendor (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT, email TEXT, phone TEXT, risk_score INTEGER, status TEXT)") {
        Ok(n) => n,
        Err(e) => -1,
    }
    let rows: Result(json, ErrorCode) = match db_query(conn, "SELECT id, name, email, phone, risk_score, status FROM vendor ORDER BY id") {
        Ok(r) => Ok(r),
        Err(e) => Err(DbError(e)),
    }
    stop conn
    return rows
}

fn list_vendor() -> Result(json, ErrorCode) {
    return match db_connect("vendor_ops.db") {
        Ok(conn) => list_vendor_inner(conn),
        Err(e) => Err(DbError(e)),
    }
}

fn create_vendor_inner(conn: db, v: Vendor) -> Result(i64, ErrorCode) {
    let created: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS vendor (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT, email TEXT, phone TEXT, risk_score INTEGER, status TEXT)") {
        Ok(n) => n,
        Err(e) => -1,
    }
    let result: Result(i64, ErrorCode) = match db_execute(conn, "INSERT INTO vendor (name, email, phone, risk_score, status) VALUES (?, ?, ?, ?, ?)", v.name, v.email, v.phone, v.risk_score, v.status) {
        Ok(n) => Ok(n),
        Err(e) => Err(DbError(e)),
    }
    stop conn
    return result
}

fn create_vendor(v: Vendor) -> Result(i64, ErrorCode) requires(role: "admin") {
    return match db_connect("vendor_ops.db") {
        Ok(conn) => create_vendor_inner(conn, v),
        Err(e) => Err(DbError(e)),
    }
}

fn update_vendor_inner(conn: db, v: Vendor) -> Result(i64, ErrorCode) {
    let created: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS vendor (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT, email TEXT, phone TEXT, risk_score INTEGER, status TEXT)") {
        Ok(n) => n,
        Err(e) => -1,
    }
    let result: Result(i64, ErrorCode) = match db_execute(conn, "UPDATE vendor SET name = ?, email = ?, phone = ?, risk_score = ?, status = ? WHERE id = ?", v.name, v.email, v.phone, v.risk_score, v.status, v.id) {
        Ok(n) => Ok(n),
        Err(e) => Err(DbError(e)),
    }
    stop conn
    return result
}

fn update_vendor(v: Vendor) -> Result(i64, ErrorCode) requires(role: "admin") {
    return match db_connect("vendor_ops.db") {
        Ok(conn) => update_vendor_inner(conn, v),
        Err(e) => Err(DbError(e)),
    }
}

fn delete_vendor_inner(conn: db, id: i64) -> Result(i64, ErrorCode) {
    let result: Result(i64, ErrorCode) = match db_execute(conn, "DELETE FROM vendor WHERE id = ?", id) {
        Ok(n) => Ok(n),
        Err(e) => Err(DbError(e)),
    }
    stop conn
    return result
}

fn delete_vendor(id: i64) -> Result(i64, ErrorCode) requires(role: "admin") {
    return match db_connect("vendor_ops.db") {
        Ok(conn) => delete_vendor_inner(conn, id),
        Err(e) => Err(DbError(e)),
    }
}

screen Vendor {
    title: "Vendors"
    field name {
        label: "Vendor Name"
        pattern: "^[A-Za-z0-9 .,&-]+$"
    }
    field email {
        format: "email"
    }
    field phone {
        format: "phone"
    }
    field risk_score {
        label: "Risk Score"
        min: 0
        max: 100
        view: role("admin")
        edit: role("admin")
    }
}

// ---- Payouts: CRUD + a role-gated custom action ------------------------

fn list_payout_inner(conn: db) -> Result(json, ErrorCode) {
    let created: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS payout (id INTEGER PRIMARY KEY AUTOINCREMENT, vendor_id INTEGER, amount_cents INTEGER, status TEXT)") {
        Ok(n) => n,
        Err(e) => -1,
    }
    let rows: Result(json, ErrorCode) = match db_query(conn, "SELECT id, vendor_id, amount_cents, status FROM payout ORDER BY id") {
        Ok(r) => Ok(r),
        Err(e) => Err(DbError(e)),
    }
    stop conn
    return rows
}

fn list_payout() -> Result(json, ErrorCode) {
    return match db_connect("vendor_ops.db") {
        Ok(conn) => list_payout_inner(conn),
        Err(e) => Err(DbError(e)),
    }
}

fn create_payout_inner(conn: db, p: Payout) -> Result(i64, ErrorCode) {
    let created: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS payout (id INTEGER PRIMARY KEY AUTOINCREMENT, vendor_id INTEGER, amount_cents INTEGER, status TEXT)") {
        Ok(n) => n,
        Err(e) => -1,
    }
    let result: Result(i64, ErrorCode) = match db_execute(conn, "INSERT INTO payout (vendor_id, amount_cents, status) VALUES (?, ?, ?)", p.vendor_id, p.amount_cents, p.status) {
        Ok(n) => Ok(n),
        Err(e) => Err(DbError(e)),
    }
    stop conn
    return result
}

fn create_payout(p: Payout) -> Result(i64, ErrorCode) requires(role: "admin") {
    return match db_connect("vendor_ops.db") {
        Ok(conn) => create_payout_inner(conn, p),
        Err(e) => Err(DbError(e)),
    }
}

fn update_payout_inner(conn: db, p: Payout) -> Result(i64, ErrorCode) {
    let created: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS payout (id INTEGER PRIMARY KEY AUTOINCREMENT, vendor_id INTEGER, amount_cents INTEGER, status TEXT)") {
        Ok(n) => n,
        Err(e) => -1,
    }
    let result: Result(i64, ErrorCode) = match db_execute(conn, "UPDATE payout SET vendor_id = ?, amount_cents = ?, status = ? WHERE id = ?", p.vendor_id, p.amount_cents, p.status, p.id) {
        Ok(n) => Ok(n),
        Err(e) => Err(DbError(e)),
    }
    stop conn
    return result
}

fn update_payout(p: Payout) -> Result(i64, ErrorCode) requires(role: "admin") {
    return match db_connect("vendor_ops.db") {
        Ok(conn) => update_payout_inner(conn, p),
        Err(e) => Err(DbError(e)),
    }
}

fn delete_payout_inner(conn: db, id: i64) -> Result(i64, ErrorCode) {
    let result: Result(i64, ErrorCode) = match db_execute(conn, "DELETE FROM payout WHERE id = ?", id) {
        Ok(n) => Ok(n),
        Err(e) => Err(DbError(e)),
    }
    stop conn
    return result
}

fn delete_payout(id: i64) -> Result(i64, ErrorCode) requires(role: "admin") {
    return match db_connect("vendor_ops.db") {
        Ok(conn) => delete_payout_inner(conn, id),
        Err(e) => Err(DbError(e)),
    }
}

fn approve_payout_inner(conn: db, id: i64) -> Result(i64, ErrorCode) {
    let created: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS payout (id INTEGER PRIMARY KEY AUTOINCREMENT, vendor_id INTEGER, amount_cents INTEGER, status TEXT)") {
        Ok(n) => n,
        Err(e) => -1,
    }
    let result: Result(i64, ErrorCode) = match db_execute(conn, "UPDATE payout SET status = 'approved' WHERE id = ?", id) {
        Ok(n) => Ok(n),
        Err(e) => Err(DbError(e)),
    }
    stop conn
    return result
}

fn approve_payout(id: i64) -> Result(i64, ErrorCode) requires(role: "admin") {
    return match db_connect("vendor_ops.db") {
        Ok(conn) => approve_payout_inner(conn, id),
        Err(e) => Err(DbError(e)),
    }
}

screen Payout {
    title: "Payouts"
    field amount_cents {
        label: "Amount (cents)"
        min: 100
    }
    action "Approve" -> approve_payout {
        style: "filled"
        confirm: "Approve this payout for processing?"
    }
}

// ---- Dashboard -----------------------------------------------------------

fn stat_vendor_count_inner(conn: db) -> Result(i64, ErrorCode) {
    let created: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS vendor (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT, email TEXT, phone TEXT, risk_score INTEGER, status TEXT)") {
        Ok(n) => n,
        Err(e) => -1,
    }
    let result: Result(i64, ErrorCode) = match db_query(conn, "SELECT COUNT(*) as value FROM vendor") {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_i64(row, "value") {
                Ok(n) => Ok(n),
                Err(e) => Ok(0),
            },
            Err(e) => Ok(0),
        },
        Err(e) => Err(DbError(e)),
    }
    stop conn
    return result
}

fn stat_vendor_count() -> Result(i64, ErrorCode) {
    return match db_connect("vendor_ops.db") {
        Ok(conn) => stat_vendor_count_inner(conn),
        Err(e) => Err(DbError(e)),
    }
}

fn stat_pending_payout_count_inner(conn: db) -> Result(i64, ErrorCode) {
    let created: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS payout (id INTEGER PRIMARY KEY AUTOINCREMENT, vendor_id INTEGER, amount_cents INTEGER, status TEXT)") {
        Ok(n) => n,
        Err(e) => -1,
    }
    let result: Result(i64, ErrorCode) = match db_query(conn, "SELECT COUNT(*) as value FROM payout WHERE status = 'requested'") {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_i64(row, "value") {
                Ok(n) => Ok(n),
                Err(e) => Ok(0),
            },
            Err(e) => Ok(0),
        },
        Err(e) => Err(DbError(e)),
    }
    stop conn
    return result
}

fn stat_pending_payout_count() -> Result(i64, ErrorCode) {
    return match db_connect("vendor_ops.db") {
        Ok(conn) => stat_pending_payout_count_inner(conn),
        Err(e) => Err(DbError(e)),
    }
}

fn chart_payouts_by_status_inner(conn: db) -> Result(json, ErrorCode) {
    let created: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS payout (id INTEGER PRIMARY KEY AUTOINCREMENT, vendor_id INTEGER, amount_cents INTEGER, status TEXT)") {
        Ok(n) => n,
        Err(e) => -1,
    }
    let rows: Result(json, ErrorCode) = match db_query(conn, "SELECT status as label, COUNT(*) as value FROM payout GROUP BY status") {
        Ok(r) => Ok(r),
        Err(e) => Err(DbError(e)),
    }
    stop conn
    return rows
}

fn chart_payouts_by_status() -> Result(json, ErrorCode) {
    return match db_connect("vendor_ops.db") {
        Ok(conn) => chart_payouts_by_status_inner(conn),
        Err(e) => Err(DbError(e)),
    }
}

dashboard {
    tile "Vendors" -> stat_vendor_count
    tile "Pending Payouts" -> stat_pending_payout_count
    chart "Payouts by Status" -> chart_payouts_by_status
}

fn main() {}
