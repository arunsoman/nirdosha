// A mock identity provider for the `examples/purchase_approval.nir` demo
// (`ROADMAP.md` Track A item A13) -- same recipe `examples/
// identity_mock.nir`'s own doc comment documents in full: `POST
// /api/login {"subject":"...","role":"..."}` mints a real signed token
// via `mock_issue_token` against a fixed, published JWKS; the token then
// validates through the real, unmodified `oidc_validate_token` on
// `purchase_approval.nir`'s own server. A separate, smaller mock than
// `identity_mock.nir` rather than reusing it, since this demo's role
// vocabulary (`manager`/`director`/`vp`) is unrelated to that one's
// (store/trade-finance roles).
//
// Serve with `nirdosha serve examples/purchase_approval_identity_mock.nir
// --port 9091`.

struct Text {
    value: str,
}

enum Role {
    manager,
    director,
    vp,
    employee,
}

fn login(subject: Text, role: Role) -> Result(Text, Text) {
    let jwks: str = "{\"keys\":[{\"kid\":\"key1\",\"kty\":\"oct\",\"k\":\"bXktc2VjcmV0LWtleQ\"}]}"
    let claims_json: str = match role {
        manager() => "{\"roles\":[\"manager\"]}",
        director() => "{\"roles\":[\"director\"]}",
        vp() => "{\"roles\":[\"vp\"]}",
        employee() => "{\"roles\":[\"employee\"]}",
    }
    return match mock_issue_token(subject.value, "https://mock-idp.local", "purchase-approval-app", 1700000000, 999999999, claims_json, jwks) {
        Ok(token) => Ok(Text(token)),
        Err(e) => Err(Text(e)),
    }
}

fn main() {}
