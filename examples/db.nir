// db_connect/db_query/db_execute -- layer 1: SQLite (rusqlite, "bundled"
// -- statically linked, no system libsqlite3), the backend below since
// ":memory:" isn't a postgres://... URL. Layer 2 (crates/compiler/src/dbconn.rs)
// adds Postgres: pass db_connect a "postgres://user@host/dbname"
// connection string instead and the exact same db_query/db_execute/stop
// calls below run against a real Postgres server, no other change to
// this file needed -- docs/PROTOLANG_PORT.md's "Locked design 5: DB" has the
// full design, crates/compiler/tests/postgres.rs the (opt-in, real-server)
// tests. One connection handle, stop-able like tcp/file/sandbox; results
// always read back as json, composing directly with json_get_*/json_array_*.

// A `db` handle is affine (like `tcp`/`file`) and, like them, has no
// borrowing story yet -- passing it to more than one helper function
// would move it away from the caller. Every query against one
// connection lives in a single function for that reason, not split
// across smaller helpers the way `first_user_name` alone might suggest
// is possible -- a real, general limitation shared by every affine
// handle in this language today, not specific to `db`.
struct Text {
    value: str,
}

fn run_all(conn: db) -> Text {
    let created: i64 = match db_execute(conn, "CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT)") {
        Ok(n) => n,
        Err(e) => -1,
    }
    let inserted: i64 = match db_execute(conn, "INSERT INTO users (name) VALUES ('ada')") {
        Ok(n) => n,
        Err(e) => -1,
    }
    let name: Text = match db_query(conn, "SELECT name FROM users ORDER BY id") {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_str(row, "name") {
                Ok(n) => Text(n),
                Err(e) => Text(e),
            },
            Err(e) => Text(e),
        },
        Err(e) => Text(e),
    }
    stop conn
    return name
}

fn main() {
    let name: Text = match db_connect(":memory:") {
        Ok(conn) => run_all(conn),
        Err(e) => Text(e),
    }
    print(name.value)
}
