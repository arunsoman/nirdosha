// A mock identity provider, shared by every `nirdosha serve`d example
// that needs a login -- `examples/store.nir` and
// `examples/rev-assurence/rev_assurance.nir` both point their
// `--identity-base` at this same process (`nirdosha serve
// examples/identity_mock.nir --port 9090`), and both `nirdosha serve`
// instances are started with `--audience store-app` to trust it.
// `POST /api/login {"subject":"...","role":"admin"}` mints a real
// signed token via `mock_issue_token` (the deliberate, explicitly-named
// inverse of `oidc_validate_token` -- see its own doc comment in
// interpreter.rs) against a fixed, published JWKS. The token then
// validates through the *real*, unmodified `oidc_validate_token` on the
// relying app's own server -- that round-trip is what makes this useful
// as a stand-in for a real IdP during local development, not a
// parallel/fake auth mechanism.
//
// Recognized roles: `"admin"`, `"analyst"` (store/rev-assurance), plus
// `examples/trade-finance/`'s doc-accurate RBAC vocabulary --
// `"system_admin"`, `"corporate_seller"`, `"corporate_buyer"`,
// `"bank_ops"`, `"compliance_officer"`, `"channel_partner"` -- or
// anything else, which becomes `"customer"`. Nirdosha `str` has no
// concatenation or parsing (docs/LANGUAGE.md §2), so there's no way to turn
// an arbitrary free-text role list into JSON claims dynamically;
// picking between a fixed set of literal, pre-written claims payloads
// via `==` is what's actually expressible. A real IdP obviously
// wouldn't have this limit.
//
// A minted token's `roles` claim can (and for several personas here,
// does) carry more than one entry -- `requires(role: "x")` checks
// array membership, not equality (`identity_has_role`, interpreter.rs),
// so `system_admin`/`analyst` are minted with every module-owning role
// baked in (broad read access), and `corporate_seller`/
// `corporate_buyer`/`bank_ops` each also carry a synthetic
// `"trade_party"` role -- a name no real persona uses, that exists
// purely so a module needing more than one business role's read access
// can still gate to one literal `requires(role: "trade_party")`. See
// `login`'s own doc comment below for the exact per-persona arrays.
//
// `issued_at` is a fixed literal, not a real clock reading -- Nirdosha
// has no wall-clock builtin (deliberate: docs/LANGUAGE.md §9's determinism
// stance), so tokens are minted with a generous fixed ttl instead of
// expiring realistically. Fine for a local mock; would need a real
// clock source to not be.

// `subject` is genuine free text (an identity subject) -- wrapped in
// `Text`, the ban's carrier struct, same as `login`'s own token/error
// return below. `role`, by contrast, is exactly the closed-vocabulary case
// the ban is meant to push out of
// `str`+`==`/literal-`match` and into a real `enum` -- `Role` below,
// one variant per recognized role string plus an explicit `customer`
// (previously the `_ =>` fallback for anything unrecognized; a request
// naming any other string is now a clean 400 from `decode_enum_value`,
// `serve.rs`, rather than silently becoming a customer login).
struct Text {
    value: str,
}

enum Role {
    admin,
    analyst,
    system_admin,
    corporate_seller,
    corporate_buyer,
    bank_ops,
    compliance_officer,
    channel_partner,
    customer,
}

fn login(subject: Text, role: Role) -> Result(Text, Text) {
    let jwks: str = "{\"keys\":[{\"kid\":\"key1\",\"kty\":\"oct\",\"k\":\"bXktc2VjcmV0LWtleQ\"}]}"
    // `system_admin`/`analyst` carry every module-owning role string
    // used by `trade_finance.nir`'s `requires(role: ...)` gates, plus
    // the synthetic `trade_party` umbrella (see below) -- so both
    // personas read every module (`identity_has_role`, interpreter.rs,
    // checks array membership, not equality; `analyst`'s array
    // deliberately omits the literal `system_admin` string, the one
    // exception -- `list_api_key`/`list_webhook_subscription` stay
    // system_admin-only even for analyst). `corporate_seller`/
    // `corporate_buyer`/`bank_ops`/`compliance_officer` each also carry
    // `trade_party`, a role that names no real persona -- it exists only
    // so Module 2's `list_counterparty` (basic KYC profile data every
    // one of these four legitimately needs) and Module 3 (dual buyer+
    // seller instruments)/Module 6 (delivery/dispute) can gate to one
    // literal `requires(role: "trade_party")` shared by all four
    // operationally-involved roles, since `requires()` itself takes
    // exactly one role string, not a list (see `examples/trade-finance/
    // todo.md`'s RBAC read-access notes for the full reasoning).
    let claims_json: str = match role {
        admin() => "{\"roles\":[\"admin\"]}",
        analyst() => "{\"roles\":[\"analyst\",\"compliance_officer\",\"bank_ops\",\"corporate_seller\",\"corporate_buyer\",\"channel_partner\",\"trade_party\"]}",
        system_admin() => "{\"roles\":[\"system_admin\",\"compliance_officer\",\"bank_ops\",\"corporate_seller\",\"corporate_buyer\",\"channel_partner\",\"trade_party\"]}",
        corporate_seller() => "{\"roles\":[\"corporate_seller\",\"trade_party\"]}",
        corporate_buyer() => "{\"roles\":[\"corporate_buyer\",\"trade_party\"]}",
        bank_ops() => "{\"roles\":[\"bank_ops\",\"trade_party\"]}",
        compliance_officer() => "{\"roles\":[\"compliance_officer\",\"trade_party\"]}",
        channel_partner() => "{\"roles\":[\"channel_partner\"]}",
        customer() => "{\"roles\":[\"customer\"]}",
    }
    return match mock_issue_token(subject.value, "https://mock-idp.local", "store-app", 1700000000, 999999999, claims_json, jwks) {
        Ok(token) => Ok(Text(token)),
        Err(e) => Err(Text(e)),
    }
}

fn main() {}
