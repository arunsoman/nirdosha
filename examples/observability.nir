// Exercises observability layer 1's traced hook points: `spawn`/`join`
// (Concurrent), `file`'s `open`/`send`/`recv`/`stop` (Io), and `print`
// (Io). Run with `--otel-console` to see one JSON span per line on
// stdout -- with no flag at all, this runs identically (and at the same
// cost) to any other program, since `tracer: None` is the default (see
// `observability.rs`'s module doc for the "zero cost when disabled"
// mechanism this example is meant to demonstrate).
//
//   nirdosha examples/observability.nir --otel-console

fn double(n: i64) -> i64 {
    return n * 2
}

fn main() {
    let h: thread i64 = spawn double(21)

    let out: file = open("/tmp/nirdosha_observability_example.txt", "w")
    send(out, "hello from the observability example")
    stop out

    let inp: file = open("/tmp/nirdosha_observability_example.txt", "r")
    let content: str = recv(inp)
    stop inp

    let doubled: i64 = join h
    print(doubled) // 42
    print(content)
}
