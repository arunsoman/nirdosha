// `transact`'s Layer 5 (docs/TRANSACT.md): a slot's named function using a
// real cross-process effect internally -- `connect`/`tcp`'s `send`/`recv`
// here, `sandbox`/`db_connect` equally legal, since the restriction is
// only "one named `Expr::Call`," never "no side effects inside it." No
// grammar change from any earlier layer: `network`/`commit` already
// accepted any user function, this one just happens to talk to a real
// socket instead of computing in-process.
//
// Needs something listening on 127.0.0.1:9000 speaking this file's own
// tiny text protocol first -- `tests/transact_durability.rs`'s
// `network_slot_talks_to_a_real_separate_process_over_tcp` is the
// self-contained version of this same shape that actually runs in CI
// (spins up its own listener, the same split `tests/tcp.rs` already has
// with `examples/tcp_client.nir`): send `txn_id`, reply `charged`.

fn call_gateway(txn_id: str, amount: i64) -> i64 {
    let conn: tcp = connect("127.0.0.1", 9000)
    send(conn, txn_id)
    let reply: str = recv(conn)
    stop conn
    return amount
}

fn check(resp: i64) -> bool {
    return resp > 0
}

fn update_db(amount: i64) -> i64 {
    print("committing", amount)
    return amount
}

fn checkout(amount: i64) -> bool {
    return transact {
        network: call_gateway(txn_id, amount) retry 3 timeout 5
        verify:  check(network)
        commit:  update_db(network)
    }
}

fn main() -> unit {
    let committed: bool = checkout(42)
    print("checkout(42) committed:", committed)
}
