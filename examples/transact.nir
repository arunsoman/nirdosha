// `transact { ... }` -- TRANSACT.md's durable-effect construct.
//
// Full protocol: precheck?, network, verify, commit, compensate?, log? --
//
//   0. `precheck` (optional) runs first -- must return `bool`. `false`
//      aborts immediately, nothing durable is ever written (the fix for
//      "the DB was already down before `network` ran").
//   1. `txn_id: str` is generated (an unpredictable, always-unique
//      idempotency key) before anything runs, and durably logged as part
//      of `network`'s own intent record -- `network`'s call must pass
//      `txn_id` as one of its arguments (typeck-enforced).
//   2. `network` runs once, its result becomes an implicit local binding
//      (`network`) visible to every slot after it -- durably recorded
//      before `verify` runs.
//   3. `verify` runs, sees `network` (its only allowed arguments are
//      `network`/`txn_id` -- this is what makes crash replay from mid-
//      `network` fully reconstructable), must return `bool` -- its
//      result becomes another implicit binding (`verify`).
//   4. `verify == true`  -> `commit` runs, retried with backoff on
//      failure (a trap, or a `Result(_, _)` return in its `Err` variant)
//      -- `transact` yields `true` once it succeeds.
//   5. `verify == false` -> `compensate` runs (if present), same retry
//      treatment, then `transact` yields `false`.
//   6. `log` (if present) always runs last, best-effort -- never itself
//      part of the durability contract, never replayed.
//
// If a `commit`/`compensate` retry budget is exhausted, `transact` traps
// (`TransactCommitPending`/`TransactCompensatePending`) rather than
// guessing `true`/`false` -- the durable log entry is left non-terminal
// for `Interpreter::replay_pending_transactions` (a restart, or the same
// reconciliation run again later) to keep retrying.
//
// `transact` is an *expression* (not a statement) that produces `bool` --
// the same "block-value convention `if` already uses" TRANSACT.md names
// explicitly, which is why `return transact { ... }` below works exactly
// like `return if c {..} else {..}` already does.

fn db_reachable() -> bool {
    // Stand-in for a real health check (e.g. `db_ping()`) -- Layer 5
    // (cross-process `network`/`commit`) lets any slot's function
    // internally use `sandbox`/`connect`/`tcp`/`db_connect` with no
    // grammar change at all.
    return true
}

fn call_api(txn_id: str, amount: i64) -> i64 {
    // Stand-in for a real network call -- a correctly-built downstream
    // dedupes on `txn_id`, which is what makes it safe for crash replay
    // to resend this exact call after a restart.
    return amount
}

fn check(resp: i64) -> bool {
    return resp > 0
}

fn update_db(amount: i64) -> i64 {
    print("committing", amount)
    return amount
}

fn refund(amount: i64) -> i64 {
    print("compensating", amount)
    return amount
}

fn write_log(amount: i64, ok: bool) -> unit {
    print("logged", amount, ok)
}

fn checkout(amount: i64) -> bool {
    return transact {
        precheck:   db_reachable()
        network:    call_api(txn_id, amount)
        verify:     check(network)
        commit:     update_db(amount)
        compensate: refund(amount)
        log:        write_log(amount, verify)
    }
}

// A `transact` with no `precheck`/`compensate`/`log` slot at all -- all
// three are optional (TRANSACT.md's grammar), and `verify == false` with
// no `compensate` present still yields `false`, it just has nothing to
// run on the way there.
fn minimal(amount: i64) -> bool {
    return transact {
        network: call_api(txn_id, amount)
        verify:  check(network)
        commit:  update_db(amount)
    }
}

fn main() -> unit {
    let committed: bool = checkout(10)
    print("checkout(10) committed:", committed)

    let compensated: bool = checkout(-5)
    print("checkout(-5) committed:", compensated)

    let minimal_ok: bool = minimal(1)
    print("minimal(1) committed:", minimal_ok)
}
