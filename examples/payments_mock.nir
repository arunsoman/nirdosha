// A mock payment gateway -- `nirdosha serve examples/payments_mock.nir
// --port 9091`. Simulates the "simulate the payment gateway" ask
// literally: `examples/store.nir`'s `checkout` calls `POST /api/charge`
// over plain `http_post` and always gets a deterministic success back.
// No real card handling, no real money movement -- this is a stand-in
// for Stripe/Adyen/etc. during local development only, the same
// "obviously not production" spirit `examples/identity_mock.nir` takes
// for identity.

enum ErrorCode {
    MalformedResponse,
}

fn charge() -> Result(json, ErrorCode) {
    return match json_parse("{\"charge_id\":\"ch_mock_001\",\"status\":\"succeeded\"}") {
        Ok(doc) => Ok(doc),
        Err(e) => Err(MalformedResponse()),
    }
}

fn main() {}
