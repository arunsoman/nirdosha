// Live demo for `ROADMAP.md` Track A item A13 / `WORKFLOW.md`'s "State
// ownership + a generated queue UI" section: a purchase order needs
// sequential sign-off from three different roles, in order, before it's
// approved -- a plain multi-level approval chain (contrast the six-eyes
// *quorum* shape `trade_payment_approval_workflow_check.rs` exercises,
// where *two distinct* holders of one role must each decide; here each
// level is a single decider, but a different role per level).
//
// Every state below names its own `owner: role(...)` -- the one thing
// `workflow{}` couldn't express before this feature: without it, any
// signed-in caller could fire `Approved`/`Rejected` on any level, not
// just the role that level is actually gated to.
//
// Served with `nirdosha serve examples/purchase_approval.nir --port
// 8080 --jwks-file <jwks.json> --issuer ... --audience ...` (or driven
// straight off `mock_issue_token` for a live demo with no real IdP --
// see `scratch/` for a worked login flow). `submit_purchase_order`
// requires a real, signed-in `employee` -- unlike `kyc_onboarding.nir`'s
// deliberately anonymous public intake, "who submitted this" is exactly
// what this demo wants to show off (`WORKFLOW.md`'s "who submitted
// this" section): the requester's own `identity.subject` is recorded as
// `data.requester_subject` *and* durably as `workflow_instance.
// started_by_subject`, so they can later pull up their own request's
// status via the generated "My Requests" tab, without needing `owner`
// on any state at all. `advance_purchase_approval`/
// `list_purchase_approval_pending_for_me`/`list_purchase_approval_submitted_by_me`/
// `get_purchase_approval_history` are all synthesized by
// `workflow_lower.rs`, not written here at all -- every signed-in caller
// may *attempt* `advance_*`, but its own runtime owner check
// (`interpreter.rs::workflow_advance_inner`) is what actually decides
// whether a given caller may fire a given instance's current event, and
// the generated "Workflows" nav section (`ui_gen.rs`/
// `ui_gen_template.html`) is what lets a manager/director/VP see and act
// on exactly the requests waiting on *them* -- and lets the original
// requester see exactly their own, read-only, with a full audit trail.

// `LANGUAGE.md` §6b's carrier-struct convention: free text crossing a
// real `fn` boundary can't be a bare `str` (`submit_purchase_order`
// below is a real, user-facing `program.fns` entry, not a workflow-
// lowering-synthesized one, so it isn't exempt the way `data { ... }`'s
// own struct fields are).
struct Text {
    value: str,
}

fn log_stage_entered(instance_id: i64) -> bool requires(public) {
    return true
}

workflow PurchaseApproval {
    data {
        requester_subject: str,
        description: str,
        amount_cents: i64,
    }

    state PendingManagerApproval {
        owner: role("manager")
        label: "Pending Manager Approval"
        on_entry {
            log_stage_entered(instance_id)
        }
        on Approved -> PendingDirectorApproval
        on Rejected -> Rejected
    }

    state PendingDirectorApproval {
        owner: role("director")
        label: "Pending Director Approval"
        on_entry {
            log_stage_entered(instance_id)
        }
        on Approved -> PendingVpApproval
        on Rejected -> Rejected
    }

    state PendingVpApproval {
        owner: role("vp")
        label: "Pending VP Approval"
        on_entry {
            log_stage_entered(instance_id)
        }
        on Approved -> Approved
        on Rejected -> Rejected
    }

    state Approved terminal {
        label: "Approved"
        on_entry {
            log_stage_entered(instance_id)
        }
    }

    state Rejected terminal {
        label: "Rejected"
        on_entry {
            log_stage_entered(instance_id)
        }
    }
}

// Any signed-in employee may submit a request -- `identity` is a
// required (not `Option`-wrapped) param on this wrapper, unlike
// `start_purchase_approval`'s own optional one, because *this* demo
// wants every request attributable to a real requester; a program that
// wants anonymous submission instead would pass `None()` through, the
// same way `kyc_onboarding.nir`'s `submit_kyc_application` does.
fn submit_purchase_order(identity: VerifiedIdentity, description: Text, amount_cents: i64) -> Result(i64, WorkflowActionError) {
    return start_purchase_approval(Some(identity), PurchaseApprovalData(identity.subject, description.value, amount_cents))
}
