// The killer demo: a two-account money-transfer ledger, written the way
// an AI agent (or a tired human) actually writes this logic on a first
// pass -- read the sender's balance, check it, then issue two separate
// `UPDATE`s. No lock. No `BEGIN IMMEDIATE`. No `transact` block. This is
// deliberately the *naive* shape (same read-check-then-write pattern
// `examples/online-trading.nir`'s `place_order_inner` already uses), not
// a specially hardened one -- the point of this demo is what happens to
// naive code like this under real concurrent load, compared to the same
// naive shape in `examples/killer_demo/ledger_naive.py`.
//
// Run it:
//   nirdosha serve examples/killer_demo/ledger.nir --port 8080 --db examples/killer_demo/ledger.db
//
// Then see `examples/killer_demo/load_test.py` and `RESULTS.md` in this
// directory for the actual concurrent-load comparison against the
// Python twin.

enum ErrorCode {
    DbError(str),
    NotFound(str),
    InsufficientFunds(str),
    InvalidAmount(str),
}

// The standing "free text crossing a function boundary" fixture
// (docs/LANGUAGE.md SS6b) -- every other example in this repo defines
// its own copy the same way.
struct Text {
    value: str,
}

struct Account {
    id: i64,
    name: str,
    balance_cents: i64,
}

// Idempotent: (re)seeds exactly two accounts at 1,000,000 cents each, so
// `total()` should always read back 2,000,000 -- the invariant the whole
// demo checks. Safe to call before every load-test run.
fn reset_ledger_inner(conn: db) -> Result(Text, ErrorCode) {
    let created: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS account (id INTEGER PRIMARY KEY, name TEXT, balance_cents INTEGER)") {
        Ok(n) => n,
        Err(e) => -1,
    }
    let cleared: Result(i64, ErrorCode) = match db_execute(conn, "DELETE FROM account") {
        Ok(n) => Ok(n),
        Err(e) => Err(DbError(e)),
    }
    let seeded_a: Result(i64, ErrorCode) = match cleared {
        Ok(_) => match db_execute(conn, "INSERT INTO account (id, name, balance_cents) VALUES (1, ?, 1000000)", "alice") {
            Ok(n) => Ok(n),
            Err(e) => Err(DbError(e)),
        },
        Err(e) => Err(e),
    }
    let seeded_b: Result(Text, ErrorCode) = match seeded_a {
        Ok(_) => match db_execute(conn, "INSERT INTO account (id, name, balance_cents) VALUES (2, ?, 1000000)", "bob") {
            Ok(n) => Ok(Text("reset")),
            Err(e) => Err(DbError(e)),
        },
        Err(e) => Err(e),
    }
    stop conn
    return seeded_b
}

fn reset_ledger() -> Result(Text, ErrorCode) requires(public) {
    return match db_connect("examples/killer_demo/ledger.db") {
        Ok(conn) => reset_ledger_inner(conn),
        Err(e) => Err(DbError(e)),
    }
}

fn balance_inner(conn: db, id: i64) -> Result(i64, ErrorCode) {
    let created: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS account (id INTEGER PRIMARY KEY, name TEXT, balance_cents INTEGER)") {
        Ok(n) => n,
        Err(e) => -1,
    }
    let result: Result(i64, ErrorCode) = match db_query(conn, "SELECT balance_cents FROM account WHERE id = ?", id) {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_i64(row, "balance_cents") {
                Ok(bal) => Ok(bal),
                Err(e) => Err(DbError(e)),
            },
            Err(e) => Err(NotFound("account")),
        },
        Err(e) => Err(DbError(e)),
    }
    stop conn
    return result
}

fn balance(id: i64) -> Result(i64, ErrorCode) requires(public) {
    return match db_connect("examples/killer_demo/ledger.db") {
        Ok(conn) => balance_inner(conn, id),
        Err(e) => Err(DbError(e)),
    }
}

// The invariant this whole demo checks: the sum of every account's
// balance never changes, no matter how many concurrent transfers ran.
// Money can move between rows; it can't be created or destroyed.
fn total_inner(conn: db) -> Result(i64, ErrorCode) {
    let created: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS account (id INTEGER PRIMARY KEY, name TEXT, balance_cents INTEGER)") {
        Ok(n) => n,
        Err(e) => -1,
    }
    let result: Result(i64, ErrorCode) = match db_query(conn, "SELECT COALESCE(SUM(balance_cents), 0) as s FROM account") {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_i64(row, "s") {
                Ok(s) => Ok(s),
                Err(e) => Err(DbError(e)),
            },
            Err(e) => Err(DbError(e)),
        },
        Err(e) => Err(DbError(e)),
    }
    stop conn
    return result
}

fn total() -> Result(i64, ErrorCode) requires(public) {
    return match db_connect("examples/killer_demo/ledger.db") {
        Ok(conn) => total_inner(conn),
        Err(e) => Err(DbError(e)),
    }
}

// Naive by design, and specifically "load two rows into app-level
// variables, then write each one's new value back" -- the classic
// ORM-style read-modify-write shape (not a relative `SET x = x - ?`,
// which SQLite would apply atomically regardless of timing and so
// wouldn't race at all): SELECT both balances, compute both new values
// in this function's own local variables, `sleep_ms` to stand in for a
// real network round trip to the database (see `RESULTS.md`'s
// methodology note -- `examples/killer_demo/ledger_naive.py` inserts the
// exact same delay in the exact same place, for a fair comparison), then
// write both rows back. This is exactly the shape that loses updates
// under concurrency on any server that can run two requests at once.
// `nirdosha serve`'s request loop is strictly sequential (one process,
// no `thread::spawn` in `serve.rs` -- see that module's own doc
// comment), so this whole function body always runs to completion
// before the next request is even looked at. That's an honest,
// verifiable property of today's `serve.rs`, not a language-level
// data-race proof the way `spawn`/`chan` (docs/LANGUAGE.md, `box`
// ownership) are -- see `RESULTS.md` for exactly what this demo does and
// doesn't claim.
fn transfer_inner(conn: db, from_id: i64, to_id: i64, amount_cents: i64) -> Result(Text, ErrorCode) {
    let created: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS account (id INTEGER PRIMARY KEY, name TEXT, balance_cents INTEGER)") {
        Ok(n) => n,
        Err(e) => -1,
    }
    let amount_ok: Result(i64, ErrorCode) = if amount_cents <= 0 {
        Err(InvalidAmount("amount_cents must be positive"))
    } else {
        Ok(amount_cents)
    }
    let from_balance: Result(i64, ErrorCode) = match amount_ok {
        Ok(_) => match db_query(conn, "SELECT balance_cents FROM account WHERE id = ?", from_id) {
            Ok(rows) => match json_array_get(rows, 0) {
                Ok(row) => match json_get_i64(row, "balance_cents") {
                    Ok(bal) => Ok(bal),
                    Err(e) => Err(DbError(e)),
                },
                Err(e) => Err(NotFound("from account")),
            },
            Err(e) => Err(DbError(e)),
        },
        Err(e) => Err(e),
    }
    let checked: Result(i64, ErrorCode) = match from_balance {
        Ok(bal) => if bal >= amount_cents {
            Ok(bal)
        } else {
            Err(InsufficientFunds("not enough funds"))
        },
        Err(e) => Err(e),
    }
    let to_balance: Result(i64, ErrorCode) = match checked {
        Ok(_) => match db_query(conn, "SELECT balance_cents FROM account WHERE id = ?", to_id) {
            Ok(rows) => match json_array_get(rows, 0) {
                Ok(row) => match json_get_i64(row, "balance_cents") {
                    Ok(bal) => Ok(bal),
                    Err(e) => Err(DbError(e)),
                },
                Err(e) => Err(NotFound("to account")),
            },
            Err(e) => Err(DbError(e)),
        },
        Err(e) => Err(e),
    }
    // Models a real network round trip to the database between reading
    // both balances and writing them back -- see this fn's doc comment.
    let slept: unit = sleep_ms(2)
    let debited: Result(i64, ErrorCode) = match checked {
        Ok(bal) => match to_balance {
            Ok(_) => match db_execute(conn, "UPDATE account SET balance_cents = ? WHERE id = ?", bal - amount_cents, from_id) {
                Ok(n) => Ok(n),
                Err(e) => Err(DbError(e)),
            },
            Err(e) => Err(e),
        },
        Err(e) => Err(e),
    }
    let credited: Result(Text, ErrorCode) = match debited {
        Ok(_) => match to_balance {
            Ok(tb) => match db_execute(conn, "UPDATE account SET balance_cents = ? WHERE id = ?", tb + amount_cents, to_id) {
                Ok(n) => Ok(Text("transferred")),
                Err(e) => Err(DbError(e)),
            },
            Err(e) => Err(e),
        },
        Err(e) => Err(e),
    }
    stop conn
    return credited
}

fn transfer(from_id: i64, to_id: i64, amount_cents: i64) -> Result(Text, ErrorCode) requires(public) {
    return match db_connect("examples/killer_demo/ledger.db") {
        Ok(conn) => transfer_inner(conn, from_id, to_id, amount_cents),
        Err(e) => Err(DbError(e)),
    }
}

fn main() {
    let setup: Result(Text, ErrorCode) = reset_ledger()
    match setup {
        Ok(n) => print("ledger ready"),
        Err(e) => print("setup error"),
    }
}
