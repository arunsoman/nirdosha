enum ErrorCode {
    DbError(str),
    NotFound,
}

struct Text {
    value: str,
}

struct Restaurant {
    id: i64,
    name: Text,
    location: Text,
}

struct MenuItem {
    id: i64,
    restaurant_id: i64,
    name: Text,
    price_cents: i64,
}

struct Customer {
    id: i64,
    name: Text,
    address: Text,
}

struct OrderRequest {
    customer_id: i64,
    item_id: i64,
    quantity: i64,
}

fn setup_db_inner(conn: db) -> Result(i64, ErrorCode) {
    let r1: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS restaurant (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT, location TEXT)") {
        Ok(n) => n,
        Err(e) => -1,
    }
    let r2: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS menu_item (id INTEGER PRIMARY KEY AUTOINCREMENT, restaurant_id INTEGER, name TEXT, price_cents INTEGER)") {
        Ok(n) => n,
        Err(e) => -1,
    }
    let r3: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS customer (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT, address TEXT)") {
        Ok(n) => n,
        Err(e) => -1,
    }
    let r4: i64 = match db_execute(conn, "CREATE TABLE IF NOT EXISTS orders (id INTEGER PRIMARY KEY AUTOINCREMENT, customer_id INTEGER, item_id INTEGER, quantity INTEGER, total_cents INTEGER)") {
        Ok(n) => n,
        Err(e) => -1,
    }
    let all_ok: bool = r1 >= 0 && r2 >= 0 && r3 >= 0 && r4 >= 0
    let result: Result(i64, ErrorCode) = if all_ok {
        Ok(0)
    } else {
        Err(DbError("setup failed"))
    }
    stop(conn)
    return result
}

fn setup_db() -> Result(i64, ErrorCode) {
    return match db_connect("food_delivery.db") {
        Ok(conn) => setup_db_inner(conn),
        Err(e) => Err(DbError(e)),
    }
}

fn list_restaurants_inner(conn: db) -> Result(json, ErrorCode) {
    let rows: Result(json, ErrorCode) = match db_query(conn, "SELECT id, name, location FROM restaurant ORDER BY id") {
        Ok(r) => Ok(r),
        Err(e) => Err(DbError(e)),
    }
    stop(conn)
    return rows
}

fn list_restaurants() -> Result(json, ErrorCode) {
    return match db_connect("food_delivery.db") {
        Ok(conn) => list_restaurants_inner(conn),
        Err(e) => Err(DbError(e)),
    }
}

fn list_menu_items_inner(conn: db, restaurant_id: i64) -> Result(json, ErrorCode) {
    let rows: Result(json, ErrorCode) = match db_query(conn, "SELECT id, restaurant_id, name, price_cents FROM menu_item WHERE restaurant_id = ?", restaurant_id) {
        Ok(r) => Ok(r),
        Err(e) => Err(DbError(e)),
    }
    stop(conn)
    return rows
}

fn list_menu_items(restaurant_id: i64) -> Result(json, ErrorCode) {
    return match db_connect("food_delivery.db") {
        Ok(conn) => list_menu_items_inner(conn, restaurant_id),
        Err(e) => Err(DbError(e)),
    }
}

fn create_restaurant_inner(conn: db, r: Restaurant) -> Result(i64, ErrorCode) {
    let res: Result(i64, ErrorCode) = match db_execute(conn, "INSERT INTO restaurant (name, location) VALUES (?, ?)", r.name.value, r.location.value) {
        Ok(n) => Ok(n),
        Err(e) => Err(DbError(e)),
    }
    stop(conn)
    return res
}

fn create_restaurant(r: Restaurant) -> Result(i64, ErrorCode) requires(role: "admin") {
    return match db_connect("food_delivery.db") {
        Ok(conn) => create_restaurant_inner(conn, r),
        Err(e) => Err(DbError(e)),
    }
}

fn create_menu_item_inner(conn: db, m: MenuItem) -> Result(i64, ErrorCode) {
    let res: Result(i64, ErrorCode) = match db_execute(conn, "INSERT INTO menu_item (restaurant_id, name, price_cents) VALUES (?, ?, ?)", m.restaurant_id, m.name.value, m.price_cents) {
        Ok(n) => Ok(n),
        Err(e) => Err(DbError(e)),
    }
    stop(conn)
    return res
}

fn create_menu_item(m: MenuItem) -> Result(i64, ErrorCode) requires(role: "admin") {
    return match db_connect("food_delivery.db") {
        Ok(conn) => create_menu_item_inner(conn, m),
        Err(e) => Err(DbError(e)),
    }
}

fn create_customer_inner(conn: db, c: Customer) -> Result(i64, ErrorCode) {
    let res: Result(i64, ErrorCode) = match db_execute(conn, "INSERT INTO customer (name, address) VALUES (?, ?)", c.name.value, c.address.value) {
        Ok(n) => Ok(n),
        Err(e) => Err(DbError(e)),
    }
    stop(conn)
    return res
}

fn create_customer(c: Customer) -> Result(i64, ErrorCode) {
    return match db_connect("food_delivery.db") {
        Ok(conn) => create_customer_inner(conn, c),
        Err(e) => Err(DbError(e)),
    }
}

fn place_order_inner(conn: db, req: OrderRequest) -> Result(i64, ErrorCode) {
    let item_result: Result(json, ErrorCode) = match db_query(conn, "SELECT price_cents FROM menu_item WHERE id = ?", req.item_id) {
        Ok(r) => Ok(r),
        Err(e) => Err(DbError(e)),
    }
    
    let total_cents: i64 = match item_result {
        Ok(rows) => match json_array_get(rows, 0) {
            Ok(row) => match json_get_i64(row, "price_cents") {
                Ok(p) => p * req.quantity,
                Err(e) => -1,
            },
            Err(e) => -1,
        },
        Err(e) => -1,
    }
    
    let valid_order: bool = total_cents > 0 && req.quantity > 0
    let res: Result(i64, ErrorCode) = if valid_order {
        match db_execute(conn, "INSERT INTO orders (customer_id, item_id, quantity, total_cents) VALUES (?, ?, ?, ?)", req.customer_id, req.item_id, req.quantity, total_cents) {
            Ok(n) => Ok(n),
            Err(e) => Err(DbError(e)),
        }
    } else {
        Err(NotFound())
    }
    stop(conn)
    return res
}

fn place_order(req: OrderRequest) -> Result(i64, ErrorCode) {
    return match db_connect("food_delivery.db") {
        Ok(conn) => place_order_inner(conn, req),
        Err(e) => Err(DbError(e)),
    }
}

fn list_orders_inner(conn: db, customer_id: i64) -> Result(json, ErrorCode) {
    let rows: Result(json, ErrorCode) = match db_query(conn, "SELECT id, customer_id, item_id, quantity, total_cents FROM orders WHERE customer_id = ?", customer_id) {
        Ok(r) => Ok(r),
        Err(e) => Err(DbError(e)),
    }
    stop(conn)
    return rows
}

fn list_orders(customer_id: i64) -> Result(json, ErrorCode) {
    return match db_connect("food_delivery.db") {
        Ok(conn) => list_orders_inner(conn, customer_id),
        Err(e) => Err(DbError(e)),
    }
}

fn main() {
    let setup: Result(i64, ErrorCode) = setup_db()
    let ok: bool = match setup {
        Ok(n) => true,
        Err(e) => false,
    }
    if ok {
        print("Database initialized successfully")
    } else {
        print("Database setup failed")
    }
}