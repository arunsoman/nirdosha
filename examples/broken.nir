// Deliberately rejected — for `nirdosha examples/broken.nir --format=json`
// (README §10, "Structured diagnostics"). `consume` takes ownership of its
// `box i64` argument; the second call below reuses `a` after it has
// already been moved into the first call. The ownership checker catches
// this statically (row 1/2) and reports it as a structured `Diagnostic`
// (`"stage":"Ownership"`, `"kind":"UseAfterMove"`) instead of running it.
fn consume(b: box i64) -> i64 {
    return *b
}

fn main() {
    let a: box i64 = box 10
    print(consume(a))
    print(consume(a))
}
