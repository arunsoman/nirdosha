// Generated from Neo4j project "trade-finance-b2b-2" user stories,
// via scratch/nirdosha_llm_prompt.md. First 5 stories only (test run).
// Regenerated after the prompt was updated (instruction 6/7) to name
// functions for `emit-ui`/`serve` screen inference: list_/create_/
// update_/delete_/get_<struct>.

struct Text {
    value: str,
}

// --- story-001/002: Select Trade Workflow Variant / Payment Method
// Decision Engine Recommendation -- both act on the same TradeRecord
// entity, so they share one CRUD screen (create = new PO + recommended
// variant pre-filled, update = officer's accept/override confirmation).

enum WorkflowVariant {
    AdvancePayment,
    OpenAccount,
    DocumentaryCollection,
    LcBacked,
    MilestoneEscrow,
}

enum TrustLevel {
    Low,
    Medium,
    High,
}

struct TradeRecord {
    id: i64,
    po_id: i64,
    trust_level: TrustLevel,
    credit_rating: i64,
    order_size_cents: i64,
    bank_guarantee_required: bool,
    recommended_variant: WorkflowVariant,
    workflow_variant: WorkflowVariant,
}

fn workflow_variant_code(v: WorkflowVariant) -> Text {
    return match v {
        AdvancePayment => Text("advance_payment"),
        OpenAccount => Text("open_account"),
        DocumentaryCollection => Text("documentary_collection"),
        LcBacked => Text("lc_backed"),
        MilestoneEscrow => Text("milestone_escrow"),
    }
}

fn trust_level_code(t: TrustLevel) -> Text {
    return match t {
        Low => Text("low"),
        Medium => Text("medium"),
        High => Text("high"),
    }
}

// Non-CRUD domain logic (story-002's decision engine) -- not its own
// screen action, called from create_trade_record so the recommendation
// is pre-filled the moment a trade record is created.
fn recommend_workflow_variant(trust: TrustLevel, credit_rating: i64, order_size_cents: i64, bank_guarantee_required: bool) -> WorkflowVariant {
    return if bank_guarantee_required {
        LcBacked()
    } else {
        match trust {
            High => if credit_rating >= 700 {
                OpenAccount()
            } else {
                AdvancePayment()
            },
            Medium => if order_size_cents >= 10000000 {
                MilestoneEscrow()
            } else {
                DocumentaryCollection()
            },
            Low => AdvancePayment(),
        }
    }
}

fn list_trade_record() -> Result(json, Text) {
    return match db_connect("b2b_trade_finance.db") {
        Ok(conn) => match db_query(conn, "SELECT id, po_id, trust_level, credit_rating, order_size_cents, bank_guarantee_required, recommended_variant, workflow_variant FROM trade_record ORDER BY id") {
            Ok(rows) => Ok(rows),
            Err(e) => Err(Text(e)),
        },
        Err(e) => Err(Text(e)),
    }
}

fn create_trade_record(t: TradeRecord) -> Result(i64, Text) {
    let recommended: WorkflowVariant = recommend_workflow_variant(t.trust_level, t.credit_rating, t.order_size_cents, t.bank_guarantee_required)
    let rec_code: Text = workflow_variant_code(recommended)
    let trust_code: Text = trust_level_code(t.trust_level)
    return match db_connect("b2b_trade_finance.db") {
        Ok(conn) => match db_execute(conn, "INSERT INTO trade_record (po_id, trust_level, credit_rating, order_size_cents, bank_guarantee_required, recommended_variant, workflow_variant) VALUES (?, ?, ?, ?, ?, ?, ?)", t.po_id, trust_code.value, t.credit_rating, t.order_size_cents, t.bank_guarantee_required, rec_code.value, rec_code.value) {
            Ok(n) => Ok(n),
            Err(e) => Err(Text(e)),
        },
        Err(e) => Err(Text(e)),
    }
}

fn update_trade_record(t: TradeRecord) -> Result(i64, Text) {
    let sel_code: Text = workflow_variant_code(t.workflow_variant)
    let trust_code: Text = trust_level_code(t.trust_level)
    return match db_connect("b2b_trade_finance.db") {
        Ok(conn) => match db_execute(conn, "UPDATE trade_record SET po_id = ?, trust_level = ?, credit_rating = ?, order_size_cents = ?, bank_guarantee_required = ?, workflow_variant = ? WHERE id = ?", t.po_id, trust_code.value, t.credit_rating, t.order_size_cents, t.bank_guarantee_required, sel_code.value, t.id) {
            Ok(n) => Ok(n),
            Err(e) => Err(Text(e)),
        },
        Err(e) => Err(Text(e)),
    }
}

// --- story-003: Multi-Format Document Ingestion ---

enum DocumentFormat {
    Pdf,
    Image,
    Edi,
}

enum DocumentType {
    PurchaseOrder,
    BillOfLading,
    CommercialInvoice,
    PackingList,
    CertificateOfOrigin,
}

struct Document {
    id: i64,
    trade_id: i64,
    doc_type: DocumentType,
    format: DocumentFormat,
    s3_key: str,
    status: str,
}

fn document_type_code(t: DocumentType) -> Text {
    return match t {
        PurchaseOrder => Text("purchase_order"),
        BillOfLading => Text("bill_of_lading"),
        CommercialInvoice => Text("commercial_invoice"),
        PackingList => Text("packing_list"),
        CertificateOfOrigin => Text("certificate_of_origin"),
    }
}

fn document_format_code(f: DocumentFormat) -> Text {
    return match f {
        Pdf => Text("pdf"),
        Image => Text("image"),
        Edi => Text("edi"),
    }
}

fn list_document() -> Result(json, Text) {
    return match db_connect("b2b_trade_finance.db") {
        Ok(conn) => match db_query(conn, "SELECT id, trade_id, doc_type, format, s3_key, status FROM document ORDER BY id") {
            Ok(rows) => Ok(rows),
            Err(e) => Err(Text(e)),
        },
        Err(e) => Err(Text(e)),
    }
}

fn create_document(d: Document) -> Result(i64, Text) {
    let type_code: Text = document_type_code(d.doc_type)
    let format_code: Text = document_format_code(d.format)
    return match db_connect("b2b_trade_finance.db") {
        Ok(conn) => match db_execute(conn, "INSERT INTO document (trade_id, doc_type, format, s3_key, status) VALUES (?, ?, ?, ?, 'queued_for_ocr')", d.trade_id, type_code.value, format_code.value, d.s3_key) {
            Ok(n) => Ok(n),
            Err(e) => Err(Text(e)),
        },
        Err(e) => Err(Text(e)),
    }
}

// --- story-004: ML/OCR Data Extraction ---
// (extraction itself runs in an external ML/OCR service and writes the
// row this screen lists; update_ is the officer's "confirm correct" step)

struct DocumentExtraction {
    id: i64,
    document_id: i64,
    line_items_json: str,
    currency: str,
    incoterms: str,
    counterparty_metadata_json: str,
    confirmed: bool,
}

fn list_document_extraction() -> Result(json, Text) {
    return match db_connect("b2b_trade_finance.db") {
        Ok(conn) => match db_query(conn, "SELECT id, document_id, line_items_json, currency, incoterms, counterparty_metadata_json, confirmed FROM document_extraction ORDER BY id") {
            Ok(rows) => Ok(rows),
            Err(e) => Err(Text(e)),
        },
        Err(e) => Err(Text(e)),
    }
}

fn update_document_extraction(e: DocumentExtraction) -> Result(i64, Text) {
    return match db_connect("b2b_trade_finance.db") {
        Ok(conn) => match db_execute(conn, "UPDATE document_extraction SET line_items_json = ?, currency = ?, incoterms = ?, counterparty_metadata_json = ?, confirmed = ? WHERE id = ?", e.line_items_json, e.currency, e.incoterms, e.counterparty_metadata_json, e.confirmed, e.id) {
            Ok(n) => Ok(n),
            Err(e2) => Err(Text(e2)),
        },
        Err(e2) => Err(Text(e2)),
    }
}

// --- story-005: Cross-Document Validation ---

struct CrossDocumentValidation {
    id: i64,
    trade_id: i64,
    field_name: str,
    invoice_value: str,
    bol_value: str,
    mismatch: bool,
    acknowledged: bool,
}

fn list_cross_document_validation() -> Result(json, Text) {
    return match db_connect("b2b_trade_finance.db") {
        Ok(conn) => match db_query(conn, "SELECT id, trade_id, field_name, invoice_value, bol_value, mismatch, acknowledged FROM cross_document_validation ORDER BY id") {
            Ok(rows) => Ok(rows),
            Err(e) => Err(Text(e)),
        },
        Err(e) => Err(Text(e)),
    }
}

fn update_cross_document_validation(v: CrossDocumentValidation) -> Result(i64, Text) {
    return match db_connect("b2b_trade_finance.db") {
        Ok(conn) => match db_execute(conn, "UPDATE cross_document_validation SET field_name = ?, invoice_value = ?, bol_value = ?, mismatch = ?, acknowledged = ? WHERE id = ?", v.field_name, v.invoice_value, v.bol_value, v.mismatch, v.acknowledged, v.id) {
            Ok(n) => Ok(n),
            Err(e) => Err(Text(e)),
        },
        Err(e) => Err(Text(e)),
    }
}

fn main() {}
